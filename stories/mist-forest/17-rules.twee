:: StoryRules [script]
// 条件表（`#435`）：手写段落分支 → **表驱动**。字段语义、三条机检纪律、与该表配套的门，
// 统一写在 `docs/dev-conventions.md` §11–§12（单一权威）；这里只留最省字的速记：
//   `req`全部满足 / `any`至少一个 / `exclude`都不满足 / `prereq`前置行 id / `prio`显式优先级（降序、同 prio 按表序）
//   `scope` 作用域（`段落` 或 `段落#位点`；是**结构**：决定该行 text 算哪个段落的故事文本）
//   `premise` 散文锚句 / `yields` 授予笔记 id / `gives` 授予物品 / `sets` 置真状态键（三类写点都在 `<<rules>>` 渲染成功后同处落）
//   `text` 选中时渲染的正文（**不含渲染期状态读**；点击态写只许词汇宏 —— `#624`）
// 选择器在引擎侧（`src/engine/40-sim/21-resolve.twee`），**只经 `Sg.story.rules()` 取表**；
// 单选用 `<<rules "scope">>`、菜单用 `<<rulelist "scope">>`（渲染全部命中行）。
Object.assign((window.Sg.story ??= {}), {
	rules: () => [
		{
			id: 'keeper.flower_warning_echo',
			scope: '守林人',
			// 来源：`40-ch2.twee` 里原先手写的 `<<if Sg.notes.has('n_flower_warned') and Sg.notes.has('n_keeper_told')>>`
			//（`#435` 形状 PR 的**第一个真实样本**；`#516` 动过的那处正文）
			req: ['n_flower_warned', 'n_keeper_told'],
			prio: 10,
			text: `''"塔基墙根那片银白的花——味道闻久了会睡。要摘，先把气含住。"''`,
		},
		{
			id: 'flowerfield.stand', scope: '塔外花田#站一会',   // 一段落多条件位点 ⇒ scope 用 `段落#位点`（本文件约定）
			exclude: ['n_flower_warned'], prio: 10,
			text: `你在花田边站了一会儿。风从花那边过来，眼皮跟着沉了沉。`,
		},
		{
			id: 'flowerfield.back', scope: '塔外花田#退回',
			exclude: ['n_flower_warned'], prio: 10,
			text: `		<<link "先别动它，退回塔门">><<goto "塔门">><</link>>`,
		},
		{ id: '雾之魔物·战.初见', scope: '雾之魔物·战#初见', req: ['n_mist_is_guard'], prio: 10, text: `			''它退开半步，让出一条路。''你知道它守的是谁——它也知道你知道了。
			[[往塔那边去|守林人]]
		` },
		{ id: '雾之魔物·战.初见.else', scope: '雾之魔物·战#初见', exclude: ['n_mist_is_guard'], prio: 10, text: `			它散了，又在三步外聚起来。你从它旁边过去，它没有追。
			[[往塔那边去|守林人]]
		` },
		{ id: '守林人.雾影', scope: '守林人#雾影', req: ['n_mist_is_guard'], prio: 10, text: `（你提起路上那团雾，问他它为什么让了路。他说：''"它只是把生人当成了敌人。"''）` },
		{ id: '守林人.花警', scope: '守林人#花警', exclude: ['n_flower_warned'], yields: ['n_flower_warned'], prio: 10, text: `	/% #229：保命信息不按交情发放——花警告与楼板警告同级，初遇对所有人说（canon §5.4） %/
	"还有，"他叫住你，"塔基墙根那片银白的花——味道闻久了会睡。要摘，先把气含住。我小时候在那儿睡过一下午，醒来天都黑了。"
	` },
		{ id: '书房.暗格', scope: '书房#暗格', req: ['n_witch_hint'], prio: 10, text: `''女巫说的暗格''，位置分毫不差。` },
		{ id: '书房.暗格.else', scope: '书房#暗格', exclude: ['n_witch_hint'], prio: 10, text: `你不确定那是不是暗格。` },
		{ id: '天文台.账本', scope: '天文台#账本', req: ['n_ledger_hint'], prio: 10, text: `<span class="sys-note">（你已经知道：那些点是等分的。）</span>` },
		// 来源：`40-ch2.twee` 里原先手写的 <<if $era is Game.Era.PAST>> ＋ 内层 <<if $pc.keeper.met>>
		{ id: '守林人.初见.met', scope: '守林人#初见', req: ['era:past', 'keeper.met'], prio: 10, text: `		''他说话的样子，与三百年后那位一字不差。''这家人把该说的，都写进了差事里。
	` },
		{ id: '守林人.初见.young', scope: '守林人#初见', req: ['era:past'], exclude: ['keeper.met'], prio: 10, text: `		他年轻些，腰上那把钥匙的穗子还是新的。
	` },
		// 来源：`40-ch2.twee` 里原先手写的 <<if $pc.inv["时光护符"]>>（行内）
		{ id: '守林人.护符', scope: '守林人#护符', req: ['inv:时光护符'], prio: 10, text: `（他先看的是你脖子上那枚护符——''他一眼就认出来了''。）"''我妈让你来的。''"他说，语气没什么起伏，"那你就不是来找麻烦的。"

` },
		// 来源：`40-ch2.twee` 里原先手写的 <<if $era is Game.Era.PRESENT and Sg.notes.has('n_forge_seen') and not $pc.ev.forge_thanks>>
		{ id: '守林人.带话', scope: '守林人#带话', req: ['era:present', 'n_forge_seen'], exclude: ['forge_thanks'], sets: ['forge_thanks'], prio: 10, text: `	
	你替工坊的铁匠带了话。他摸了摸左臂：照他尺寸打的那副护臂，他一直没去取。
	''"那是我先人的臂。他不来取，就归用得上的人。"''他顿了顿，"替我谢谢他。''要是你还能回到炉火旺的那一晚。''""
` },
		// 来源：`40-ch2.twee` 里原先手写的 <<if $era is Game.Era.PAST>>（钥匙那句）
		{ id: '守林人.回头.past', scope: '守林人#回头', req: ['era:past'], prio: 10, text: `	他从腰上解下钥匙，搁进你手里："地下今晚为客开着。这钥匙你也收着，''我家的差事，认符也认人。''"
` },
		{ id: '守林人.回头.present', scope: '守林人#回头', exclude: ['era:past'], prio: 10, text: `	他从腰上解下钥匙，搁进你手里："地下那道门，只有这把钥匙开。"
` },
		// 来源：`40-ch2.twee` 里原先手写的 <<if $pc.inv["日记"]>>（摊开日记）
		{ id: '守林人·劝杀.日记', scope: '守林人·劝杀#日记', req: ['inv:日记'], prio: 10, text: `	<<link "摊开日记：缺的从来不是咒，是有人肯了结它">>
		<<sitecheck "守林人·劝杀·日记">><<snapshot>>
		<<if $last_check.success>>
			他一页一页翻过去。翻到那行被描过两遍的字，他的手停了很久。

			"''下早了。''"他合上日记，起身取杖，"这件事，我家欠它一个准话。我去把它了结。"

			<<goto "结局 守林人击杀">>
		<<else>>
			他把日记推回来："描过两遍的字，我妈也描过。''你读出来的，未必是我们没读出来的。''"

			<<goto "守林人·劝杀">>
		<</if>>
	<</link>>
` },
		{ id: '守林人·劝杀.日记.else', scope: '守林人·劝杀#日记', exclude: ['inv:日记'], prio: 10, text: `	（没带日记：你想说服他，手里得有''他们家自己没读懂的东西''。）
` },
		// 来源：`40-ch2.twee` 里原先手写的 <<if $pc.inv["日记"]>>（行内）
		{ id: '守林人·送.日记', scope: '守林人·送#日记', req: ['inv:日记'], prio: 10, text: `（日记里那半句，你还记得。）` },
		// `#569` 读侧口径（票面「知识面走笔记、经历/分支面走键」）：这两处要的是**具体那条 path**
		//（"听过比法" ≠ "看清了钉子"）⇒ 用键名作 `req`（键名在表里由封装层求值，不是字面状态读）。
		// 它们同时也是 `#437` 批二里最后两处"叙事段知识键直读"——搬进表后 `--reads` 的那两条基线随之核销。
		{ id: '门厅.已听比法', scope: '门厅#已听比法', req: ['world.hall_hint'], exclude: ['world.whistle_taken'], prio: 10, text: `<span class="sys-note">（你已经听过比法：那钉子是弯钩，往上提、再往外带。）</span>` },
		{ id: '书房.已摸清暗格', scope: '书房#已摸清暗格', req: ['world.study_hint'], prio: 10, text: `<span class="sys-note">（你已经摸清：暗格在炉膛后头那面墙里。）</span>` },
		// `#624`：`#568` 的对象算子（`{ gte: […] }`／`{ oneOf: […] }`）首批真实位点（原手写 if 在 40-ch2／50-ch3）。
		// 复合条件的否定（原文 else）用「无条件 ＋ 更低 prio」兜底行表达（`exclude` 单条盖不住）。
		{ id: '守林人.软限', scope: '守林人#软限', req: [{ gte: ['star.spent', 3] }], prio: 10, text: `''"你来回跑了几趟了。"''他看了一眼你身后的林子，''"雾薄了。可薄下去的东西，不全是你带回的。"''` },
		{ id: '守林人.封印选项', scope: '守林人#封印选项', req: [{ oneOf: ['keeper.state', ['seal']] }], prio: 10, text: `	[[那就让他念——用他家的封印术|守林人·封印]]` },
		{ id: '地下宴会厅.哨子', scope: '地下宴会厅#哨子', req: [{ oneOf: ['keeper.state', ['ally']] }, 'inv:好哨'], prio: 10, text: `		[[吹响哨子，叫醒它|唤醒]]` },
		{ id: '地下宴会厅.哨子.else', scope: '地下宴会厅#哨子', prio: 5, text: `		[[叫醒它|唤醒]]` },
		{ id: '地下宴会厅.提醒', scope: '地下宴会厅#提醒', any: [{ oneOf: ['keeper.state', ['seal', 'ally']] }], prio: 10, text: `		守林人没有拦你，只说了一句：''"你打不过它。"''说完便退到门边。` },
		{ id: '地下宴会厅.提醒.else', scope: '地下宴会厅#提醒', exclude: [{ oneOf: ['keeper.state', ['seal', 'ally']] }], prio: 10, text: `		门框内侧刻着一行小字，刻痕很旧了：''"别动手。你打不过它。"''落款没有名字。` },
		// `#624` 批 1（菜单进表）：`<<rulelist>>` 渲染全部命中行；点击态用词汇宏 `<<note>>`（非裸 run）。
		{ id: '酒馆.t1', scope: '酒馆#打听', exclude: ['n_tav_keeper'], prio: 10, text: `	<<link "讲守林人的那一桌">><<note "n_tav_keeper">><<goto "酒馆">><</link>>` },
		{ id: '酒馆.t2', scope: '酒馆#打听', exclude: ['n_tav_dragon'], prio: 10, text: `	<<link "上了年纪的村人">><<note "n_tav_dragon">><<goto "酒馆">><</link>>` },
		{ id: '酒馆.t3', scope: '酒馆#打听', exclude: ['n_tav_grudge'], prio: 10, text: `	<<link "跑生意的">><<note "n_tav_grudge">><<goto "酒馆">><</link>>` },
		{ id: '酒馆.t4', scope: '酒馆#打听', exclude: ['n_tav_ageless'], prio: 10, text: `	<<link "接嘴的那个人">><<note "n_tav_ageless">><<goto "酒馆">><</link>>` },
		{ id: '酒馆.t5', scope: '酒馆#打听', exclude: ['n_tav_flower'], prio: 10, text: `	<<link "背着画板的游客——他在问月光花">><<note "n_tav_flower">><<goto "酒馆">><</link>>` },
		{ id: '酒馆.t6', scope: '酒馆#打听', exclude: ['n_tav_painting'], prio: 10, text: `	<<link "墙上那幅旧画">><<note "n_tav_painting">><<goto "酒馆">><</link>>` },
		{ id: '女巫.t1', scope: '女巫小屋#打听', exclude: ['n_wq_painting'], prio: 10, text: `	<<link "问：你们家与那座塔有什么渊源">><<note "n_wq_painting">><<goto "女巫小屋">><</link>>` },
		{ id: '女巫.t2', scope: '女巫小屋#打听', exclude: ['n_wq_night'], prio: 10, text: `	<<link "问：三百年前那一夜，发生过什么">><<note "n_wq_night">><<goto "女巫小屋">><</link>>` },
		{ id: '女巫.t3', scope: '女巫小屋#打听', exclude: ['n_wq_fog'], prio: 10, text: `	<<link "问：雾到底是什么">><<note "n_wq_fog">><<goto "女巫小屋">><</link>>` },
		{ id: '女巫.t4', scope: '女巫小屋#打听', exclude: ['n_wq_talisman'], prio: 10, text: `	<<link "问：这护符到底怎么用">><<note "n_wq_talisman">><<goto "女巫小屋">><</link>>` },
		{ id: '女巫.t5', scope: '女巫小屋#打听', exclude: ['n_wq_under'], prio: 10, text: `	<<link "问：塔底下锁着的到底是什么">><<note "n_wq_under">><<goto "女巫小屋">><</link>>` },
		{ id: '女巫.t6', scope: '女巫小屋#打听', exclude: ['n_wq_past'], prio: 10, text: `	<<link "问：你就这么看着，什么也不做？">><<note "n_wq_past">><<goto "女巫小屋">><</link>>` },
		{ id: '女巫.t7', scope: '女巫小屋#打听', exclude: ['n_wq_alone'], prio: 10, text: `	<<link "问：我一个人上去，够吗">><<note "n_wq_alone">><<goto "女巫小屋">><</link>>` },
		// `#624` 批 4：**可负担性**（`gold ≥ 事件价`）用取值项 `{ price: '<econ id>' }`（片二）；买不起/已买过 ⇒ 兜底行渲染原文案。
		// 标签里的价格仍调封装层 `Game.Economy.priceOf`（是**读**、不是字面状态读 ⇒ `--reads` 允许）。
		{ id: '酒馆.情报.买', scope: '酒馆#打听情报', req: [{ gte: ['pc.gold', { price: 'rumor_buy' }] }], exclude: ['n_rumor'], prio: 10, text: `	<<link \`"花 " + (-Game.Economy.priceOf("rumor_buy", $pc)) + " 金币：请他讲讲洞里的路"\`>>
		<<econ "rumor_buy">><<note "n_rumor">><<goto "酒馆">>
	<</link>>` },
		{ id: '酒馆.情报.else', scope: '酒馆#打听情报', prio: 5, text: `	（老猎人的牛皮里混着真话：''第三块板子是脆的''。）

	他把酒碗往你那边推了推："''这话值五枚，爱听不听。''洞里那排石板，第三块是脆的。真要动手，落脚时避开它。"

	说完就低头喝酒，不再看你。<span class="sys-note">（''这条情报会在洞穴里帮你。''）</span>` },
		{ id: '女巫小屋.情报.买', scope: '女巫小屋#打听情报', req: [{ gte: ['pc.gold', { price: 'witch_hint' }] }], exclude: ['n_witch_hint'], prio: 10, text: `	<<link \`"花 " + (-Game.Economy.priceOf("witch_hint", $pc)) + " 金币：问塔里的门道"\`>>
		<<econ "witch_hint">><<note "n_witch_hint">><<goto "女巫小屋">>
	<</link>>` },
		{ id: '女巫小屋.情报.else', scope: '女巫小屋#打听情报', prio: 5, text: `	<span class="sys-note">（她画给你看：''炉膛后头那个暗格''。位置分毫不差。''家里记了一百年的东西，不会有错。这条会在塔里的书房帮到你。''）</span>
	她收了炭笔："''塔我进不去——那条路认他们家的钥匙。''所以我只能把它记下来，等人带进去。"` },
		{ id: '女巫小屋.药膏.买', scope: '女巫小屋#买药膏', req: [{ gte: ['pc.gold', { price: 'salve_buy' }] }], prio: 10, text: `	<<link \`"花 " + (-Game.Economy.priceOf("salve_buy", $pc)) + " 金币买一副药膏（当前 " + $pc.salves + " 副）"\`>>
		<<econ "salve_buy">><<goto "女巫小屋">>
	<</link>>` },
	],
});
