:: Game Notes 二章 [script]
// 笔记模型（伞 #422）的**增量文件**：只往已有表追加，不定义任何别的全局。
// 本文件是 B1（#429）的内容：二章知识型旗标。
// 铁律：① 只允许 Object.assign((window.Game.Notes ??= { entries: {} }).entries, {…}) 这一句形状；
//       ② 条目只声明 flagPath（数据表不得出现字面状态读——见 #435 的那道门）；
//       ③ 分类按 docs/notes-model-batches.md §3 的作业单（93 键唯一权威表），有异议走 #432。
// 本批 6 条；**两条是多源 OR**（flagPath 给数组 ⇒ Sg.notes.readPath 取 any）：
//   · `world.hall_hint` ∨ `ev.hall_seen` —— 同一知识的两条获取路径（看钉失败听人比过／看钉成功看准了）；
//   · `world.study_hint` ∨ `ev.study_found` —— 同一知识的两条路径（敲墙/断代失败摸清位置／任一成功路径确认位置）。
// 依据 #432-B12／B8（拆键对照：`study_found` 的知识面并入本条，其世界态面「已取出」不落笔记）。
Object.assign((window.Game.Notes ??= { entries: {} }).entries, {
	n_hall_hint: {
		title: '那钉子是弯钩', src: '门厅', tags: ['二章', '门厅'],
		body: '挂哨子的钉身弯成钩：往上提、再往外带，不必硬掰。',
		era: window.Game.Era.PRESENT, flagPath: ['world.hall_hint', 'ev.hall_seen'],
	},
	n_study_hint: {
		title: '暗格在炉膛后头那面墙里', src: '书房', tags: ['二章', '书房'],
		body: '二楼书房烤炉后头那面墙上有一道细缝——那就是暗格。',
		era: window.Game.Era.PRESENT, flagPath: ['world.study_hint', 'ev.study_found'],
	},
	n_ledger_hint: {
		title: '那些点是等分的', src: '天文台', tags: ['二章', '天文台'],
		body: '缺口边上那几粒没连上的点，间距是等分的。',
		era: window.Game.Era.PRESENT, flagPath: 'world.ledger_hint',
	},
	n_failure_cause: {
		title: '缺的从来不是咒', src: '书房', tags: ['二章', '书房'],
		body: "日记最后一页，有行字被描过两遍：''缺的从来不是咒。''这句后面再没有别的字。",
		era: window.Game.Era.PRESENT, flagPath: 'ev.failure_cause',
	},
	n_observation_lock: {
		title: '没人看过它睡得怎么样', src: '书房', tags: ['二章', '书房'],
		body: "日记里还有一句更小的话：''没人看过它睡得怎么样。''",
		era: window.Game.Era.PRESENT, flagPath: 'ev.observation_lock',
	},
	n_forge_seen: {
		title: '这甲是照着一个人的手臂打的', src: '工坊', tags: ['二章', '工坊'],
		body: "架上那副锻到一半的护臂，是照着''守林人的臂''量的尺寸；那人还没来取。",
		era: window.Game.Era.PRESENT, flagPath: 'ev.forge_seen',
	},
});
