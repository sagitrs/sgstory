:: StoryRules [script]
// ── 条件表（伞 #422 阶段 4／`#435`）：手写段落分支 → **表驱动** ─────────────────────────
// 形状让 reader 一眼看懂，让**门**读得动（这是本表存在的理由，不是风格偏好）：
//   `req`      全部满足（键名／笔记 id；求值走封装层 ⇒ 表里**不出现字面状态读**）
//   `any`      至少一个满足；`exclude` 必须都不满足；`prereq` 前置行 id（必须先选中过）
//   `prio`     **显式优先级**（选择器按它降序、同 prio 按声明顺序稳定 ⇒ 不做隐式顺序假设）
//   `scope`    作用域（哪一段/哪个话题）—— 死规则门的"同作用域"比较靠它
//   `premise`  散文锚句（`test/premise-source.mjs` 用；字段名沿用原口径）
//   `yields`   本行被选中后授予的笔记 id（由调用处 `Sg.notes.add` 落地，本表不写状态）
//   `text`     选中时渲染的正文（模板；**不含字面状态读**）
// 门（`--rules` 写侧 ＋ `--reads` 读侧，两条例均属 `#435`）：
//   ① 死规则门（永不被选中的行）· `prereq` 形状（同 scope＋禁环）· 并列 prio 报告
//   ② `text` 列只许**纯渲染**（不得含状态写宏——写请走 `yields`，A 方案由 `<<rules>>` 统一落）
//      ＋ `scope` 与调用点一致：未接管行（无 `<<rules>>` 调用）／同一段落同位点重复调用／`段落#位点` 归属不符
//   ③ 表里不得出现字面状态读（`req`/`any`/`exclude`/`prereq`/`yields`/`text`）——只许 note id／键名，求值走封装层
// 入口：选择器在引擎侧（`src/engine/40-sim/21-resolve.twee` 的 `Sg.rules`），**只经 `Sg.story.rules()` 取表**。
Object.assign((window.Sg.story ??= {}), {
	rules: () => [
		{
			id: 'keeper.flower_warning_echo',
			scope: '守林人',
			// 来源：`40-ch2.twee` 里原先手写的 `<<if Sg.notes.has('n_flower_warned') and Sg.notes.has('n_keeper_told')>>`
			//（`#435` 形状 PR 的**第一个真实样本**；`#516` 动过的那处正文）
			req: ['n_flower_warned', 'n_keeper_told'],
			prio: 10,
			text: `''"塔基墙根那片银白的花——味道闻久了会睡。要摘，先把气含住。"''`,
		},
		{
			id: 'flowerfield.stand', scope: '塔外花田#站一会',   // 一段落多条件位点 ⇒ scope 用 `段落#位点`（本文件约定）
			exclude: ['n_flower_warned'], prio: 10,
			text: `你在花田边站了一会儿。风从花那边过来，眼皮跟着沉了沉。`,
		},
		{
			id: 'flowerfield.back', scope: '塔外花田#退回',
			exclude: ['n_flower_warned'], prio: 10,
			text: `		<<link "先别动它，退回塔门">><<goto "塔门">><</link>>`,
		},
		{ id: '雾之魔物·战.初见', scope: '雾之魔物·战#初见', req: ['n_mist_is_guard'], prio: 10, text: `			''它退开半步，让出一条路。''你知道它守的是谁——它也知道你知道了。
			[[往塔那边去|守林人]]
		` },
		{ id: '雾之魔物·战.初见.else', scope: '雾之魔物·战#初见', exclude: ['n_mist_is_guard'], prio: 10, text: `			它散了，又在三步外聚起来。你从它旁边过去，它没有追。
			[[往塔那边去|守林人]]
		` },
		{ id: '守林人.雾影', scope: '守林人#雾影', req: ['n_mist_is_guard'], prio: 10, text: `（你提起路上那团雾，问他它为什么让了路。他说：''"它只是把生人当成了敌人。"''）` },
		{ id: '守林人.花警', scope: '守林人#花警', exclude: ['n_flower_warned'], yields: ['n_flower_warned'], prio: 10, text: `	/% #229：保命信息不按交情发放——花警告与楼板警告同级，初遇对所有人说（canon §5.4） %/
	"还有，"他叫住你，"塔基墙根那片银白的花——味道闻久了会睡。要摘，先把气含住。我小时候在那儿睡过一下午，醒来天都黑了。"
	` },
		{ id: '书房.暗格', scope: '书房#暗格', req: ['n_witch_hint'], prio: 10, text: `''女巫说的暗格''，位置分毫不差。` },
		{ id: '书房.暗格.else', scope: '书房#暗格', exclude: ['n_witch_hint'], prio: 10, text: `你不确定那是不是暗格。` },
		{ id: '天文台.账本', scope: '天文台#账本', req: ['n_ledger_hint'], prio: 10, text: `<span class="sys-note">（你已经知道：那些点是等分的。）</span>` },
	],
});
