		picks: [0, 1, 2, 0, 0, 0, 1, 0],
	},
	{
		name: '影手',
		desc: '精灵游荡者，修行者出身。眼观六路，擅长把危机掐灭在发生之前。',
		summary: '敏15 魅13｜HP 10｜长剑(+2)｜警觉 · 机运(+1)',
		picks: [1, 2, 1, 1, 1, 1, 0, 1],
	},
	{
		name: '秘典',
		desc: '人类学者出身的巫师。体质是硬伤，但你知道所有值钱的尔西藏在哪。',
		summary: '智17 感15｜HP 7｜药膏(自动回4)｜巧手 · 学识',
		picks: [2, 0, 0, 2, 2, 2, 2, 2],
