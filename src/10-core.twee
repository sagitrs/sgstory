:: Rules [script]

/* `#1048`：**取值词汇 · 引擎派生标签**（可检索载体 ㊷——与 `pc` 字段集对账的单一权威）。
 *注意：对账判据（能假）：`pc` 初始化里出现 `xxxLabel` 字段而此处未登记 → `test/prose-vocabulary.mjs` 红。 */
Object.assign(window.Game ??= {}, {
	VALUE_LABELS: Object.freeze(['classLabel', 'bgLabel', 'speciesLabel']),
});
// ── 规则内核（d20 / SRD 5.2 风格）——数值层单一源 ─────────────
// 设计模式参考（未复制代码）：Another-RPG-Engine (MIT) 修饰栈 / foundryvtt-dnd5e (MIT) 公式组织
// 规则数值来源：D&D SRD 5.2（CC BY 4.0, © Wizards of the Coast）
// #320 阶段 4：规则内核挂到 `Game.Rules`（本文件最早加载，故在此建命名空间根）
window.Game ??= {};
// ── **引擎保留槽的登记归引擎**（`#581`）：这些键由**引擎自己**写/读（结果槽、交涉台账、骰面快照、
// 战斗台账、结局登记、笔记存储），与故事内容无关 → 登记（`Consequences.engine`，D2 门的“归属桶”）
// 由引擎在这里种一份默认，故事 2/3 不必再为它们背书。
// 理由必须**非空**（否则 `--consequences` 判“声明缺理由 → 红”）；键必须是**引擎独占**的
//（若某个故事在**叙事段落**读它，门会判“错标”——那就说明该键不属于这一档）。
// 故事仍可覆盖/追加自己的 `Consequences`（故事 1 就是整块给；用 `Object.assign` 追加不会把引擎这半清掉）。
Object.assign(((window.Game.Consequences ??= { provenance: {}, engine: {} }).engine), {
	ending: '结局登记：致命伤安全网与结局页读它（引擎侧）',
	last_result: '结果槽：`<<actOut>>` 把本次结果暂存于此（#270 通用留屏）',
	last_roll: '骰面快照：`<<lastcheck>>` 复显用',
	soc: '交涉台账：渲染期结算后清空',
	soc_lever: '交涉优势筹码：随下一次手段掷骰消费后清空',
	soc_last: '交涉回显：面板展示用',
	notes: '笔记「已授予」真存储（`ev.notes.<id>` 命名空间，经 `Sg.notes.readPath` 读）',
	// 注：`fight`（战斗台账）**故意不在引擎默认里** —— 它是**故事相关**的：有战斗内容的故事
	//（无名洞窟）会在**叙事段落**读它（`<<if $pc.ev.fight.wave>>`）→ D2 会算成 `mechanic` 桶，
	// 此时再声明为 `engine` 就是“错标”；没有战斗内容的故事（minimal-demo）才是引擎面 → 由**它自己**登记。
});
// ── 加载期常量：**已搬到 `src/engine/10-const.twee`**（`#660` 片二 Q1）──
// `Game.Era`（时代枚举）与 `Game.Damage`（伤害档梯）是**引擎政策**、不是故事数据。
// 本文件**不再定义**它们（谁是源必须唯一）——只依赖 ORDER 保证那一份先加载（`scripts/module-order.mjs`，
// 本文件排在 `10-const` **之后**），历史原因与口径写在那一页的头注里。
// ── 随机源（#441-A 抽纯函数的第一步）：**唯一取值口**，可注入 ──────────────
// 为什么要有它：`#441` 的四条验收之一是「战斗/交涉/位点判定能**不经浏览器**在 node 里驱动」——
// 而 `random()`（SugarCube 全局）在 node 里不存在 → 判定函数必须把随机源当**依赖**而不是直接调。
// 纪律：`10-kernel`／`50-present` 里**不得出现直调 `Math.random()`**（本文件与后续 sim 件一律走此处）。
// 注入方式：浏览器/ jsdom 默认走 SugarCube `random()`（harness 覆盖 `window.Math.random` 仍然有效）；
// node 侧先 `Game.Rules.rng.set((lo, hi) => k)` 再驱动。
window.Game.Rules = {
	rng: {
		_impl: null,
		set(fn) { this._impl = fn; return this; },
		reset() { this._impl = null; return this; },
		d(n) {
			if (this._impl) return this._impl(1, n);
			// `#491` 判据 10：URL 给了 `?seed=` → 惰性装上内联 PRNG（**整局骰子固定**；没给则零影响）
			const dbg = window.Game?.Rules?.debug;
			if (dbg && dbg.seed != null && typeof window.Game.Rules.seedRng === 'function') {
				this._impl = window.Game.Rules.seedRng(dbg.seed);
				return this._impl(1, n);
			}
			if (typeof random === 'function') return random(1, n);   // SugarCube 默认源
			throw new Error('Game.Rules.rng 未注入随机源：node 环境请先 Game.Rules.rng.set(fn)');
		},
		/** ★ `#1441`（分家配套）：**随机取一个下标**（`n<=0` ⇒ `-1`）。
		 *  `Math.min(n - 1, d(n) - 1)` —— ★`Math.min` 那一层是**防御**：`d(n)` 的源若被注入成越界值，
		 *  这里仍不越界（✗ 不会取到 `undefined` 后一路静默下去 ✓）。 */
		pickIndex(n) {
			const len = Number(n);
			if (!Number.isFinite(len) || len <= 0) return -1;
			// ★**上下界都夹**（`#1441` 实测）：原式只有 `Math.min`（上界）⇒ 源若返回 `0`，
			//   `d(len)-1 = -1` ⇒ 仍**越界** ✗（判据当场咬到）。故补 `Math.max(0, …)` ✓
			//   ★对**正常源**（约定 1..n）零影响 ⇒ "零行为变化"仍成立 ✓。
			return Math.max(0, Math.min(len - 1, this.d(len) - 1));
		},
		/** ★ `#1441`（分家配套）：**从列表里随机取一**（空列表 ⇒ `null`）。
		 *  为什么单列成一条：**同一式子（取下标再取值）在本仓出现 5 处** ——
		 *  部位抽取／状态目标／随机部位／攻击命中部位／池抽取 ⇒ 五份副本＝**五处会各自漂移的地方** ✓
		 *  ★注意：需要"**下标**"的调用方（如 splice 后取走）用 `pickIndex`，✗ 不要用 `indexOf(pickOne(…))`
		 *  （列表**有重复元素**时 `indexOf` 会取到**第一个** ⇒ 与随机意图不符 ✗）。 */
		pickOne(list) {
			const xs = Array.isArray(list) ? list : [];
			if (!xs.length) return null;
			return xs[this.pickIndex(xs.length)];
		},
	},
	// ── `#491` 判据 10：**调试开关**（限"构建期/URL 参数"，**不进玩家 UI**）───────────────
	// 口径（已定 ⑩）：① 只在 URL 带参数时生效 → 默认**零影响**；② 只影响**随机与事件池**，不动规则/数值表；
	// ③ 不渲染任何 UI（玩家看不到开关本身）→ 验收的确定性证据由它提供（`?seed=123&pool=short,long,chest`）。
	debug: (() => {
		try {
			const q = new URLSearchParams((typeof location !== 'undefined' && location.search) || '');
			const seed = q.get('seed'), pool = q.get('pool');
			return {
				seed: seed == null || seed === '' || !Number.isFinite(Number(seed)) ? null : (Number(seed) >>> 0),
				pool: pool ? pool.split(',').map((s) => s.trim()).filter(Boolean) : null,
			};
		} catch { return { seed: null, pool: null }; }             // 无 location（vm/node）→ 空开关
	})(),
	/** 内联 PRNG（mulberry32；不引 `scripts/` 的 node 侧工具，那些不进产物）。 */
	seedRng(seed) {
		let a = seed >>> 0;
		return (lo, hi) => {
			a = (a + 0x6D2B79F5) >>> 0;
			let x = Math.imul(a ^ (a >>> 15), 1 | a);
			x = (x + Math.imul(x ^ (x >>> 7), 61 | x)) ^ x;
			return lo + Math.floor((((x ^ (x >>> 14)) >>> 0) / 4294967296) * (hi - lo + 1));
		};
	},
	// ── `#1438` 规则参数包：**内置缺省**（dnd SRD 5.2 那套）───────────────────────
	// 为什么有"内置"这一份：✗ 未声明 `rulesPack` 的故事必须**逐字不变** ⇒ 缺省＝今天的常量 ✓
	// 取值面：故事经契约成员 `rulesPack`（`const` kind ⇒ `Sg.story.rulesPack()`）给**覆盖值**；
	//   合并语义＝**键级覆盖**（只给 `prof` 就只改 prof ✓）；缺面／`null` ⇒ 全走内置 ✓
	BUILTIN: {
		abilities: { str: '力量', dex: '敏捷', con: '体质', int: '智力', wis: '感知', cha: '魅力' },
		skills: {
			运动: 'str', 体操: 'dex', 巧手: 'dex', 隐匿: 'dex',
			奥秘: 'int', 历史: 'int', 调查: 'int', 自然: 'int', 宗教: 'int',
			驯兽: 'wis', 洞悉: 'wis', 医药: 'wis', 察觉: 'wis', 生存: 'wis',
			欺瞒: 'cha', 恐吓: 'cha', 表演: 'cha', 游说: 'cha',
		},
		abilityMod: { base: 10, divisor: 2 },   // ★公式的**参数**（`(score - base) / divisor`）⇒ ✗ 不存公式字符串
		prof: 2,
		// ★ `#1461`（第五刀·键名定稿）：**"跟骰子有关的命名"全进 `dice`** ——
		//   `sides`（骰面）／`nat20`／`nat1`（自然骰 ⇒ **档位名**）／`ok`／`bad`（普通成败 ⇒ **档位名**）✓
		//   ✗ 不另开 `outcome` 存同两个值（两个键存同一个值 ⇒ 必然漂移 ✓）
		// ★ `#1461` 定稿终形：`{sides, name, nat20, nat1, ok, bad}` ——
		//   ★分工：**命中哪一档由骰面定**（`1` 与 `sides`）｜**那一档叫什么由包定**（档位名）✓
		//   ✗ 不新增「下界值」键（骰面下界恒 `1` 是**骰的语义** ✓）；`name` ＝ **玩家可见字样**（`d20(3)`）✓
		dice: { sides: 20, name: 'd20', nat20: 'crit', nat1: 'bad', ok: 'ok', bad: 'bad' },
		// ★ `#1461` ①：`pcAC()` 读它 —— **基数 ＋ 用哪个属性**两键（✗ 不写表达式：声明面不许大于实现面 ✓）
		ac: { base: 10, ability: 'dex' },
		// ★ `#1461` ④：**分档名全表**（一处权威）—— 战斗三档 ＋ `statuses.onFail` 的 `most`／`low`
		//   （`#1433` 的收敛判据："**同名同概念才合**" ⇒ 这里恰恰同名同概念 ⇒ 一张表 ✓）
		gradesAll: ['crit', 'ok', 'bad', 'most', 'low'],
		// ★ `#1487`（五步④·D1）：**量纲族** —— ★引擎按名取值（✗ 不认字面量 ✓）
		//   ★为什么住 `BUILTIN`（裁定①）：★与 `dice`／`ac`／`gradesAll` **同一模式**（"引擎的内置规则"）
		//     ⇒ ★**引擎✗知键名**的准确含义＝"✗ 硬编在**结算逻辑**里"；硬编在**声明的缺省**里且**可被数据覆盖** ⇒ 合规 ✓
		//   ★终形（写作者定 ✓，✗ 不改）：`{keys, zero, zeroGives, floor, heal}`
		//   ★形状规则：**逐量纲各一值** ⇒ `vitals.<类>.<量纲>`（如 `floor`）｜**全量纲共一值** ⇒ `vitals.<类>`（如 `heal`／`zero`）✓
		vitals: {
			// ① 量纲 → `pc` 键名（★换一套规则书 ⇒ **类的名不变、键名可变** ✓）
			keys: { hp: 'hp', maxHp: 'max_hp', salves: 'salves' },
			// ② 零界阈值（D3：**只 0** ⇒ ✗ 不实现多档 ✓）
			zero: 0,
			// ③ 零界后果＝**声明的实体授予**（`#1488` 定名；★走 `gives` 族 ⇒ 单级布尔 ✓；✗ 引擎✗特判"死亡" ✓）
			zeroGives: ['倒地'],
			// ④ **逐量纲**：减法后**下限**（今天的 `hp` 下限 0 ⇒ `Math.max(floor.hp, …)` ✓）
			floor: { hp: 0 },
			// ⑤ **全量纲共一值**：治疗量（今天两处同一个数 ⇒ 单值 ✓ —— 声明面 ✗ 不许大于实现面 ✓）
			// ★ `#1487` 注记（边界）：★本族**只管"结算"** —— ★**展示类**（`hpbar` 的 `❤ x / y`／`snap()` 快照／`diff()` 文案／侧栏）
			//   ★**已收口**：★键名走 `vk()`／文案走 `vl()`（`#1518` 展示半 —— `pc.hp` 与 `生命` 等字面量已归零 ✓）。
			//   ★**初值类**（`pcShape`／`chargen` 的键）：★住各自的**声明面**（✗ 不是"字面量" ⇒ 也不是本族该管的 —— 本族只管取值口）✓
			heal: 4,
			// ★ `#1518`（展示半·D1「展示面需要键名 ⇒ 展示层读数据」）：**展示用文案**——与 `keys` **同形状**
			//   （逐量纲各一值 ⇒ `label.<量纲>`）⇒ ★读点写 `V().label.hp`（✗ 不硬编字面量 ✓）。
			//   ★为什么必须有它：票面要求「文案从数据读」，而 `#1520` 只落了 `keys/zero/zeroGives/floor/heal`
			//     ⇒ 没有装文案的字段 ⇒ ✗ 新造机制（D6）而按**已定的形状规则**添一格 ✓。
			label: { hp: '生命', maxHp: '生命上限', salves: '药膏' },
		},
		// ★★ `#1530`（`#1487` 同族）：**钱币量纲的声明面** —— ★同 `vitals` 的形（★第 5 成员 ✓）
		//   ★为什么要：★`gold` 原先**结算层硬编**（`pc.gold = (pc.gold ?? 0) + …`）
		//     ★而**展示层也硬编**（`金币：$pc.gold`）⇒ ★与 `vitals` **同病** ✗
		//   ★口径：★"引擎✗知键名"＝★**✗ 硬编在结算逻辑里**；
		//     ★硬编在**声明的缺省**里且**可覆盖** ⇒ 合规 ✓
		economy: {
			// ① 量纲 → `pc` 键名（★换一套规则书 ⇒ ★名不变、键名可变 ✓）
			keys: { gold: 'gold' },
			// ② ★**展示用文案**（★与 `vitals.label` **同形状** ⇒ 逐量纲各一值 ✓）
			label: { gold: '金币' },
		},
	},
	/** ★ `#1487`：**量纲取值的单一入口** —— ★引擎各处走它（✗ 不裸读字面量 ✓）。
	 *  ★"引擎✗知键名"的落地形：★**名字从 `vitals.keys` 取**（`V.hp` ＝ 数据给的那个键名）⇒ 结算逻辑里**无字面量** ✓
	 *  ★缺省／部分缺省都安全：★逐键回落（`pack().vitals?.keys?.hp ?? BUILTIN.vitals.keys.hp` ✓）。 */
	V() {
		const p = this.pack().vitals ?? null;
		const b = this.BUILTIN.vitals;
		if (!p || typeof p !== 'object' || Array.isArray(p)) return b;
		// ★**一层深合并**（只并 `keys`／`floor`／`label` 三个**对象**类；标量/数组整块取 ✓）
		// ★`label` 放**末位**：★`V()` 的键序必须与 `BUILTIN.vitals` **逐字同**（既有判据“缺面 ⇒ 内置”逐字比 ✓）
		return {
			keys: { ...b.keys, ...(p.keys ?? {}) },
			zero: p.zero ?? b.zero,
			zeroGives: Array.isArray(p.zeroGives) ? p.zeroGives : b.zeroGives,
			floor: { ...b.floor, ...(p.floor ?? {}) },
			heal: p.heal ?? b.heal,
			// ★ `#1518`：文案同样**逐键回落**（只给 `label.hp` ⇒ `maxHp` 仍走内置 ✓）
			label: { ...b.label, ...(p.label ?? {}) },
		};
	},
	/** ★ `#1487`：**量纲名 → `pc` 键名**（`V().keys` 的取值口）—— 读点写 `pc[this.vk('hp')]` ✓ */
	vk(name) { return this.V().keys?.[name] ?? this.BUILTIN.vitals.keys[name]; },
	/** ★ `#1518`：**量纲名 → 展示文案**（`V().label` 的取值口）—— 读点写 `this.vl('hp')` ✓
	 *  ★为什么单开一个口（✗ 不裸读 `V().label.hp`）：与 `vk()` **同形对称** —— 展示面的两问
	 *    「这个量纲的**键**叫什么」与「它在屏上**叫什么**」各自一个口 ⇒ ✗ 读点不会漏回落到内置 ✓ */
	vl(name) { return this.V().label?.[name] ?? this.BUILTIN.vitals.label[name]; },
	/** ★ `#1538`（表示面 P2）：**故事声明的「属性 → UI」维**（契约成员 `panels`）—— 单一读点。
	 *
	 *  ★它做什么：把**声明的规范化与只读**放在一处，✗ 不在此渲染（渲染在 `Sg.draw.*`，由消费面调用）。
	 *  ★为什么 P2 就要有这个读点（✗ 等 P3）：本仓的门有一条 `dead-declaration`（`contract-defaults.mjs:364`：
	 *    "**声明了但引擎从不读**" ⇒ 点名），而 `test/contract-defaults.mjs:88` 把它归**失败面**（计入退出码）。
	 *    ⇒ 若只有 `DEFAULTS.panels` 而**无读点**，则**任何故事一声明 `panels` 就红** ⇒
	 *    "声明面先行、消费面在后"的分期就**没有可声明窗口**，P3 又要 books 同窗补声明（spec §6①）⇒ 承重顺序互锁。
	 *    ★而 spec §3.1（"补一块声明 ⇒ 那一块**立即**改走声明"）正是要求故事**能先声明**。
	 *  ★形状（spec §2.2）：数组；每项 `{ as: 'bar'|'list', props: [...] }`。
	 *  ★边界：缺面 ⇒ `[]`（**"这一面在，但空"** —— spec §4④：✗ 不印占位、✗ 不印 `$pc.x`，玩家面**干净的空**）；
	 *    给了非数组（结构畸形）⇒ **fail-loud**（照 `pcDefaults()` 的同族口径：✗ 不静默当空 —— 见上方 `pcDefaults` 那一支的同一句话）。 */
	panels() {
		const raw = window.Sg?.story?.panels?.();
		if (raw == null) return [];
		if (!Array.isArray(raw)) throw new Error('Sg.story.panels()：必须返回**数组**（结构畸形必须报错，照 pcDefaults 同族口径）—— ✗ 不静默当空');
		return raw;
	},
	/** ★★ `#1571`（`#1222` 链 1c）：**实体表**（甲2a 裁：目标实体的运行期状态另开一张表 ⇒ `State.variables.actors`）。
	 *  ★本读点取的是**声明面的初始实体**（契约成员 `actors`，`kind:'const'`）—— ★它是"**实体名**"的**单一权威**：
	 *    编译期据此判"**声明里引用的实体名是否真存在**"（✗ 等玩家）（照 `#1564` 那套前缀判据的同一精神 ✓）。
	 *  ★形状：`{ "<实体名>": { …任意属性… }, … }`（键＝实体名 ⇒ ★声明面引用时**只写名字**，✗ 写路径 ✓）。
	 *  ★边界：缺面 ⇒ `{}`（**"这一面在，但空"** —— 用于没有实体面的故事，✗ 不报错）；非对象（结构畸形）⇒ **fail-loud**
	 *    （照 `panels()`／`pcDefaults()` 的同族口径：✗ 不静默当空 ✓）。 */
	actors() {
		const raw = window.Sg?.story?.actors?.();
		if (raw == null) return {};
		if (typeof raw !== 'object' || Array.isArray(raw)) {
			throw new Error('Sg.story.actors()：必须返回**对象**（实体名 ⇒ 属性表；结构畸形必须报错，照 panels 同族口径）—— ✗ 不静默当空');
		}
		return raw;
	},
	/** ★ `#1530`：**钱币量纲面**（`vitals` 同族）—— ★缺面 ⇒ 内置；★**逐键回落** ✓ */
	E() {
		const p = this.pack().economy ?? null;
		const b = this.BUILTIN.economy;
		if (!p || typeof p !== 'object' || Array.isArray(p)) return b;
		// ★与 `V()` **同手法**：★只并 `keys`／`label` 两个**对象**类；★`label` 放**末位**（★键序逐字同 ✓）
		return {
			keys: { ...b.keys, ...(p.keys ?? {}) },
			label: { ...b.label, ...(p.label ?? {}) },
		};
	},
	/** ★ `#1530`：**量纲名 → `pc` 键名**（`E().keys` 的取值口）—— ★读点写 `pc[this.ek('gold')]` ✓ */
	ek(name) { return this.E().keys?.[name] ?? this.BUILTIN.economy.keys[name]; },
	/** ★ `#1530`：**量纲名 → 展示文案**（`E().label` 的取值口）—— ★读点写 `this.el('gold')` ✓ */
	el(name) { return this.E().label?.[name] ?? this.BUILTIN.economy.label[name]; },
	/** 故事声明的规则包（缺面 ⇒ 内置）；★合并＝**键级覆盖**（✗ 不是整份替换）。
	 *  为什么键级：故事只想改 `prof` 时，✗ 不该被迫照抄 18 个技能名（照抄 ⇒ 两处必漂移 ✗）。 */
	pack() {
		const p = window.Sg?.story?.rulesPack?.() ?? null;
		if (!p || typeof p !== 'object' || Array.isArray(p)) return this.BUILTIN;
		return { ...this.BUILTIN, ...p };
	},
	// ★`SKILLS`／`ABILITIES` 改为 **getter**：**读法不变**（`R.SKILLS`／`R.ABILITIES` 照旧 ✓）
	//   ⇒ 既有调用点、`test/rules.mjs` 的"引擎 ↔ 编译期镜像逐字同"钉法、五处 `skillLabel` 文案**全部不动** ✓
	get ABILITIES() { return this.pack().abilities ?? this.BUILTIN.abilities; },
	get SKILLS() { return this.pack().skills ?? this.BUILTIN.skills; },
	mod(score) {
		// `#1438`：公式**参数**归包（✗ 不写死 10／2）
		const f = this.pack().abilityMod ?? this.BUILTIN.abilityMod;
		return Math.floor(((score ?? f.base) - f.base) / f.divisor);
	},
	fmod(score) { const m = this.mod(score); return m >= 0 ? `+${m}` : `${m}`; },
	abilityMod(pc, ab) { return this.mod(pc.abilities?.[ab]); },
	prof() { return this.pack().prof ?? this.BUILTIN.prof; }, // `#1438`：熟练加值归包（缺省 2 ＝ SRD 5.2）
	skillMod(pc, skill) {
		const ab = this.SKILLS[skill];
		if (!ab) throw new Error(`未知技能: ${skill}`);
		let m = this.abilityMod(pc, ab);
		if ((pc.skills ?? []).includes(skill)) m += this.prof();
		return m;
	},
	d20(adv) {
		// `#1438`：**骰面归包**（缺省 20 ⇒ 今天逐字不变 ✓）
		const S = this.pack().dice?.sides ?? this.BUILTIN.dice.sides;
		if (!adv) return this.rng.d(S);
		const a = this.rng.d(S), b = this.rng.d(S);
		return adv > 0 ? Math.max(a, b) : Math.min(a, b);
	},
	// 判定标注：说清"用什么属性判定"（技能 → 属性，SRD 5.2）
	skillLabel(skill) { const ab = this.SKILLS[skill]; return ab ? `${skill}检定（${this.ABILITIES[ab]}）` : `${skill}检定`; },
	// 取骰：记下两枚供"计算过程"显示（优势取高 / 劣势取低）
	roll(adv) {
		// ★ `#1463`（T 阻断，我实测成立）：**骰面 ≈ 判定侧的源头** —— 这里硬编 `20` ⇒
		//   包改了 `dice.sides` 而此处仍掷 20 ⇒ ★`nat20` 那一支**恒不触发** ✗（判定侧改了也没用 ✓）
		//   ★保留 `{roll, rolls}` 返回形（`rolls` 是"计算过程"要显示的两枚 ⇒ ✗ 不能直接 `return d20` 丢它 ✓）
		const _S = this.pack().dice?.sides ?? 20;   // 缺省 20 ⇒ 零包＝今天 ✓
		const a = this.rng.d(_S);
		if (!adv) return { roll: a, rolls: [a] };
		const b = this.rng.d(_S);
		return { roll: adv > 0 ? Math.max(a, b) : Math.min(a, b), rolls: [a, b] };
	},
	// 修正构成（拆项：判定属性 + 熟练 + 加值 + 幸运）
	parts(pc, ability, { skill = '', bonus = 0 } = {}) {
		const out = [{ k: this.ABILITIES[ability] ?? ability, v: this.abilityMod(pc, ability), kind: 'ability' }];
		if (skill && (pc.skills ?? []).includes(skill)) out.push({ k: '熟练', v: this.prof(), kind: 'prof' });
		if (bonus) out.push({ k: '额外加值', v: bonus, kind: 'bonus' });
		if (pc.flags?.luck) out.push({ k: '幸运', v: 1, kind: 'luck' });
		return out;
	},
	// nat：要求「天然出目」等于 nat 才算成功（彩蛋检定用；此时 DC 不参与判定）
	check(pc, skill, dc, { adv = 0, bonus = 0, nat = 0, site = '', advWhy = '', disWhy = '' } = {}) {
		const ability = this.SKILLS[skill];
		if (!ability) throw new Error(`未知技能: ${skill}`);
		const parts = this.parts(pc, ability, { skill, bonus });
		const mod = parts.reduce((n, p) => n + p.v, 0);
		const { roll, rolls } = this.roll(adv), total = roll + mod;
		// ★ `#1461`（第五刀）：**自然骰读包**（✗ 不写死 20／1 ⇒ 否则与包不同步 ✓）
		const _dp = window.Game.Rules.pack().dice;
		return { label: this.skillLabel(skill), site, skill, ability, dc, roll, rolls, mod, total, parts, adv, advWhy, disWhy, nat,
			success: nat ? roll === nat : roll === _dp.sides ? true : roll === 1 ? false : total >= dc };
	},
	save(pc, ability, dc, { adv = 0, bonus = 0, nat = 0, site = '', advWhy = '', disWhy = '' } = {}) {
		const parts = this.parts(pc, ability, { bonus });
		const mod = parts.reduce((n, p) => n + p.v, 0);
		const { roll, rolls } = this.roll(adv), total = roll + mod;
		const _dp2 = window.Game.Rules.pack().dice;   // ★ `#1461`：自然骰读包（同 `check`）
		return { label: `${this.ABILITIES[ability]}豁免`, site, ability, dc, roll, rolls, mod, total, parts, adv, advWhy, disWhy, nat,
			success: nat ? roll === nat : roll === _dp2.sides ? true : roll === 1 ? false : total >= dc };
	},
};

// ── 角色状态形状：单一默认源 + 旧档迁移（新增字段必须过这里，否则读档即崩）──
window.Game.Pc = {
	// `#1186`：**玩法状态组的在场信号表**（单一真相：模块状态组 ← 故事契约面）。
	//
	// 口径（`#1184` 流一裁定）：模块的状态组不能按"模块文件有没有加载"来判——引擎各模块在任何故事里都加载，
	// 按加载判等于没判。在场信号一律取**故事的接入契约面**（"声明即所用"那条既有线，零新机制）。
	// 键名是契约成员名；`kind` 只用于文档（`fn`＝函数面、`face`＝数据面）。
	//注意：本片只落这张表与判据（键集合暂不动）；按它收窄基础面、各模块注册状态组是同一片的下一步。
	groups: {
		chargen: { keys: ['classKey', 'classLabel', 'bgKey', 'bgLabel', 'speciesKey', 'speciesLabel', 'abilities', 'skills', 'feats', 'gear', 'hp', 'max_hp', 'salves'], present: ['hasChargen'], kind: 'fn' },
		economy: { keys: ['gold'], present: ['econEvents'], kind: 'fn' },
		items: { keys: ['inv'], present: ['itemEffect'], kind: 'fn' },
		gear: { keys: ['gearHp'], present: ['gearDef'], kind: 'fn' },
		checks: { keys: ['statuses'], present: ['checkSite'], kind: 'fn' },
		// `#1227` 类一：`keys` 不再写死 `dragon` —— 战斗组贡献什么键由故事的 `foeStateShape()`（`pcShape` 同路）给；
		// 本行只声明『哪一面在场即启用这一组』。
		combat: { keys: [], present: ['combatPool', 'combatAction'], kind: 'fn' },
		social: { keys: ['soc'], present: ['socialAsks', 'socialHooks'], kind: 'fn' },
	},
	// 取当前 pc（原裸全局 `Game.Pc.now()`，#320 阶段 4 并进来）
	now() { return State.variables.pc; },
	// `#660` 片三-3：**形状住引擎、数值走故事** —— 本函数只给**形状**（键名 ＋ **中性值**：0/''/false/[]/{}），
	// 故事侧用 `Sg.story.pcDefaults()` 叠加它自己的数值（deep-merge 一层，键集合仍由引擎定）。
	// 为什么：`star.charge = 12`／`keeper.state = 'post'` 是**故事 1 的数值**，写在引擎里等于故事 2/3 也带着
	// 故事 1 的量跑（`#660` 片三-3 的边界问题）。缺面 → **显式降级**（只给形状，不报错）；面返回非对象 → **报错**（结构畸形）。
	defaults() {
		const shape = {
			// 基础面（与玩法机制无关；显式清单的单一真相在 `editor/lib/core/pc-state-map.mjs` 的 `PC_BASE_KEYS`）
			name: '', round: 0, picked: [], mode: '', flags: {}, ev: {}, world: {},
			// `#1186`：玩法状态（车卡族与其他六组）**不在这里预置** —— 一律由下面的**在场信号**（故事的接入契约面）贡献；
			// 缺面即无键（判据二"未声明模块的故事角色状态零玩法概念"要的形状）。
			// `#1186`：世界观概念（`star`／`keeper` 这类）由**故事自己声明形状与初值**（契约面 `pcShape`）；引擎不预置、
			// 也**不补兄弟键**（补了等于把形状偷渡回引擎，本票要治的正是这个）。
		};
		// ── `#1186`：在场模块的状态组（信号＝故事的接入契约面）──
		// 车卡族：只有 `hasChargen()` 为真的故事才有这 13 个键。缺面／假值 → 键不存在（判据二"零玩法概念"要的）。
		if (window.Sg?.story?.hasChargen?.() === true) {
			Object.assign(shape, {
				classKey: '', classLabel: '', bgKey: '', bgLabel: '', speciesKey: '', speciesLabel: '',
				abilities: null, skills: [], feats: [], gear: [], hp: 0, max_hp: 0, salves: 0,
			});
		}
		// ── `#1186`：故事自有的状态形状（契约面 `pcShape`：形状与初值一处给，引擎**不补兄弟键**）──
		// ★ `#1484`（五步①·裁定甲**＋定名**）：**`pcShape` 允许给「引擎面键（车卡族）」的静态初值** ——
		//   即不跑车卡流程也能把 `hp`／`max_hp`／`salves`（及 `abilities` 等）写成**终值** ✓
		//   ★为什么需要它（① 开笔实测的落差）：车卡族 13 键的**形状＋中性值**由 `hasChargen()` 预置，
		//     而**真值**只有跑车卡流程（`Chargen.finalize`）才算得出 ⇒
		//     ★三夹具（`hp-basic`／`cb-basic`／`fp`）**不跑车卡**却需要 hp 真值 ⇒ 此前**借 `pcDefaults` 偷渡** ✗
		//     ⇒ 收束后那条路走不通 ⇒ ★故**开放 `pcShape` 给车卡族静态初值**（复用既有口 ✗ 不新造第二套语义 ✓）
		//   ★**单产生路径纪律**：车卡族键**二选一** —— **车卡流程** ∨ **`pcShape` 静态初值**；
		//     ★两者并存（`hasChargen() && Sg.story.chargen`）⇒ **fail-loud 点名**（✗ 静默以某一方为准 ✓）
		//   ★**过渡形**：④（键归数据）落地时，这些初值**随键名一起迁数据** ⇒ 本开放**不是**永久语义 ✓
		if (typeof window.Sg?.story?.pcShape === 'function') {
			const own = window.Sg.story.pcShape();
			if (own && typeof own === 'object' && !Array.isArray(own)) {
				const chargenKeys = this.groups?.chargen?.keys ?? [];
				const hasChargenFace = window.Sg?.story?.hasChargen?.() === true;
				for (const [k, v] of Object.entries(own)) {
					// ★并存点名：`pcShape` 给车卡族键 **且** 车卡流程也在 ⇒ 两条产生路径
					if (chargenKeys.includes(k) && hasChargenFace && window.Sg?.story?.chargen != null) {
						throw new Error(`Sg.story.pcShape()：键「${k}」属**车卡族** ⇒ 与**车卡流程**并存 ✗`
							+ ` 两条产生路径（车卡族键二选一：车卡流程 ∨ pcShape 静态初值）（#1484）`);
					}
					shape[k] = (v && typeof v === 'object' && !Array.isArray(v)) ? { ...v } : v;
				}
			}
		}
		// ── `#1186`：在场模块的状态组（信号＝故事的接入契约面，登记见本对象 `groups`）──
		// 缺面 → 键不存在（判据二"未声明模块的故事角色状态零玩法概念"要的形状）。
		const face = (k) => window.Sg?.story?.[k] != null;
		// ★ `#1530`：★**默认形也走数据** —— ★否则改了键名
		//   ⇒ ★本行仍造**旧键** ⇒ ★侧栏 `ek()` 读不到 ⇒ **`undefined`** ✗
		//   ★宿主：★本处在 `Game.Pc.defaults()`（`this` 是 `Game.Pc` ✗ `Game.Rules`）
		//     ⇒ ★必须显式 `window.Game.Rules.ek('gold')`（✗ 不能 `this.ek` ✗）
		if (face('econEvents')) shape[window.Game.Rules.ek('gold')] = 0;
		if (face('itemEffect')) shape.inv = {};
		if (face('gearDef')) shape.gearHp = {};
		if (face('checkSite')) shape.statuses = {};
		// `#1227` 类一：**伴生体状态键不再写死** —— 键名与形状由故事经 `pcShape` 声明（`#1186` 的同一路径）；
		// 引擎这里只按『故事有没有对手状态面』决定**要不要**贡献这一组，贡献什么键不归引擎定。
		//（旧写法 `shape.dragon = {...}` 等于把『雾林有一只叫 dragon 的伴生体』写进引擎形状。）
		if (face('foeState')) Object.assign(shape, window.Game?.Combat?.foeShape?.() ?? {});
		if (face('socialAsks') || face('socialHooks')) shape.soc = { att: {}, tries: {}, read: {} };
		// ── 故事数值叠加（`#660` 片三-3）────────────────────────────────────────────

		const extra = window.Sg?.story?.pcDefaults?.();
		if (extra === undefined || extra === null) return shape;        // 缺面 → **显式降级**（只给形状）
		if (typeof extra !== 'object' || Array.isArray(extra)) {
			throw new Error('Sg.story.pcDefaults()：必须返回对象（结构畸形必须报错，#660 片三-3）');
		}
		// ★ `#1484`（五步①，裁定 D1／D6）：**`pcDefaults` 只给"故事自定义键"** ——
		//   引擎已知键（基础面 ＋ **各模块组声明的键**）**不许**走这条口 ⇒ ★点名 fail-loud（✗ 静默吸收）。
		//   ★为什么（真因）：`defaults()` 早已收窄成"**只给形状**"（键集合由引擎定 ⇒ 见本函数上面），
		//     而**车卡族数值**本应由车卡族自己的面给 —— 但实测三夹具（`hp-basic`／`cb-basic`／`fp`）把
		//     `hp`／`max_hp`／`salves`（＋ `cb-basic` 还带 `abilities`）塞在 `pcDefaults` 里 ⇒
		//     ★引擎**静默吸收**了它们 ⇒ 与"引擎不知 hp 键名"（D1）**方向相反** ✗
		//   ★名单**从代码推出**（✗ 不写死 —— 照 `#1448` 的纪律：写死会腐烂 ✓）：
		//     ＝ `PC_BASE_KEYS` 同源的基础面 ＋ 下面 `groups` 各组的 `keys`（★同一张表，引擎自持 ✓）
		const baseKeys = new Set(['name', 'round', 'picked', 'mode', 'flags', 'ev', 'world']);
		const groupKeys = new Set(Object.values(this.groups ?? {}).flatMap((g) => g?.keys ?? []));
		for (const [k, v] of Object.entries(extra)) {
			if (baseKeys.has(k) || groupKeys.has(k)) {
				throw new Error(`Sg.story.pcDefaults()：键「${k}」属**引擎已知键**（基础面／模块状态组）`
					+ ` ⇒ ✗ 不许由 \`pcDefaults\` 给（那是"故事自定义键"的口）—— `
					+ `车卡族／模块键的**数值**该由该模块自己的面给（#1484）`);
			}
			const cur = shape[k];
			// 两边都是对象 → **一层深合并**（保住形状的其它子键：只给 `charge` 不能把 `spent`/`first_free` 抹掉）
			if (v && typeof v === 'object' && !Array.isArray(v) && cur && typeof cur === 'object' && !Array.isArray(cur)) Object.assign(cur, v);
			else shape[k] = Array.isArray(v) ? [...v] : v;
		}
		return shape;
	},
	has(name) { return !!State.variables.pc?.inv?.[name]; },
	// ── `#746`（口径：「文字反馈最重要」）：**副作用要能自己说出数字** ──────────────────────
	// 为什么住引擎：句子由内容面写（文案属故事），但"掉了多少血／上了什么异常／哪件护具掉了几点耐久／
	// 拿了什么"是**机制算出来的** —— 让作者手写这些数字，一定会漏（实测：失败/惩罚路径普遍没接句子）。
	// 用法（内容面）：
	// <<set _snap to Game.Pc.snap($pc)>> …做点什么… <<caveEffect _snap>>
	// 口径：**纯函数**（不改 pc）· 只报**变化项**（无变化 → 空串 → 调用方不打印）· 顺序稳定（便于门与复核）。
	snap(pc) {
		// ★ `#1518`（展示半·D1）：**快照的 hp 半也按名取值** —— 键名走 `vk('hp')`（✗ 不硬编 `pc.hp` ✓）
		//   ★为什么快照也算展示面：它只服务于「**说法子**」（`diff()` ⇒ `−3 生命`）⇒ 与血条同一族 ✓
		//   ★`gold` **不在本笔**（它是 `groups.economy` 的键，其结算层也硬编 ⇒ 另票，见 `#1518` 评论）✓
		//   ★注意宿主：本函数住 `Game.Pc`，取值口在 `Game.Rules` ⇒ **✗ 不能写 `this.vk`**（`this` 是 `Game.Pc`）
		const _khp = window.Game.Rules.vk('hp');
		// ★★ `#1530`：gold 本笔收了（它属 groups.economy ⇒ 另一个量纲面 ⇒ 走 ek('gold') ✓）
		const _kg = window.Game.Rules.ek('gold');
		const _lgd = window.Game.Rules.el('gold');
		return {
			hp: pc?.[_khp] ?? 0, gold: pc?.[_kg] ?? 0,
			gearHp: { ...(pc?.gearHp ?? {}) },
			statuses: JSON.parse(JSON.stringify(pc?.statuses ?? {})),
			inv: { ...(pc?.inv ?? {}) },
		};
	},
	/** 差分：返回**人话数组**（每项一段），例如 `−3 生命`／`获得异常：手臂·流血（5 回合）`／`耐久 火把 2→1`／`得到 干粮`／`−5 金币`。 */
	diff(before, pc) {
		const out = [];
		const b = before ?? {};
		// ★ `#1518`（展示半·D1）：**量纲文案从数据读** —— 词（`生命`）走 `vl('hp')`（✗ 不硬编 ✓）
		//   ★宿主同上：`Game.Pc.diff` 里 `this` 不是 `Game.Rules` ⇒ 显式取 `window.Game.Rules` ✓
		const _khp = window.Game.Rules.vk('hp'), _lhp = window.Game.Rules.vl('hp');
		const hp0 = b.hp ?? 0, hp1 = pc?.[_khp] ?? 0;
		if (hp1 !== hp0) out.push(`${hp1 > hp0 ? '+' : '−'}${Math.abs(hp1 - hp0)} ${_lhp}（${hp0}→${hp1}）`);
		// ★ `#1530`：★**钱币差分也走数据**（★键名 `ek('gold')`／文案 `el('gold')` ✓）
		//   ★同 `#1518` 那行的手法（★实宿主不是 `Game.Rules` ⇒ 显式取 `window.Game.Rules` ✓）
		const _kgd = window.Game.Rules.ek('gold'), _lgd = window.Game.Rules.el('gold');
		const g0 = b[_kgd] ?? 0, g1 = pc?.[_kgd] ?? 0;
		if (g1 !== g0) out.push(`${g1 > g0 ? '+' : '−'}${Math.abs(g1 - g0)} ${_lgd}（${g0}→${g1}）`);
		const bStatus = b.statuses ?? {}, nowStatus = pc?.statuses ?? {};
		for (const [part, bag] of Object.entries(nowStatus)) {
			for (const [id, turns] of Object.entries(bag ?? {})) {
				const was = bStatus?.[part]?.[id];
				if (was !== turns) out.push(`获得异常：${part}·${id}（${turns} 回合）`);
			}
		}
		for (const [part, bag] of Object.entries(bStatus)) {
			for (const id of Object.keys(bag ?? {})) if (!nowStatus?.[part]?.[id]) out.push(`解除异常：${part}·${id}`);
		}
		const bGear = b.gearHp ?? {}, nowGear = pc?.gearHp ?? {};
		for (const k of [...new Set([...Object.keys(bGear), ...Object.keys(nowGear)])].sort()) {
			if ((bGear[k] ?? null) !== (nowGear[k] ?? null)) out.push(`耐久 ${k} ${bGear[k] ?? '?'}→${nowGear[k] ?? '?'}`);
		}
		const bInv = b.inv ?? {}, nowInv = pc?.inv ?? {};
		for (const k of [...new Set([...Object.keys(bInv), ...Object.keys(nowInv)])].sort()) {
			if (!bInv[k] && nowInv[k]) out.push(`得到 ${k}`);
			if (bInv[k] && !nowInv[k]) out.push(`失去 ${k}`);
		}
		return out;
	},
	migrate(pc) {
		if (!pc || typeof pc !== 'object') return this.defaults();
		const d = this.defaults();
		for (const k of Object.keys(d)) {
			if (pc[k] === undefined) pc[k] = d[k];
			else if (Array.isArray(d[k])) { if (!Array.isArray(pc[k])) pc[k] = d[k]; }
			else if (d[k] === null) { if (pc[k] !== null && typeof pc[k] !== 'object') pc[k] = d[k]; }
			else if (typeof d[k] === 'object') {
				if (!pc[k] || typeof pc[k] !== 'object' || Array.isArray(pc[k])) pc[k] = d[k];
				else for (const j of Object.keys(d[k])) if (pc[k][j] === undefined) pc[k][j] = d[k][j];
			}
		}
		// `#437` C-2c-2：旧档的知识面**写一次迁移**（旗标 → `ev.notes` 真存储）。
		// 放在最后、幂等：新档没有旗标可迁（返回 0），旧档每次载入都会补齐（补完即 0）。
		// 结构缺失（故事未注册笔记表）时 `Sg.notes` 自己 fail-loud → 这里不吞错。
		// `#1223`/`#1251`：旧档迁移随 `notes` 概念退场，调用点同笔删除。
		return pc;
	},
};

// ── 宏：<<check 技名 DC [adv|dis] [加值]>> / <<save 属性 DC [adv|dis] [加值]>> ──
// 计算过程显示开关（"显示计算过程"；关掉只剩结果）。本地持久化，与图鉴同一套 localStorage 套路
// #320 阶段 2：UI 与运行时统一挂到 `Sg.*`（数据/规则挂 `Game.*`，见 docs/criterion-design.md §八 8.6）
window.Sg ??= {};
window.Sg.UI = {
	// #441-B/#462：键构造收敛到 `Sg.store`（本处是 **engine** 作用域 → 不加故事前缀，
	// 键名仍是 `sgstory.ui.v1` → 与旧档兼容、无需迁移；跨故事共享「显示计算过程」这类偏好）。
	key() { return window.Sg.store.key('engine', 'ui.v1'); },
	read() { try { return JSON.parse(window.localStorage.getItem(this.key()) ?? '{}') ?? {}; } catch { return {}; } },
	write(d) { try { window.localStorage.setItem(this.key(), JSON.stringify(d)); } catch { /* 降级：本次会话有效 */ } },
	showDetail() { const d = this.read(); return d.detail === undefined ? true : !!d.detail; },
	setDetail(on) { const d = this.read(); d.detail = !!on; this.write(d); },
	toggle() { this.setDetail(!this.showDetail()); },
	// 设定集里的开关（<<replace>> 就地重画）
	renderToggle() {
		if (this.showDetail()) {
			return `计算过程：'''开'''　${'<<link "关掉：只留骰面与总修正">><<set _t to Sg.UI.toggle()>><<replace "#ui-detail">><<= Sg.UI.renderToggle()>> <</replace>><</link>>'}`;
		}
		return `计算过程：'''关'''　${'<<link "打开：显示属性、熟练与取骰过程">><<set _t to Sg.UI.toggle()>><<replace "#ui-detail">><<= Sg.UI.renderToggle()>> <</replace>><</link>>'}`;
	},
};

function renderCheck(res) {
	// #441-A：本函数改为**纯渲染**（不再写 `State.variables.last_check`）——
	// 结果槽的写入属「算」那一步（`Game.Checks.resolve`／`check`·`save` 宏），present 只渲染。
	const cls = res.success ? 'check-success' : 'check-fail';
	const dcStr = res.nat ? `需天然 ${res.nat}` : `DC${res.dc}`;
	const detail = Sg.UI.showDetail();
	const modStr = res.mod >= 0 ? `+${res.mod}` : `${res.mod}`;
	const parts = (res.parts ?? []).filter((p) => p.v).map((p) => `${p.v >= 0 ? '+' : ''}${p.v} ${p.k}`).join(' ');
	const head = `<div class="check-result ${cls}">🎯 <span class="check-label">${res.label}</span>` +
		(res.site ? ` <span class="check-site">〔${res.site}〕</span>` : '') + ` · ${dcStr}：` +
		`<span class="check-dice">${window.Game.Rules.pack().dice.name ?? 'd20'}(${res.roll})</span>${detail && parts ? ` ${parts}` : ` ${modStr}`} = <b>${res.total}</b> ${res.roll === 20 ? '★ 大成功' : res.roll === 1 ? '✘ 大失败' : res.success ? '✔ 成功' : '✘ 失败'}</div>`;
	if (!detail) return head;
	const notes = [];
	if (res.adv > 0) notes.push(`优势：${res.advWhy || '有利条件'}（${(res.rolls ?? []).join(' / ')} 取高）`);
	if (res.adv < 0) notes.push(`劣势：${res.disWhy || '不利条件'}（${(res.rolls ?? []).join(' / ')} 取低）`);
	if (res.nat) notes.push(`只有天然 ${res.nat} 才算成功（DC 不参与）`);
	if (!notes.length) return head;
	return head + `<div class="check-why">↳ ${notes.join(' · ')}</div>`;
}
// <<check 技名 DC [adv|dis] [加值] [nat] [位点] [优势理由] [劣势理由]>>
// #441-A：本宏＝「算 ＋ 写结果槽 ＋ 渲染」的历史入口（段落里的 ad-hoc 检定用它）；
// 位点检定（sitecheck）改走 `Game.Checks.resolve`（算）＋ `<<checkres>>`（渲染）。
Macro.add('check', {
	handler() {
		const adv = this.args[2] === 'adv' ? 1 : this.args[2] === 'dis' ? -1 : 0;
		const res = Game.Rules.check(Game.Pc.now(), this.args[0], this.args[1], {
			adv, bonus: Number(this.args[3]) || 0, nat: Number(this.args[4]) || 0,
			site: this.args[5] ?? '', advWhy: this.args[6] ?? '', disWhy: this.args[7] ?? '',
		});
		State.variables.last_check = res;
		// `#1275`：**同一落点**并记「按站点名索引」的结果表（`chk:` 族的取值面）。
		// 只在有站点名时记（无站点的临时检定不进表 → 不会被 `chk:` 误取到）。
		if (res && res.site) { const c = (State.variables.checks = State.variables.checks || {}); c[res.site] = res; }
		$(this.output).append(renderCheck(res));
	},
});
Macro.add('save', {
	handler() {
		const adv = this.args[2] === 'adv' ? 1 : this.args[2] === 'dis' ? -1 : 0;
		const res = Game.Rules.save(Game.Pc.now(), this.args[0], this.args[1], {
			adv, bonus: Number(this.args[3]) || 0, nat: Number(this.args[4]) || 0,
			site: this.args[5] ?? '', advWhy: this.args[6] ?? '', disWhy: this.args[7] ?? '',
		});
		State.variables.last_check = res;
		// `#1275`：**同一落点**并记「按站点名索引」的结果表（`chk:` 族的取值面）。
		// 只在有站点名时记（无站点的临时检定不进表 → 不会被 `chk:` 误取到）。
		if (res && res.site) { const c = (State.variables.checks = State.variables.checks || {}); c[res.site] = res; }
		$(this.output).append(renderCheck(res));
	},
});
// ── 渲染一枚**已结算**的检定（#441-A）：present 侧入口，只渲染、不掷骰、不写状态 ──
// 用法：<<checkres `Game.Checks.resolve("门厅·翻检", $pc, null)`>>
// 拆开的理由：原 `<<sitecheck>>` 把「推导优势 + 掷骰 + 写结果槽 + 渲染」挤在一个 widget 里，
// 使位点判定只能在浏览器里测（#441 的四条验收之四：不经浏览器可驱动 resolve()）。
Macro.add('checkres', {
	handler() {
		const res = this.args[0];
		// `#1275`（**来源面**）：present 层也要**同款落点**记录“本次结果表”。
		// 为什么必须补：`check`／`save` 两个入口都写了 `State.variables.checks`，而**新格式**走
		// `<<sitecheck>>` → `<<checkres Game.Checks.resolve(…)>>` → **本宏（present 层）当时没写** →
		// 取值族 `chk:<站点>.success` 永远取不到 → 条件行 **fail-loud 打断整段渲染**（绿而不通  ）。
		// 口径：只补**写入**（与 `check`／`save` 完全同款）；**不动** fail-loud、**不动** `resolve`（纯函数保持纯）。
		if (res && res.site) { const c = (State.variables.checks = State.variables.checks || {}); c[res.site] = res; }
		$(this.output).append(renderCheck(res));
	},
});

// ── 复显上一轮玩家发起的检定骰面（M9；不掷骰，只渲染快照）──
Macro.add('lastcheck', {
	handler() {
		const r = State.variables.pc?.ev?.last_roll;
		if (r) $(this.output).append(renderCheck(r));
	},
});
// 只在"刚掷过这些位点之一"时复显（hub 用：防止拿别处的旧骰面骗人）
// 也接受**一个数组**参数（<<lastcheckFor _a.sites>>）——SugarCube 的宏参数不支持 JS 展开（...），
// 交涉面板的位点表在运行期才知道，只能整表传进来再由这里摊平。
Macro.add('lastcheckFor', {
	handler() {
		// #300 P2：本次结果槽已经带着这一掷的骰面时不再复显（同一颗骰不显示两遍）
		const lr = State.variables.pc?.ev?.last_result;
		if (lr?.hasCheck && lr.p === State.passage) return;
		const sites = this.args.flat(Infinity).map(String);
		const r = State.variables.pc?.ev?.last_roll;
		if (r && sites.includes(r.site)) $(this.output).append(renderCheck(r));
	},
});

// ── 结局登记宏（图鉴用：终局 final 才给空页提示，章节出口 chapter 只记账）──
Macro.add('ending', {
	handler() {
		const key = String(this.args[0] ?? '').trim();
		const kind = String(this.args[1] ?? 'final').trim();
		if (key) {
			State.variables.pc.ev.ending = key;                          // 本档记录
			// `#574`：图鉴是**故事可选面**（故事 1 有、故事 2/3 没有）→ 可选链：没有它就只是不记账。
			window.Sg.Codex?.recordEnding?.(key, kind);  // 永久记录（有图鉴的故事才记）
		}
		// C1 收尾入口：每个结局都要有出口。卡片渲染在调用处（段落顶部），
		// 渲染完由 StoryScript 的:passagerender 挪到段落末尾。
		const foot = window.Sg.Ending?.foot(key, kind);
		if (foot) jQuery(this.output).append(foot);
	},
});

// ★★`#1539`（表示面 P3）：**`<<hpbar>>` 宏已删**（引擎侧清零 —— spec §5 P3）。
//   ★为什么删：它把「量纲语义（`hp`）」与「画法（`❤ cur/max` ＋ 三档配色 50/25）」**焊死在引擎**里
//     —— 正是 Admin 判定的那条矛盾（【引擎侧不感知 hp 概念】vs【引擎侧要有状态表示 UI】）。
//   ★替代：**故事声明 `panels`**（spec §2.2）⇒ 引擎侧 `Sg.panels.renderSlot()` 经 `Sg.draw.bar()` 画；
//     键名（`valueKey`／`maxKey`）／文案（`label`）／样式（`style`）**全在故事数据**里。
//   ★先例：`#1227` 类一删 `dragonbar`（引擎✗为某个故事/某个概念提供渲染件）—— 本条是同族的第二例。

// `#1227` 类一：`dragonbar`（龙专用血条宏）**已删** —— 它是内容专用渲染件（文案里写死"龙"、取数写死
// `Sg.story.dragonMaxHp()`）。★`#1539`（P3）：**`<<hpbar>>` 也已删**（同族第二例）——
// 通用渲染件改走**故事声明的 `panels`**（`Sg.panels.renderSlot()` → `Sg.draw.bar/list`）
// ⇒ 引擎侧**不再为任何故事/任何概念提供渲染件**（键名/文案/样式全在故事数据里）✓。

// `#1132` B1：快速成型一次点击 → 写 `$pc.presetIdx` ＋ 跳目标段。段名由调用点给 → 引擎零故事 slug；
// `$i` 是真引擎**求值后**的值 → 没设即 `undefined` → 必须大声报（不许静默跑）。
Macro.add('pickPreset', {
	handler() {
		const dest = String(this.args[0] ?? '');
		const raw = this.args[1];
		const missing = dest === '' || raw === undefined || raw === null || raw === '';
		if (missing) {
			throw new Error('<<pickPreset>> 用法：<<pickPreset "目标段名" 序号>> —— 本次拿到 目标段名=['
				+ dest + ']／序号=[' + String(raw) + ']（序号未设 ⇒ 调用点没 capture 局部量 ⇒ 会静默跑错 ✗）');
		}
		const n = Number(raw);   // `#1132` S1 加固①：调用点可能传文本 → `Number('abc')` = NaN → **静默烂值**
		if (!Number.isFinite(n)) {
			throw new Error('<<pickPreset>> 序号=[' + String(raw) + '] 非数字 ⇒ 会写进烂值（后续 `presets[NaN]` 才炸且报文不知所云 ✗）');
		}
		State.variables.pc.presetIdx = n;
		Engine.play(dest);   // `#1132` B1：用引擎侧程序性导航（同 `80-script.twee` 的既有写法）
		//注意：别把跳转目标拼进 **wiki 宏串**（拼接出的字面宏会被静态分析当成真边 → 假悬空报错 实测踩过）
	},
});

// `#1132` B1：快速成型一次完成（委托既有 `Game.Chargen` 方法 → 本步行为逐字不变）。
// `pcName` 读取与声明式施加器留 B2（届时数据才进 json）；`pc` 未初始化靠 `StoryInit` 先行保证 → 不另设守卫。
Macro.add('applyQuickPreset', {
	handler() {
		const Ch = window.Game?.Chargen;
		const pc = State.variables.pc;
		if (!Ch || typeof Ch.applyPreset !== 'function') {
			throw new Error('<<applyQuickPreset>> 前置缺失：故事的 `Game.Chargen` 未接入（本宏需要其 applyPreset／finalize ✓）');
		}
		Ch.applyPreset(pc.presetIdx ?? 0);
		pc.mode = 'quick';
		if (!pc.finalized) {
			Ch.finalize(pc);
			pc.finalized = true;
		}
		// `#1132` B3：姓名由数据接管（原故事侧那一行 `$pc.name` 已删）——与 `mode`／`finalized` 同处，属宏的职责。
		const P = Ch.presets?.[pc.presetIdx ?? 0];
		if (P?.pcName) pc.name = P.pcName;
	},
});

// `#1216` B 半 Operator 裁：**能力组**——若干成员合起来才是『一个能力』，不是若干独立值。
// 口径一句话：『缺席＝这个能力不在』是一件事；『缺席＝某个值取零』是另一件事（前者门控、后者缺省，别混）。
// 判据件从**本表**派生组员（一处定义、别处引用），不另写一份。
window.Sg.capabilityGroups = { flip: ['flipItem', 'flipStarCost', 'flipReturnFlag'] };
/**
 * 能力组门控（单点入口，两处读点共用）：
 * - 全缺 → 能力关（不崩、不渲染）；
 * - **部分缺 → 出声**点名缺哪几个（半声明是作者错，别静默）；
 * - 全在 → 给参数。**不给数值缺省**（`flipStarCost` 缺省 0 会让『翻转免费』静默成立＝危险缺省）。
 */
window.Sg.capability = (group) => {
	const names = window.Sg.capabilityGroups?.[group];
	if (!names) return { ok: false, reason: 'unknown' };
	const have = names.filter((n) => typeof window.Sg.story?.[n] === 'function');
	if (have.length === 0) return { ok: false, reason: 'off' };
	if (have.length < names.length) return { ok: false, reason: 'partial', missing: names.filter((n) => !have.includes(n)) };
	const out = { ok: true };
	// 键名**显式映射**（原先用 `n.replace(/^flip/,'')` 机械推导 → `flipStarCost` 成了 `starcost`，
	// 调用方要的 `cost` 取到 undefined → `spent` 变 NaN。名字映射要写死，别推导。）
	const KEYS = { flipItem: 'item', flipStarCost: 'cost', flipReturnFlag: 'flag' };
	for (const n of names) out[KEYS[n] ?? n] = window.Sg.story[n]();
	return out;
};

/% ★★`#1539`（表示面 P3）：**声明驱动渲染**（spec §2.2／§3.1）—— 引擎只做「拿 `Sg.draw.*` 去画 `props` 里这几个数」。

   形状（spec §2.2，**定形乙**）：`valueKey`／`maxKey` **装 `pc` 键名**（✗ 量纲名）⇒ 取值＝`pc[valueKey]`。
   ★定形为乙的理由（2026-09-27 裁定；并有实测支持）：§2.2 示例逐字（`maxKey:'max_hp'`／`valueKey:'inv'`）
     都是 **`pc` 键名** ⇒ 乙照逐字落地；§2.3 的验收目标「引擎侧再无 `hp` 这个字」**不依赖** `vk()`
     （键名字面量全在**故事数据**里）；而甲下 `list` 的 `inv` **不是量纲** ⇒ 无法照 §6③ 落地 ✗。
   ⇒ ★`vk()` 只在**声明侧**把量纲名翻成键名；**引擎侧渲染只做 `pc[valueKey]` 取值**。

   逐块切换（spec §3.1）：**以 `panels` 声明为准画；未声明的块 ✗ 画** —— 粒度＝**块**（✗ 全故事一次切）。
   红线（spec §2.1）：① 实现里 ✗ 许出现领域词／✗ 认得出“这是哪个量纲”（值全由 `props` 指）
     ② 空 ⇒ **不产字节**（✗ 不自造「（空）」✗ 不印 `$pc.x` —— 故事可显式给 `empty`）
     ③ 样式（色／图标／分隔符）**全由 `style` 传**（✗ 引擎不内置配色）。 %/
window.Sg.actors = {
	/** 声明面的初始实体（经 `Game.Rules.actors()` 那个读点 —— 缺面 ⇒ `{}`）。 */
	declared() {
		return (window.Game?.Rules?.actors?.() ?? {});
	},
	/** `StoryInit` 用：把**声明**的初始实体**深拷贝**进运行期表 `State.variables.actors`。
	 *  ★为什么必须拷贝（✗ 不许直接引用声明对象）：声明面是**共享的常量** ⇒ 直接引用会让"这一档写着写着"
	 *    把**声明**改了（换档/重开还在），且同一进程里两个档会互相看见 ✗（同族：`panels` 的 `__const_*` 只读语义 ✓）。 */
	init() {
		// ★★ `#1573`（阶 2b · 候选甲·修订形）：★**这里 ✗ 放 `pc` 键** —— ★实测：`<<set $actors to …>>` 会对值**克隆**
		//   ⇒ ★把 getter 定义在**返回值**上 ⇒ 克隆后**变一份拷贝** ✗（`descHasGet=false` ＋ 两侧 keys 同形 ⇒ ★**静默分叉** ✓）
		//   ⇒ ★别名改在**设定之后**、对**活表**定义（见 `bind()` ✓）⇒ ★从源头保证**永不存在**那份拷贝 ✓。
		return JSON.parse(JSON.stringify(this.declared() ?? {}));
	},
	/** ★★ `#1573`：把**玩家那一行**绑到**活表** `State.variables.actors` 上（★**getter** ⇒ 与 `$pc` **同一对象** ✓）。
	 *  ★**非枚举**（`enumerable: false`）—— ★实测口径：★**枚举 getter 会被 `JSON.stringify` 物化成值快照** ✗
	 *    （★即存档里会多一份 `pc` 的**死拷贝** ✓ ⇒ ★载档后那次重绑会把它**覆盖**掉 ✓，但★**"零存档影响"**这条承诺
	 *      就**不成立**了 ✗）⇒ ★取**非枚举** ✓ ⇒ ★存档里**没有**这个键 ✓（★验收格＝**payload 键级**实证 ✓）。
	 *  ★**调用点**：★`StoryInit` 的 `<<set $actors …>>` **之后**一处 ✓；★**其余场合靠「口内自愈」** ✓
	 *    —— ★故意**✗ 放 `Save.onLoad`**（★早期版本曾放 ✓、已删 ✓）：★那个注册面 **测不了**
	 *    （`Save.onLoad` **无 `fire`** ✓ 实测 ✓）⇒ ★留一段**没有格钉**的码 ＝ **拒绝** ✓。
	 *    ★故：★读玩家须**经口**（`player()`／`resolve(…, 'pc')` ✓）⇒ ★口内自愈 ⇒ ★**每次读都可被格钉** ✓。
	 *  ★幂等（可重复调 ✓）。 */
	bind() {
		const tbl = State.variables.actors;
		if (!tbl || typeof tbl !== 'object') return false;
		Object.defineProperty(tbl, 'pc', { get: () => State.variables.pc, enumerable: false, configurable: true });
		return true;
	},
	/** ★★ `#1573`：**玩家那一行**（★presentation／存档／"读玩家状态"面的**唯一口** ✓）。
	 *  ★为什么与 `current()` **分列两口**（✗ 合并）：★语义不同 —— `player()` ＝ **玩家**（★侧栏／存档 ⇒ **战斗轮里仍是玩家** ✓）；
	 *    `current()` ＝ **当前作用实体**（★effects ⇒ **战斗轮里可能是对手** ✓）⇒ ★混用＝"**战斗轮侧栏显示对手的血**" ✗。 */
	player() {
		const tbl = State.variables.actors;
		// ★自愈：★载档后若没跑到 `Save.onLoad` 钩子 ⇒ 这里补绑（✗ 让"表里有 pc"**时有时无** ✓）
		if (tbl && typeof tbl === 'object' && !Object.getOwnPropertyDescriptor(tbl, 'pc')?.get) this.bind();
		const it = tbl && typeof tbl === 'object' ? tbl.pc : undefined;
		return it ?? State.variables.pc;      // ★表／绑定未就绪（如 `StoryInit` 之前）⇒ 回退 `$pc` ✓
	},
	/** ★★ `#1573`：**当前作用实体**（★`vitals`／`floor`／`zeroGives` 的施加口要"作用于它" ✓ —— 票面做法③ ✓）。
	 *  ★本口**只读**：★"当前是谁"由**战斗循环**持有（✗ 不在这里放第二份状态 ✓）。★缺省＝玩家 ✓（＝`resolve(pc, 空)` 同义 ✓）。 */
	current() {
		return this.player();
	},
	/** ★★**对象维的解析口**（本票的"一个词两端同用"就落在这里）：给一个**实体名** ⇒ 回"该读/写哪个对象"。
	 *  · ★`name` 缺省／空白 ⇒ **原样回 `pc`**（既有行为逐字不变 ⇒ 验收②"不回归" ✓）；
	 *  · ★有名字 ⇒ 回 `State.variables.actors[name]`；★**取不到 ⇒ fail-loud 点名**
	 *    （✗ 不静默回退 `pc`、✗ 不静默不产字节 —— 那是"静默死"族；编译期另有一道点名 ✓ 见 `commands.mjs`）。
	 *  ★语义：返回的是**根对象** ⇒ 读端 `pc[key]`／写端 `readPath/writePath(pc, path)` 的 `pc` 位置
	 *    换成它即可（两端**各只有一个收束口**，✗ 不新造第二套读写路径 ✓）。 */
	resolve(pc, name) {
		// ★(CR NIT②) 自指深度护栏：★事件 ⇒ 子事件（`call`）链可能自指 ⇒ ✗ 无护栏会栈溢出
		const n = String(name ?? '').trim();
		if (!n) return pc;
		const tbl = State.variables.actors;
		// ★★ `#1573`：★**自愈**（★载档后反序列化出来的表**没有**那个 getter ✗）——
		//   ★为什么放这里（✗ 不放 `Save.onLoad` 钩子）：★钩子的注册面**测不了**（`Save.onLoad` 无 `fire` ✓ 实测 ✓）
		//     ⇒ ★"留一段**没有格钉**的码"＝**拒绝** ✓（同 `#1664` 的复核 RC ✓）；★自愈放**口里** ⇒ 每次读都**可被格钉** ✓
		//   ★为什么要在 `'pc'` 这一支上：★不补 ⇒ 载档后 `resolve(pc, 'pc')` 走 `it == null` ⇒ **fail-loud 抛** ✗。
		if (n === 'pc' && !Object.getOwnPropertyDescriptor(tbl, 'pc')?.get) this.bind();
		const it = tbl && typeof tbl === 'object' ? tbl[n] : undefined;
		if (it == null) {
			throw new Error(`Sg.actors：实体「${n}」**不在实体表**（\`State.variables.actors\`）里 —— `
				+ '声明面写的实体名必须真存在（✗ 静默回退 `pc`、✗ 静默不产字节；结构错必须点名 ✓）'
				+ `（现表：${JSON.stringify(Object.keys(tbl ?? {}))}）`);
		}
		return it;
	},
};

/** ★★ `#1562`（阶 2b）：**事件调用面** —— ★形照 `Sg.actors`（命名空间 ＋ 薄口 ✓）。
 *  ★分工：★`Sg.rules.evalExpr`／`evalEffect` 是**求值器**（纯，住 `22-rules.twee`）；
 *  本口只做**编排**：取声明 ⇒ 选 `use` ⇒ 求 `args`（**一次／前态**）⇒ 施加 `effect`（★写到**对象维的根** ✓）✓
 *  ★★为什么"施加"复用既有五个施加器（✗ 不另造写路）：★"**写侧一处收束**"（同 `#1408`／`#1474` 的理由 ✓）。 */
// ★ `#1569`（阶 3）：**结果表** —— 「结算结果 ⇒ 渲染」的取值面。
//   ★形：`State.variables.uses[<被作用的目标名>] = { <路径>: { before, after } }`（★按**目标名**索引 ✓ ——
//     ★与 `chk:<站点>.field` 同构：★按名索引的结果表 ＋ **键前缀读** ＋ ★**本次尚未产生 ⇒ 点名** ✓）。
//   ★写入者 ＝ **引擎通用写**（★每条 `effect` 子句执行后落各路径的 before／after ⇒ ★引擎**不知故事语义** ✓）。
window.Sg.uses = {
	table() { return (State.variables.uses ??= {}); },
	/** 记一条：**目标名** + 路径 + 前值 + 后值（★effect 子句专用 ✓）。 */
	record(targetName, path, before, after) {
		const t = this.table();
		const box = (t[targetName] ??= {});
		box[path] = { before, after, amount: (typeof after === 'number' && typeof before === 'number') ? after - before : after };
		return box[path];
	},
	/** ★**键前缀读** `use:that.<路径>` ⇒ ★未产生 ⇒ **fail-loud 点名**（✗ 不静默当 0 ✓）。 */
	read(a, p) {
		const rel = String(p ?? '').trim();
		if (!rel.startsWith('that')) throw new Error(`Sg.uses.read：结果键 \`use:${rel}\` 只认 \`that.<路径>\` 形（✗ 别的不许 ✓）`);
		const name = a && a.targetName;
		const box = name ? this.table()[name] : null;
		if (!box) throw new Error(`Sg.uses.read：结果键 \`use:${rel}\` **本次尚未产生** —— 目标「${name ?? '(无)'}」还没有结算记录（✗ 静默当 0 会让渲染说谎 ✓）`);
		let cur = box;
		const segs = rel.slice('that'.length).replace(/^\./, '').split('.').filter(Boolean);
		for (const k of segs) {
			if (cur == null || !Object.prototype.hasOwnProperty.call(cur, k)) {
				throw new Error(`Sg.uses.read：结果键 \`use:${rel}\` **本次尚未产生** —— 「${name}」的结算记录里没有「${segs.join('.')}」（✗ 静默当 0 ✓）`);
			}
			cur = cur[k];
		}
		return cur;
	},
};

window.Sg.events = {
	/** 声明表的**唯一读口**（生成件 `Game.Events.defs` ⇐ `data/events.json` ✓）。 */
	defs() {
		return (window.Game?.Events?.defs ?? {});
	},
	/** ★**调用一个事件**（点击那一刻 ⇒ 链接／规则行的 `data-sg-call`）。
	 *  @param {string} name 事件名（★必须已宣告 ⇒ ✗ 否则点名 ✓）
	 *  @param {{actor?:string, pc?:object}} [ctx] `actor` ⇒ 目标实体名（★1c 的对象维 ✓） */
	call(name, ctx = {}, _depth = 0) {
		// ★(CR NIT②) 自指深度护栏：事件 ⇒ 子事件（`call`）链可能自指 ⇒ ✗ 无护栏会栈溢出
		if (_depth > 16) throw new Error('Sg.events.call：事件调用链**超过 16 层**（★自指事件？）—— 事件「' + name + '」');
		const n = String(name ?? '').trim();
		const table = this.defs();
		const ev = n && Object.prototype.hasOwnProperty.call(table, n) ? table[n] : null;
		if (!ev) {
			throw new Error(`Sg.events：事件「${n}」**不在声明表**（\`Game.Events.defs\`）里 —— `
				+ `（已宣告：${JSON.stringify(Object.keys(table))}）⇒ 名字写错不许静默无效 ✓`);
		}
		const R = window.Sg.rules;
		const pc = ctx.pc ?? State.variables.pc;
		// ★目标实体（1c 的对象维）：★缺省 ⇒ 原样回 `pc` ✓
		const target = window.Sg.actors.resolve(pc, ctx.actor);
		const list = Array.isArray(ev.use) ? ev.use : [];
		// ★① 按序取**第一个 `when` 成立者**（★漏写 ⇒ `true` ✓；★取中即停 ✓）
		// ★(阶3) 结果表的**目标名**（★按目标名索引 ✓）—— ★函数级（✗ 别关进 if(eff) 块里）
		const tgtName = String(ctx.actor ?? 'pc').trim() || 'pc';
		let pick = null;
		let pickIdx = -1;
		for (let i = 0; i < list.length; i += 1) {
			const it = list[i];
			if (!it || typeof it !== 'object') continue;
			const ok = it.when == null ? true : !!R.holdsCond(it.when, pc, { target });
			if (ok) { pick = it; pickIdx = i; break; }
		}
		if (!pick) {
			throw new Error(`Sg.events：事件「${n}」的 \`use\` 列表**全不成立**（${list.length} 条都没选中）—— `
				+ '✗ 静默什么都不做（那是"看起来能跑"族）⇒ 请补兜底项或检查 when ✓');
		}
		// ★② `args` ⇒ **一次、前态**（★`$n` **只求值一次** ⇒ ✗ 引用两次得两个数 ✗）
		const args = {};
		for (const [k, v] of Object.entries(pick.args ?? {})) {
			if (!/^\$\d+$/.test(k)) {
				throw new Error(`Sg.events：参数名「${k}」不合法 —— ★必须以 **\`$\`＋数字** 组成（如 \`$1\`）✓`);
			}
			args[k] = R.evalExpr(v, { pc, self: ev, target });
		}
		// ★③ `effect` ⇒ 写到**对象维的根**（✗ 不硬编 `pc` ✓）⇒ 交给既有五个施加器 ✓
		// ★★ 子句的两支（★照 Operator 的草图 ＝ 子句带 `effect`；而**散文**挪子事件是**另一件事** ⇒ 两者并存 ✓）：
		//   · ★`effect` ⇒ **就地**施加（本事件的这一支 ✓ —— ★本阶主要用它 ✓）
		//   · ★`call` ⇒ **调子事件**（★递归 ⇒ 阶 3 的散文支会用得最多 ✓；★子事件也可只是逻辑 ✓）
		//   ★★二者同时给 ⇒ **点名**（✗ 不许"谁先谁后"静默 —— 语义不明即缺陷 ✓）。
		const hasEff = pick.effect != null;
		const sub = pick.call != null && String(pick.call).trim() !== '' ? String(pick.call).trim() : null;
		if (hasEff && sub) {
			throw new Error(`Sg.events：事件「${n}」的 ` + '`use` 子句**同时**给了 `effect` 与 `call` ⇒ 语义不明 ⇒ ✗ 请拆成两条 ✓');
		}
		const eff = hasEff ? R.evalEffect(pick.effect, { pc, self: ev, target, args }) : null;
		if (eff) {
			// #1562 (2b): 本笔的 effect 语义 = **函数式更新**（evalEffect 已算出**最终值** => 见 evalExpr）
			//   => 经 **Sg.notes.writePath** 落盘。它**就是写侧的唯一收束点**（引擎注释原话:
			//   applySets/applyAdds/applyYields 的 y.path **都经本函数**）=> 本处**不是**第二条写路
			//   （区别于五个施加器: 它们的路径约定是"裸键 => ev.* 前缀", 而实体根字段(如 hp)必须根相对
			//     => 那正是 panels 的 valueKey 所用的口径 => 两者一致）。
			// ★(CR NIT①) 两阶段：先**全量校验** ⇒ 再落盘
			//   ★理由：下面那个循环是**边检边写** ⇒ 中途一处 undefined 会留**半写**（★半写比不写更坏 ✗）
			// ★(阶3) 结果表：先读各路径 before ⇒ 写后再落 before／after（引擎通用写，不知故事语义）
			const befores = {};
			for (const path of Object.keys(eff)) { try { befores[path] = window.Sg.notes.readPath(target, path); } catch (e) { befores[path] = undefined; } }
			for (const [p0, v0] of Object.entries(eff)) {
				if (v0 === undefined) throw new Error('Sg.events：effect 的路径「' + p0 + '」算不出值（undefined）✗ —— ★本检在**任何写之前**（★两阶段校验 ✓）');
			}
			for (const [path, val] of Object.entries(eff)) {
				if (val === undefined) {
					throw new Error('Sg.events：effect 的路径「' + path + '」算不出值（undefined）—— 来源写错会在写侧静默变空 ✗');
				}
				window.Sg.notes.writePath(target, path, val);
				const rec = {};
				for (const [path, val] of Object.entries(eff)) { window.Sg.notes.writePath(target, path, val); rec[path] = window.Sg.uses.record(tgtName, path, befores[path], val); }
				// ★(阶3) 顶层也落 {amount, before, after}（回填的形 ⇒ `use:that.amount` 才读得到）
				const first = Object.keys(rec)[0];
				if (first) Object.assign(window.Sg.uses.table()[tgtName], { amount: rec[first].amount, before: rec[first].before, after: rec[first].after, path: first });
			}
		}
		// ★递归调子事件（★`args` 不向下传 —— 子事件自带 `$n` 绑定 ⇒ ✗ 不许隐式继承 ⇒ 显式才可判 ✓）
		// ★(阶3) 子句是 `call`（子事件）⇒ ★把**子事件的结果整体带回**（★含它的 `text` ⇒ 否则子事件的散文不渲染 ✗ 实测）
		if (sub) return this.call(sub, { actor: ctx.actor, pc }, _depth + 1);   // ★NIT② 深度 +1（自指 ⇒ 16 层点名 ✓）
		const T = window.Game?.Events?.texts ?? {};
		const text = T[n + '#' + pickIdx] ?? T[n] ?? null;
		return { name: n, pick, pickIdx, args, eff, text, renderArgs: Object.assign({}, args, { that: target, this: ev, targetName: tgtName }) };
	},
};

window.Sg.panels = {
	/** 取故事的 `panels` 声明（经 `Game.Rules.panels()` 那个**读点** —— 缺面 ⇒ `[]`，非数组 ⇒ 抛）。 */
	declared() {
		return (window.Game?.Rules?.panels?.() ?? []);
	},
	/** 一个 `prop` 的取值：**直接 `pc[valueKey]`**（定形乙 —— 装的是 `pc` 键名）。
	 *  ✗ 不经 `vk()`；✗ 认不出“这是哪个量纲”（那是故事的事 ✓）。 */
	/** ★★ `#1571`（1c）：**对象维的解析点** —— 一块 prop 要读**哪个对象**（`prop.actor`；缺省 ⇒ 传进来的 `pc` ✓）。
	 *  ★为什么单列一个口（✗ 只在 `valueOf` 里解）：一个 prop 里有**多个键**（`valueKey` ＋ **`maxKey`**）——
	 *    它们**必须取自同一个对象** ✗ 否则会印出"**实体的值 / 玩家的上界**"这种混合读数（实测踩过：`10000 / 12`）。 */
	objectOf(pc, prop) {
		return Sg.actors.resolve(pc, prop?.actor);
	},
	/** 一个 `prop` 的取值：★入参**已是根对象**（由 `objectOf` 解析 —— ✗ 这里不认识"实体"这个概念 ✓）。
	 *  直接 `root[valueKey]`（定形乙 —— 装的是**键名**）；✗ 不经 `vk()`；✗ 认不出"这是哪个量纲"（那是故事的事 ✓）。 */
	valueOf(root, prop) {
		const k = prop?.valueKey;
		return (k == null || k === '') ? undefined : root?.[k];
	},
	/** 已知 `as` 原语表（spec §2.2 起步两件；`group` 待将来真形再定 ✓）。 */
	primitives: {
		bar({ pc, prop }) {
			// ★ `#1571`：**先解析对象**（`prop.actor`）⇒ `valueKey` 与 `maxKey` **同一个对象** ✓
			const root = Sg.panels.objectOf(pc, prop);
			const v = Sg.panels.valueOf(root, prop);
			const m = Sg.panels.valueOf(root, { valueKey: prop?.maxKey });
			return Sg.draw.bar({ value: v, max: m, label: prop?.label ?? '', style: prop?.style ?? {} });
		},
		list({ pc, prop }) {
			const src = Sg.panels.valueOf(Sg.panels.objectOf(pc, prop), prop);
			const items = Array.isArray(src) ? src
				: (src && typeof src === 'object') ? Object.keys(src)
				: [];
			return Sg.draw.list({ items, label: prop?.label ?? '', empty: prop?.empty ?? '', sep: prop?.sep ?? '' });
		},
	},
	/** 画**一块**（`panels` 的一项）⇒ DOM 串。★空 ⇒ **不产字节**（spec §2.1 红线②）。
	 *  ★未声明的 `as` ⇒ **fail-loud**（✗ 静默不画 —— 同族：`#1543` 的 `fight` 类型错／`#1551` 的 `panels` 非数组）。 */
	renderBlock(pc, block) {
		const name = String(block?.as ?? '');
		const fn = this.primitives[name];
		if (typeof fn !== 'function') {
			throw new Error(`Sg.panels：未知的 \`as\` 原语「${name}」（已知：${Object.keys(this.primitives).join('、')}）`
				+ ` —— ✗ 静默不画（声明写错必须看得见）`);
		}
		return (block.props ?? []).map((prop) => fn.call(this.primitives, { pc, prop })).join('');
	},
	/** 按 `slot` 取该位置的全部块 ⇒ DOM 串（**逐块**；未声明 ⇒ ✗ 画 —— spec §3.1）。 */
	renderSlot(pc, slot) {
		return this.declared()
			.filter((b) => (b?.slot ?? 'sidebar.primary') === slot)
			.map((b) => this.renderBlock(pc, b)).join('');
	},
};

:: StoryInit
<<set $era to Game.Era.PRESENT>>
/% 全局状态初始化（**形状**单一源见 `Game.Pc.defaults`；**数值**来自 `Sg.story.pcDefaults()`，见 `#660` 片三-3） %/
<<set $player_name to "">>
<<set $pc to Game.Pc.defaults()>>
/% ★ `#1571`：运行期实体表（`State.variables.actors`）—— ★由**声明面**的初始实体深拷贝而来（✗ 直接引用声明 ✓） %/
<<set $actors to Sg.actors.init()>>
/* ★★ `#1573`：★**设定之后**才绑（★`<<set>>` 会克隆 ⇒ 定在 `init()` 的返回值上会被克隆成**拷贝** ✗）——
   ★本行**必须**紧跟 `$actors` 那一行 ✓（★丢返回用 `_probe` ⇒ `<<set>>` 必须有左侧 ✓）。 */
<<set _probe to Sg.actors.bind()>>

:: Widgets [widget]
/% 受伤 + 药膏自动生效 + 死亡判定。用法：<<damage N>>。
   药膏自动门槛：缺口满 4 点（一副的恢复量）才自动用——满血/轻伤不烧药膏（#201）。 %/

<<widget "firstTime">>
	<<set _first to !$pc.ev[$args[0]]>>
	<<if _first>><<set $pc.ev[$args[0]] to true>><</if>>
<</widget>>

<<widget "damage">><<nobr>>
	/% `#1409`：**参数校验（fail-loud）** —— 非有限数 ⇒ **点名**（✗ 不许静默产 NaN：
	   实测病灶：散文里反引号包宏 ⇒ `<<damage>>` **空参执行** ⇒ `$args[0]=undefined` ⇒
	   `Math.max(0, hp - undefined)` ⇒ **NaN**（hp 是 number 型的 NaN ⇒ 类型检查挡不住 ✗）） %/
	/% `#1409`：**一次算完校验 ＋ 结算** —— ✗ 不用"先 if 再 set"两行：SugarCube 里 `<<run>>` 抛错
	   **不中止**后续宏（实测：报文出来了、`<<set>>` 仍执行 ⇒ hp 照样 NaN ✗）⇒ 必须在**同一表达式内**兜住：
	   非有限数 ⇒ 抛（fail-loud，✗ 不静默产 NaN）） %/
	/% ★ `#1487`（五步④·D1）：**结算逻辑里 ✗ 不出现量纲键名字面量** —— 键名从 `Game.Rules.vk('hp')` 取（＝数据给的 ✓）；
	   下限从 `V().floor.hp` 取；零界后果走 `zeroGives`。★缺省（`BUILTIN`）＝今天那套 ⇒ **零包逐位同** ✓ %/
	<<set _V to Game.Rules.V()>>
	<<set _khp to Game.Rules.vk('hp')>>
	<<set _kmx to Game.Rules.vk('maxHp')>>
	<<set _ksa to Game.Rules.vk('salves')>>
	/% ★ `#1488`（五步⑤·裁定 D2）：★**结算走枚举原语**（`settleValue('sub', …)` ⇒ ★下限由 `vitals.floor.hp` 给 ✓）——
	   ★原写法 `Math.max(floor, hp - n)` 是"**就地写结算**" ✗ ⇒ 与"算子枚举"相抵（✗ 每处各写一遍 ⇒ 漂移 ✓）
	   ★仍**同一表达式内兜住**（`#1409` 口径：`<<run>>` 抛错不中止后续宏 ✓ —— 且原语自身 fail-loud ✓ %/
	/% ★ `#1488` 注记：★**两个对象别混** —— `vitals`／`vk`／`V` 住 **`Game.Rules`**（`10-core`）；
	   ★结算原语 `settleValue`／`applyZeroGives` 住 **`Sg.rules`**（`22-rules`）⇒ ★调用要分清（我第一版混过 ✓） %/
	<<set $pc[_khp] to window.Sg.rules.settleValue('sub', $args[0],
		{ cur: $pc[_khp], max: $pc[_kmx], floor: _V.floor.hp })>>
	<<if $pc[_ksa] gt 0 and $pc[_khp] gt _V.zero and ($pc[_kmx] - $pc[_khp]) gte _V.heal>>
		<<set $pc[_ksa] to $pc[_ksa] - 1>>
		<<set $pc[_khp] to $pc[_khp] + _V.heal>>
		/% ★ `#1487`（CR ③）：文案里的"恢复 4 点"**与 `vitals.heal` 同值** ⇒ ★改用 `_V.heal`（✗ 不硬编 ✓ ⇒ 改 `heal` 该串跟变 ✓） %/
		<span class="damage-flash">''你受到了 $args[0] 点伤害！''（伤得重，消耗一副<<print Game.Rules.vl('salves')>>，恢复 <<print _V.heal>> 点<<print Game.Rules.vl('hp')>>）</span>
	<<else>>
		<span class="damage-flash">''你受到了 $args[0] 点伤害！''</span>
	<</if>>
	/% ★ `#1487`（五步④·D1）：零界判定与后果**都读数据** ——
	   阈值＝`V().zero`（D3 只 0）｜后果＝`V().zeroGives`（**声明的实体授予** ⇒ ★引擎✗特判"死亡" ✓）
	   ★去向仍是**故事可选面**（`#491` 判据 4）：★引擎只**授予实体**；跳不跳结局由**故事自己**的条件行决定 ✓ %/
	<<if $pc[_khp] lte _V.zero>>
		/% ★ `#1488`（裁定甲①）：★**改调原语**（`Sg.rules.applyZeroGives`）—— ✗ 不在此内联循环 ✓
		   ★理由（D6 单一入口）：★经"零界授予"这件事**今天只有一处**，但**内联循环与原语各写一份**
		     ⇒ ★改一处不改另一处 ⇒ **必然漂移** ✗；★且原语**无人用＝死码**（★本笔落了个"没人调的函数" ✗）✓ %/
		<<run window.Sg.rules.applyZeroGives(State.variables.pc, Game.Rules.V().zeroGives)>>
		/% #357：致命伤**即刻登记结局**——安全网（:passagestart 的 hp≤0 修补）以
		   `!pc.ev.ending` 为门，若不先登记，它会赶在结局页渲染前把 hp 修回 1，
		   把刚受致命伤的角色"复活"。 %/
		/% `#491` 判据 4：这一跳是**故事可选面**——引擎不得假定每故事都有一页「结局 死亡」
（本仓反复的"引擎知道故事名"族：`hallResult`／`fog_thin`／`Sg.Codex` 同一个教训）。
		   没有该页的故事（用**重置**语义的「无名洞窟」）→ 什么都不做：登记 `ending` 会钉住安全网，
		   还会让故事自己的"回出生点"失去机会（实测：`<<damage>>` 抛 `passage "结局 死亡" does not exist`）。 %/
		<<if Story.has("结局 死亡")>>
			<<set $pc.ev.ending to "死亡">>
			<<goto "结局 死亡">>
		<</if>>
	<</if>>
<</nobr>><</widget>>

/% 检定位点词汇：DC/技能出走 Game.Checks.sites（正文只传位点键）；优势推导与掷骰住在
   `Game.Checks.resolve`（新文件 `src/21-resolve.twee`，sim 侧），本 widget 只负责**调它 + 渲染**。
   为什么这样拆（#441-A）：「点一下既算又画」是「界面/判定分离」在这份代码里的唯一实体障碍——
   抽完后本 widget 体内不再有 `<<set $…>>`（present 不写状态），且 `resolve()` 能在 node 里直接驱动。 %/
<<widget "sitecheck">><<nobr>>
	<<set _adv to ($args[1] is "-" ? null : $args[1])>><<checkres `Game.Checks.resolve($args[0], $pc, _adv, $args.includes("reroll"))`>>
<</nobr>><</widget>>

/% 经济事件词汇：金额出走 Game.Economy；gives 自动入账 %/
/% 经济事件词汇：金额出走 Game.Economy；gives 自动入账 %/
/% #441-A：落帐（算价＋金币＋gives）搬去 `Game.Economy.apply`（sim）；文案格式与 `<<socresolve>>`
   共用 `Game.Economy.note`（单一源，否则两处各写一份必漂）。 %/
<<widget "econ">><<nobr>>
	<<set _d to Game.Economy.apply($pc, $args[0]).delta>>
	<span class="econ-note"><<print Game.Economy.note(_d)>></span>
<</nobr>><</widget>>

/% 时代切回现在（不耗星力：时间自己走完的场合专用——宴散/仪式终） %/
<<widget "eraPresent">>
<</widget>>

/% `#1223`：`<<note>>` 与 `<<notepath>>` **已随笔记概念退役**（内容面改用 `<<setflag "ev.notes.<id>">>`，
   状态即 `ev.notes` 命名空间；二者的守卫随之退役 —— 见本笔下架表）。 %/

/% 拾取道具（物品栏）：<<give "日记">> %/
<<widget "give">><<nobr>>
	<<run $pc.inv[$args[0]] = true>>
	<span class="gain">''获得【$args[0]】。''</span>
<</nobr>><</widget>>

/% 检定结果快照（M9）：玩家发起的检定在 link 里掷完骰后存一份，
   结果分支重渲染时用 <<lastcheck>> 复显骰面——否则 <<goto>> 会把骰面一起丢掉 %/
<<widget "snapshot">>
	<<set $pc.ev.last_roll to $last_check>>
<</widget>>

/% 世界旗标：<<setflag "goblin_spared">> %/
<<widget "setflag">>
	/% `#624` 片三：裸键写 `world`（原语义）；**带点路径**（`ev.x`／`world.x`）走 `Sg.notes.writePath`
	   —— 点击态里"置某个 ev 旗标"原先只能裸 `<<set $pc.ev.x to true>>`（表行 `text` 里不许）。 %/
	<<if $args[0] and $args[0].includes('.')>>
		<<run Sg.notes.writePath($pc, $args[0], true)>>
	<<elseif $args[0]>>
		<<run $pc.world[$args[0]] = true>>
	<<else>>
		/% 空参/缺参：不落 `$pc.world['']` 脏键，交给写侧统一出声路径（没有目的地不等于缺数据，#1247） %/
		<<run Sg.notes.writePath($pc, $args[0], true)>>
	<</if>>
<</widget>>

/% `#624` 片三：**取走**一件道具（`<<take "月光花">>` ≡ `delete $pc.inv["月光花"]`）。
   为什么要有它：赠出/交出的位点原本只能裸 `<<run delete $pc.inv[…]>><<set $pc.ev.x to true>>` → 进不了表。
   幂等：没有这件道具也不报错（内容常在条件分支里调用）。 %/
<<widget "take">><<nobr>>
	<<run delete $pc.inv[$args[0]]>>
<</nobr>><</widget>>


/% ── 战斗动作池（B1）：每轮随机 3 选 1；每个动作是一次属性化检定，成/败/大成功各有后果 ──
   回合状态挂在 $pc.ev.fight：{ pool, round, offer, act, adv, guard, skipFoe, flee, done}。
   （`#707`：原有一个 `last` 字段**从未被写过、也没有产品面读者** → 已删；门 `test/fight-fields.mjs` 会盯住这类死字段。）
   点动作只写 $pc.ev.fight.act ＋重渲染（<<goto `passage()`>>）——结算在段落渲染顶部跑完，骰面不会丢。
   <<fightbegin>> 只在"新一场"重置：同池子且没打完＝这就是重渲染，不能清台账。 %/
<<widget "fightbegin">><<nobr>>
	<<if !$pc.ev.fight or $pc.ev.fight.pool isnot $args[0] or $pc.ev.fight.done>>
		/% `#1227` 类一：**这一场有没有"具名对手"是故事数据**（`Combat.poolsNamed` 列出具名对手的池），
		   不再由故事段把 `true/false` 当参数传进引擎（那是"引擎认识哪个故事有龙"的老写法）。 %/
		<<set $pc.ev.fight to { pool: $args[0], namedFoe: Game.Combat.poolIsNamed($args[0]), round: 1, offer: [], act: null, adv: 0, guard: 0, skipFoe: false, flee: false, done: false }>>
	<</if>>
<</nobr>><</widget>>

/% 结算玩家选的那一手 ＋ 对手这一轮的动作 %/
/% #350：**结算必须在点击时刻完成**——渲染期的状态变更不进 moment，S/L 会重掷这一轮
   （与 #300 P1 同源）。fightact＝点击时掷骰/结算/写日志；fightlog＝渲染期**只读**回放。 %/
/% #441-A：本 widget 现在只负责**调 sim ＋ 渲染**——算与写在 `Game.Combat.resolvePlayer`／`resolveFoe`。
   拆两段（而不是一次算完）是为了让**渲染顺序**（玩家骰面 → 玩家受伤闪光 → 对手骰面 → 挨打闪光）
   与 **hp 时序**（玩家受伤后的 hp 决定对手这一轮是否发生）与旧实现逐字一致。 %/
<<widget "fightact">><<nobr>>
	/% #487（S2）：**回合开始 → 异常结算** —— 在玩家行动之前先结算（已定 ⑤的顺序）。
	   未启用新机制（`Sg.story.mechanics()` 为 null）→ `tickStatuses` 返回 null → 这一行完全无副作用。
	   落 HP 仍走 present 的 `<<damage>>`（与其他伤害同一处，保住既有渲染/时序）。 %/
	<<set _st to Game.StatusFx.tickStatuses($pc)>>
	<<if _st and _st.hurt>><<damage _st.hurt>><</if>>
	<<set _p to Game.Combat.resolvePlayer($pc, $args[0])>>
	<<checkres `_p.check`>>
	<<if _p.hurt>><<damage _p.hurt>><</if>>
	<<set _fo to Game.Combat.resolveFoe($pc, $args[0], _p.log, _p.site)>>
	<<if _fo.check>><<checkres `_fo.check`>><</if>>
	<<if _fo.hurt>><<damage _fo.hurt>><</if>>
	/% `#701`（症状：战斗屏只有**最后一手**，翻页/重渲染后旧的就没了）：**点击时**（sim 路径，允许写状态）
	   把这一手落进 `$pc.ev.fight.history`（有界环形缓冲，上限住引擎 `Game.Combat.HISTORY_MAX`）→ 渲染面只读回放。
	   **不改掷骰序**：只是把已经算完的 `log` 攒起来（`test/fight-seq.mjs` 仍逐字节不变 → 可机检）。
注意：逻辑住引擎（`Game.Combat.pushLog`）：SugarCube 的 `<<set>>` 吃不下"数组字面量＋方法链"，
	   而且那种失败只在真机初始化时现形（本节踩过一次）。 %/
	<<run Game.Combat.pushLog($pc)>>
<</nobr>><</widget>>

/% 渲染期只读回放上一手（#315 契约：渲染路径不得改状态；#350：S/L 后必须复现同一手） %/
<<widget "fightlog">><<nobr>>
	/% `#701`：先回放**战斗日志**（最近 N 手；上限住 `Game.Combat.HISTORY_MAX`），再面上一手。
	   历史块**独立于** `_L`（重渲染/读档后没有 `_L` 也能回看）；没打过仗（无 `history`）→ 整块不出现。 %/
	<<if $pc.ev.fight.history and $pc.ev.fight.history.length>>
		<div class="fight-history">''第 <<print $pc.ev.fight.moves>> 回合''（你 → 它）
			<<for _h range $pc.ev.fight.history>>
				<div>第 <<print _h.n>> 手：<<print _h.you>><<if _h.foes and _h.foes.length>> ／ <<print _h.foes.join(" ／ ")>><</if>></div>
			<</for>>
		</div>
	<</if>>
	<<set _L to $pc.ev.fight.log>>
	<<if _L>>
		<div class="fight-log">
			''你：<<print _L.you.label>>''　<<if _L.you.kind is "crit">><span class="fight-crit">''大成功''</span><</if>>
			<<print _L.you.text>>
			<div class="meta"><<if _L.you.dmg>>打掉 <<print _L.you.dmg>> 点<</if>><<if _L.you.gearBonus>>（<<print _L.you.gearName>> +<<print _L.you.gearBonus>>）<</if>><<if _L.you.dmg>>　<</if>><<if _L.you.adv>>下一击有优势　<</if>><<if _L.you.guard>>这一轮少挨 <<print _L.you.guard>>　<</if>><<if _L.you.hurt>>自己挨了 <<print _L.you.hurt>>　<</if>><<if _L.you.skipFoe>>它这一轮没能出手　<</if>><<if _L.you.goodNote>>（<<print _L.you.goodNote>>）<</if>><<if _L.you.kind is "bad">>''没能得手''<</if>></div>
		</div>
		<<if _L.foe>><div class="fight-log">''它：''<<print _L.foe.text>>
			/% `#704`（症状：`log.foe.slots` 有数据但渲染面**从不引用** → 玩家看不到"打在哪、被哪件吸了多少、哪件快坏了"）：
			   受击明细**单独一行**（与耐久/异常各占一块，不混排 —— 混排会让"扣了多少"对不上账）。
			   **取值口与 `#703` 侧栏共用** `Game.Gear.gearDurability($pc)`（不写两套）。
			   **未启用槽位的故事没有 `slots` → 这一行整个不出现**（不留空行/问号；这条是门的反例）。 %/
			<<if _L.foe.slots>>
				<<set _s to _L.foe.slots>>
				<<set _max to 0>>
				<<for _g range Game.Gear.gearDurability($pc)>>
					<<if _g.name is _s.gear>><<set _max to _g.max>><</if>>
				<</for>>
				<div class="meta">〔<<print _s.part>>〕<<if _s.gear>>护具 ''<<print _s.gear>>'' 吸 <<print _s.absorbed>><<if _s.reduce>>（减 <<print _s.reduce>>）<</if>><<if _max gt 0>>　余 <<print _s.gearHp>>/<<print _max>><</if>><<if _s.broke>>　''碎了''<</if>><<else>>没有护具挡下<</if>>　→ 落 HP <<print _s.toHp>></div>
			<</if>>
		</div><</if>>
	<</if>>
<</nobr>><</widget>>

/% ── `#1413`：**战斗收尾宏**（作者面）—— 把"这场打完了、谁赢"落成**可判的声明态** ──────────────
   为什么需要：旧故事在散文里自己写三件事（`<<if $pc.hp gt 0>>` ＋ `<<if $pc.ev.fight.round gt 2>>` ＋
   `<<set $pc.ev.fight.done to true>>`）⇒ 新格式**没有落点** ✗（条件行无 hp／round 维，且 `done` 全仓无人写）。
   本宏把"收尾"收成**一处调用**：落 `State.variables.fights[<池名>] = { won, lost, done, round, pcHp }`
   ⇒ 条件行即可写 **`fight:<池名>.won` / `.lost` / `.done`**（与 `chk:` 同构的**声明态** ✓）。
   ★**结果由作者显式给**（`won`／`lost`）—— ✗ 引擎**不判**"打够几回合算赢"（那是**故事策略**；
     引擎一旦写死阈值，就是把"哪个故事怎么算赢"塞进引擎 ✗）。
     ✗ 不传也可：本宏仍落**事实**（`round`／`pcHp`／`done`），并**按"hp ≤ 0 ⇒ lost"这一条**兜底
     （它与引擎既有的"致命伤 ⇒ 结局"一致 ⇒ 属引擎可知的事实 ✓）。
   ★✗ 不新开写路：仍写 `State` 表（与 `checks` 同规），由**本宏**（既有收尾位置）调用 ✓
   用法：`<<fightend "雾影">>` ／ `<<fightend "雾影" won>>`（重复调用幂等 ✓） %/
<<widget "fightend">><<nobr>>
	/% ★ 落法要点（实测两坑）：
	   ① `$args` 是**宏上下文**量 —— ✗ 在传给函数的函数体内取不到（实测：恒空 ⇒ 表从不被写）
	   ② SugarCube 的 `<<run>>` **只吃单行表达式** —— ✗ 多行函数体会被截断（实测 `Unexpected end of input`）
	   ⇒ 落法：**宏体顶层取局部量** ＋ **逻辑放引擎侧一处纯函数**（`Game.Combat.settle`），`<<run>>` 只调用 ✓ %/
	<<set _pool to String($args[0] ?? "")>>
	<<set _want to String($args[1] ?? "")>>
	<<run Game.Combat.settle($pc, _pool, _want)>>
<</nobr>><</widget>>

/% ★ `#1432`：**收尾后的去向**（作者裁定＝③「收尾后自动跳转」；与 `#1426` 的收尾时机**同轴**：都在面板参数上）。
   ✗ 引擎仍**不判胜负**（那是故事策略 ✓）；✗ 不新开写路（复用 `Game.Combat.settle` ✓）。
   ★为什么单开一个 widget：判定与跳转都要落在 **link 体**（＝**点击那一刻**）——
     ① ✗ 不能放渲染期：渲染期判"已收尾"只能读**持久**的 `fights[池].done` ⇒ 同一池名**跨章复用**时会**无敌可打** ✗
     ② ✗ 不能直接写在三处 link 体内（三份重复 ⇒ 改一处漏两处 ✗）⇒ 收进一个 widget，三处调用 ✓
   ★死透优先级：本 widget **只做跳转**，其调用点在三处 `<<if $pc.hp gt 0>>` **之内** ⇒
     ✗ 不会覆盖 `<<damage>>` 已跳的「结局 死亡」（既有注释已写明这条）✓
   用法：`<<fightdest "<段名>" "<池名>">>`（第 1 参缺省／空 ⇒ **什么都不做** ⇒ 与今天逐字相同 ✓） %/
<<widget "fightdest">><<nobr>>
	<<set _fdest to String($args[0] ?? "")>>
	<<if _fdest isnot "">>
		<<if Story.has(_fdest)>>
			/% ★**用 `<<goto>>` 宏**（✗ 不用 `Engine.play`）：实测两条 ——
			   · `Engine.play(dest)` 在**渲染期**被引擎拒（本 widget 正跑在 link 体的渲染里）⇒ 不动 ✗
			   · `<<goto>>` 宏＝`setTimeout(() => Engine.play(…), Engine.DOM_DELAY)`（读 `vendor/format.js`）
			     ⇒ **异步但一定会跳**（默认 40ms ⇒ 观感上就是「立刻」）✓ ⇒ 这才是渲染期导航的正路 ✓
			   ★判据注意：读「跳没跳」要**等一拍**（✗ 点完立刻读 ⇒ 会假红） %/
			<<goto `_fdest`>>
		<<else>>
			<<run (function(){ throw new Error('<<fightpanel>>：第 5 参（收尾后去向）指向的段落不存在：「' + String(_fdest) + '」（战斗池：「' + String($args[1] ?? "") + '」）—— 请核段落名，✗ 不静默跳成荒地'); })()>>
		<</if>>
	<</if>>
<</nobr>><</widget>>

/% #441-A：面板是 **present** —— 抽牌与「选中哪一手」都改走 `Game.Combat.ensureOffer`／`chooseAction`（sim），
   本 widget 体内因此不再有 `<<set $…>>`（旧实现三处 `<<set $pc.ev.fight.act to …>>` ＋ 一处经 `_f` 别名的
   `<<set _f.offer to …>>`，后者同样是写状态）。 %/
/% ★ `#1440`（分家配套·第一步，裁＝甲）：**面板点击体**收成一处 ——
   为什么：`<<fightpanel>>` 把**同一段点击逻辑**写**三遍**（`offer[0]`／`[1]`／`[2]`，各约 15 行）
   ⇒ 三份副本＝**改一处漏两处**（本仓反复治过的那类 ✗）。本 widget 是那三份的**唯一**落点。
   ★取向（裁＝甲）：**统一"三段结构"（选项渲染／结算派发／回放），✗ 不统一"点击机制"** ——
     即 `<<link>>` 通道（本 widget 服务的）与 `<a data-*>`＋委托通道（`socpanel`）**并存**，
     ★但两条通道都归一到**"点击那一刻跑结算"**这一语义 ✓。
   ★`socpanel` 为什么不能用 `<<link>>`（`80-script.twee:596-599` 原文，**机制约束** ✗ 不是风格）：
     「`<<link>>` 的内容是**点击时**才解析的，那时 `<<for>>` 的临时变量已经被同一段落里下一个面板覆盖
       （"点花的面板、算成求术的面板"）⇒ 面板直接发 `<a data-ask data-how>`，**值与它一起进 DOM**」 ✓
   参数：① `idx`（第几张牌）② `pool` ③ `N`（打满即收尾；可空）④ `result`（`won`／`lost`；可空）⑤ `dest`（去向段名；可空）
   ★调用约定：本 widget **只放 `<<link>>` 体内**（✗ 不含 `<<link>>` 外壳 —— 标签文案仍由各调用点给 ✓）。 %/
<<widget "fightpick">><<nobr>>
	<<set _orig to passage()>>
	<<run Game.Combat.chooseAction($pc, $args[0])>>
	<<fightact $args[1]>>
	/% ★ `#1426`：**收尾判定放在点击时**（✗ 不能在渲染期 —— 实测：SugarCube 对 `<<goto 同段>>`
	   **不重渲染** ⇒ 渲染期的判断在「打满」那一刻永不执行 ✗）
	   第 3 参＝打满 N 回合即收尾（**机械事实**）；第 4 参＝作者给的结果（缺省＝不判） %/
	<<if $args[2] isnot undefined and $args[2] isnot null and $args[2] isnot "">>
		<<if $pc.ev.fight and $pc.ev.fight.round gte Number($args[2])>>
			<<run Game.Combat.settle($pc, String($args[1] ?? ""), String($args[3] ?? ""))>>
		<</if>>
	<</if>>
	/% #350/#357：结算在点击时完成；**死透就不再归位**——`<<damage>>` 已跳「结局 死亡」，再 goto 会把它覆盖掉。
	   用**存活条件**判。★`#1432`：收尾后按作者给的去向跳转（第 5 参）；缺省 ⇒ 走今天的 `<<goto _orig>>` ✓；
	   且排在存活条件**之内** ⇒ 死透那一击仍去「结局 死亡」（✗ 不被覆盖）✓ %/
	/% ★ `#1487`：**存活守卫也按名取值**（`vk('hp')` ＋ `V().zero` ⇒ ✗ 不裸读键名/阈值 ✓） %/
	<<set _khp2 to Game.Rules.vk('hp')>>
	<<set _V2 to Game.Rules.V()>>
	<<if $pc[_khp2] gt _V2.zero>>
		<<if $args[2] isnot undefined and $args[2] isnot null and $args[2] isnot "" and $pc.ev.fight and $pc.ev.fight.round gte Number($args[2]) and $args[4] isnot undefined and $args[4] isnot null and $args[4] isnot "">>
			<<fightdest $args[4] $args[1]>>
		<<else>>
			<<goto `_orig`>>
		<</if>>
	<</if>>
<</nobr>><</widget>>

<<widget "fightpanel">><<nobr>>
	/% ★ `#1426`（**收尾时机**，与 `#1420` 同轴）：第 3 参＝**打满 N 回合即收尾**（**机械事实**：回合数 ✓）；
	   第 4 参＝**作者显式给的结果**（`won`／`lost`；缺省＝**不判胜负** ⇒ 两侧分叉都不出 ✓）。
	   ✗ 引擎仍**不判胜负**（那是故事策略 ✓）；✗ 不新开写路（复用 `Game.Combat.settle` ✓）；
	   ✗ 不破零表达式（作者写的仍是**具名动作 ＋ 字面量参数** ✓）。
	   ★兼容：两参**可选** ⇒ 不传 ⇒ 行为与今天**逐字相同** ✓（旧故事与既有夹具不受影响 ✓） %/
	<<run Game.Combat.ensureOffer($pc)>>
	<<set _f to $pc.ev.fight>>
	<div class="acts">
		''这一轮你能做的：''
		<<if _f.offer.length gt 0>>
			<<link `Sg.story.actionLabel?.(_f.offer[0]) ?? _f.offer[0]`>>
				/% `#1440`：体内三段（`_orig`／`chooseAction`／`fightact`／收尾判定／去向或 `goto`）
				   原来**逐字写第 0 遍** ⇒ 改调 `<<fightpick>>`；`link` 外壳与标签仍在此处 ✓
				   参数逐字对照：`idx=0` ⇔ `offer[0]`，其余四参＝本 widget 的 `$args[0..3]` ✓ %/
				<<fightpick 0 $args[0] $args[1] $args[2] $args[3]>>
			<</link>>
			<span class="meta">（<<print Game.Combat.siteInfo(_f.offer[0])>>）</span>
		<</if>>
		<<if _f.offer.length gt 1>>
			<<link `Sg.story.actionLabel?.(_f.offer[1]) ?? _f.offer[1]`>>
				/% `#1440`：体内三段（`_orig`／`chooseAction`／`fightact`／收尾判定／去向或 `goto`）
				   原来**逐字写第 1 遍** ⇒ 改调 `<<fightpick>>`；`link` 外壳与标签仍在此处 ✓
				   参数逐字对照：`idx=1` ⇔ `offer[1]`，其余四参＝本 widget 的 `$args[0..3]` ✓ %/
				<<fightpick 1 $args[0] $args[1] $args[2] $args[3]>>
			<</link>>
			<span class="meta">（<<print Game.Combat.siteInfo(_f.offer[1])>>）</span>
		<</if>>
		<<if _f.offer.length gt 2>>
			<<link `Sg.story.actionLabel?.(_f.offer[2]) ?? _f.offer[2]`>>
				/% `#1440`：体内三段（`_orig`／`chooseAction`／`fightact`／收尾判定／去向或 `goto`）
				   原来**逐字写第 2 遍** ⇒ 改调 `<<fightpick>>`；`link` 外壳与标签仍在此处 ✓
				   参数逐字对照：`idx=2` ⇔ `offer[2]`，其余四参＝本 widget 的 `$args[0..3]` ✓ %/
				<<fightpick 2 $args[0] $args[1] $args[2] $args[3]>>
			<</link>>
			<span class="meta">（<<print Game.Combat.siteInfo(_f.offer[2])>>）</span>
		<</if>>
	</div>
<</nobr>><</widget>>

/% ── 交涉（B2 · D&D 2024 Influence action + DMG 社交交互）────────────────────
   三档意愿：willing（他本来就想给——不掷骰）· hesitant（掷骰）· unwilling（越线——掷骰也没用）
   态度：友好 −5 / 冷淡 0 / 敌意 +5（DMG 社交交互表压成一根轴）
   筹码：把对方想要的东西摆出来 → 免检（auto）或优势（adv）——有不靠嘴的路
   代价：游说/历史失败 → 这一问 DC 递增（2024「不许原地重掷」）· 欺瞒被识破 → 态度骤降 · 恐吓 → 得手也记仇
   架构与战斗动作池一致：点选项只写 $pc.ev.soc，重渲染后在段落顶部结算（骰面留在帧里）。

   注意：选项必须是**我们自己发的 <a data-...>**，不能写成 <<link>>：<<link>> 的内容在**点击时**才
   解析，那时 <<for>> 的临时变量早被同段落的下一个面板覆盖了（"点花的面板、算成求术的面板"）。
   值与它一起走进 DOM，点谁是谁。 %/

/% #441-A：本 widget 现在只负责**调 sim ＋ 渲染**——分支判定与全部状态写点都在
   `Game.Social.resolveAsk`（`21-resolve.twee`）。它**唯一渲染的东西**是筹码那一支的金额文案。
   抽出的意义：`test/social-lever.mjs` 可以不经浏览器驱动整个交涉回合。 %/
<<widget "socresolve">><<nobr>>
	<<set _r to Game.Social.resolveAsk($pc, $args[0], $pc.ev.soc?.how ?? null)>>
	<<if _r and _r.econ>><span class="econ-note"><<print Game.Economy.note(_r.econ.delta)>></span><</if>>
<</nobr>><</widget>>

<<widget "socpanel">><<nobr>>
	<<set _a to Game.Social.ask($args[0])>>
	<<set _S to Game.Social>>
	<<if _a>>
		<div class="soc-ask">
			''<<print _a.q>>''
			<<if $pc.ev.soc_last and $pc.ev.soc_last[_a.id]>>
				<<set _L to $pc.ev.soc_last[_a.id]>>
				<<lastcheckFor _a.sites>>
				<span class="soc-said"><<print _L.text>></span>
				<<for _n to 0; _n lt (_L.notes ?? []).length; _n++>><span class="soc-cost">（<<print _L.notes[_n]>>）</span><</for>>
			<</if>>
			<<if _S.askDone(_a, $pc)>>
				<span class="soc-done">（这一件已经有结果了。）</span>
			<<else>>
				<<set _v to _S.verdict(_a, $pc)>>
				<<if _v is "unwilling">>
					<span class="soc-no"><<print _a.why ?? "（这件事没得谈。）">></span>
				<<else>>
					<<set _att to _S.attitude(_a, $pc)>>
					<div class="panel">
					<<if _v is "willing">>
						<<print `<a class="soc-opt" role="link" tabindex="0" data-ask="${_a.id}" data-how="will">开口：${_a.q}（${_a.tag}）</a>`>>
						<span class="soc-meta">（对方本来就要说<<if Sg.UI.showDetail()>>——不必掷骰<</if>>）</span>
					<</if>>
					<<for _i to 0; _i lt _S.levers(_a, $pc).length; _i++>>
						<<set _lv to _S.levers(_a, $pc)[_i]>>
						<<print `<a class="soc-opt" role="link" tabindex="0" data-ask="${_a.id}" data-how="lever:${_lv.id}">拿出筹码：${_lv.name}（${_a.tag}）</a>`>>
						<span class="soc-meta">（<<if _lv.econ>>花 <<print -Game.Economy.priceOf(_lv.econ, $pc)>> <<print Game.Rules.el('gold')>> ｜ <</if>><<if _lv.gives is "auto">>直接答应<<if Sg.UI.showDetail()>>，无需掷骰<</if>><</if>><<if _lv.gives is "adv">>后续更有把握<<if Sg.UI.showDetail()>>（交涉检定有优势）<</if>><</if>>）</span>
					<</for>>
					<<for _i to 0; _i lt _S.open(_a, $pc).length; _i++>>
						<<set _o to _S.open(_a, $pc)[_i]>>
						<<print `<a class="soc-opt" role="link" tabindex="0" data-ask="${_a.id}" data-how="site:${_o.site}">${_o.ap.verb}：${_o.skill}（${_a.tag}）</a>`>>
						<span class="soc-meta">（<<print _S.ATT[_att]>><<if Sg.UI.showDetail()>> → DC<<print _o.dc>><</if>><<if _o.ap.onFail?.retry>> ｜ 失败：话说死了，更难开口<</if>><<if _o.ap.onFail?.att>> ｜ 失败：<<print _a.npc>>记住了<<if Sg.UI.showDetail()>>（态度降一级）<</if>><</if>><<if not _o.ap.onFail?.retry and not _o.ap.onFail?.att>> ｜ 失败：只是没接上话<</if>><<if _o.ap.onOk?.att>> ｜ 成了也记仇<</if>>）</span>
					<</for>>
					</div>
				<</if>>
			<</if>>
		</div>
	<</if>>
<</nobr>><</widget>>

<<widget "flipEra">><<nobr>>
	/% `#1132` B3＋`#1216` B 半：时代翻转是**能力组**（三名一起才是这个能力）。
	   全缺 → 能力关（不渲染）；部分缺 → 出声点名；不给数值缺省。 %/
	<<set _flipCap to Sg.capability('flip')>>
	<<if _flipCap.reason is 'off'>>
	<<elseif _flipCap.reason is 'partial'>>
		<div><span class="era-drained">时代翻转的数据声明不完整：缺 <<print _flipCap.missing.join('、')>>。</span></div>
	<<else>>
	<<set _flipItem to _flipCap.item>><<set _flipCost to _flipCap.cost>><<set _flipFlag to _flipCap.flag>>
	<<if not $pc.inv[_flipItem]>>
		<div><span class="era-drained">你身上没有能校进另一段时间的东西。</span></div>
	<<else>>
		<<link `($era is Game.Era.PRESENT ? "翻转护符：坠入『过去』" : "翻转护符：回到『现在』")`>>
			/% `#1227` 类二：**首翻免费与两个键名都是故事数据**
（`Game.Star.flipPolicy = { firstFree, key, freeKey, spentKey}` —— 顶层键 `key` 与内层两个键名 `freeKey`／`spentKey`
			   都由故事给）；引擎**不写死任何故事键名字面**，**缺项即出声**（不静默取默认当键名）。
			   本句由判据「引擎侧出现故事键名 → 红」管着（见 `test/contract-defaults.mjs` 的同名格）。 %/
			<<run Game.Star.chargeFlip($pc, _flipCost)>>
			<<set $era to ($era is Game.Era.PRESENT ? Game.Era.PAST : Game.Era.PRESENT)>>
			<<if $era is Game.Era.PRESENT>><<set $pc.world[_flipFlag] to true>><</if>>
			<<goto `passage()`>>
		<</link>>
	<</if>>
	<</if>>
<</nobr>><</widget>>

:: StoryCaption
/% 侧边栏：常驻存档入口（v16 §5.0）+ 实时角色卡 + 物品栏 %/
<<nobr>>
<div class="save-bar">
	<button type="button" class="save-btn" onclick="Sg.save.quick()">💾 快速存档</button>
	<button type="button" class="save-btn" onclick="Sg.save.quickLoad()">📂 快速读档</button>
	<button type="button" class="save-btn" onclick="Sg.save.menu()">🗂 存档 / 读档</button>
</div>
<</nobr>>
<<if $pc.classLabel>>
''$pc.name''
$pc.speciesLabel $pc.classLabel
/% ★★`#1539`（P3）：**逐块切换** —— 以 `panels` 声明为准画；未声明 ⇒ ✗ 画（粒度＝块，✗ 全故事一次切）。
   ★为什么不能“旧内置块继续画”：那样同一属性会出现**两处**（一份来自声明、一份来自内置）
     ⇒ “**真正生效的那一份不可判**”（同族：`#1474`／`#1478`／`#1484`）✓。
   ★零声明 ⇒ **干净的空**（spec §4④：✗ 印 `（空）`、✗ 印 `$pc.x` ✓）。 %/
<<print Sg.panels.renderSlot($pc, 'sidebar.primary')>>
/% ★★`#1539`（P3）×`#1530`（economy 键名）：**金币行两个口径同时满足** ——
   ① 键名走 `Game.Rules.ek('gold')` / 文案走 `Game.Rules.el('gold')`（`#1530`：✗ 硬编）；
   ② spec §4④：**没有该维 ⇒ 整行不产字节**（✗ 印 `$pc.x` 字面 —— 实测未声明 economy 的故事
     会把裸变量当散文原样印给玩家，`#1534` 评论 `5851722091` §三）。 %/
<<set _gk to Game.Rules.ek('gold')>><<set _gv to $pc[_gk]>><<if _gv !== undefined>><<print Game.Rules.el('gold')>>：<<print _gv>><</if>>
<<print Game.Rules.vl('salves')>>：<<print $pc[Game.Rules.vk('salves')]>> 副（缺口满 <<print Game.Rules.V().heal>> 点时自动用，一副恢复 <<print Game.Rules.V().heal>> 点）
<<if $pc.gear.length>>行囊：<<print $pc.gear.join('、')>><</if>>
/% ★★`#1540`（表示面 P4）：**`gear-hp`（装备耐久）与 `status-list`（部位异常）两块已删**。
   ★为什么删（✗ 不是"搬走"）：**全部对象**（5 个 books 故事 ＋ 各夹具）的 `mechanics.statuses`
     与 `gearDef` **全空** ⇒ 这两块**一个都不渲染**（`_gh.length`／`_st.length` 恒 0）。
   ★判据：**"有实现、无驱动"＝架构上等于不存在，却看起来像能力**（写作者在 `#1542` 的同一条）。
   ★先例：`#1227` 类一删 `dragonbar`（引擎✗为某个故事/某个概念提供渲染件）。
   ★**要恢复**的话：`#703` 的"机制必须可被玩家看见"仍成立 —— 但**靠 `panels` 声明**（✗ 靠引擎内置块）：
     故事有该数据时，声明一块 `bar`／`list` 指向它即可（`Sg.panels` 已就绪）✓。
   ★**同笔**：`scripts/audit/gates/status.mjs` 的判据由"**字面串在场**"改为"**渲染面存在**"——
     原判据要求 `StoryCaption` 里出现 `Game.Gear.gearDurability(` 等**字面串**，那在"走声明"的
     终态下会**反过来逼死代码留着**（循环：门在守"删不得"）✗。 %/
<<set _flipCap to Sg.capability('flip')>><<if _flipCap.ok and $pc.inv[_flipCap.item]>>
<</if>>
/% #460：设定集是本故事的页面（引擎不知道故事名）→ **存在才渲染**；否则第二/第三故事侧栏会出现死链 %/
<<if Story.has("设定集")>>[[📖 设定集|设定集]]<</if>>
<<elseif not Sg.story.hasChargen?.()>>
/% `#574`：**没有车卡的故事**（第二/第三个）——侧栏退化为最小面：血量·金币·物品·存档。
   为什么另起一段而不是共用上面那段：那段以车卡产物（`name`／`speciesLabel`／`classLabel`／`salves`／
   `gear`）为前提，没有车卡的故事里那些字段永远是空；而"能看见血量的战斗试验场"是本故事的前提。
   故事 1 不受影响：它有车卡 → 车卡前仍是"只有存档按钮"，与改前逐字相同。
   `#660` 片三-2：这里原本**直接探测故事的全局名**（`not Game.Chargen`）——那是边界破口（引擎知道故事的表叫什么）→
   改成问**接入契约** `Sg.story.hasChargen()`（引擎只问"有没有"，不把故事全局再拿回去）。
   ★★`#1539`（P3）：本支同样改走 `panels` 声明（逐块切换）——两条支的差别只在"车卡卡面"与
     "最小面"的**其余元素**；状态块本身**同一处口径**（✗ 两份实现 ✓）。 %/
<<print Sg.panels.renderSlot($pc, 'sidebar.primary')>>
/% ★★`#1539`（P3）×`#1530`（economy 键名）：金币行**两个口径同时满足** ——
   ① 键名 `Game.Rules.ek('gold')` / 文案 `Game.Rules.el('gold')`（`#1530`：✗ 硬编）；
   ② spec §4④：**没有该维 ⇒ 整行不产字节**（✗ 印 `$pc.x` 字面） ✓ %/
<<set _gk to Game.Rules.ek('gold')>><<set _gv to $pc[_gk]>><<if _gv !== undefined>><<print Game.Rules.el('gold')>>：<<print _gv>><</if>>
/% 设定集同样是"存在才渲染"（本故事没有它 → 不出现死链） %/
<<if Story.has("设定集")>>[[📖 设定集|设定集]]<</if>>
<</if>>
