				crit: { text: "你抹得极匀。刃面上那层银白反着他杖尖那点微光——''它一看见就慢了半拍''，你趁那半拍送了进去。", venom: true, dmg: 13 },
				bad:  { text: "手一抖，花汁抹歪了。还有半朵，可以再抹。", hurt: 1 } },
			'封印·呼应': { site: '封印·呼应', label: '喊守林人：往左半步',
				ok:   { text: "\"往左半步！\"他没回头，脚已经动了。他杖尖那点微光落在你让开的那条线上，也落在它肋下。", adv: 1, guard: 3, dmg: 8 },
				crit: { text: "你们俩同时动了。那点微光顺着你的刃背挪过去——''那一句念得很稳''，你那一刀也压得很实。", adv: 1, dmg: 15 },
				bad:  { text: "你喊晚了一步。他被自己的杖绊了一下，那一句念断了。", hurt: 2 } },
			'封印·吹哨': { site: '封印·吹哨', label: '吹响那支哨子', need: 'inv:坏哨',
				ok:   { text: "哨音很短。它的头偏了一下——''它在听''。你就着那个偏头切进去。", adv: 1, dmg: 6 },
				crit: { text: "哨音撞在穹顶上又落下来，绕着它转了一圈。它整个低了下去——低到你够得着。", adv: 1, dmg: 14 },
				bad:  { text: "哨子卡了一下，只出来一声破音。", hurt: 1 } },
			'封印·读术式': { site: '封印·读术式', label: '听懂他念到哪儿，提前半句接上',
				ok:   { text: "你听出下一个词。它还没到，你已经在它该在的地方了——刃和那句话一起落下去。", adv: 1, dmg: 10 },
				crit: { text: "你比他自己早半拍念出那个词。他停了半息看你一眼，然后跟上——那半句从没念得这么顺。", adv: 1, dmg: 18 },
				bad:  { text: "你猜错了词。术式的节拍乱了一下，他也被带着顿住。", hurt: 3 } },
			'封印·硬扛': { site: '封印·硬扛', label: '不躲了，硬吃一下换一刀',
				ok:   { text: "你吃下那一记，刀也吃进去了。", dmg: 18, hurt: 4 },
				crit: { text: "你把肩膀顶上去，刃顺着它的力道往里走——''这一刀很深''。", dmg: 28, hurt: 2 },
				bad:  { text: "你硬吃了一下，刀却滑了。", hurt: 8 } },
			'封印·举臂': { site: '封印·举臂', label: '把护臂顶上去挡它的嘴', need: 'inv:龙鳞护臂',
				ok:   { text: "那副甲卡进它齿缝里，它合不上嘴——你把刃从底下送进去。", guard: 6, dmg: 10 },
				crit: { text: "甲撑住它的下颌，你从底下把刃一路送到柄。", guard: 6, dmg: 18 },
				bad:  { text: "甲被撞得脱手，弹在你小腿上。", hurt: 3 } },

			'龙·躲闪': { site: '龙·躲闪', label: '躲它的尾扫',
				ok:   { text: "你滚开半步，尾巴擦着你的背过去。", guard: 6 },
				crit: { text: "你从尾巴底下钻过去，顺手在它落脚处划了一道。", guard: 6, dmg: 3 },
				bad:  { text: "你没躲开。", hurt: 6 } },
			'龙·看缝': { site: '龙·看缝', label: '盯住逆鳞那道缝',
				ok:   { text: "那道缝在它左肋，比别处浅。''你看见了。''", guard: 3 },
				crit: { text: "缝比你想的长，一直通到颈根。''你看见了，也记住了。''", guard: 4, dmg: 2 },
				bad:  { text: "它一直动，你什么也没看清。", hurt: 3 } },
			'龙·喊名': { site: '龙·喊名', label: '把书里那个名字喊出来',
				ok:   { text: "你喊了。它停了一拍——''像在听''。这一拍够你退开。", guard: 4 },
				crit: { text: "你喊出那个名字。它整条都顿住了，喉咙里发出一声不像怒吼的声音。", guard: 5, dmg: 3 },
				bad:  { text: "你喊错了音节。它连头都没偏。", hurt: 2 } },
			'龙·横刀': { site: '龙·横刀', label: '横刀挡在身前',
				ok:   { text: "刀背撑住了那一下。你的手臂麻到抬不起来。", guard: 5 },
				crit: { text: "你借它的力道把刀背滑开，反手在它掌缘划了一道。", guard: 5, dmg: 4 },
				bad:  { text: "刀被砸弯了一点，虎口裂了。", hurt: 5 } },
			'龙·后撤': { site: '龙·后撤', label: '往后撤，回到门边',
				ok:   { text: "你退到门边。它没有追——它甚至没有站起来。", guard: 4 },
				crit: { text: "你退到门边，顺手推了推那道门：''还能开''。", guard: 4, flee: true },
				bad:  { text: "你退得太急，后脚跟磕在门槛上。", hurt: 2 } },
			'龙·数拍': { site: '龙·数拍', label: '数它的呼吸，等它换气',
				ok:   { text: "它每三下换一次气。你掐着那个空当走位。", guard: 5 },
				crit: { text: "它换气的空当比你以为的长。你在那个空当里多砍了一下。", guard: 5, dmg: 4 },
				bad:  { text: "你数到第四下，它还在吸气。", hurt: 3 } },
		},
		// 这一手走哪一项属性、DC 多少（给玩家看：不同选择＝不同判定）
		siteInfo(actionId) {
			const s = Checks.sites[this.actions[actionId]?.site];
			if (!s) return '';
			const what = s.skill ? Rules.skillLabel(s.skill) : (s.abil === 'con' ? '体质豁免' : s.abil);
			return `${what} DC${s.dc}`;
		},
		// 每轮给 3 个：排除条件不满足的、以及上一轮刚用过的
		eligible(poolId, pc) {
			const held = pc?.inv ?? {};
			return (this.pools[poolId] ?? []).filter((id) => {
				const need = this.actions[id]?.need;
				if (!need) return true;
				if (need.startsWith('inv:')) return !!held[need.slice(4)];
				return true;
			});
		},
		offer(poolId, round, pc, lastUsed) {
			let list = this.eligible(poolId, pc).filter((id) => id !== lastUsed);
			if (list.length < 3) list = this.eligible(poolId, pc);
			const picked = [];
			while (picked.length < 3 && list.length) {
				const i = Math.min(list.length - 1, Math.floor(Math.random() * list.length));
				picked.push(list.splice(i, 1)[0]);
			}
			// 备药优先：手上有花、还没涂毒 → 第一轮一定给「涂毒」（免得玩家永远等不到）
			if (poolId === '封印' && (round ?? 1) === 1 && pc?.inv?.['月光花'] && !pc?.dragon?.venom && !picked.includes('封印·涂毒')) {
				picked[picked.length - 1] = '封印·涂毒';
			}
			return [...new Set(picked)];
		},
		// 定档：天然 20 ＝ 大成功（大成功优先于成功/失败）
		pick(actionId, res) {
			const a = this.actions[actionId];
			if (!a) throw new Error(`未登记的战斗动作: ${actionId}`);
			const kind = res?.roll === 20 ? 'crit' : res?.success ? 'ok' : 'bad';
			return { kind, eff: a[kind] ?? {} };
		},
		// 把效果的"非血量"部分落进状态（血量交给 <<damage>> 走 widget，好让药膏与死亡判定生效）
		applyEffect(pc, eff, fight) {
			if (eff.dmg) pc.dragon.hp = Math.max(0, (pc.dragon.hp ?? 0) - eff.dmg);
			if (eff.adv) fight.adv = (fight.adv ?? 0) + eff.adv;
			if (eff.guard) fight.guard = (fight.guard ?? 0) + eff.guard;
			if (eff.skipFoe) fight.skipFoe = true;
			if (eff.flee) fight.flee = true;
			if (eff.venom) pc.dragon.venom = true;
			if (eff.flag) pc.ev[eff.flag] = true;
		},
	};


	// ── 交涉（B2 · D&D 2024 Influence action + DMG 社交交互）──────────────
	// 三档意愿（2024）：willing＝他本来就想给（不掷骰）· hesitant＝在理但要说服（掷骰）
	//                  unwilling＝越了他的线（掷骰也没用，他直接回绝——掷骰不是万能钥匙）
	// 态度（2024）：友好 / 冷淡 / 敌意 → 按 DMG 社交交互表折算成 DC 修正（−5 / 0 / +5）
	// 手段（2024 Influence checks：游说 / 欺瞒 / 恐吓 / 表演；另按「用别的属性」侧栏加
	//       洞悉＝读人 · 历史＝引先例）——同一诉求换手段＝换属性判定
	// 筹码（DMG）：把对方想要的东西摆出来 → 免检（auto）或优势（adv）——有不靠嘴的路
	// 失败各有代价：游说/历史 → 这一问更难再开口（DC 递增，对应 2024「24 小时内不能重试」）
	//              欺瞒被识破 → 态度骤降 · 恐吓 → 得手也记仇
	const Social = {
		ATT: { friendly: '友好', neutral: '冷淡', hostile: '敌意' },
		attAdj: { friendly: -5, neutral: 0, hostile: 5 },
		approaches: {
			游说: { verb: '把话说圆',             onFail: { retry: 5 },  note: '话说死了，这一问就更难再开口' },
			欺瞒: { verb: '编一套他爱听的',       onFail: { att: -2 },   note: '被识破的人不会再把后背留给你' },
			恐吓: { verb: '亮一亮手里的家伙',     onFail: { att: -1 },   onOk: { att: -1 }, note: '他让了，但他记住了（成了也记仇）' },
			表演: { verb: '讲一段、唱一段',       onFail: {},            note: '图一乐，不落把柄' },
			洞悉: { verb: '先看他手里攥着什么',   onFail: {},            read: true, note: '读人不花代价' },
			察觉: { verb: '先看清他身上那点不对劲', onFail: {},          note: '线索就在他身上，看得见就说得出口' },
			历史: { verb: '引一段先例',           onFail: { retry: 5 },  note: '记错了就没人再听你引' },
		},
		// 一个诉求＝一句话 ＋ 若干条开口的方式（sites）＋ 若干件他真正想要的（levers）
		// verdict：unwilling（越线，掷骰也没用）→ willing（他本来就想给）→ 否则掷骰
		asks: [
			{ id: '老板娘·进塔', tag: '问路', npc: '老板娘', q: '进塔该注意什么', base: 'neutral', yield: 'ev:tav_tips',
				sites: ['酒馆·打听', '老板娘·吓', '老板娘·接话', '老板娘·读'],
				levers: [
					{ id: 'drink', name: '请她喝一轮', gives: 'auto', econ: 'drink_round', note: '她不缺你这两句话，缺的是一轮酒' },
					{ id: 'read',  name: '看出她一直在瞟炉子', gives: 'adv', needRead: true, note: '她怕的是火，不是塔' },
				],
				done: (pc) => !!pc.ev.tav_tips,
				apply: (pc) => { pc.ev.tav_tips = true; pc.ev.tav_fog = true; },
				ok: '"你要真想进去，"她把杯子放下，"就记住两件事：一是别在雾里睡觉，二是听见有人叫你名字，别应。"',
				bad: `她把抹布在台面上又擦了一遍，没接你的话。（''她听过了，不想再说。''）`,
				auto: '你把酒钱推过去。她愣了一下，然后真的坐下了："……你倒是会做人。坐下吧。"' },

			{ id: '守林人·花', tag: '问花', npc: '守林人', q: '塔基墙根那片银白的花是什么', yield: 'flag:flower_warned',
				base: (pc) => (pc.inv['时光护符'] ? 'friendly' : 'neutral'),
				sites: ['守林人·交涉', '守林人·指花', '守林人·读'],
				levers: [
					{ id: 'journal', name: '把日记摊在桌上', gives: 'adv', need: (pc) => !!pc.inv['日记'], note: '那是我家先人那一辈的字' },
					{ id: 'read',    name: '看出他靴边那一圈白', gives: 'adv', needRead: true, note: '他每天都要从那片花边上走一趟' },
				],
				// 2024「willing」由段落内手写（带日记/书＝他本来就要说：_t>0 → 直给），这里只留掷骰与筹码
				done: (pc) => !!pc.world.flower_warned,
				apply: (pc) => { pc.world.flower_warned = true; pc.ev.keeper_told = true; },
				ok: '"那花会睡人。"他看了一眼炉子，"要摘，先把气含住。我小时候在那儿睡过一下午，醒来天都黑了。"',
				bad: `"那片花？"他把灯芯剪短了一截，''"你别去碰它。"''他不再说别的。`,
				auto: '他顺着你的手看过去，沉默了一下："……你看见我靴子了。"' },

			{ id: '守林人·术', tag: '求术', npc: '守林人', q: '用你家那门术式', yield: 'keeper:seal',
				base: (pc) => (pc.inv['时光护符'] ? 'friendly' : 'neutral'),
				sites: ['守林人·求术', '守林人·引先例', '守林人·读'],
				levers: [
					{ id: 'talisman', name: '把脖子上那枚护符亮出来', gives: 'auto', need: (pc) => !!pc.inv['时光护符'], note: '他母亲给你的东西，他认得' },
					{ id: 'read',     name: '看出他一直在练错的那几个字', gives: 'adv', needRead: true, note: '他要的不是赢，是把这一句念完' },
				],
				willing: (pc) => (pc.keeper?.trust ?? 0) > 0,
				done: (pc) => pc.keeper?.state === 'seal',
				apply: (pc) => { pc.keeper.state = 'seal'; },
				ok: '他把手稿收进抽屉，在桌边坐下，示意你也坐。"术式我念得动。"他说，"我练了一辈子。"',
				bad: '"这门东西不给人看。"他把灯拨正，"你要是不知道自己在求什么，就别求。"',
				will: '他没等你说完，已经把抽屉拉开了。"你带着我家先人的字来，"他说，"那我就没什么可藏的。"',
				auto: `他先看的是你脖子上那枚护符。"我妈让你来的。"他说——''那你就不是来找麻烦的''。` },

			{ id: '观星者·图', tag: '求图', npc: '观星者', q: '把完整星图给我', yield: '完整星图',
				base: (pc) => (pc.inv['观星者的书'] ? 'friendly' : 'neutral'),
				sites: ['观星者·说服', '观星者·洞悉', '观星者·磨'],
				levers: [
					{ id: 'book', name: '把风化了的书放回案上', gives: 'auto', need: (pc) => !!pc.inv['观星者的书'], note: '那是他自己写的字' },
					{ id: 'read', name: '看出他停在最后一轨', gives: 'adv', needRead: true, note: '他算不下去了，也没人替他算' },
				],
				done: (pc) => !!pc.ev.seer_gave,
				apply: (pc) => { pc.ev.seer_gave = true; },
				ok: `他把笔放下了。''"空口无凭"''那四个字，他没说。`,
				bad: `"空口无凭。"他把图收了回去。（''你要是说不动他，就得拿出他认得的东西来。''）`,
				auto: '你把那册风化了的书放在案上。他的手停住了。"这是我写的。"他翻了两页，看了很久。' },

			{ id: '女巫·看哨', tag: '看哨', npc: '当时的女巫', q: '那支哨子，给我看看', base: 'neutral', yield: 'ev:witch_grip',
				sites: ['当时的女巫·辨认', '当时的女巫·开口', '当时的女巫·激'],
				levers: [
					{ id: 'read', name: '看她握哨的手势', gives: 'adv', needRead: true, note: '那只手一直没松开过' },
				],
				done: (pc) => !!pc.ev.witch_grip,
				apply: (pc) => { pc.ev.witch_grip = true; },
				ok: '你把看出来的东西说出口。她把手翻过来给你看："你眼力不错。"',
				bad: '她把手合上了。"哨子是我家的。"',
				auto: '你还没开口，她已经注意到你在看那只手。' },

			{ id: '女巫·换哨', tag: '换哨', npc: '当时的女巫', q: '把她那支哨换过来', base: 'neutral',
				sites: [], levers: [],
				// 2024「unwilling」：拿不出图与还杖这两件事，说不动她——这一步不是掷骰能过的
				willing: (pc) => !!pc.inv['完整星图'] && !!pc.world.family_favor,
				unwilling: (pc) => !(pc.inv['完整星图'] && pc.world.family_favor),
				why: `（她把图与那根杖都算在了这一眼里——''这两样没凑齐，说什么都白说''。）`,
				done: (pc) => !!pc.inv['好哨'],
				apply: (pc) => { delete pc.inv['坏哨']; pc.inv['好哨'] = true; },
				will: '她看了很久，像在核对一件只有她认得的东西，然后把手里那支哨递过来。' },

			{ id: '哥布林·路', tag: '让路', npc: '哥布林', q: '让我过去', base: 'hostile', yield: 'flag:goblin_spared',
				sites: ['哥布林·哄', '哥布林·骗', '哥布林·吓', '哥布林·看'],
				levers: [
					{ id: 'coin',   name: '把几枚金币放在石头上', gives: 'auto', econ: 'goblin_bribe', note: '它要的不是路，是能换东西的石头' },
					{ id: 'stones', name: '把滚到脚边的石头给它捡回去', gives: 'auto', needRead: true, note: '它只是舍不得那些石头' },
				],
				done: (pc) => !!pc.world.goblin_spared,
				apply: (pc) => { pc.world.goblin_spared = true; },
				ok: '它把石头一块块码回怀里，往旁边挪了挪，让出半条路。',
				bad: '它尖叫着把石头抱得更紧，牙齿打颤的声音更响了。',
				auto: '你把金币放在它面前的石头上。它盯着看了一会儿，伸手抓走了。' },

			{ id: '老巫女·开口', tag: '搭话', npc: '老巫女', q: '让她多说两句', base: 'neutral',
				sites: [], levers: [],
				unwilling: () => true,
				why: `（她把袖子拢了拢。''这一桌没有你要问的事''——她不说，你也没什么能拿来换的。）`,
				done: () => false,
				no: '她没看你，只看着厅中央那张空着的位子。' },
		],
		ask(id) { return this.asks.find((a) => a.id === id) ?? null; },
		attitude(a, pc) {
			let att = typeof a.base === 'function' ? a.base(pc ?? {}) : (a.base ?? 'neutral');
			const n = pc?.soc?.att?.[a.npc] ?? 0;
			if (n >= 1) att = 'friendly';
			else if (n <= -1) att = 'hostile';
			return att;
		},
		shift(pc, npc, n) {
			if (!pc.soc) pc.soc = { att: {}, tries: {}, read: {} };
			pc.soc.att[npc] = (pc.soc.att[npc] ?? 0) + n;
		},
		tries(a, pc, site) { return pc?.soc?.tries?.[`${a.id}|${site}`] ?? 0; },
		// DC ＝ 位点基础 DC ＋ 态度修正 ＋ 5 × 同一手已经试过几次（2024：不许原地重掷）
		dcOf(a, site, pc) {
			const s = Checks.sites[site] ?? {};
			return Math.max(5, (s.dc ?? 15) + (this.attAdj[this.attitude(a, pc)] ?? 0) + 5 * this.tries(a, pc, site));
		},
		// 手上有哪几张牌：这一问能怎么开口（每张＝一项技能），筹码开没开
		open(a, pc) {
			return (a.sites ?? []).map((site) => {
				const skill = Checks.sites[site]?.skill ?? '';
				return { site, skill, ap: this.approaches[skill] ?? null, dc: this.dcOf(a, site, pc) };
			}).filter((o) => o.ap);
		},
		levers(a, pc) { return (a.levers ?? []).filter((lv) => this.leverOpen(a, lv, pc)); },
		leverOpen(a, lv, pc) {
			if (lv.needRead && !pc?.soc?.read?.[a.npc]) return false;
			if (lv.need && !lv.need(pc)) return false;
			return true;
		},
		// 掷一次（不渲染）：骰面存进 $pc.ev.last_roll，交给 <<lastcheckFor>> 复显——
		// 免得"结算处"与"面板处"各印一遍检定框
		roll(pc, site, dc, advWhy) {
			const s = Checks.sites[site] ?? {};
			const opt = { adv: advWhy ? 1 : 0, site, advWhy: advWhy ?? '' };
			return s.abil ? Rules.save(pc, s.abil, dc, opt) : Rules.check(pc, s.skill, dc, opt);
		},
		// 结果定档：willing＝不掷骰 · unwilling＝不掷骰（回绝）· 其余掷骰
		verdict(a, pc) {
			if (a.unwilling?.(pc)) return 'unwilling';
			if (a.willing?.(pc)) return 'willing';
			return 'roll';
		},
		// 落账：成功/失败各自的代价（2024 的态度与重试规则）
		settle(a, pc, site, kind) {
			const skill = Checks.sites[site]?.skill ?? '';
			const ap = this.approaches[skill] ?? {};
			if (!pc.soc) pc.soc = { att: {}, tries: {}, read: {} };
			if (kind === 'crit' || kind === 'ok') {
				if (ap.read) { if (!pc.soc.read) pc.soc.read = {}; pc.soc.read[a.npc] = true; }
				if (ap.onOk?.att) this.shift(pc, a.npc, ap.onOk.att);
				return [];
			}
			const notes = [];
			// 重试代价只给「话说死了」的那几手（游说/历史）：这一手越问越难。
			// 其它手段的代价另算——欺瞒/恐吓＝态度降级（整条轴都变贵），表演/洞悉/察觉＝只是没接上话。
			if (site && ap.onFail?.retry) {
				const k = `${a.id}|${site}`;
				pc.soc.tries[k] = (pc.soc.tries[k] ?? 0) + 1;
			}
			if (ap.onFail?.retry) notes.push(`这一手他听过了——再开口，''更难''（DC +5）。`);
			if (ap.onFail?.att) { this.shift(pc, a.npc, ap.onFail.att); notes.push(`''他记住了。''（态度 下滑）`); }
			return notes;
		},
	};

	const Star = {
		budget: 4,          // 正路必要 3 次（塔内入过去 / 回现在取日记 / 宴会换哨）+ 1 次余量
		overBudget(pc) { return (pc?.star?.spent ?? 0) > this.budget; },
	};

	const Dragon = {
		hp: 60,
		// v17 补正 #3：封印术发动条件——把龙打到 sealAt 以下，守林人才能把最后一句念完
		sealAt: 10,
		bladeDamage: 10,   // 冒险者一剑能吃进去的量
		hitBase: 6,
		sneakHit: 12,
		rage: 0,
		dragonDamage(inv, round, defeats, poisoned) {
			return Items.battleDamage(round, inv, defeats, poisoned);
		},
		// 玩家一剑吃进去多少（A1：行囊里有剑就多一分）
		bladeOf(pc) {
			return this.bladeDamage + Gear.damageBonus(pc?.gear);
		},
	};

	return { Checks, Economy, Items, Gear, Combat, Social, Codex, Truth, Echoes, Choices, Systems, Shifts, Star, Dragon };
})();
