:: Resolve [script]
// ── 结算（sim，伞 #441 的 `40-sim` rank 落点）──────────────────────────────
// 为什么单独一个文件（#441-A）：把「算」从 widget 里剥出来——
//   · `rollSite`：**纯函数**，不写状态、不渲染 ⇒ 可在 **node** 里直接驱动（不经浏览器）
//   · `resolve` ：薄封装，多一步「写结果槽 `$last_check`」（段落分支读它）＝ sim 侧
// 现状只有位点检定一条；战斗（`fightact`）与交涉（`socresolve`）在 #441-A 的后续批次按同一形状接上。
// 依赖：`10-core.twee`（Game.Rules / Game.Rules.rng）＋ `15-tables.twee`（**只经 `Sg.story` 取故事数据**）。
// #459 切片三：位点表／情报捷径／战斗动作表已改走 `Sg.story.checkSite/checkKnowledge/combatAction`——
// 本文件搬进 `src/engine/**` 后**不再直读故事表**（⚠️ 层间门按字面量匹配，这里曾用别名 `T.Game` 躲过它，
// 所以"门绿"不等于边界成立；本文件的证据是"真的没有直读"，见 PR）。
// 命名根：挂 `Game.Checks.*`（数据/规则 ⇒ Game.*，见 docs/dev-conventions.md §7）。
Object.assign((window.Game.Checks ??= {}), {
	// 位点判定的**算**：查位点表 → 推导优势/劣势（道具·行囊·情报·位点自带）→ 掷骰
	// 纯函数：`pc` 只读、不碰 `State`、不渲染 ⇒ node 侧注入 `Game.Rules.rng` 即可复算成败。
	rollSite(site, pc, advArg) {
		const T = window.Game;
		// #459 切片三：故事**数据**经接入契约取（`Sg.story.checkSite`；未登记由它 fail-loud 报错）
		const s = window.Sg.story.checkSite(site);
		let adv = advArg, why = '', why2 = '';
		if (!adv) {
			const item = T.Items.advSource(site, pc.inv, pc.gear);
			if (item) { adv = 'adv'; why = (T.Items.advAt(site, { [item]: true }) ? '道具' : '行囊') + item; }
		}
		if (!adv) {
			const kn = window.Sg.story.checkKnowledge(site);
			if (kn && pc.world?.[kn.flag]) { adv = 'adv'; why = '情报·' + kn.why; }
		}
		if (!adv && s.dis) { adv = 'dis'; why2 = s.disWhy ?? '这一手本来就悬'; }
		const opt = {
			adv: adv === 'adv' ? 1 : adv === 'dis' ? -1 : 0,
			bonus: 0, nat: s.nat ?? 0, site, advWhy: why, disWhy: why2,
		};
		return s.abil ? T.Rules.save(pc, s.abil, s.dc, opt) : T.Rules.check(pc, s.skill, s.dc, opt);
	},
	// sim 侧入口：算完把结果写进**结果槽**（`$last_check`——段落分支与 `<<snapshot>>` 读它）
	resolve(site, pc, advArg) {
		const res = this.rollSite(site, pc, advArg);
		State.variables.last_check = res;
		return res;
	},
});

// ── 战斗回合的「算」（#441-A 第二刀）──────────────────────────────────────
// 现状问题：`<<fightpanel>>` 的 link 体里 `<<set $pc.ev.fight.act>>` ＋ `<<fightact>>` ——
// **点一下既算又画**（T 席在 `#441` 上点名的那处）。现在拆成两段：
//   · `pick`／`ensureOffer`：面板点击的落点（state 写在 sim 侧，面板只调）
//   · `resolvePlayer`／`resolveFoe`：两段式结算（保留原本的**渲染顺序**：玩家骰面 → 玩家受伤闪光 →
//     对手骰面 → 挨打闪光；`<<damage>>` 仍由 present 调，它是结算词汇宏）
// 两段式而不是一次性：玩家受伤后的 `hp` 决定对手那一轮是否发生，而 `hp` 由 present 的 `<<damage>>` 落，
// 拆成两段才能让「渲染顺序」与「hp 时序」同时与旧实现逐字一致。
Object.assign((window.Game.Combat ??= {}), {
	// 面板惰性抽牌（下一页没抽过就抽）——旧实现是 `<<set _f.offer to …>>`（`_f` 是 state 的别名 ⇒ 也是写状态）
	ensureOffer(pc) {
		const T = window.Game, f = pc.ev.fight;
		if (f && f.offer.length === 0) f.offer = T.Combat.offer(f.pool, f.round, pc, f.last?.act);
	},
	// 点下第 idx 张牌：只写「这一手是什么」，结算留给 `resolvePlayer`
	// 命名注意：**不能叫 `pick`**——`Game.Combat.pick(actionId, res)` 已被「动作档位求值」占用
	//（`playerEff` 在用它）；同名会被本 Object.assign 覆盖 ⇒ 2026-09-13 实测踩过（回合结算当场炸）。
	chooseAction(pc, idx) { pc.ev.fight.act = pc.ev.fight.offer[idx]; },
	// 玩家这一手：掷骰（写 `$last_check`）→ 结算 → 写台账。返回 `{ check, hurt, log }`
	// `hurt` 由 present 的 `<<damage>>` 落（不在此处扣 hp）——保住旧的渲染/时序完全一致。
	resolvePlayer(pc, foeSite, isDragon) {
		const T = window.Game, f = pc.ev.fight;
		const a = window.Sg.story.combatAction(f.act);   // #459 切片三：故事数据经契约
		const check = T.Checks.resolve(a.site, pc, f.adv ? 'adv' : null);
		const hadAdv = (f.adv ?? 0) > 0;
		// #352：优势在**被这一手消费后**才清零（旧实现放在本轮末尾清零 → 准备动作的「下一击有优势」当场作废）
		f.adv = 0;
		const r = T.Combat.playerEff(f.act, check, pc);
		const eff = r.eff ?? {};
		f.last = { act: f.act, kind: r.kind, text: eff.text, dmg: eff.dmg ?? 0, hurt: eff.hurt ?? 0, adv: eff.adv ?? 0, guard: eff.guard ?? 0 };
		const log = {
			you: {
				label: a.label, kind: r.kind, text: eff.text, dmg: eff.dmg ?? 0,
				gearBonus: r.gearBonus ?? 0, gearName: T.Gear.damageSource(pc.gear),
				adv: eff.adv ?? 0, guard: eff.guard ?? 0, hurt: eff.hurt ?? 0,
				skipFoe: eff.skipFoe ?? false, goodNote: r.goodNote ?? '', rolledWithAdv: hadAdv,
			},
			foe: null,
		};
		T.Combat.applyEffect(pc, eff, f);
		f.act = null;
		return { check, hurt: eff.hurt ?? 0, log };
	},
	// 对手那一轮 ＋ 收尾（轮次/下一轮牌/清 guard 与 skipFoe/落台账）。**无论 hp 是否归零都要走收尾**
	// （旧实现里收尾在 `if ($pc.hp gt 0)` 之外）。对手检定未发生时 `check` 为 null。
	/** `#493` 接缝（片 A-2：**回落已删**）：**对手／boss 状态**的取值口——引擎**不知道**故事状态叫什么名字，
	 *  一律经 `Sg.story.foeState(pc)` 取（缺声明 ⇒ 大声报错，不静默造一个空对象）。 */
	foeState(pc) {
		const f = window.Sg?.story?.foeState;
		if (typeof f !== 'function') throw new Error('Game.Combat.foeState：故事未声明 `Sg.story.foeState(pc)`（结构缺失必须报错，#493／#459）');
		return f(pc);
	},
	resolveFoe(pc, foeSite, isDragon, log) {
		const T = window.Game, f = pc.ev.fight;
		let check = null, hurt = 0;
		// #486（S1）：受击再过一道「掷部位 ⇒ 护具吸伤/耐久 ⇒ 溢出落 HP」。
		// `mechanics()` 未启用时 `slotAbsorb` 返回 `null` ⇒ **原样返回**（显式降级，零行为变化）。
		const mitigate = (raw) => {
			const plan = T.Combat.slotAbsorb(pc, raw);
			if (!plan) return raw;
			if (plan.gear) pc.gearHp = { ...(pc.gearHp ?? {}), [plan.gear]: plan.gearHp };
			log.foe = { ...(log.foe ?? {}), slots: plan };   // 台账留证：打了哪个部位、被哪件吸了多少
			return plan.toHp;
		};
		if (pc.hp > 0) {
			if (f.skipFoe) {
				log.foe = { text: '这一轮它没有出手。' };
			} else {
				check = T.Checks.resolve(foeSite, pc, null);
				if (isDragon) {
					const F = T.Combat.foeState(pc);                      // `#493`：经接缝取（不再写死 pc.dragon）
					const raw = T.Combat.foeDamage(pc.inv, f.round, (F.defeats ?? 0) + 1, F.venom);
					const dmg = Math.max(1, raw - (f.guard ?? 0));
					if (check.success) {
						log.foe = { text: '你贴着地滚开了——它那一口咬在你刚才站的地方，石板裂了一层。' };
					} else {
						F.defeats = (F.defeats ?? 0) + 1;
						log.foe = { text: '它回手了——这一下你没能全躲开。' };
						hurt = mitigate(dmg);
					}
				} else if (check.success) {
					log.foe = { text: '它扑了个空，散在你刚才站的地方——没有追。' };
				} else {
					log.foe = { text: '它把你掀翻在地，又停住了。像在等你先动手。' };
					hurt = mitigate(T.Damage.shove);   // 原裸 `<<damage 5>>`；具名后仍同值（非档位值，见 15-tables 注）
				}
			}
		}
		f.round = (f.round ?? 1) + 1;
		// #350：下一轮的牌也在**点击时**抽定（渲染时抽＝读档重抽，玩家看到的选项会变）
		f.offer = T.Combat.offer(f.pool, f.round, pc, f.last?.act);
		f.guard = 0;
		f.skipFoe = false;
		f.log = log;
		return { check, hurt, log };
	},
});

// ── 经济事件的「落帐」与文案（#441-A 第三刀）──────────────────────────────
// 为什么要抽：`<<econ>>` 原本把「算价 ＋ 落金币 ＋ 落 gives ＋ 渲染文案」挤在一个 widget 里，
// 而 `<<socresolve>>` 要**在自己的分支里**调它（筹码那一支）⇒ 想让社交回合能在 node 里驱动，
// 就得把「落帐」抽成 sim 函数；文案格式抽成 `note()`（**单一源**，否则两处各写一份必漂）。
Object.assign((window.Game.Economy ??= {}), {
	// `#660` 片三-1：**事件表只经接入契约取**（`Sg.story.econEvents()`）——引擎不再直读故事的 `events` 成员。
	// 为什么：`events` 是**故事数据**（每个故事一张事件表），引擎直读它＝边界破了（成员档门会咬，见 `--engine-story-free`）。
	// 结构缺失 **fail-loud**（故事没注册 ⇒ 报错），不静默当空表——`<<econ>>` 静默不生效是最难查的那类故障。
	econEvents() {
		const f = window.Sg?.story?.econEvents;
		if (typeof f !== 'function') throw new Error('Game.Economy：故事未注册 `Sg.story.econEvents()`（接入契约；结构缺失必须报错，#660）');
		return f() ?? {};
	},
	// sim：算价 → 落金币 → 落 gives。返回 `{ delta }`（供 present 渲染文案）
	apply(pc, id) {
		const ev = this.econEvents()[id];
		const d = this.priceOf(id, pc);
		pc.gold = pc.gold + d;
		if (ev?.gives) {
			for (const [k, v] of Object.entries(ev.gives)) {
				if (Array.isArray(v)) pc[k] = [...(pc[k] ?? []), ...v.filter((x) => !(pc[k] ?? []).includes(x))];
				else pc[k] = (pc[k] ?? 0) + v;
			}
		}
		return { delta: d };
	},
	// present：金额文案（`<<econ>>` widget 与 `<<socresolve>>` 共用此一处）
	note(d) { return `（${d < 0 ? `金币 ${d}` : d > 0 ? `金币 +${d}` : '——'}）`; },
});

// ── 交涉回合的「算」（#441-A 第三刀）──────────────────────────────────────
// 现状：`<<socresolve>>` 是「算 ＋ 写」的 sim widget；它**唯一渲染的东西**是筹码那一支里的 `<<econ>>` 文案。
// 抽出后：状态写点全在 sim；widget 只剩「调 sim ＋ 渲染那一句文案」⇒ `test/social-lever.mjs` 可以不经浏览器驱动。
// ⚠️ 顺序敏感：`econ` 原本在 `shift`／`apply` **之前**（`priceOf` 可能吃 `apply` 落的旗标折扣）——
//    本实现**保持原顺序**（econ 先落、`apply` 后调），别为了「看起来整齐」把它挪位。
Object.assign((window.Game.Social ??= {}), {
	// 返回 `{ econ: { delta } | null }`；`null`＝这次点击不该结算（`$pc.ev.soc` 与 ask 不匹配）
	resolveAsk(pc, askId, how) {
		const T = window.Game, S = T.Social;
		const a = S.ask(askId);
		if (!a || !pc.ev.soc || pc.ev.soc.id !== a.id) return null;
		if (!pc.ev.soc_last) pc.ev.soc_last = {};
		let econ = null;
		const h = String(how ?? '');
		if (h === 'will') {
			a.apply(pc);
			pc.ev.soc_last[a.id] = { kind: 'will', text: a.will };
		} else if (h.startsWith('lever:')) {
			const lv = S.levers(a, pc).find((l) => l.id === h.slice(6));
			if (lv) {
				if (lv.gives === 'adv') {
					// #360：优势筹码只把「这一问更有把握」摆出来——**不完成诉求**。
					pc.ev.soc_lever = lv.id;
					pc.ev.soc_last[a.id] = { kind: 'lever', text: '你把筹码摆了出来：' + lv.name + '。他看了一眼，没有立刻接话。', notes: ['下一掷有优势（' + lv.note + '）'] };
				} else {
					if (lv.econ) econ = { delta: T.Economy.apply(pc, lv.econ).delta };
					S.shift(pc, a.npc, 1);
					a.apply(pc);
					pc.ev.soc_last[a.id] = { kind: 'auto', text: a.auto, notes: ['拿出了筹码：' + lv.name] };
				}
			}
		} else if (h.startsWith('site:')) {
			const site = h.slice(5);
			const dc = S.dcOf(a, site, pc);
			let lv = S.levers(a, pc).find((l) => l.id === pc.ev.soc_lever);
			if (!lv) lv = S.levers(a, pc).find((l) => l.gives === 'adv' && !l.econ);
			const res = S.roll(pc, site, dc, lv?.note ?? '');
			pc.ev.soc_lever = null;
			pc.ev.last_roll = res;
			if (res.success) {
				a.apply(pc);
				pc.ev.soc_last[a.id] = { kind: 'ok', text: a.ok, notes: S.settle(a, pc, site, res.roll === 20 ? 'crit' : 'ok') };
			} else {
				pc.ev.soc_last[a.id] = { kind: 'bad', text: a.bad, notes: S.settle(a, pc, site, 'bad') };
			}
		}
		pc.ev.soc = null;
		return { econ };
	},
});

// ── #512：机制从故事文件（`15-tables.twee`）搬进 sim ────────────────────────────────
// 为什么搬：这些是**机制**（取数/结算），却住在故事文件里 ⇒ 引擎侧只能"往上"调故事实现（层间方向反了）。
// 搬法：**公开面一字不动**（同名同命名空间 ⇒ 调用方无感），只把**数据读取**改走 `Sg.story.*`。
// 零行为变化由 `audit:golden`（逐字节）＋ `npm test`＋`soak` 兜住；`Sg.story` 的缺省语义与原文逐条对齐
// （`?? null` 对应 `this.defs[k]?.x`；`?? []` 对应 `this.pools[...] ?? []`；只有必需数值 fail-loud）。
// ⚠️ 两个**有意留在故事侧**的（本片不搬，另票）：
//   ① `Combat.offer` —— 它用 `Math.random()`，而 sim 有既有的门「不得直调 `Math.random()`」
//      （`test/resolve-node.mjs` ④ 实测会咬）。改成 `Game.Rules.rng.d(n)-1`（同公式）在**浏览器/jsdom** 下等价，
//      但会让 `--combat`／`--dragon` 的蒙特卡洛在 node 侧从"真随机"变成"必须先注入 rng" ⇒ 那是**另一个自变量**
//      （会改这两道门的输出与 golden）⇒ 按单变量纪律本片不动，另开票处理"注入 rng ＋ 重签蒙特卡洛基线"。
//      ⇒ 本片后 sim 仍调 `Game.Combat.offer` 一处（`STORY_SYMBOLS` 不含它 ⇒ 层间判据 0 命中，但架构上仍是"引擎调故事机制"✗）。
//   ② `Combat.eligible` 已随本片搬入 sim（`offer` 经 `this.eligible` 调用它 ⇒ 运行时同命名空间解析 ✓）。
Object.assign((window.Game.Gear ??= {}), {
	damageBonus(gear) {
		return (gear ?? []).reduce((a, k) => a + (window.Sg.story.gearDef(k)?.damage ?? 0), 0);
	},
	damageSource(gear) {
		return (gear ?? []).find((k) => (window.Sg.story.gearDef(k)?.damage ?? 0) > 0) ?? '';
	},
	advSource(site, gear) {
		return (gear ?? []).find((k) => (window.Sg.story.gearDef(k)?.advSites ?? []).includes(site)) ?? '';
	},
});
Object.assign((window.Game.Items ??= {}), {
	advAt(site, inv) {
		return !!window.Game.Items.advSource(site, inv);
	},
	advSource(site, inv, gear) {
		for (const k of Object.keys(inv ?? {})) {
			const e = window.Sg.story.itemEffect(k);
			if (e && (e.advSite === site || (e.advSites ?? []).includes(site))) return k;
		}
		return window.Game.Gear.advSource(site, gear);   // 行囊也能给优势（A1：火把）
	},
	battleDamage(round, inv, defeats, poisoned) {
		const held = Object.keys(inv ?? {}).filter((k) => window.Sg.story.itemEffect(k)?.flatDamageReduce);
		const flat = held.reduce((a, k) => a + window.Sg.story.itemEffect(k).flatDamageReduce, 0);
		const rage = poisoned ? 0 : Math.min(2, defeats ?? 0);   // #236：毒液压怒（它每一下都慢半拍——连败的火也压）；未涂毒＝连败递增封顶 +2
		const base = round >= 3 ? 6 : 4 + round;
		const poison = poisoned ? window.Sg.story.poisonReduce() : 0;
		return Math.max(1, base - flat - poison + rage);
	},
});
Object.assign((window.Game.Combat ??= {}), {
	// ⚠️ 为什么挂 `Combat` 而不是龙的命名空间：后者在 `STORY_SYMBOLS` 里是**整命名空间**类符号
	//（它主要是数据：hp/sealAt/entries…）⇒ 引擎侧往它上面挂**机制**会被层间门判（实测命中 1 处）。
	// 语义上它本来就是"这一回合龙的那一下"＝战斗结算 ⇒ 住 `Combat` 更对；调用方只有本文件一处，已同步。
	/** `#493` 片 A-2：改名（`dragonDamage` ⇒ **`foeDamage`**）＋**删回落** —— 这条公式是**故事政策**
	 *  （基准值／连败封顶／毒液压怒），引擎只经 `Sg.story.battleDamage(...)` 调它（缺声明 ⇒ 大声报错）。 */
	foeDamage(inv, round, defeats, poisoned) {
		const f = window.Sg?.story?.battleDamage;
		if (typeof f !== 'function') throw new Error('Game.Combat.foeDamage：故事未声明 `Sg.story.battleDamage(...)`（结构缺失必须报错，#493／#459）');
		return f(inv, round, defeats, poisoned);
	},
	eligible(poolId, pc) {
		const held = pc?.inv ?? {};
		return window.Sg.story.combatPool(poolId).filter((id) => {
			const need = window.Sg.story.combatAction(id)?.need;
			if (!need) return true;
			if (need.startsWith('inv:')) return !!held[need.slice(4)];
			if (need.startsWith('invAny:')) return need.slice(7).split('|').some((k) => held[k]);   // #250
			return true;
		});
	},
	// #519：从故事文件搬来（原用 `Math.random`）⇒ 改走可注入的 `Game.Rules.rng`；node 侧调用点须先注入。
	// 每轮给 3 个：排除条件不满足的、以及上一轮刚用过的
	// **共用**的「随机 n 选 1」（`#489` 判据 1：事件池与战斗池**同一套**选择机制——不另写一份随机）。
	// 纯函数（拷贝后 splice，不改入参）；走**可注入** rng。抽出来的理由：第二处（事件池）要用它，
	// 而「两处各写一份随机」正是本仓反复撞过的那类分散口径。
	pickN(list, n) {
		const poolCopy = [...list];
		const picked = [];
		const rng = window.Game.Rules.rng;                        // 唯一随机入口（node 未注入 ⇒ 大声报错）
		while (picked.length < n && poolCopy.length) {
			const i = Math.min(poolCopy.length - 1, rng.d(poolCopy.length) - 1);
			picked.push(poolCopy.splice(i, 1)[0]);
		}
		return picked;
	},
	offer(poolId, round, pc, lastUsed) {
		let list = this.eligible(poolId, pc).filter((id) => id !== lastUsed);
		if (list.length < 3) list = this.eligible(poolId, pc);
		const picked = this.pickN(list, 3);                       // #489：走**共用**选择机制
		// `#493` 接缝：故事可声明"这一手必须给谁"（`Sg.story.combatPrepick(poolId, round, pc, picked)`），
		// 引擎就不必认识池名与动作名。**未声明时回落旧硬编码分支**（过渡期逐字一致）。
		// `#493` 片 A-2：**回落已删** —— 池名/动作名不再出现在引擎里（故事声明 `Sg.story.combatPrepick` 决定给哪一手）。
		const pre = window.Sg?.story?.combatPrepick?.(poolId, round ?? 1, pc, picked) ?? null;
		if (pre && !picked.includes(pre)) picked[picked.length - 1] = pre;
		return [...new Set(picked)];
	},
	// ── S4（`#489`）：通用事件池 ＋ 线索三选一 ─────────────────────────
	// 契约（声明面）：`mechanics().roads[i] = { from:number, to:number, options:[{kind,hint,noCheck?}] }`
	//   · 三选一只定**事件类型**（已定 ①）；事件**内部那一次判定**由内容面接线（S5）；
	//   · 判据 1）三选一与战斗池走**同一个** `pickN`；2）同段三路线索两两不等价（口径在 lib：`story-shape.mjs`）；
	//     3）“无判定选项”与“不死档”是**声明属性**（也由 lib 单权威判定，本块只消费）。
	roadsDecl() { return this.slotsDecl()?.roads ?? null; },
	/** 一段路的「三选一」：从该段 options 里随机取 3 个（`exclude` ＝ 本段已经出现过的类型不重复）。 */
	roadOffer(idx, exclude = []) {
		const roads = this.roadsDecl();
		if (!roads) return null;                                  // 未启用 ⇒ 调用方不调（显式降级）
		const road = roads[idx - 1];                              // 段号**从 1 计**（与声明里的 from/to 一致）
		if (!road) throw new Error(`Game.Combat.roadOffer：本故事没有第 ${idx} 段路（可用 1..${roads.length}，#489）`);
		let all = road.options ?? [];
		// `#491` 判据 10（已定 ⑩）：`?pool=a,b` 只从这些**事件类型**里出（**调试开关**，不进玩家 UI）；
		// 命中即**照用**（不足 3 条也照用：调试开关的意图就是"只让我要的那几类出现"——放宽"三选一"是**有意**的，
		// 它只在 URL 带 `?pool=` 时发生，玩家侧不可见）；一条都没命中（写错类型名）才回退全量，避免把路走成死档。
		const wanted = window.Game?.Rules?.debug?.pool;
		if (Array.isArray(wanted) && wanted.length) {
			const only = all.filter((o) => wanted.includes(o?.kind));
			if (only.length) all = only;
		}
		const filtered = all.filter((o) => !exclude.includes(o?.kind));
		return this.pickN(filtered.length >= 3 ? filtered : all, 3);   // 与战斗池同一套选择机制
	},
	// ── S1（`#486`）：部位 · 耐久 · 保护关系 ───────────────────────────────
	// 契约：**故事只声明**（`Sg.story.mechanics()`：`hitLocations` / `slots[*].protects` /
	// `equipment[*].{slot,maxHp,reduce}`——形状权威＝`scripts/audit/lib/story-shape.mjs`，`#459`），
	// **机制全在引擎**（本块）。`mechanics()` 为 `null` ⇒ 本块**一律不被调用** ⇒ 旧路径不变（#492 显式降级）。
	// 状态：`pc.gearHp = { 具名: 剩余耐久 }`（缺项＝满耐久；0 ⇒ 损坏）。
	slotsDecl() { return window.Sg.story.mechanics?.() ?? null; },
	gearHpOf(pc, mech, gearName) {
		const max = mech?.equipment?.[gearName]?.maxHp ?? 0;
		const cur = pc?.gearHp?.[gearName];
		return typeof cur === 'number' ? cur : max;
	},
	/** `#703`：侧栏（`StoryCaption`）用的**只读快照**——装备耐久与部位异常此前**全仓零渲染**（数据早就在状态里）。
	 *  只算不写（渲染路径不得改状态，`#315` 契约）；未启用新机制的故事（故事 1／最小示例）⇒ 空列表 ⇒ 侧栏整块不出现。 */
	gearDurability(pc) {
		const mech = this.slotsDecl();
		if (!mech) return [];
		return (pc?.gear ?? []).filter((g) => mech.equipment?.[g]).map((g) => {
			const max = mech.equipment[g].maxHp ?? 0;
			const cur = this.gearHpOf(pc, mech, g);
			return { name: g, cur, max, broken: cur <= 0 };
		});
	},
	statusEntries(pc) {
		const mech = this.slotsDecl();
		if (!mech) return [];
		const out = [];
		for (const [part, map] of Object.entries(pc?.statuses ?? {})) {
			for (const [id, turns] of Object.entries(map ?? {})) out.push({ part, id, label: mech.statuses?.[id]?.label ?? id, turns });
		}
		return out;
	},

	// 受击（指定部位）：该部位有护具就按声明减成（本片只落 `flat`）⇒ 余量由该件**耐久吸收**，
	// 溢出量落 HP；耐久 ≤ 0 ⇒ **损坏**（`reduce` 归 0 且不再吸伤）。**纯函数**：只返回计划，不写 `pc`。
	// （S2 需要「指定部位」的形态：异常结算的"该部位受伤"不该另掷一个部位 ⇒ 抽出本方法。）
	slotAbsorbAt(pc, part, hurt) {
		const mech = this.slotsDecl();
		if (!mech) return null;                                   // 未启用 ⇒ 调用方走旧路径
		const worn = (pc?.gear ?? []).filter((g) => g && mech.equipment?.[g]);
		const gearName = worn.find((g) => (mech.slots?.[mech.equipment[g].slot]?.protects ?? null) === part) ?? null;
		if (!gearName) return { part, gear: null, reduce: 0, absorbed: 0, toHp: hurt, gearHp: null, broke: false };
		const def = mech.equipment[gearName];
		const form = Object.keys(def.reduce ?? {})[0];
		if (form !== 'flat') throw new Error(`Game.Combat.slotAbsorb：减成形态「${form}」本片未实现（已实现：flat）——声明面不得大于实现面（#486）`);
		const hp0 = this.gearHpOf(pc, mech, gearName);
		if (hp0 <= 0) return { part, gear: gearName, reduce: 0, absorbed: 0, toHp: hurt, gearHp: 0, broke: true };   // 已损坏：不吸伤、不减成
		const reduce = def.reduce.flat ?? 0;
		const after = Math.max(0, hurt - reduce);
		const absorbed = Math.min(hp0, after);
		const hp1 = hp0 - absorbed;
		return { part, gear: gearName, reduce, absorbed, toHp: after - absorbed, gearHp: hp1, broke: hp1 <= 0 };
	},
	// 受击（掷部位，走**可注入** rng）：掷出部位后交给 `slotAbsorbAt`。
	slotAbsorb(pc, hurt) {
		const mech = this.slotsDecl();
		if (!mech) return null;
		const parts = mech.hitLocations ?? [];
		const rng = window.Game.Rules.rng;                        // 唯一随机入口（node 未注入 ⇒ 大声报错）
		const part = parts[Math.min(parts.length - 1, rng.d(parts.length) - 1)];
		return this.slotAbsorbAt(pc, part, hurt);
	},
	// 判定失败的耐久扣减（S1 已定 ④：**掷骰** −1 或 −2）；返回计划，不写 `pc`。
	gearWear(pc, gearName) {
		const mech = this.slotsDecl();
		if (!mech || !mech.equipment?.[gearName]) return null;
		const loss = window.Game.Rules.rng.d(2);                   // 1..2（已定 ④：不设"直接损坏"档）
		const from = this.gearHpOf(pc, mech, gearName);
		return { gear: gearName, loss, from, to: Math.max(0, from - loss) };
	},
	// 温泉（S1 已定 ④：v1 唯一修复点）——返回"满耐久表"；调用方写 `pc.gearHp`。
	repairAll(pc) {
		const mech = this.slotsDecl();
		if (!mech) return null;
		return Object.fromEntries(Object.entries(mech.equipment ?? {}).map(([n, d]) => [n, d.maxHp]));
	},
	// ── S2（`#487`）：部位 × 异常（每回合判定：恢复／恶化／受伤） ───────────────
	// 契约（声明面；形状权威＝`scripts/audit/lib/story-shape.mjs`）：
	//   `mechanics().statuses[id] = { parts:'*'|[部位…], turns:n, check:{attr,dc}, onFail:[{when,…}] }`
	//   `mechanics().statusPenalty['status@part'] = { check:n }`   ← 作用域：**该部位相关判定**
	// 状态：`pc.statuses = { 部位: { 异常: 剩余回合 } }`（缺项／0 ⇒ 不生效）
	// 顺序（已定 ⑤）：**回合开始 → 异常结算 → 玩家行动 → 敌人行动 → 回合推进**
	//   ⇒ `fightact` 在 `resolvePlayer` **之前**调一次 `tickStatuses`；本块**只算**，落 HP 仍由 present 的 `<<damage>>`。
	// `mechanics()` 为 `null` ⇒ 本块一律不被调用（`#492` 显式降级）。
	statusLowRoll: 5,      // 低骰分档阈值（设计稿 §2.3／§8 D4）：d20 原值 ≤ 5 ⇒ `low` 档，其余 ⇒ `most`
	statusParts(mech, id) {
		const st = mech?.statuses?.[id];
		if (!st) return [];
		return st.parts === '*' ? (mech.hitLocations ?? []) : (st.parts ?? []);
	},
	/** 枚举生效中的 `{ 部位, 异常, 剩余回合 }`。 */
	statusInstances(pc) {
		const out = [];
		for (const [part, bag] of Object.entries(pc?.statuses ?? {})) {
			for (const [id, turns] of Object.entries(bag ?? {})) if (turns > 0) out.push({ part, id, turns });
		}
		return out;
	},
	/** 该部位当前的判定减成（`statusPenalty['异常@部位']`；本片只认 `check` 键，其余形态报错）。 */
	statusPenaltyFor(pc, part, mech = this.slotsDecl()) {
		let sum = 0;
		for (const { id } of this.statusInstances(pc)) {
			if (!this.statusParts(mech, id).includes(part)) continue;
			const pen = mech.statusPenalty?.[`${id}@${part}`];
			if (!pen) continue;
			for (const [k, v] of Object.entries(pen)) {
				if (k !== 'check' || typeof v !== 'number') throw new Error(`Game.Combat.statusPenaltyFor：statusPenalty['${id}@${part}'] 的键「${k}」本片未实现（只认 check:number）——声明面不得大于实现面（#487）`);
				sum += v;
			}
		}
		return sum;
	},
	/** 骰式：**纯整数**（`N`，固定伤害）· **`NdM`** · **`NdM±K`**（`#702` 5e 对齐新增：伤害骰 ＋ 属性调整，如 `1d8+3`）。
	 *  其余形态（`1d4+2d6`、`abc`…）**报错**：声明面不得大于实现面（#487／#702）。 */
	rollDice(expr) {
		const m = /^(\d+)(?:d(\d+))?(?:([+-])(\d+))?$/.exec(String(expr ?? ''));
		if (!m) throw new Error(`Game.Combat.rollDice：只认 \`N\`／\`NdM\`／\`NdM±K\`（收到 ${JSON.stringify(expr)}）——声明面不得大于实现面（#487／#702）`);
		const n = Number(m[1]);
		const flat = m[3] ? (m[3] === '-' ? -1 : 1) * Number(m[4]) : 0;   // 属性调整
		if (!m[2]) return n + flat;                                      // 纯整数（可带调整）
		const rng = window.Game.Rules.rng;
		let sum = 0;
		for (let i = 0; i < n; i++) sum += rng.d(Number(m[2]));
		return sum + flat;
	},
	/** `onFail` 一档的**效果**（本片只认两种；随机目标在**算**里就落定 ⇒ 计划完整、可复算）。 */
	statusEffect(entry, mech, excludeId) {
		if (entry?.harm === 'damage') return { kind: 'damage', amount: this.rollDice(entry.dice ?? '1') };
		if (entry?.addStatus === 'random') {
			const ids = Object.keys(mech.statuses ?? {}).filter((x) => x !== excludeId);
			if (!ids.length) return { kind: 'none' };
			const rng = window.Game.Rules.rng;
			const id = ids[Math.min(ids.length - 1, rng.d(ids.length) - 1)];
			const parts = this.statusParts(mech, id);
			const part = entry.part === 'random' ? parts[Math.min(parts.length - 1, rng.d(parts.length) - 1)] : entry.part;
			return { kind: 'addStatus', id, part, turns: mech.statuses[id].turns };
		}
		throw new Error(`Game.Combat.statusTick：onFail 效果形态未实现（本片只认 harm:'damage'+dice ／ addStatus:'random'）——声明面不得大于实现面（#487）`);
	},
	/** **纯函数**：一回合的异常结算计划（不写 `pc`）。逐 (部位 × 异常) 各判定一次：
	 *  每回合被动（`perRound.hp`）⇒ 该部位扣 HP（走 S1 的减成/耐久）→ 判定 ⇒ 成功恢复（−1，到 0 清）／失败按分档出效果。 */
	statusTick(pc) {
		const mech = this.slotsDecl();
		if (!mech) return null;                                   // 未启用 ⇒ 调用方不调（显式降级）
		const statuses = mech.statuses ?? {};
		const steps = [];
		for (const { part, id, turns } of this.statusInstances(pc)) {
			const st = statuses[id];
			if (!st) throw new Error(`Game.Combat.statusTick：状态「${id}」不在声明表里（结构缺失必须报错，#487）`);
			if (!(typeof st.turns === 'number' && st.turns > 0)) throw new Error(`Game.Combat.statusTick：状态「${id}」缺 \`turns\`（正数）——持续回合必须可声明（#487）`);
			const per = st.perRound?.hp;
			if (per !== undefined && typeof per !== 'number') throw new Error(`Game.Combat.statusTick：状态「${id}」的 \`perRound.hp\` 必须是数字（#487）`);
			const res = window.Game.Rules.save(pc, st.check.attr, st.check.dc, { bonus: this.statusPenaltyFor(pc, part, mech) });
			const step = { part, id, res, perRound: typeof per === 'number' ? per : 0 };
			if (res.success) { step.kind = 'recover'; step.turns = turns - 1; steps.push(step); continue; }
			const grade = res.roll <= this.statusLowRoll ? 'low' : 'most';
			const entry = (st.onFail ?? []).find((x) => x.when === grade);
			if (!entry) throw new Error(`Game.Combat.statusTick：状态「${id}」缺「${grade}」档（分档必须穷尽，#459）`);
			step.kind = 'fail'; step.grade = grade; step.effect = this.statusEffect(entry, mech, id);
			steps.push(step);
		}
		return { steps };
	},
	/** 把计划**落**成新状态 ＋ 本回合要落 HP 的伤害（新状态返回，**不直接改调用方对象**）。 */
	statusTickApply(pc, plan) {
		if (!plan) return null;
		const mech = this.slotsDecl();
		const next = {};
		for (const [part, bag] of Object.entries(pc?.statuses ?? {})) next[part] = { ...bag };
		const drop = (part, id) => { if (next[part]) { delete next[part][id]; if (!Object.keys(next[part]).length) delete next[part]; } };
		const put = (part, id, turns) => { next[part] = { ...(next[part] ?? {}), [id]: turns }; };
		let hurt = 0;
		const hits = [];
		for (const s of plan.steps) {
			if (s.perRound) {
				const at = this.slotAbsorbAt(pc, s.part, Math.abs(s.perRound));   // 每回合被动也走 S1 的减成/耐久
				if (at?.gear) pc.gearHp = { ...(pc.gearHp ?? {}), [at.gear]: at.gearHp };
				hits.push({ part: s.part, from: s.id, ...at });
				hurt += at ? at.toHp : Math.abs(s.perRound);
			}
			if (s.kind === 'recover') { if (s.turns > 0) put(s.part, s.id, s.turns); else drop(s.part, s.id); continue; }
			if (s.effect?.kind === 'damage') {
				const at = this.slotAbsorbAt(pc, s.part, s.effect.amount);
				if (at?.gear) pc.gearHp = { ...(pc.gearHp ?? {}), [at.gear]: at.gearHp };
				hits.push({ part: s.part, from: s.id, ...at });
				hurt += at ? at.toHp : s.effect.amount;
			} else if (s.effect?.kind === 'addStatus') {
				put(s.effect.part, s.effect.id, s.effect.turns);
			}
		}
		return { statuses: next, hurt, hits };
	},
	/** 施加一个异常（内容面/失败分档用）：部位必须在声明允许范围内，否则报错。 */
	applyStatus(pc, id, part) {
		const mech = this.slotsDecl();
		if (!mech) return null;
		const st = mech.statuses?.[id];
		if (!st) throw new Error(`Game.Combat.applyStatus：状态「${id}」未声明（结构缺失必须报错，#487）`);
		if (!this.statusParts(mech, id).includes(part)) throw new Error(`Game.Combat.applyStatus：「${id}」不允许落在「${part}」（仅限部位是声明的一部分，#487）`);
		return { statuses: { ...(pc?.statuses ?? {}), [part]: { ...(pc.statuses?.[part] ?? {}), [id]: st.turns } } };
	},
	/** 解除（消耗品路径）：按异常 id 清（`S5` 的消耗品调它；物品↔异常映射属故事数据）。 */
	cureStatus(pc, id) {
		const next = {};
		for (const [part, bag] of Object.entries(pc?.statuses ?? {})) { const b = { ...bag }; delete b[id]; if (Object.keys(b).length) next[part] = b; }
		return { statuses: next };
	},
	/** 温泉（已定 ⑤：清全部——与 S1 的 `repairAll` 同一处场景，一起用）。 */
	clearStatuses() { return { statuses: {} }; },
	/** 回合开始「算 ＋ 落」一步到位：写 `pc.statuses`，返回本回合因异常落 HP 的量
	 *（present 用 `<<damage>>` 落，与其他伤害同一处）。未启用 ⇒ 返回 `null`（调用方跳过）。 */
	tickStatuses(pc) {
		const plan = this.statusTick(pc);
		if (!plan) return null;
		const applied = this.statusTickApply(pc, plan);
		pc.statuses = applied.statuses;
		return { hurt: applied.hurt, hits: applied.hits, steps: plan.steps };
	},
	// ── S3（`#488`）：波次战斗 ＋ 失败重置 ─────────────────────────────
	// 契约（声明面，`#459` 已声明）：`mechanics().encounters[id] = { waves:[{pool,difficulty,reinforce?}], rewardsScale? }`
	//   · 短＝乘 1 批、长＝乘 2 批（第二批 difficulty 更大 ＋ `reinforce:true`）——形状门在校验；
	//   · **已定 ②的常数就是引擎口径**：短＝单次判定定胜负（1 回合·1 命中即可）；
	//     长＝**3 回合上限 ＋ 3 次成功**（每批各自计）；回合用尽未倒 ⇒ 判负。
	// 状态：`pc.ev.fight.wave = { encounter, idx, hits, rounds }`（**不新增顶层键** ⇒ 不牵动 `--state` 域表）。
	// `mechanics()` 为 `null` ⇒ 本块一律不被调用（`#492` 显式降级）。
	wavePlan(id) {
		const mech = this.slotsDecl();
		if (!mech) return null;                                  // 未启用 ⇒ 调用方不调
		const enc = mech.encounters?.[id];
		if (!enc) throw new Error(`Game.Combat.wavePlan：遭遇「${id}」未声明（结构缺失必须报错，#488）`);
		const waves = enc.waves ?? [];
		if (waves.length !== 1 && waves.length !== 2) throw new Error(`Game.Combat.wavePlan：遭遇「${id}」的批数必须是 1（短）或 2（长）——实际 ${waves.length}（#488）`);
		const long = waves.length === 2;
		return {
			id, waves: waves.map((wv) => ({ pool: wv.pool, difficulty: wv.difficulty, reinforce: !!wv.reinforce })),
			// `#599`（2026-09-14 口径定案）：长战斗**回合上限 3 → 5**，保留"需 3 次成功"——
			// 依据：① 保留"三击"＝长战斗的形，只松压力；② `#600` 必掉钥匙 × 0.74% 清完率自相矛盾；
			// ③ 候选里这是"保持结构、只改压力"的那档（改命中数＝改形）。两批清完率 ≈ 16.6%。
			long, rounds: long ? 5 : 1, hits: long ? 3 : 1,          // 两档只在"回合数"这一维正交（短＝1 回合·1 命中）
			rewardsScale: typeof enc.rewardsScale === 'number' ? enc.rewardsScale : 1,
		};
	},
	/** 开始一场带波次的遭遇（写 `pc.ev.fight.wave`）；返回本批的 `{ pool }` 供战斗 UI 用。 */
	waveBegin(pc, id) {
		const plan = this.wavePlan(id);
		if (!plan) return null;
		pc.ev.fight = { ...(pc.ev.fight ?? {}), wave: { encounter: id, idx: 1, hits: 0, rounds: 0 } };
		return { pool: plan.waves[0].pool, plan };
	},
	/** 记一次「本回合的命中/成败」；返回推进后的相位：`continue`／`advance`（增援）／`cleared`／`failed`。 */
	waveRecord(pc, success) {
		const w = pc?.ev?.fight?.wave;
		if (!w) throw new Error('Game.Combat.waveRecord：尚未 `waveBegin`（没有波次状态）——调用方先开局（#488）');
		const plan = this.wavePlan(w.encounter);
		w.rounds += 1;
		if (success) w.hits += 1;
		if (w.hits >= plan.hits) {
			if (w.idx >= plan.waves.length) return { phase: 'cleared', plan, wave: w, advance: false };
			w.idx += 1; w.hits = 0; w.rounds = 0;                  // **增援**：清完一批才进下一批，且下一批各自重置计数
			return { phase: 'advance', plan, wave: w, advance: true, pool: plan.waves[w.idx - 1].pool };
		}
		if (w.rounds >= plan.rounds) return { phase: 'failed', plan, wave: w, advance: false };
		return { phase: 'continue', plan, wave: w, advance: false };
	},
	/** 奖励曲线：难度越高奖励越大（**单调**可机检）——只给倍数，具体金币/道具属内容面（S5）。 */
	waveRewardScale(id, waveIdx = 1) {
		const plan = this.wavePlan(id);
		if (!plan) return null;
		const wv = plan.waves[Math.min(plan.waves.length - 1, Math.max(0, waveIdx - 1))];
		return plan.rewardsScale * wv.difficulty;                    // 线性：同一遭遇内随难度严格递增
	},
	/** 遭遇奖励的**归一化形状**（`#600`）：`reward = { gold, item }`，`item` 允许 `'道具'`（＝必掉）或 `{ id, chance }`。
	 *  为什么要有这个面：掉落规则以前只活在散文里（内容里各拄一遍 "读 reward.gold"），表里的声明与行为对不上也没人看得见。
	 *  ⇒ 现在**声明是单一权威**：内容只渲染、门按它判、掉落按它掷。
	 *  结构问题 **fail-loud**（未登记的道具属故事面，由 `--waves` 对账；这里只管形状），因为静默当"不掉"正是本仓反复踩的那类。 */
	/** 参数：
	 * @param {string} id 遭遇 id
	 * @returns {{ gold: number, item: { id: string, chance: number } | null }}
	 */
	encounterReward(id) {
		const enc = this.slotsDecl()?.encounters?.[id];
		if (!enc) return { gold: 0, item: null };
		const r = enc.reward ?? {};
		const gold = typeof r.gold === 'number' && r.gold > 0 ? r.gold : 0;
		let item = null;
		if (r.item != null) {
			const o = typeof r.item === 'string' ? { id: r.item, chance: 100 } : r.item;
			if (typeof o?.id !== 'string' || !o.id) throw new Error(`Game.Combat.encounterReward：encounters.${id}.reward.item 必须是道具名或 { id, chance }（拿到 ${JSON.stringify(r.item)}）——结构畸形必须报错（#600）`);
			const chance = o.chance ?? 100;
			if (!(typeof chance === 'number' && chance >= 1 && chance <= 100)) throw new Error(`Game.Combat.encounterReward：encounters.${id}.reward.item.chance 必须在 1..100（拿到 ${JSON.stringify(o.chance)}）——结构畸形必须报错（#600）`);
			item = { id: o.id, chance };
		}
		return { gold, item };
	},
	/** 遭遇的**失败笔记**（`#608`）：声明面 `encounters[id].failNote`（内容面数据），未声明 ⇒ `null`。
	 *  与 `encounterReward` 同族：**机制住引擎、数据住故事**——短战斗 widget 落败时按它写笔记。 */
	encounterFailNote(id) {
		const enc = this.slotsDecl()?.encounters?.[id];
		const n = enc?.failNote;
		if (n == null) return null;
		if (typeof n !== 'string' || !n) throw new Error(`Game.Combat.encounterFailNote：encounters.${id}.failNote 必须是非空字符串（拿到 ${JSON.stringify(n)}）——结构畸形必须报错（#608）`);
		return n;
	},
	/** 结算一次遭遇奖励：落金币 ＋ 按 `chance` 掷掉落（写 `pc.inv`）。**返回本次真的给了什么**（文案按返回值渲染）。
	 *  · `rng` 可注入（测试用）；默认走 `Game.Rules.rng.d(100)`（受 `?seed=` 影响 ⇒ 可复算）。
	 *  · 幂等：道具是 `pc.inv[id] = true`（重复给不报错，与 `<<give>>` 同口径）；金币按次累加。
	 *  · 单一落点：内容不许再自己读 `reward.gold`／自己掷骰（`--waves` 有"声明 ↔ 内容对账"断言）。 */
	grantReward(pc, id, { rng } = {}) {
		const { gold, item } = this.encounterReward(id);
		if (gold > 0) pc.gold = (pc.gold ?? 0) + gold;
		let got = null;
		if (item) {
			const roll = rng ? rng(1, 100) : window.Game.Rules.rng.d(100);
			if (roll <= item.chance) { pc.inv = pc.inv ?? {}; pc.inv[item.id] = true; got = item.id; }
		}
		return { gold, item: got };
	},
	/** 全灭判定（已定 ⑧：`reset` 只在**全灭**时触发；单步失败＝**带伤继续**）。 */
	runOver(pc) { return (pc?.hp ?? 1) <= 0; },
	/** 失败重置（已定 ⑧）：回出生点 ＋ **道具清零** ＋ 耐久/异常一并清；**保留**笔记/图鉴/已解锁。
	 *  返回被重置的字段清单（供门/UI 逐条核销）——`RESET_KEEPS` 是「**不清什么**」的显式声明。 */
	resetRun(pc) {
		const before = {
			inv: Object.keys(pc?.inv ?? {}).length,
			gearHp: Object.keys(pc?.gearHp ?? {}).length,
			statuses: Object.keys(pc?.statuses ?? {}).length,
		};
		pc.inv = {};
		pc.gearHp = {};
		pc.statuses = {};
		pc.hp = pc.max_hp ?? pc.hp;
		if (pc.ev) pc.ev.fight = null;                     // 瞬态战斗状态整块清（“回出生点”语义）
		return { reset: ['inv', 'gearHp', 'statuses', 'hp', 'ev.fight'], before, keeps: [...Game.Combat.RESET_KEEPS] };
	},
	/** 「**不清什么**」的显式声明（已定 ⑧）：清单本身就是判据面——门会逐项断言它们不受 `resetRun` 影响。 */
	RESET_KEEPS: ['ev', 'soc', 'star', 'dragon', 'world', 'Sg.notes', 'Sg.Codex', 'Sg.store'],
	pick(actionId, res) {
		const a = window.Sg.story.combatAction(actionId);
		const kind = res?.roll === 20 ? 'crit' : res?.success ? 'ok' : 'bad';
		return { kind, eff: a[kind] ?? {} };
	},
	playerEff(actionId, res, pc) {
		const r = window.Game.Combat.pick(actionId, res);
		const bonus = window.Game.Gear.damageBonus(pc?.gear);
		if (bonus && r.eff.dmg) {
			r.eff = { ...r.eff, dmg: r.eff.dmg + bonus };
			r.gearBonus = bonus;
		}
		// #250：好档升级（好哨＝原版玩具哨／持卷跟读）——克隆合并，不动动作表单源
		const g = window.Sg.story.combatAction(actionId)?.good;
		if (g && (!g.need || (g.need.startsWith('inv:') ? !!pc?.inv?.[g.need.slice(4)] : true))) {
			r.eff = {
				...r.eff,
				dmg: r.eff.dmg ? r.eff.dmg + (g.dmg ?? 0) : r.eff.dmg,
				skipFoe: g.skipFoe || r.eff.skipFoe,
			};
			r.goodNote = g.note;
		}
		return r;
	},
	applyEffect(pc, eff, fight) {
		const F = this.foeState(pc);                                   // `#493`：经接缝（不再写死 pc.dragon）
		if (eff.dmg) F.hp = Math.max(0, (F.hp ?? 0) - eff.dmg);
		if (eff.adv) fight.adv = (fight.adv ?? 0) + eff.adv;
		if (eff.guard) fight.guard = (fight.guard ?? 0) + eff.guard;
		if (eff.skipFoe) fight.skipFoe = true;
		if (eff.flee) fight.flee = true;
		if (eff.venom) F.venom = true;
		if (eff.flag) pc.ev[eff.flag] = true;
	},
});

// 注（`#460`）：本文件里的 `Object.assign((window.Game.X ??= {}), …)` 是**引擎自建容器**——
//   原先写的是 `Object.assign(window.Game.X, …)`，那些容器**只有故事 1 的 `15-tables.twee` 会建**
//   ⇒ 一个"只有引擎 ＋ 自己的段落"的故事在**加载期**就崩（`TypeError: Cannot convert undefined or null to object`）。
//   引擎不该依赖故事提供容器（`#512` 的方向）：`??=` 自建，故事只往里填数据。

// ── 条件表选择器（伞 #422 阶段 4／`#435`）——**引擎侧**机制，只经 `Sg.story.rules()` 取表 ──────────
// 归属（`#441` 结合面）：选择器与死规则门属**引擎层**（与故事内容无关）；表属**故事层**。
// 规则（`#435` 票面）：first-match wins，但**优先级只看显式 `prio`**（同 prio 按声明顺序**稳定**）——
// 不做"声明越靠前越优先"的隐式假设（那会让重排表变成行为变更）。
window.Sg ??= {};
window.Sg.rules = {
	// 表**只经故事注册的入口**取；结构缺失/畸形 ⇒ fail-loud（与 `Sg.notes.table()` 同一纪律）
	table() {
		const provide = window.Sg.story?.rules;
		if (typeof provide !== 'function') throw new Error('Sg.rules：故事未注册 `Sg.story.rules()`（接入契约 #436-b／#441-E）——结构缺失必须报错');
		const t = provide();
		if (!Array.isArray(t)) throw new Error('Sg.rules：`Sg.story.rules()` 必须返回**行数组**（拿到 ' + (t === null ? 'null' : typeof t) + '）');
		return t;
	},
	// **键形前缀的宣告**（`#435` 口径②，dev 的 `--rules` 判据会核对）：行里用了**未宣告**的前缀 ⇒ 红。
	// 为什么必须在引擎侧宣告：引擎不认的前缀会让条件**永假** ⇒ 行静默死掉，没有任何门看得见（本仓反复踩的那类）。
	prefixes: ['inv', 'era', 'gear'],   // `#624` 片四：`gear:<道具>`＝行囊/装备里有它（`$pc.gear.includes(…)` 的键形）
	// **引擎兑现的"面"**（`#435` Q1 拍板，与 `prefixes` 同轴的反沉默面）：行里用到的授予面必须是这里声明过的。
	// 为什么：被引擎忽略的声明＝**静默空转**——行看起来授予了，实际什么都没发生，而没有任何门看得见。
	// `yields`/`gives` 早于本机制（老面，不追溯）；`sets` 是新增面 ⇒ 用到就必须在这里宣告。
	effects: ['yields', 'gives', 'sets'],
	// **条件项的"对象算子"词表**（`#568`，与 `prefixes`／`effects` 同轴）：行里用了未宣告的算子 ⇒ `--rules` 判红。
	// 为什么必须由引擎宣告：引擎不认的算子会让条件**永假** ⇒ 行静默死掉（本仓反复踩的那类）。
	// 词表与门侧同一份口径（`scripts/audit/lib/shared.mjs` 的 `OPS`）；两侧漂移会被 `--rules` 当场抓住。
	ops: ['gte', 'lte', 'oneOf'],
	// **取值项**（`#624` 片二，与 `ops` 同轴的反沉默面）：条件里可以写"随状态变的值"，当前只有
	// `{ price: '<econ 事件 id>' }`（＝该事件**当前要花多少钱**，正数）。为什么要有它：可负担性判定
	// （`gold ≥ 价格`）原本只能在散文里算 ⇒ 那几处进不了表。用到的取值项必须在这里宣告（门核对）。
	terms: ['price'],
	// 取值项 → 数：`{ price: id }` ⇒ `-Game.Economy.priceOf(id, pc)`（事件价是**负增量**，取正数＝要花的钱）；
	// 字面量原样返回。**未宣告/畸形 ⇒ fail-loud**（静默当字面量会让条件永假，正是本仓反复踩的那类）。
	termValue(t, pc) {
		if (!t || typeof t !== 'object' || Array.isArray(t)) return t;
		const names = Object.keys(t);
		const bad = names.length !== 1 || !this.terms.includes(names[0]);
		if (bad) throw new Error(`Sg.rules：取值项 ${JSON.stringify(t)} 非法（\`Sg.rules.terms\` = ${JSON.stringify(this.terms)}）——未宣告或畸形必须报错（#624）`);
		if (names[0] === 'price') {
			// ⚠️ **必须绑到 `Game.Economy` 上调用**（`priceOf` 里用 `this.events`）：把函数取出来再调会丢 `this`（实测 TypeError）。
			const E = window.Game?.Economy;
			if (typeof E?.priceOf !== 'function') throw new Error('Sg.rules：取值项「price」需要引擎经济面 `Game.Economy.priceOf`（当前未注册）');
			return -E.priceOf(t.price, pc);
		}
		return t;
	},
	// 一个"键"的**值**（不是真假）：`n_*` ⇒ 笔记真假；`inv:`／`era:` ⇒ 持有／时代；其余按 `readPath` 走（裸键＝`ev.`）。
	// 与下面 `holds()` 的分工：`holds` 问"这个键成不成立"，`readKey` 问"这个键是多少"（算子形要比大小／比集合）。
	readKey(key, pc) {
		const k = String(key);
		if (k.startsWith('n_')) return window.Sg.notes.has(k);
		const m = /^(inv|era|gear):(.+)$/.exec(k);
		if (m) {
			if (m[1] === 'inv') return !!(pc?.inv ?? {})[m[2]];                      // 持有物（不在 pc.ev/world 域）
			if (m[1] === 'gear') return (pc?.gear ?? []).includes(m[2]);             // 行囊/装备（同上；`#624` 片四）
			const want = window.Game?.Era?.[String(m[2]).toUpperCase()] ?? m[2];     // 时代（`era:present`／`era:past`）
			return State.variables.era === want;
		}
		// `#624` 片二：**显式根** `pc.` ⇒ 从 pc 根走。为什么需要：`pc.gold`／`pc.hp` 这类**顶层字段**原本没有键形可用——
		// 裸键＝`ev.`、`world.` 是另一个域、第三命名空间又必须带点 ⇒ 可负担性判定（`gold ≥ 价格`）写不出来。
		if (k.startsWith('pc.')) return window.Sg.notes.readPath(pc, k.slice(3));
		return window.Sg.notes.readPath(pc, k.includes('.') ? k : `ev.${k}`);
	},
	// 一个"键名"是否成不成立（真值）—— 逐字沿用旧口径，现在是 `readKey` 的 `!!` 投影（一处实现、两个问法）。
	holds(key, pc) { return !!this.readKey(key, pc); },
	// 单个**条件项**是否满足（`#568`）：字符串 ⇒ 沿用 `holds()`；对象 ⇒ 按算子比较。
	// 结构问题一律 **fail-loud**（畸形／未宣告算子 ⇒ 抛错）——静默为假正是本票要根除的那类；
	// 而**取值失败**（键缺失、类型不可比）⇒ 只**不匹配**（false）："还没发生"是合法状态，不是结构缺陷。
	holdsCond(cond, pc) {
		if (cond == null || typeof cond !== 'object' || Array.isArray(cond)) return this.holds(cond, pc);
		const names = Object.keys(cond);
		if (names.length !== 1) throw new Error(`Sg.rules：条件项对象形必须**恰有一个**算子（拿到 ${names.length} 个：${names.join('／')}）——结构畸形必须报错（#568）`);
		const op = names[0];
		if (!this.ops.includes(op)) throw new Error(`Sg.rules：算子「${op}」未被引擎宣告（\`Sg.rules.ops\` = ${JSON.stringify(this.ops)}）——未宣告的算子会让条件永假（#568）`);
		const args = cond[op];
		if (!Array.isArray(args) || args.length < 2) throw new Error(`Sg.rules：算子「${op}」的参数必须是 [键, …值]（拿到 ${JSON.stringify(args)}）——结构畸形必须报错（#568）`);
		const [key, ...rest] = args;
		// **先解析操作数**（取值项）：结构问题必须 fail-loud，不能因为键恰好缺失就把它静默跳过。
		const want = op === 'oneOf' ? null : this.termValue(rest[0], pc);
		const got = this.readKey(key, pc);
		if (got === undefined || got === null) return false;                        // 键缺失 ⇒ 不匹配
		if (op === 'oneOf') {
			const allowed = rest.length === 1 && Array.isArray(rest[0]) ? rest[0] : rest;   // `['k', ['a','b']]` 或 `['k','a','b']`
			return allowed.includes(got);
		}
		if (typeof got !== 'number' || typeof want !== 'number') return false;     // 数值算子遇非数值 ⇒ 不匹配（不硬比、不抛）
		return op === 'gte' ? got >= want : got <= want;
	},
	// 行是否满足（`req` 全中 ∧ `any` 至少一（空＝不要求）∧ `exclude` 全不中 ∧ `prereq` 已选中过）
	// 三个字段走**同一**抽取（字符串／对象形都认）；`prereq` 是**行 id**，不是条件项 ⇒ 不走 `holdsCond`。
	matches(row, pc, chose = new Set()) {
		const items = (x) => (Array.isArray(x) ? x : x ? [x] : []);
		if (!items(row.req).every((c) => this.holdsCond(c, pc))) return false;
		const any = items(row.any);
		if (any.length && !any.some((c) => this.holdsCond(c, pc))) return false;
		if (items(row.exclude).some((c) => this.holdsCond(c, pc))) return false;
		if (!items(row.prereq).every((id) => chose.has(id))) return false;
		return true;
	},
	// 选择：过滤作用域 → **按 prio 降序（稳定：同 prio 保持声明序）** → 取第一条
	pick(scope, { pc = State.variables.pc, chose = new Set() } = {}) {
		const rows = this.table().filter((r) => r && r.scope === scope);
		const idx = new Map(rows.map((r, i) => [r, i]));
		return rows.filter((r) => this.matches(r, pc, chose))
			.sort((a, b) => (b.prio ?? 0) - (a.prio ?? 0) || idx.get(a) - idx.get(b))[0] ?? null;
	},
	// **菜单**：同一作用域**所有**命中的行（按 `prio` 降序、同 prio 按表序）——与 `pick()` 的"单选"分工见 `<<rulelist>>`。
	// 为什么需要它（`#624` 批 1 勘察）：`pick()` 是 first-match wins ⇒ 一个作用域只渲染一行；
	// 而"一次能问六个话题"这种**菜单**天然是一组**同时可用**的行 ⇒ 表机制必须有"渲染全部命中行"的入口。
	pickAll(scope, { pc = State.variables.pc, chose = new Set() } = {}) {
		const rows = this.table().filter((r) => r && r.scope === scope);
		const idx = new Map(rows.map((r, i) => [r, i]));
		return rows.filter((r) => this.matches(r, pc, chose))
			.sort((a, b) => (b.prio ?? 0) - (a.prio ?? 0) || idx.get(a) - idx.get(b));
	},
	// 授予：把行声明的 `yields` 落到 `Sg.notes.add`（**A 方案**：`text` 只渲染，授予由调用侧统一做）。
	// 返回**本次真正新授予**的 id（幂等 ⇒ 第二次调用返回 `[]`）——这个返回值就是"连渲两次只落一次"的取证面。
	applyYields(row) {
		const list = Array.isArray(row?.yields) ? row.yields : row?.yields ? [row.yields] : [];
		const granted = [];
		for (const y of list) {
			// `#569`：**混合形状** —— `'n_x'`（老）与 `{ id, path }`（多源笔记的路径限定授予）。
			// `{ id }` 不带 `path` ⇒ 当老形状走（门侧 `yieldPathProblems()` 也不参与 path 判定）。
			if (y && typeof y === 'object') {
				const id = String(y.id);
				const hit = y.path == null ? window.Sg.notes.add(id) : window.Sg.notes.addPath(id, String(y.path));
				if (hit) granted.push(id);
			} else if (window.Sg.notes.add(String(y))) granted.push(String(y));
		}
		return granted;
	},
	// **物品**面（`#435`：dev 定的"写点面分两类"）——行里声明 `gives: ['月光花']`，由 `<<rules>>`
	// 渲染成功后统一落（与 `yields` 同处、同幂等面）。**可见文案不在这里生成**：`<<give>>` 的
	// 「获得【…】」提示改为写在行的 `text` 里（逐字不变 ⇒ `--zero` 仍为 0），否则提示会被追加到
	// 渲染结果的**末尾**而与原位不同 ⇒ 文本漂移 ✗。口径一句话：**表＝声明（条件／文本／授予），
	// 写点执行恒在 `<<rules>>` 一处**。
	applyGrants(row) {
		const pc = State.variables.pc;
		const items = Array.isArray(row?.gives) ? row.gives : row?.gives ? [row.gives] : [];
		const granted = [];
		for (const it of items) {
			const k = String(it);
			pc.inv = pc.inv ?? {};
			if (pc.inv[k] !== true) { pc.inv[k] = true; granted.push(k); }
		}
		return granted;
	},
	// **状态键**面（`#435` Q1：授予家族第三类 —— `yields` 笔记／`gives` 物品／`sets` 状态键）。
	// 行里声明 `sets: ['world.flower_taken']` ≡ `<<setflag "flower_taken">>`，由 `<<rules>>` 渲染成功后统一落。
	// 为什么要有第三类：世界态/运行时旗标（`flower_taken`／`flower_sleep`／`forge_thanks`…）**没有笔记**，
	// 既进不了 `yields`（那是笔记），也不该进 `gives`（那是物品）——此前这类位点只能永远留在段落里。
	// 口径三条（门侧 `setProblems()` 机检）：只置**真**（不写数值/枚举）· 键必须是**已登记的状态键** ·
	// **有笔记的键不得走这里**（必须 `yields`，否则同一知识两条写路）。
	// 裸键默认 `ev.`（与 `holds()` 同口径）；写入走 `Sg.notes.writePath`（与读侧同一权威，不另开写路）。
	applySets(row) {
		const pc = State.variables.pc;
		const keys = Array.isArray(row?.sets) ? row.sets : row?.sets ? [row.sets] : [];
		const set = [];
		for (const k0 of keys) {
			const k = String(k0);
			const path = k.includes('.') ? k : `ev.${k}`;
			if (window.Sg.notes.readPath(pc, path) !== true) { window.Sg.notes.writePath(pc, path, true); set.push(k); }
		}
		return set;
	},
};
// `<<rules "作用域">>`：选中 → **先渲染** `text` → **渲染成功后再落** `yields`／`gives`／`sets`。
// 为什么必须"渲染后"（dev 定稿的规则①）：授予要与"这一行真的被选中且渲染成功"绑定 —— 渲染若抛错就不该记账，
// 否则声明与实际写点必然漂移（本仓反复撞过的那类）。规则②（幂等/重渲染安全）由各面自己的幂等保证：
// `Sg.notes.add` 连调两次只落一次、`applyGrants`/`applySets` 也只在"真的新落下"时才计入 ⇒
// 结果留屏重放、SugarCube 重渲染都安全。三面同处（**写点恒在 `<<rules>>` 一处**），顺序无关。
Macro.add('rules', {
	handler() {
		const row = window.Sg.rules.pick(String(this.args[0] ?? ''));
		if (!row) return;
		if (row.text) $(this.output).wiki(String(row.text));   // 先渲染（抛错则不往下走）
		window.Sg.rules.applyYields(row);                       // 渲染成功后再授予（笔记；幂等）
		window.Sg.rules.applyGrants(row);                       // 物品面（同上）
		window.Sg.rules.applySets(row);                         // 状态键面（同上；只置真）
	},
});


// `<<rulelist "作用域">>`（`#624` 批 1）：渲染**全部命中**的行（按 `prio` → 表序）。
// 与 `<<rules>>` 的分工：`<<rules>>` ＝ **单选**（first-match wins，用于同一处的互斥变体）；
// `<<rulelist>>` ＝ **菜单**（同时可用的多个入口，例如"还能问哪几个话题"）。
// 授予面与 `<<rules>>` 完全同路（渲染成功后再落），所以两类行共用同一套判据。
Macro.add('rulelist', {
	handler() {
		for (const row of window.Sg.rules.pickAll(String(this.args[0] ?? ''))) {
			if (row.text) $(this.output).wiki(String(row.text));
			window.Sg.rules.applyYields(row);
			window.Sg.rules.applyGrants(row);
			window.Sg.rules.applySets(row);
		}
	},
});
