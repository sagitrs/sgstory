window.Chargen = {
	pick(roundIdx, optIdx) {
		const pc = State.variables.pc;
		const round = ChargenRounds[roundIdx];
		const opt = round.options[optIdx];
		opt.apply(pc);
		pc.skills = [...new Set(pc.skills)]; // 背景与职业可能给同一技能，去重
		pc.picked.push(`${round.title}：${opt.name}`);
		pc.round += 1;
		if (pc.round >= ChargenRounds.length) {
			pc.name = State.variables.player_name || '无名旅人';
			pc.hp = pc.max_hp;
		}
	},

	// 快速模式：一键应用整套预设（8 轮选项索引）
	applyPreset(idx) {
		const picks = ChargenPresets[idx].picks;
		for (let r = 0; r < ChargenRounds.length; r++) this.pick(r, picks[r]);
	},
};

// 三套预设（索引依次对应各轮选项：数组/背景/物种/职业/技艺/行囊/专长/烙印）
window.ChargenPresets = [
	{
