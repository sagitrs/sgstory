:: Rules [script]
// ── 规则内核（d20 / SRD 5.2 风格）——数值层单一源 ─────────────
// 设计模式参考（未复制代码）：Another-RPG-Engine (MIT) 修饰栈 / foundryvtt-dnd5e (MIT) 公式组织
// 规则数值来源：D&D SRD 5.2（CC BY 4.0, © Wizards of the Coast）
window.Rules = {
	ABILITIES: { str: '力量', dex: '敏捷', con: '体质', int: '智力', wis: '感知', cha: '魅力' },
	SKILLS: {
		运动: 'str', 体操: 'dex', 巧手: 'dex', 隐匿: 'dex',
		奥秘: 'int', 历史: 'int', 调查: 'int', 自然: 'int', 宗教: 'int',
		驯兽: 'wis', 洞悉: 'wis', 医药: 'wis', 察觉: 'wis', 生存: 'wis',
		欺瞒: 'cha', 恐吓: 'cha', 表演: 'cha', 游说: 'cha',
	},
	mod(score) { return Math.floor(((score ?? 10) - 10) / 2); },
	fmod(score) { const m = this.mod(score); return m >= 0 ? `+${m}` : `${m}`; },
	abilityMod(pc, ab) { return this.mod(pc.abilities?.[ab]); },
	prof() { return 2; }, // 1–4 级熟练加值（SRD 5.2 曲线）
	skillMod(pc, skill) {
		const ab = this.SKILLS[skill];
		if (!ab) throw new Error(`未知技能: ${skill}`);
		let m = this.abilityMod(pc, ab);
		if ((pc.skills ?? []).includes(skill)) m += this.prof();
		return m;
	},
	d20(adv) {
		if (!adv) return random(1, 20);
		const a = random(1, 20), b = random(1, 20);
		return adv > 0 ? Math.max(a, b) : Math.min(a, b);
	},
	// 判定标注：说清"用什么属性判定"（技能 → 属性，SRD 5.2）
	skillLabel(skill) { const ab = this.SKILLS[skill]; return ab ? `${skill}检定（${this.ABILITIES[ab]}）` : `${skill}检定`; },
	// 取骰：记下两枚供"计算过程"显示（优势取高 / 劣势取低）
	roll(adv) {
		const a = random(1, 20);
		if (!adv) return { roll: a, rolls: [a] };
		const b = random(1, 20);
		return { roll: adv > 0 ? Math.max(a, b) : Math.min(a, b), rolls: [a, b] };
	},
	// 修正构成（拆项：判定属性 + 熟练 + 加值 + 幸运）
	parts(pc, ability, { skill = '', bonus = 0 } = {}) {
		const out = [{ k: this.ABILITIES[ability] ?? ability, v: this.abilityMod(pc, ability), kind: 'ability' }];
		if (skill && (pc.skills ?? []).includes(skill)) out.push({ k: '熟练', v: this.prof(), kind: 'prof' });
		if (bonus) out.push({ k: '额外加值', v: bonus, kind: 'bonus' });
		if (pc.flags?.luck) out.push({ k: '幸运', v: 1, kind: 'luck' });
		return out;
	},
	// nat：要求「天然出目」等于 nat 才算成功（彩蛋检定用；此时 DC 不参与判定）
	check(pc, skill, dc, { adv = 0, bonus = 0, nat = 0, site = '', advWhy = '', disWhy = '' } = {}) {
		const ability = this.SKILLS[skill];
		if (!ability) throw new Error(`未知技能: ${skill}`);
		const parts = this.parts(pc, ability, { skill, bonus });
		const mod = parts.reduce((n, p) => n + p.v, 0);
		const { roll, rolls } = this.roll(adv), total = roll + mod;
		return { label: this.skillLabel(skill), site, skill, ability, dc, roll, rolls, mod, total, parts, adv, advWhy, disWhy, nat,
			success: nat ? roll === nat : roll === 20 ? true : roll === 1 ? false : total >= dc };
	},
	save(pc, ability, dc, { adv = 0, bonus = 0, nat = 0, site = '', advWhy = '', disWhy = '' } = {}) {
		const parts = this.parts(pc, ability, { bonus });
		const mod = parts.reduce((n, p) => n + p.v, 0);
		const { roll, rolls } = this.roll(adv), total = roll + mod;
		return { label: `${this.ABILITIES[ability]}豁免`, site, ability, dc, roll, rolls, mod, total, parts, adv, advWhy, disWhy, nat,
			success: nat ? roll === nat : roll === 20 ? true : roll === 1 ? false : total >= dc };
	},
};

window.pcNow = () => State.variables.pc;

// ── 角色状态形状：单一默认源 + 旧档迁移（新增字段必须过这里，否则读档即崩）──
window.Pc = {
	defaults() {
		return {
			// 车卡
			name: '', round: 0, picked: [], mode: '',
			classKey: '', classLabel: '', bgKey: '', bgLabel: '', speciesKey: '', speciesLabel: '',
			abilities: null, skills: [], feats: [], gear: [], flags: {},
			hp: 0, max_hp: 0, gold: 0, salves: 0,
			// 世界
			inv: {},              // 物品栏：{ 名: true }
			star: { charge: 12, spent: 0, first_free: false },   // 星力隐藏计数（玩家不可见）；first_free：头一次翻转不收费（#219 C1②）
			keeper: { met: false, trust: 0, state: 'post', key: false },
			ev: {},               // 证据链
			soc: { att: {}, tries: {}, read: {} },   // 交涉台账（B2）：态度偏移 / 同一手试过几次 / 读没读过这人
			dragon: { hp: 0, defeats: 0, awake: false, venom: false },   // 轮次归 B1 动作池：$pc.ev.fight.round
			world: {},            // 世界旗标
		};
	},
	has(name) { return !!State.variables.pc?.inv?.[name]; },
	migrate(pc) {
		if (!pc || typeof pc !== 'object') return this.defaults();
		const d = this.defaults();
		for (const k of Object.keys(d)) {
			if (pc[k] === undefined) pc[k] = d[k];
			else if (Array.isArray(d[k])) { if (!Array.isArray(pc[k])) pc[k] = d[k]; }
			else if (d[k] === null) { if (pc[k] !== null && typeof pc[k] !== 'object') pc[k] = d[k]; }
			else if (typeof d[k] === 'object') {
				if (!pc[k] || typeof pc[k] !== 'object' || Array.isArray(pc[k])) pc[k] = d[k];
				else for (const j of Object.keys(d[k])) if (pc[k][j] === undefined) pc[k][j] = d[k][j];
			}
		}
		return pc;
	},
};

// ── 宏：<<check 技名 DC [adv|dis] [加值]>> / <<save 属性 DC [adv|dis] [加值]>> ──
// 计算过程显示开关（"显示计算过程"；关掉只剩结果）。本地持久化，与图鉴同一套 localStorage 套路
window.SgUI = {
	KEY: 'sgstory.ui.v1',
	read() { try { return JSON.parse(window.localStorage.getItem(this.KEY) ?? '{}') ?? {}; } catch { return {}; } },
	write(d) { try { window.localStorage.setItem(this.KEY, JSON.stringify(d)); } catch { /* 降级：本次会话有效 */ } },
	showDetail() { const d = this.read(); return d.detail === undefined ? true : !!d.detail; },
	setDetail(on) { const d = this.read(); d.detail = !!on; this.write(d); },
	toggle() { this.setDetail(!this.showDetail()); },
	// 设定集里的开关（<<replace>> 就地重画）
	renderToggle() {
		if (this.showDetail()) {
			return `计算过程：'''开'''　${'<<link "关掉：只留骰面与总修正">><<set _t to SgUI.toggle()>><<replace "#ui-detail">><<= SgUI.renderToggle()>> <</replace>><</link>>'}`;
		}
		return `计算过程：'''关'''　${'<<link "打开：显示属性、熟练与取骰过程">><<set _t to SgUI.toggle()>><<replace "#ui-detail">><<= SgUI.renderToggle()>> <</replace>><</link>>'}`;
	},
};

function renderCheck(res) {
	State.variables.last_check = res;
	const cls = res.success ? 'check-success' : 'check-fail';
	const dcStr = res.nat ? `需天然 ${res.nat}` : `DC${res.dc}`;
	const detail = SgUI.showDetail();
	const modStr = res.mod >= 0 ? `+${res.mod}` : `${res.mod}`;
	const parts = (res.parts ?? []).filter((p) => p.v).map((p) => `${p.v >= 0 ? '+' : ''}${p.v} ${p.k}`).join(' ');
	const head = `<div class="check-result ${cls}">🎯 <span class="check-label">${res.label}</span>` +
		(res.site ? ` <span class="check-site">〔${res.site}〕</span>` : '') + ` · ${dcStr}：` +
		`<span class="check-dice">d20(${res.roll})</span>${detail && parts ? ` ${parts}` : ` ${modStr}`} = <b>${res.total}</b> ${res.roll === 20 ? '★ 大成功' : res.roll === 1 ? '✘ 大失败' : res.success ? '✔ 成功' : '✘ 失败'}</div>`;
	if (!detail) return head;
	const notes = [];
	if (res.adv > 0) notes.push(`优势：${res.advWhy || '有利条件'}（${(res.rolls ?? []).join(' / ')} 取高）`);
	if (res.adv < 0) notes.push(`劣势：${res.disWhy || '不利条件'}（${(res.rolls ?? []).join(' / ')} 取低）`);
	if (res.nat) notes.push(`只有天然 ${res.nat} 才算成功（DC 不参与）`);
	if (!notes.length) return head;
	return head + `<div class="check-why">↳ ${notes.join(' · ')}</div>`;
}
// <<check 技名 DC [adv|dis] [加值] [nat] [位点] [优势理由] [劣势理由]>>
Macro.add('check', {
	handler() {
		const adv = this.args[2] === 'adv' ? 1 : this.args[2] === 'dis' ? -1 : 0;
		$(this.output).append(renderCheck(Rules.check(pcNow(), this.args[0], this.args[1], {
			adv, bonus: Number(this.args[3]) || 0, nat: Number(this.args[4]) || 0,
			site: this.args[5] ?? '', advWhy: this.args[6] ?? '', disWhy: this.args[7] ?? '',
		})));
	},
});
Macro.add('save', {
	handler() {
		const adv = this.args[2] === 'adv' ? 1 : this.args[2] === 'dis' ? -1 : 0;
		$(this.output).append(renderCheck(Rules.save(pcNow(), this.args[0], this.args[1], {
			adv, bonus: Number(this.args[3]) || 0, nat: Number(this.args[4]) || 0,
			site: this.args[5] ?? '', advWhy: this.args[6] ?? '', disWhy: this.args[7] ?? '',
		})));
	},
});

// ── 复显上一轮玩家发起的检定骰面（M9；不掷骰，只渲染快照）──
Macro.add('lastcheck', {
	handler() {
		const r = State.variables.pc?.ev?.last_roll;
		if (r) $(this.output).append(renderCheck(r));
	},
});
// 只在"刚掷过这些位点之一"时复显（hub 用：防止拿别处的旧骰面骗人）
// 也接受**一个数组**参数（<<lastcheckFor _a.sites>>）——SugarCube 的宏参数不支持 JS 展开（...），
// 交涉面板的位点表在运行期才知道，只能整表传进来再由这里摊平。
Macro.add('lastcheckFor', {
	handler() {
		// #300 P2：本次结果槽已经带着这一掷的骰面时不再复显（同一颗骰不显示两遍）
		const lr = State.variables.pc?.ev?.last_result;
		if (lr?.hasCheck && lr.p === State.passage) return;
		const sites = this.args.flat(Infinity).map(String);
		const r = State.variables.pc?.ev?.last_roll;
		if (r && sites.includes(r.site)) $(this.output).append(renderCheck(r));
	},
});

// ── 结局登记宏（图鉴用：终局 final 才给空页提示，章节出口 chapter 只记账）──
Macro.add('ending', {
	handler() {
		const key = String(this.args[0] ?? '').trim();
		const kind = String(this.args[1] ?? 'final').trim();
		if (key) {
			State.variables.pc.ev.ending = key;                          // 本档记录
			if (window.SgCodex) window.SgCodex.recordEnding(key, kind);  // 永久记录
		}
		// C1 收尾入口：每个结局都要有出口。卡片渲染在调用处（段落顶部），
		// 渲染完由 StoryScript 的 :passagerender 挪到段落末尾。
		const foot = window.SgEnding?.foot(key, kind);
		if (foot) jQuery(this.output).append(foot);
	},
});

// ── 血条宏 ──────────────────────────────────────────────
Macro.add('hpbar', {
	skipArgs: true,
	handler() {
		const pc = pcNow();
		const hp = Math.max(0, pc.hp ?? 0), max = pc.max_hp ?? 1;
		const pct = Math.round((hp / max) * 100);
		const color = pct > 50 ? '#5dbb63' : pct > 25 ? '#e0a458' : '#d1495b';
		jQuery(this.output).append(
			`<div class="hpbar"><div class="hpbar-fill" style="width:${pct}%;background:${color}"></div>` +
			`<span class="hpbar-text">❤ ${hp} / ${max}</span></div>`
		);
	},
});
Macro.add('dragonbar', {
	skipArgs: true,
	handler() {
		const pc = pcNow();
		const hp = Math.max(0, pc.dragon?.hp ?? 0), max = window.Game?.Dragon?.hp ?? 1;
		const pct = Math.round((hp / max) * 100);
		jQuery(this.output).append(
			`<div class="hpbar"><div class="hpbar-fill" style="width:${pct}%;background:#7a4a8f"></div>` +
			`<span class="hpbar-text">☠ 龙 ${hp} / ${max}</span></div>`
		);
	},
});

:: StoryInit
/% 全局状态初始化（默认形状单一源见 Pc.defaults） %/
<<set $player_name to "">>
<<set $pc to Pc.defaults()>>
<<set $era to Game.Era.PRESENT>>

:: Widgets [widget]
/% 受伤 + 药膏自动生效 + 死亡判定。用法：<<damage N>>。
   药膏自动门槛：缺口满 4 点（一副的恢复量）才自动用——满血/轻伤不烧药膏（#201）。 %/
/% #185 门厅：取物结果单源；replace 原地重绘，goto 不再冲掉结果 %/
<<widget "hallResult">><<nobr>>
	<<lastcheck>>
	<<if $args[0] is "翻检">>
		<<if $last_check.success>>
			你把哨子从钉子上提起来，收进行囊，可在''物品栏''查看。<<give "坏哨">>
		<<else>>
			哨子卡在钉子上。你拨了半天，指头刮破了一道口子——到底还是弄下来了。
			<<damage 1>><<give "坏哨">>
		<</if>>
	<<else>>
		<<if $last_check.success>>
			你借了箱子的高度，一把攥住哨子拧了下来。<<give "坏哨">>
		<<else>>
			箱子一滑，你磕在墙角上。<<damage 2>>好歹把哨子攥下来了。<<give "坏哨">>
		<</if>>
	<</if>>
	<p>这里你已经''翻找过''了，没有别的。</p>
<</nobr>><</widget>>
/% #261（#185 阶段三）首遇门控泛化：<<firstTime "flag">> → _first（并置位）。
   用法：<<firstTime "keeper_intro">><<if _first>>完整首遇<<else>>返回短入口<</if>> %/
<<widget "firstTime">>
	<<set _first to !$pc.ev[$args[0]]>>
	<<if _first>><<set $pc.ev[$args[0]] to true>><</if>>
<</widget>>

<<widget "damage">><<nobr>>
	<<set $pc.hp to Math.max(0, $pc.hp - $args[0])>>
	<<if $pc.salves gt 0 and $pc.hp gt 0 and ($pc.max_hp - $pc.hp) gte 4>>
		<<set $pc.salves to $pc.salves - 1>>
		<<set $pc.hp to $pc.hp + 4>>
		<span class="damage-flash">''你受到了 $args[0] 点伤害！''（伤得重，消耗一副药膏，恢复 4 点生命）</span>
	<<else>>
		<span class="damage-flash">''你受到了 $args[0] 点伤害！''</span>
	<</if>>
	<<if $pc.hp lte 0>>
		/% #357：致命伤**即刻登记结局**——安全网（:passagestart 的 hp≤0 修补）以
		   `!pc.ev.ending` 为门，若不先登记，它会赶在结局页渲染前把 hp 修回 1，
		   把刚受致命伤的角色"复活"。 %/
		<<set $pc.ev.ending to "死亡">>
		<<goto "结局 死亡">>
	<</if>>
<</nobr>><</widget>>

/% 检定位点词汇：DC/技能出走 Game.Checks.sites；正文只传位点键。site.abil → 豁免，否则技能检定。
   携带道具的位点优势由 Game.Items.advAt 自动附加（无哨/书即无优势）；位点级 dis 自动劣势。 %/
<<widget "sitecheck">><<nobr>>
	<<set _site to Game.Checks.sites[$args[0]]>>
	<<set _adv to $args[1]>>
	<<set _why to "">>
	<<set _why2 to "">>
	<<set _item to Game.Items.advSource($args[0], $pc.inv, $pc.gear)>>
	<<if not _adv and _item>><<set _adv to "adv">><<set _why to (Game.Items.advAt($args[0], { [_item]: true }) ? "道具" : "行囊") + _item>><</if>>
	<<if not _adv and Game.Checks.knowledge[$args[0]] and $pc.world[Game.Checks.knowledge[$args[0]]]>>
		<<set _adv to "adv">><<set _why to "情报·" + (Game.Checks.knowledgeWhy[Game.Checks.knowledge[$args[0]]] ?? Game.Checks.knowledge[$args[0]])>>
	<</if>>
	<<if not _adv and _site.dis>>
		<<set _adv to "dis">><<set _why2 to _site.disWhy ?? "这一手本来就悬">>
	<</if>>
	<<if _site.abil>>
		<<save _site.abil _site.dc _adv 0 _site.nat $args[0] _why _why2>>
	<<else>>
		<<check _site.skill _site.dc _adv 0 _site.nat $args[0] _why _why2>>
	<</if>>
<</nobr>><</widget>>

/% 经济事件词汇：金额出走 Game.Economy；gives 自动入账 %/
<<widget "econ">><<nobr>>
	<<set _ev to Game.Economy.events[$args[0]]>>
	<<set _d to Game.Economy.priceOf($args[0], $pc)>>
	<<set $pc.gold to $pc.gold + _d>>
	<<if _ev.gives>><<run Object.entries(_ev.gives).forEach(([k, v]) => { if (Array.isArray(v)) (State.variables.pc[k] = [...(State.variables.pc[k] ?? []), ...v.filter((x) => !(State.variables.pc[k] ?? []).includes(x))]); else State.variables.pc[k] = (State.variables.pc[k] ?? 0) + v; })>><</if>>
	<span class="econ-note">（<<if _d lt 0>>金币 _d<<elseif _d gt 0>>金币 +_d<<else>>——<</if>>）</span>
<</nobr>><</widget>>

/% 时代切回现在（不耗星力：时间自己走完的场合专用——宴散/仪式终） %/
<<widget "eraPresent">>
	<<set $era to Game.Era.PRESENT>>
<</widget>>

/% 拾取道具（物品栏）：<<give "日记">> %/
<<widget "give">><<nobr>>
	<<run $pc.inv[$args[0]] = true>>
	<span class="gain">''获得【$args[0]】。''</span>
<</nobr>><</widget>>

/% 检定结果快照（M9）：玩家发起的检定在 link 里掷完骰后存一份，
   结果分支重渲染时用 <<lastcheck>> 复显骰面——否则 <<goto>> 会把骰面一起丢掉 %/
<<widget "snapshot">>
	<<set $pc.ev.last_roll to $last_check>>
<</widget>>

/% 世界旗标：<<setflag "goblin_spared">> %/
<<widget "setflag">>
	<<run $pc.world[$args[0]] = true>>
<</widget>>

/% 翻转时代（v16 §3.3）：原地生效、位置决定年代；耗隐藏星力；从过去回来时雾淡一些 %/
<<widget "flip">><<nobr>>
	<<if $pc.world.fog_thin>>
		/% #291 I1-G1：现象层钩子——跑得多了，雾的变化要能被感觉到（不显示任何数字） %/
		<<if $pc.star.spent gte 3>>
			<div><span class="flip-note">你回到现在。雾比上回更''薄了一层''，林子里的声音听得清楚了些。</span></div>
		<<else>>
			<div><span class="flip-note">你回到现在。身边的雾，''淡了一些''。</span></div>
		<</if>>
		<<set $pc.world.fog_thin to false>>
	<</if>>
	<<if not $pc.inv["时光护符"]>>
		<div><span class="era-drained">你身上没有能校进另一段时间的东西。</span></div>
	<<else>>
		<<if $pc.star.spent gte 3>>
			<div><span class="sys-note">（你翻得越来越熟了。可每次回来，身上都像被抽走了一点点什么。）</span></div>
		<</if>>
		<<link `($era is Game.Era.PRESENT ? "翻转护身符：坠入『过去』" : "翻转护身符：回到『现在』")`>>
			<<if not $pc.star.first_free>>
				<<set $pc.star.first_free to true>>   /% #219 C1②：头一次翻转不收费——造它的人留的一点余量 %/
			<<else>>
				<<set $pc.star.spent to $pc.star.spent + 1>>
			<</if>>
			<<set $era to ($era is Game.Era.PRESENT ? Game.Era.PAST : Game.Era.PRESENT)>>
			<<if $era is Game.Era.PRESENT>><<set $pc.world.fog_thin to true>><</if>>
			<<goto `passage()`>>
		<</link>>
	<</if>>
<</nobr>><</widget>>

/% ── 战斗动作池（B1）：每轮随机 3 选 1；每个动作是一次属性化检定，成/败/大成功各有后果 ──
   回合状态挂在 $pc.ev.fight：{ pool, round, offer, act, adv, guard, skipFoe, flee, last, done }。
   点动作只写 $pc.ev.fight.act ＋重渲染（<<goto `passage()`>>）——结算在段落渲染顶部跑完，骰面不会丢。
   <<fightbegin>> 只在"新一场"重置：同池子且没打完＝这就是重渲染，不能清台账。 %/
<<widget "fightbegin">><<nobr>>
	<<if !$pc.ev.fight or $pc.ev.fight.pool isnot $args[0] or $pc.ev.fight.done>>
		<<set $pc.ev.fight to { pool: $args[0], round: 1, offer: [], act: null, adv: 0, guard: 0, skipFoe: false, flee: false, last: null, done: false }>>
	<</if>>
<</nobr>><</widget>>

/% 结算玩家选的那一手 ＋ 对手这一轮的动作 %/
<<widget "fightresolve">><<nobr>>
	<<set _f to $pc.ev.fight>>
	<<if _f.act>>
		<<set _a to Game.Combat.actions[_f.act]>>
		<<if _f.adv>>
			<<sitecheck _a.site "adv" "上一手的准备">>
		<<else>>
			<<sitecheck _a.site>>
		<</if>>
		<<set _r to Game.Combat.playerEff(_f.act, $last_check, $pc)>>
		<<set _f.last to { act: _f.act, kind: _r.kind, text: _r.eff.text, dmg: _r.eff.dmg ?? 0, hurt: _r.eff.hurt ?? 0, adv: _r.eff.adv ?? 0, guard: _r.eff.guard ?? 0 }>>
		<div class="fight-log">
			''你：<<print _a.label>>''　<<if _r.kind is "crit">><span class="fight-crit">''大成功''</span><</if>>
			<<print _r.eff.text>>
			<div class="fight-meta"><<if _r.eff.dmg>>打掉 <<print _r.eff.dmg>> 点<</if>><<if _r.gearBonus>>（<<print Game.Gear.damageSource($pc.gear)>> +<<print _r.gearBonus>>）<</if>><<if _r.eff.dmg>>　<</if>><<if _r.eff.adv>>下一击有优势　<</if>><<if _r.eff.guard>>这一轮少挨 <<print _r.eff.guard>>　<</if>><<if _r.eff.hurt>>自己挨了 <<print _r.eff.hurt>>　<</if>><<if _r.eff.skipFoe>>它这一轮没能出手　<</if>><<if _r.goodNote>>（<<print _r.goodNote>>）<</if>><<if _r.kind is "bad">>''没能得手''<</if>></div>
		</div>
		<<run Game.Combat.applyEffect($pc, _r.eff, _f)>>
		<<if _r.eff.hurt>><<damage _r.eff.hurt>><</if>>
		<<set _f.act to null>>
		<<if $pc.hp gt 0>>
			<<if _f.skipFoe>>
				<div class="fight-log">''它：''这一轮它没有出手。</div>
			<<else>>
				<<sitecheck $args[0]>>
				<<if $args[1]>>
					<<set _raw to Game.Dragon.dragonDamage($pc.inv, _f.round, ($pc.dragon.defeats ?? 0) + 1, $pc.dragon.venom)>>
					<<set _dmg to Math.max(1, _raw - (_f.guard ?? 0))>>
					<<if $last_check.success>>
						<div class="fight-log">''它：''你贴着地滚开了——它那一口咬在你刚才站的地方，石板裂了一层。</div>
					<<else>>
						<<set $pc.dragon.defeats to ($pc.dragon.defeats ?? 0) + 1>>
						<div class="fight-log">''它：''它回手了——这一下你没能全躲开。</div>
						<<damage _dmg>>
					<</if>>
				<<else>>
					<<if $last_check.success>>
						<div class="fight-log">''它：''它扑了个空，散在你刚才站的地方——没有追。</div>
					<<else>>
						<div class="fight-log">''它：''它把你掀翻在地，又停住了。像在等你先动手。</div>
						<<damage 5>>
					<</if>>
				<</if>>
			<</if>>
		<</if>>
		<<set _f.round to (_f.round ?? 1) + 1>>
		<<set _f.offer to []>>
		<<set _f.guard to 0>>
		<<set _f.adv to 0>>
		<<set _f.skipFoe to false>>
	<</if>>
<</nobr>><</widget>>

/% 这一轮的三张牌：每张都写明"走哪一项属性、DC 多少" %/
<<widget "fightpanel">><<nobr>>
	<<set _f to $pc.ev.fight>>
	<<if _f.offer.length is 0>>
		<<set _f.offer to Game.Combat.offer(_f.pool, _f.round, $pc, _f.last?.act)>>
	<</if>>
	<div class="fight-acts">
		''这一轮你能做的：''
		<<if _f.offer.length gt 0>>
			<<link `Game.Combat.actions[_f.offer[0]].label`>>
				<<set $pc.ev.fight.act to $pc.ev.fight.offer[0]>><<goto `passage()`>>
			<</link>>
			<span class="fight-meta">（<<print Game.Combat.siteInfo(_f.offer[0])>>）</span>
		<</if>>
		<<if _f.offer.length gt 1>>
			<<link `Game.Combat.actions[_f.offer[1]].label`>>
				<<set $pc.ev.fight.act to $pc.ev.fight.offer[1]>><<goto `passage()`>>
			<</link>>
			<span class="fight-meta">（<<print Game.Combat.siteInfo(_f.offer[1])>>）</span>
		<</if>>
		<<if _f.offer.length gt 2>>
			<<link `Game.Combat.actions[_f.offer[2]].label`>>
				<<set $pc.ev.fight.act to $pc.ev.fight.offer[2]>><<goto `passage()`>>
			<</link>>
			<span class="fight-meta">（<<print Game.Combat.siteInfo(_f.offer[2])>>）</span>
		<</if>>
	</div>
<</nobr>><</widget>>

/% ── 交涉（B2 · D&D 2024 Influence action + DMG 社交交互）────────────────────
   三档意愿：willing（他本来就想给——不掷骰）· hesitant（掷骰）· unwilling（越线——掷骰也没用）
   态度：友好 −5 / 冷淡 0 / 敌意 +5（DMG 社交交互表压成一根轴）
   筹码：把对方想要的东西摆出来 → 免检（auto）或优势（adv）——有不靠嘴的路
   代价：游说/历史失败 → 这一问 DC 递增（2024「不许原地重掷」）· 欺瞒被识破 → 态度骤降 · 恐吓 → 得手也记仇
   架构与战斗动作池一致：点选项只写 $pc.ev.soc，重渲染后在段落顶部结算（骰面留在帧里）。

   ⚠ 选项必须是**我们自己发的 <a data-...>**，不能写成 <<link>>：<<link>> 的内容在**点击时**才
   解析，那时 <<for>> 的临时变量早被同段落的下一个面板覆盖了（"点花的面板、算成求术的面板"）。
   值与它一起走进 DOM，点谁是谁。 %/

<<widget "socresolve">><<nobr>>
	<<set _a to Game.Social.ask($args[0])>>
	<<if _a and $pc.ev.soc and $pc.ev.soc.id is _a.id>>
		<<set _S to Game.Social>>
		<<set _how to $pc.ev.soc.how>>
		<<if not $pc.ev.soc_last>><<set $pc.ev.soc_last to {}>><</if>>
		<<if _how is "will">>
			<<run _a.apply($pc)>>
			<<set $pc.ev.soc_last[_a.id] to { kind: "will", text: _a.will }>>
		<<elseif _how.startsWith("lever:")>>
			<<set _lv to _S.levers(_a, $pc).find((l) => l.id is _how.slice(6))>>
			<<if _lv>>
				<<if _lv.econ>><<econ _lv.econ>><</if>>
				<<run _S.shift($pc, _a.npc, 1)>>
				<<run _a.apply($pc)>>
				<<set $pc.ev.soc_last[_a.id] to { kind: "auto", text: _a.auto, notes: ["拿出了筹码：" + _lv.name] }>>
			<</if>>
		<<elseif _how.startsWith("site:")>>
			<<set _site to _how.slice(5)>>
			<<set _dc to _S.dcOf(_a, _site, $pc)>>
			<<set _lv to _S.levers(_a, $pc).find((l) => l.gives is "adv" and not l.econ)>>
			<<set _res to _S.roll($pc, _site, _dc, _lv?.note ?? "")>>
			<<set $pc.ev.last_roll to _res>>
			<<if _res.success>>
				<<run _a.apply($pc)>>
				<<set _notes to _S.settle(_a, $pc, _site, _res.roll is 20 ? "crit" : "ok")>>
				<<set $pc.ev.soc_last[_a.id] to { kind: "ok", text: _a.ok, notes: _notes }>>
			<<else>>
				<<set _notes to _S.settle(_a, $pc, _site, "bad")>>
				<<set $pc.ev.soc_last[_a.id] to { kind: "bad", text: _a.bad, notes: _notes }>>
			<</if>>
		<</if>>
		<<set $pc.ev.soc to null>>
	<</if>>
<</nobr>><</widget>>

<<widget "socpanel">><<nobr>>
	<<set _a to Game.Social.ask($args[0])>>
	<<set _S to Game.Social>>
	<<if _a>>
		<div class="soc-ask">
			''<<print _a.q>>''
			<<if $pc.ev.soc_last and $pc.ev.soc_last[_a.id]>>
				<<set _L to $pc.ev.soc_last[_a.id]>>
				<<lastcheckFor _a.sites>>
				<span class="soc-said"><<print _L.text>></span>
				<<for _n to 0; _n lt (_L.notes ?? []).length; _n++>><span class="soc-cost">（<<print _L.notes[_n]>>）</span><</for>>
			<</if>>
			<<if _a.done($pc)>>
				<span class="soc-done">（这一件已经有结果了。）</span>
			<<else>>
				<<set _v to _S.verdict(_a, $pc)>>
				<<if _v is "unwilling">>
					<span class="soc-no"><<print _a.why ?? "（这件事没得谈。）">></span>
				<<else>>
					<<set _att to _S.attitude(_a, $pc)>>
					<div class="soc-opts">
					<<if _v is "willing">>
						<<print `<a class="soc-opt" role="link" tabindex="0" data-ask="${_a.id}" data-how="will">开口：${_a.q}（${_a.tag}）</a>`>>
						<span class="soc-meta">（对方本来就要说<<if SgUI.showDetail()>>——不必掷骰<</if>>）</span>
					<</if>>
					<<for _i to 0; _i lt _S.levers(_a, $pc).length; _i++>>
						<<set _lv to _S.levers(_a, $pc)[_i]>>
						<<print `<a class="soc-opt" role="link" tabindex="0" data-ask="${_a.id}" data-how="lever:${_lv.id}">拿出筹码：${_lv.name}（${_a.tag}）</a>`>>
						<span class="soc-meta">（<<if _lv.econ>>花 <<print -Game.Economy.priceOf(_lv.econ, $pc)>> 金币 ｜ <</if>><<if _lv.gives is "auto">>直接答应<<if SgUI.showDetail()>>，无需掷骰<</if>><</if>><<if _lv.gives is "adv">>后续更有把握<<if SgUI.showDetail()>>（交涉检定有优势）<</if>><</if>>）</span>
					<</for>>
					<<for _i to 0; _i lt _S.open(_a, $pc).length; _i++>>
						<<set _o to _S.open(_a, $pc)[_i]>>
						<<print `<a class="soc-opt" role="link" tabindex="0" data-ask="${_a.id}" data-how="site:${_o.site}">${_o.ap.verb}：${_o.skill}（${_a.tag}）</a>`>>
						<span class="soc-meta">（<<print _S.ATT[_att]>><<if SgUI.showDetail()>> → DC<<print _o.dc>><</if>><<if _o.ap.onFail?.retry>> ｜ 失败：话说死了，更难开口<</if>><<if _o.ap.onFail?.att>> ｜ 失败：<<print _a.npc>>记住了<<if SgUI.showDetail()>>（态度降一级）<</if>><</if>><<if not _o.ap.onFail?.retry and not _o.ap.onFail?.att>> ｜ 失败：只是没接上话<</if>><<if _o.ap.onOk?.att>> ｜ 成了也记仇<</if>>）</span>
					<</for>>
					</div>
				<</if>>
			<</if>>
		</div>
	<</if>>
<</nobr>><</widget>>

/% 物品栏（v16 §5.0）：侧栏列出身上带着的东西——不凑数、不集齐开锁 %/
<<widget "inventory">><<nobr>>
	<<set _inv to Object.keys($pc.inv ?? {})>>
	<<if _inv.length>>
		<<for _i to 0; _i lt _inv.length; _i++>><span class="inv-item">_inv[_i]</span><</for>>
	<<else>>
		（空）
	<</if>>
<</nobr>><</widget>>

:: StoryCaption
/% 侧边栏：常驻存档入口（v16 §5.0）+ 实时角色卡 + 物品栏 %/
<<nobr>>
<div class="save-bar">
	<button type="button" class="save-btn" onclick="sgQuickSave()">💾 快速存档</button>
	<button type="button" class="save-btn" onclick="sgQuickLoad()">📂 快速读档</button>
	<button type="button" class="save-btn" onclick="sgSaveMenu()">🗂 存档 / 读档</button>
</div>
<</nobr>>
<<if $pc.classLabel>>
''$pc.name''
$pc.speciesLabel $pc.classLabel
<<hpbar>>
金币：$pc.gold
药膏：$pc.salves 副（缺口满 4 点时自动用，一副恢复 4 点）
<<if $pc.gear.length>>行囊：<<print $pc.gear.join('、')>><</if>>
<div class="inv-block">
''物品栏''
<div class="inv-list"><<inventory>></div>
</div>
<<if $pc.inv["时光护符"]>>
⌛ <<if $era is Game.Era.PAST>>过去<<else>>现在<</if>>
<</if>>
[[📖 设定集|设定集]]
<</if>>
