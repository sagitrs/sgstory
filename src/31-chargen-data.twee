	{
		title: '命运烙印',
		intro: '车卡的最后一格留给命运。写下你的：',
		options: [
			{ name: '勇气', desc: '疼，但你从不后退半步。', effect: '鲁莽挑战受伤 -1',
				apply(pc) { pc.flags.courage = true; } },
			{ name: '机运', desc: '命运偏爱你一点点。', effect: '所有检定与豁免 +1',
				apply(pc) { pc.flags.luck = true; } },
			{ name: '学识', desc: '你知道宝物藏在哪里，也认得卖消息的人。', effect: '搜刮战利品金币 +10；女巫情报半价（8→5 金）',
				apply(pc) { pc.flags.lore = true; } },
