:: StoryInit
/% 全局状态初始化（默认形状单一源见 Pc.defaults）%/
<<set $player_name to "">>
<<set $pc to Pc.defaults()>>
/% 剧情旗标（与车卡无关的世界状态） %/
<<set $has_amulet to false>>
<<set $heard_rumor to false>>
<<set $goblin_spared to false>>
<<set $witch_healed to false>>
/% 第二章：塔 %/
<<set $era to "present">>
<<set $hint_diary to false>>
<<set $hint_star to false>>

:: Widgets [widget]
/% 受伤 + 死亡判定 + 药膏自动生效。用法：<<damage N>>。
   塔的回声守卫（#23）：tower.echo 为真时战败不死——hp 回 1、败计数+1、送回「塔的回声」。 %/
<<widget "damage">>
	<<set $pc.hp to Math.max(0, $pc.hp - $args[0])>>
	<<if $pc.gear.includes("药膏") and not $pc.salve_used and $pc.hp gt 0>>
		<<set $pc.salve_used to true>>
		<<set $pc.hp to Math.min($pc.max_hp, $pc.hp + 4)>>
		<span class="damage-flash">''你受到了 $args[0] 点伤害！''（药膏自动生效，回复 4 点生命）</span>
	<<else>>
		<span class="damage-flash">''你受到了 $args[0] 点伤害！''</span>
	<</if>>
	<<if $pc.hp lte 0>>
		<<if $pc.tower.echo>>
			<<set $pc.tower.echo to false>>
			<<set $pc.tower.defeats to ($pc.tower.defeats ?? 0) + 1>>
			<<set $pc.hp to 1>>
			<<goto "塔的回声">>
		<<else>>
			<<goto "结局 死亡">>
		<</if>>
	<</if>>
<</widget>>

/% 检定位点词汇（#28）：DC/技能出走 Game.Checks.sites，正文/包装宏只传位点键。
   site.abil → 豁免（<<save>>），否则技能检定；[adv] 可选 %/
<<widget "sitecheck">>
	<<set _site to Game.Checks.sites[$args[0]]>>
	<<if _site.abil>>
		<<save _site.abil _site.dc $args[1]>>
	<<else>>
		<<check _site.skill _site.dc $args[1]>>
	<</if>>
<</widget>>

/% 旗标词汇（#28）：点击态故事旗标统一入口（W1 纪律） %/
<<widget "setflag">>
	<<run State.variables[$args[0]] = true>>
<</widget>>

/% 经济事件词汇（#28）：金额出走 Game.Economy.events；动态事件（战利品）传第二参 %/
<<widget "econ">>
	<<set _ev to Game.Economy.events[$args[0]]>>
	<<set _d to (typeof $args[1] is "number") ? $args[1] : _ev.delta>>
	<<set $pc.gold to $pc.gold + _d>>
<</widget>>

/% 洞穴察觉检定：精灵黑暗视觉 / 警觉专长给优势；DC 查位点表（#28） %/
<<widget "perceptionroll">>
	<<if $pc.speciesKey is "elf" or $pc.feats.includes("警觉")>>
		<<sitecheck "开局·察觉" "adv">>
	<<else>>
		<<sitecheck "开局·察觉">>
	<</if>>
<</widget>>

/% 战斗检定：位点键第一参（#28）；长剑 +2 是装备规则留在宏内；可选 "adv" %/
<<widget "attackroll">>
	<<set _site to Game.Checks.sites[$args[0]]>>
	<<if $args[1] is "adv" and $pc.gear.includes("长剑")>>
		<<check _site.skill _site.dc "adv" 2>>
	<<elseif $args[1] is "adv">>
		<<check _site.skill _site.dc "adv">>
	<<elseif $pc.gear.includes("长剑")>>
		<<check _site.skill _site.dc 0 2>>
	<<else>>
		<<check _site.skill _site.dc>>
	<</if>>
<</widget>>

/% 吊桥体操检定：绳索或听过传闻给优势；DC 查位点表（#28） %/
<<widget "bridgeroll">>
	<<if $pc.has_rope or $heard_rumor>>
		<<sitecheck "断桥" "adv">>
	<<else>>
		<<sitecheck "断桥">>
	<</if>>
<</widget>>

/% 第二章：时代切换（护身符充能 -1，重渲染当前段落）%/

/% 战斗意图词汇（#29）：点击态状态变更必须走词汇宏——裸 set 在 link 体内是
   O(内容) 测试负担源头（L0 纪律告警 W1 拦截对象） %/
<<widget "setintent">>
	<<set $pc.tower.intent to $args[0]>>
<</widget>>
<<widget "erashift">>
	<<if $pc.amulet_charges gt 0>>
		<<link `($era is "present" ? "翻转护身符：坠入『过去』（剩 $pc.amulet_charges 次）" : "翻转护身符：回到『现在』（剩 $pc.amulet_charges 次）")`>>
			<<set $pc.amulet_charges to $pc.amulet_charges - 1>>
			<<set $era to ($era is "present" ? "past" : "present")>>
			<<goto `passage()`>>
		<</link>>
	<<else>>
		<span class="era-drained">护身符的银辉已经黯淡，无法再切换时代。</span>
	<</if>>
<</widget>>

/% 鲁莽挑战：体质豁免 DC15 查位点表（#28）；矮人/勇气减伤 %/
<<widget "defyeroll">>
	<<sitecheck "雾影·抵抗">>
	<<if $last_check.success>>
		<<set _dmg to 3>>
	<<else>>
		<<set _dmg to 6>>
	<</if>>
	<<if $pc.speciesKey is "dwarf">><<set _dmg to _dmg - 2>><</if>>
	<<if $pc.flags.courage>><<set _dmg to _dmg - 1>><</if>>
	<<set _dmg to Math.max(1, _dmg)>>
	<<damage _dmg>>
<</widget>>
