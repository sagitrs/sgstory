:: StoryStyleSheet [stylesheet]
/* ── 迷雾森林 · 暗色主题 ─────────────────────────────── */
body {
	background-color: #191722;
	background-image:
		radial-gradient(ellipse at 50% -10%, #2c2742 0%, transparent 55%),
		radial-gradient(ellipse at 50% 110%, #20282b 0%, transparent 50%);
	color: #e6dfd2;
	font-family: 'LXGW WenKai', 'LXGW WenKai Screen', 'Kaiti SC', 'STKaiti', 'KaiTi', 'Noto Serif SC', serif;
	-webkit-font-smoothing: antialiased;
	text-rendering: optimizeLegibility;
}

#passages {
	max-width: 620px;
	margin: 2em auto;
	padding: 0 1em;
}

.passage {
	font-size: 1.15em;
	line-height: 2.1;
	text-align: left;
	letter-spacing: 0.04em;
	text-shadow: 0 1px 2px rgba(0, 0, 0, 0.45);
	animation: fadein 0.6s ease;
}

@keyframes fadein {
	from { opacity: 0; transform: translateY(6px); }
	to   { opacity: 1; transform: none; }
}

/* 链接 */
.passage a.link-internal {
	color: #a9c0da;
	border-bottom: 1px dotted rgba(169, 192, 218, 0.45);
	text-decoration: none;
}
.passage a.link-internal:hover {
	color: #dde8f4;
	background: rgba(169, 192, 218, 0.10);
}
.passage a.link-internal:active {
	color: #eccf96;
}

/* 侧边栏 */
#story {
	border-right: none;
}
#menu li a {
	color: #8b8497;
}
#menu li a:hover {
	color: #d3e2f5;
}

/* 血条 */
.hpbar {
	position: relative;
	height: 22px;
	background: #2c2836;
	border: 1px solid #4a4358;
	border-radius: 11px;
	overflow: hidden;
	margin: 0.8em auto;
	max-width: 320px;
}
.hpbar-fill {
	height: 100%;
	transition: width 0.4s ease;
	border-radius: 11px 0 0 11px;
}
.hpbar-text {
	position: absolute;
	inset: 0;
	text-align: center;
	font-size: 0.78em;
	line-height: 22px;
	color: #fff;
	text-shadow: 0 1px 2px rgba(0, 0, 0, 0.9);
}

/* 受伤提示 */
.damage-flash {
	display: block;
	color: #da8a95;
	margin: 0.4em 0;
}

/* 标题画面 */
.title-card {
	text-align: center;
	margin: 2.5em 0;
}
.title-card h1 {
	font-size: 2.4em;
	letter-spacing: 0.35em;
	margin: 0 0 0.3em;
	color: #d3e2f5;
	text-shadow: 0 0 24px rgba(157, 180, 212, 0.45);
}
.title-card .subtitle {
	color: #8b8497;
	font-size: 0.9em;
	letter-spacing: 0.2em;
}
.title-card .engine-credit {
	margin-top: 2.2em;
	font-size: 0.72em;
	color: #5f5a6d;
	letter-spacing: 0.05em;
}

/* 结局画面 */
.ending-card {
	border: 1px solid #4a4358;
	border-radius: 10px;
	padding: 1.2em 1.6em;
	margin: 1.5em 0;
	background: rgba(20, 18, 28, 0.7);
	box-shadow: 0 0 32px rgba(0, 0, 0, 0.5) inset;
}
.ending-card h2 {
	text-align: center;
	letter-spacing: 0.15em;
	margin-top: 0;
}
.ending-card table {
	margin: 0 auto;
	border-spacing: 1em 0.3em;
	font-size: 0.95em;
}
.ending-card td:first-child {
	color: #8b8497;
	padding-right: 0.5em;
	text-align: right;
}

/* ── 车卡流程 ── */
.chargen-card {
	border: 1px solid #4a4358;
	border-radius: 10px;
	padding: 1.2em 1.5em;
	background: rgba(20, 18, 28, 0.7);
}
.mode-expert {
	margin-top: 1.2em;
	text-align: center;
	padding: 0.7em;
	border-top: 1px dashed #4a4358;
}
.mode-expert a.link-internal {
	color: #8b8497;
	font-size: 0.88em;
}
.mode-expert a.link-internal:hover {
	color: #d3e2f5;
}
.chargen-progress {
	color: #8b8497;
	font-size: 0.8em;
	letter-spacing: 0.2em;
}
.chargen-card h3 {
	letter-spacing: 0.2em;
	margin: 0.3em 0;
}
.chargen-intro {
	color: #c8c0b0;
}
.choices {
	display: grid;
	grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
	gap: 0.8em;
	margin-top: 1em;
}
.choice-card {
	border: 1px solid #3c3648;
	border-radius: 8px;
	padding: 0.9em 1em;
	background: rgba(44, 40, 54, 0.5);
	display: flex;
	flex-direction: column;
	gap: 0.4em;
	transition: border-color 0.2s, transform 0.2s;
}
.choice-card:hover {
	border-color: #9db4d4;
	transform: translateY(-2px);
}
.choice-name {
	font-size: 1.1em;
	letter-spacing: 0.15em;
	color: #d3e2f5;
}
.choice-desc {
	color: #a89f92;
	font-size: 0.9em;
	flex: 1;
}
.choice-effect {
	color: #7fb285;
	font-size: 0.82em;
}
.choice-card a.link-internal {
	text-align: center;
	display: block;
	border: 1px solid #4a4358;
	border-radius: 6px;
	padding: 0.3em 0;
}

/* ── 检定结果框 ── */
.check-result {
	border-left: 3px solid;
	border-radius: 4px;
	padding: 0.5em 0.9em;
	margin: 0.8em 0;
	font-size: 0.95em;
	background: rgba(44, 40, 54, 0.5);
}
.check-result.check-success {
	border-color: #74b57c;
}
.check-result.check-fail {
	border-color: #d3707f;
}
.check-dice {
	color: #9db4d4;
	font-family: monospace;
}

/* ── 角色卡总览 ── */
.charsheet {
	border: 1px solid #4a4358;
	border-radius: 10px;
	padding: 1.2em 1.6em;
	background: rgba(20, 18, 28, 0.7);
}
.charsheet h2 {
	text-align: center;
	letter-spacing: 0.15em;
	margin-top: 0;
}
.charsheet-line {
	text-align: center;
	color: #8b8497;
}
.ability-table {
	margin: 1em auto;
	border-spacing: 0.6em 0.3em;
	text-align: center;
}
.ability-table th {
	color: #8b8497;
	font-weight: normal;
	font-size: 0.85em;
}
.charsheet-rows {
	display: flex;
	flex-direction: column;
	gap: 0.3em;
}
.charsheet-rows .label {
	color: #8b8497;
	display: inline-block;
	min-width: 5.5em;
}

/* ── D6 窄屏适配（≤480px，#40）：卡片/表格/血条/检定框不溢出 ── */
@media (max-width: 480px) {
	.ending-card { padding: 0.8em 0.9em; margin: 1em 0; }
	.ending-card table { font-size: 0.85em; border-spacing: 0.6em 0.2em; }
	.check-result { font-size: 0.85em; padding: 0.4em 0.6em; }
	.hpbar-text { font-size: 0.8em; }
	.choice-card { padding: 0.6em 0.7em; }
	.tower-hub ul { padding-inline-start: 1.2em; }
	.tower-hub li { margin: 0.3em 0; }
}

/* ── 设定集（伞 #64 子票 2）：hub 卡片与锁定态视觉弱化 ── */
.codex-hub {
	border: 1px solid #4a4358;
	border-radius: 10px;
	padding: 1em 1.4em;
	margin: 1em 0;
	background: rgba(20, 18, 28, 0.7);
}
.codex-hub h2 { text-align: center; letter-spacing: 0.15em; }
.codex-note { color: #8b8497; font-size: 0.9em; text-align: center; }
.codex-locked { color: #5a5468; display: block; margin: 0.25em 0; font-size: 0.95em; }
.codex-hub .macro-link { display: block; margin: 0.25em 0; }

/* ── 道具图鉴（v17 M8）────────────────────────────────── */
.codex-entry { border-top: 1px solid #3a3548; padding: 0.5em 0; }
.codex-entry h4 { margin: 0.2em 0; letter-spacing: 0.08em; }
.codex-entry.codex-locked h4 { color: #5a5468; }
.codex-clues { margin: 0.2em 0 0.2em 1.1em; padding: 0; }
.codex-clues li { color: #b9b2c6; font-size: 0.95em; margin: 0.15em 0; }
.codex-hint { margin: 0.2em 0 0; color: #8b8497; font-size: 0.92em; font-style: italic; }
.codex-hint-off { color: #5a5468; }

/* ── 常驻存档栏 + 物品栏（v16 §5.0）────────────────────── */
.save-bar {
	display: flex;
	flex-wrap: wrap;
	gap: 6px;
	margin: 0 0 0.8em;
}
.save-bar .save-btn {
	display: inline-block;
	padding: 3px 8px;
	font-size: 0.82em;
	line-height: 1.6;
	cursor: pointer;
	border: 1px solid rgba(169, 192, 218, 0.35);
	border-radius: 6px;
	color: #a9c0da;
	background: rgba(169, 192, 218, 0.08);
	user-select: none;
}
.save-bar .save-btn:hover { background: rgba(169, 192, 218, 0.2); }
.inv-block { margin-top: 0.6em; }
.inv-list {
	display: flex;
	flex-wrap: wrap;
	gap: 3px 8px;
	font-size: 0.88em;
	line-height: 1.7;
}
.inv-item { color: #cfd8c8; }

/* ── M1 骨架补充 ─────────────────────────────────────── */
.flip-note { color: #a9c0da; font-size: 0.95em; }
.econ-note { color: #b8a97e; font-size: 0.9em; }
.gain { color: #9fd0a0; }
.era-drained { color: #8b8497; font-style: italic; }
