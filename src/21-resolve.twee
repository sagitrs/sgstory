:: Resolve [script]
// ── 结算（sim，伞 #441 的 `40-sim` rank 落点）──────────────────────────────
// 为什么单独一个文件（#441-A）：把「算」从 widget 里剥出来——
//   · `rollSite`：**纯函数**，不写状态、不渲染 ⇒ 可在 **node** 里直接驱动（不经浏览器）
//   · `resolve` ：薄封装，多一步「写结果槽 `$last_check`」（段落分支读它）＝ sim 侧
// 现状只有位点检定一条；战斗（`fightact`）与交涉（`socresolve`）在 #441-A 的后续批次按同一形状接上。
// 依赖：`10-core.twee`（Game.Rules / Game.Rules.rng）＋ `15-tables.twee`（**只经 `Sg.story` 取故事数据**）。
// #459 切片三：位点表／情报捷径／战斗动作表已改走 `Sg.story.checkSite/checkKnowledge/combatAction`——
// 本文件搬进 `src/engine/**` 后**不再直读故事表**（⚠️ 层间门按字面量匹配，这里曾用别名 `T.Game` 躲过它，
// 所以"门绿"不等于边界成立；本文件的证据是"真的没有直读"，见 PR）。
// 命名根：挂 `Game.Checks.*`（数据/规则 ⇒ Game.*，见 docs/dev-conventions.md §7）。
Object.assign(window.Game.Checks, {
	// 位点判定的**算**：查位点表 → 推导优势/劣势（道具·行囊·情报·位点自带）→ 掷骰
	// 纯函数：`pc` 只读、不碰 `State`、不渲染 ⇒ node 侧注入 `Game.Rules.rng` 即可复算成败。
	rollSite(site, pc, advArg) {
		const T = window.Game;
		// #459 切片三：故事**数据**经接入契约取（`Sg.story.checkSite`；未登记由它 fail-loud 报错）
		const s = window.Sg.story.checkSite(site);
		let adv = advArg, why = '', why2 = '';
		if (!adv) {
			const item = T.Items.advSource(site, pc.inv, pc.gear);
			if (item) { adv = 'adv'; why = (T.Items.advAt(site, { [item]: true }) ? '道具' : '行囊') + item; }
		}
		if (!adv) {
			const kn = window.Sg.story.checkKnowledge(site);
			if (kn && pc.world?.[kn.flag]) { adv = 'adv'; why = '情报·' + kn.why; }
		}
		if (!adv && s.dis) { adv = 'dis'; why2 = s.disWhy ?? '这一手本来就悬'; }
		const opt = {
			adv: adv === 'adv' ? 1 : adv === 'dis' ? -1 : 0,
			bonus: 0, nat: s.nat ?? 0, site, advWhy: why, disWhy: why2,
		};
		return s.abil ? T.Rules.save(pc, s.abil, s.dc, opt) : T.Rules.check(pc, s.skill, s.dc, opt);
	},
	// sim 侧入口：算完把结果写进**结果槽**（`$last_check`——段落分支与 `<<snapshot>>` 读它）
	resolve(site, pc, advArg) {
		const res = this.rollSite(site, pc, advArg);
		State.variables.last_check = res;
		return res;
	},
});

// ── 战斗回合的「算」（#441-A 第二刀）──────────────────────────────────────
// 现状问题：`<<fightpanel>>` 的 link 体里 `<<set $pc.ev.fight.act>>` ＋ `<<fightact>>` ——
// **点一下既算又画**（T 席在 `#441` 上点名的那处）。现在拆成两段：
//   · `pick`／`ensureOffer`：面板点击的落点（state 写在 sim 侧，面板只调）
//   · `resolvePlayer`／`resolveFoe`：两段式结算（保留原本的**渲染顺序**：玩家骰面 → 玩家受伤闪光 →
//     对手骰面 → 挨打闪光；`<<damage>>` 仍由 present 调，它是结算词汇宏）
// 两段式而不是一次性：玩家受伤后的 `hp` 决定对手那一轮是否发生，而 `hp` 由 present 的 `<<damage>>` 落，
// 拆成两段才能让「渲染顺序」与「hp 时序」同时与旧实现逐字一致。
Object.assign(window.Game.Combat, {
	// 面板惰性抽牌（下一页没抽过就抽）——旧实现是 `<<set _f.offer to …>>`（`_f` 是 state 的别名 ⇒ 也是写状态）
	ensureOffer(pc) {
		const T = window.Game, f = pc.ev.fight;
		if (f && f.offer.length === 0) f.offer = T.Combat.offer(f.pool, f.round, pc, f.last?.act);
	},
	// 点下第 idx 张牌：只写「这一手是什么」，结算留给 `resolvePlayer`
	// 命名注意：**不能叫 `pick`**——`Game.Combat.pick(actionId, res)` 已被「动作档位求值」占用
	//（`playerEff` 在用它）；同名会被本 Object.assign 覆盖 ⇒ 2026-09-13 实测踩过（回合结算当场炸）。
	chooseAction(pc, idx) { pc.ev.fight.act = pc.ev.fight.offer[idx]; },
	// 玩家这一手：掷骰（写 `$last_check`）→ 结算 → 写台账。返回 `{ check, hurt, log }`
	// `hurt` 由 present 的 `<<damage>>` 落（不在此处扣 hp）——保住旧的渲染/时序完全一致。
	resolvePlayer(pc, foeSite, isDragon) {
		const T = window.Game, f = pc.ev.fight;
		const a = window.Sg.story.combatAction(f.act);   // #459 切片三：故事数据经契约
		const check = T.Checks.resolve(a.site, pc, f.adv ? 'adv' : null);
		const hadAdv = (f.adv ?? 0) > 0;
		// #352：优势在**被这一手消费后**才清零（旧实现放在本轮末尾清零 → 准备动作的「下一击有优势」当场作废）
		f.adv = 0;
		const r = T.Combat.playerEff(f.act, check, pc);
		const eff = r.eff ?? {};
		f.last = { act: f.act, kind: r.kind, text: eff.text, dmg: eff.dmg ?? 0, hurt: eff.hurt ?? 0, adv: eff.adv ?? 0, guard: eff.guard ?? 0 };
		const log = {
			you: {
				label: a.label, kind: r.kind, text: eff.text, dmg: eff.dmg ?? 0,
				gearBonus: r.gearBonus ?? 0, gearName: T.Gear.damageSource(pc.gear),
				adv: eff.adv ?? 0, guard: eff.guard ?? 0, hurt: eff.hurt ?? 0,
				skipFoe: eff.skipFoe ?? false, goodNote: r.goodNote ?? '', rolledWithAdv: hadAdv,
			},
			foe: null,
		};
		T.Combat.applyEffect(pc, eff, f);
		f.act = null;
		return { check, hurt: eff.hurt ?? 0, log };
	},
	// 对手那一轮 ＋ 收尾（轮次/下一轮牌/清 guard 与 skipFoe/落台账）。**无论 hp 是否归零都要走收尾**
	// （旧实现里收尾在 `if ($pc.hp gt 0)` 之外）。对手检定未发生时 `check` 为 null。
	resolveFoe(pc, foeSite, isDragon, log) {
		const T = window.Game, f = pc.ev.fight;
		let check = null, hurt = 0;
		if (pc.hp > 0) {
			if (f.skipFoe) {
				log.foe = { text: '这一轮它没有出手。' };
			} else {
				check = T.Checks.resolve(foeSite, pc, null);
				if (isDragon) {
					const raw = T.Dragon.dragonDamage(pc.inv, f.round, (pc.dragon.defeats ?? 0) + 1, pc.dragon.venom);
					const dmg = Math.max(1, raw - (f.guard ?? 0));
					if (check.success) {
						log.foe = { text: '你贴着地滚开了——它那一口咬在你刚才站的地方，石板裂了一层。' };
					} else {
						pc.dragon.defeats = (pc.dragon.defeats ?? 0) + 1;
						log.foe = { text: '它回手了——这一下你没能全躲开。' };
						hurt = dmg;
					}
				} else if (check.success) {
					log.foe = { text: '它扑了个空，散在你刚才站的地方——没有追。' };
				} else {
					log.foe = { text: '它把你掀翻在地，又停住了。像在等你先动手。' };
					hurt = T.Damage.shove;   // 原裸 `<<damage 5>>`；具名后仍同值（非档位值，见 15-tables 注）
				}
			}
		}
		f.round = (f.round ?? 1) + 1;
		// #350：下一轮的牌也在**点击时**抽定（渲染时抽＝读档重抽，玩家看到的选项会变）
		f.offer = T.Combat.offer(f.pool, f.round, pc, f.last?.act);
		f.guard = 0;
		f.skipFoe = false;
		f.log = log;
		return { check, hurt, log };
	},
});

// ── 经济事件的「落帐」与文案（#441-A 第三刀）──────────────────────────────
// 为什么要抽：`<<econ>>` 原本把「算价 ＋ 落金币 ＋ 落 gives ＋ 渲染文案」挤在一个 widget 里，
// 而 `<<socresolve>>` 要**在自己的分支里**调它（筹码那一支）⇒ 想让社交回合能在 node 里驱动，
// 就得把「落帐」抽成 sim 函数；文案格式抽成 `note()`（**单一源**，否则两处各写一份必漂）。
Object.assign(window.Game.Economy, {
	// sim：算价 → 落金币 → 落 gives。返回 `{ delta }`（供 present 渲染文案）
	apply(pc, id) {
		const ev = this.events[id];
		const d = this.priceOf(id, pc);
		pc.gold = pc.gold + d;
		if (ev?.gives) {
			for (const [k, v] of Object.entries(ev.gives)) {
				if (Array.isArray(v)) pc[k] = [...(pc[k] ?? []), ...v.filter((x) => !(pc[k] ?? []).includes(x))];
				else pc[k] = (pc[k] ?? 0) + v;
			}
		}
		return { delta: d };
	},
	// present：金额文案（`<<econ>>` widget 与 `<<socresolve>>` 共用此一处）
	note(d) { return `（${d < 0 ? `金币 ${d}` : d > 0 ? `金币 +${d}` : '——'}）`; },
});

// ── 交涉回合的「算」（#441-A 第三刀）──────────────────────────────────────
// 现状：`<<socresolve>>` 是「算 ＋ 写」的 sim widget；它**唯一渲染的东西**是筹码那一支里的 `<<econ>>` 文案。
// 抽出后：状态写点全在 sim；widget 只剩「调 sim ＋ 渲染那一句文案」⇒ `test/social-lever.mjs` 可以不经浏览器驱动。
// ⚠️ 顺序敏感：`econ` 原本在 `shift`／`apply` **之前**（`priceOf` 可能吃 `apply` 落的旗标折扣）——
//    本实现**保持原顺序**（econ 先落、`apply` 后调），别为了「看起来整齐」把它挪位。
Object.assign(window.Game.Social, {
	// 返回 `{ econ: { delta } | null }`；`null`＝这次点击不该结算（`$pc.ev.soc` 与 ask 不匹配）
	resolveAsk(pc, askId, how) {
		const T = window.Game, S = T.Social;
		const a = S.ask(askId);
		if (!a || !pc.ev.soc || pc.ev.soc.id !== a.id) return null;
		if (!pc.ev.soc_last) pc.ev.soc_last = {};
		let econ = null;
		const h = String(how ?? '');
		if (h === 'will') {
			a.apply(pc);
			pc.ev.soc_last[a.id] = { kind: 'will', text: a.will };
		} else if (h.startsWith('lever:')) {
			const lv = S.levers(a, pc).find((l) => l.id === h.slice(6));
			if (lv) {
				if (lv.gives === 'adv') {
					// #360：优势筹码只把「这一问更有把握」摆出来——**不完成诉求**。
					pc.ev.soc_lever = lv.id;
					pc.ev.soc_last[a.id] = { kind: 'lever', text: '你把筹码摆了出来：' + lv.name + '。他看了一眼，没有立刻接话。', notes: ['下一掷有优势（' + lv.note + '）'] };
				} else {
					if (lv.econ) econ = { delta: T.Economy.apply(pc, lv.econ).delta };
					S.shift(pc, a.npc, 1);
					a.apply(pc);
					pc.ev.soc_last[a.id] = { kind: 'auto', text: a.auto, notes: ['拿出了筹码：' + lv.name] };
				}
			}
		} else if (h.startsWith('site:')) {
			const site = h.slice(5);
			const dc = S.dcOf(a, site, pc);
			let lv = S.levers(a, pc).find((l) => l.id === pc.ev.soc_lever);
			if (!lv) lv = S.levers(a, pc).find((l) => l.gives === 'adv' && !l.econ);
			const res = S.roll(pc, site, dc, lv?.note ?? '');
			pc.ev.soc_lever = null;
			pc.ev.last_roll = res;
			if (res.success) {
				a.apply(pc);
				pc.ev.soc_last[a.id] = { kind: 'ok', text: a.ok, notes: S.settle(a, pc, site, res.roll === 20 ? 'crit' : 'ok') };
			} else {
				pc.ev.soc_last[a.id] = { kind: 'bad', text: a.bad, notes: S.settle(a, pc, site, 'bad') };
			}
		}
		pc.ev.soc = null;
		return { econ };
	},
});
