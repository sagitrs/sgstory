				rareToolSite: '宝箱·机关针·借助具·珍贵',
				tool: '手套'
			},
			'石块': {
				site: '宝箱·石块',
				rareSite: '宝箱·石块·珍贵',
				toolSite: '宝箱·石块·借助具',
				rareToolSite: '宝箱·石块·借助具·珍贵',
				tool: '铁撬'
			}
		},
		loot: {
			'普通': [
				'干粮'
			],
			'珍贵': [
				'干粮',
				'TOOL'
			]
		},
		gold: {
			'普通': 5,
			'珍贵': 12
		},
		rarities: {
			'普通': {
				dc: 12
			},
			'珍贵': {
				dc: 15
			}
		},
		toolReduce: 3,
		keyReduce: 'to-zero'
	}
};
Object.assign((window.Sg.story ??= {}), {
	notes: () => window.Game.Notes.entries,
	econEvents: () => window.Game.Economy.events,
	hasChargen: () => false,
	pcDefaults: () => ({}),
	rules: () => [],
	checkSite: (name) => window?.Game?.Checks?.sites?.[name] ?? null,
	foeState: () => ({}),
	combatPool: (id) => window?.Sg?.story?.mechanics?.()?.pools?.[id] ?? [],
	combatAction: (id) => window?.Sg?.story?.mechanics?.()?.actions?.[id] ?? null,
	actionLabel: (id) => window?.Sg?.story?.mechanics?.()?.actions?.[id]?.label ?? String(id),
	itemEffect: (id) => window?.Game?.Items?.defs?.[id] ?? null,
	poisonReduce: () => 0,
	dragonMaxHp: () => 0,
	gearDef: (id) => Sg?.story?.mechanics?.()?.equipment?.[id] ?? null,
	mechanics: () => __const_mechanics,
	eventKindLabel: (k) => Sg?.story?.mechanics?.()?.kindLabels?.[k] ?? null,
	chestGold: (rarity) => Sg?.story?.mechanics?.()?.chest?.gold?.[rarity] ?? 0,
	enemyDef: (id) => Sg?.story?.mechanics?.()?.enemies?.[id] ?? null,
	caveReward: (k) => Sg?.story?.mechanics?.()?.caveRewards?.[k] ?? null,
	chestDef: (id) => Sg?.story?.mechanics?.()?.chest?.mechanisms?.[id] ?? null,
	lootOf: (rarity) => Sg?.story?.mechanics?.()?.chest?.loot?.[rarity] ?? [],
	lootText: (r, base) => {
		const bits = [];
		if (r?.gold > 0) bits.push(`旧币 ${r.gold} 枚`);
		if (r?.item) bits.push(`一把${({
	'钥匙': '锈钥匙'
})[r.item] ?? r.item}`);
		if (!bits.length) return '';
		return `${base ?? ''}他退开的地方散着${bits.join('，还有')}。`.trim();
	},
});
