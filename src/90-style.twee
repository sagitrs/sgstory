:: StoryStyleSheet [stylesheet]
/* ── 迷雾森林 · 暗色主题 ─────────────────────────────── */
body {
	background-color: #191722;
	background-image:
		radial-gradient(ellipse at 50% -10%, #2c2742 0%, transparent 55%),
		radial-gradient(ellipse at 50% 110%, #20282b 0%, transparent 50%);
	color: #e6dfd2;
	font-family: 'LXGW WenKai', 'LXGW WenKai Screen', 'Kaiti SC', 'STKaiti', 'KaiTi', 'Noto Serif SC', serif;
	-webkit-font-smoothing: antialiased;
	text-rendering: optimizeLegibility;
}

#passages {
	max-width: 620px;
	margin: 2em auto;
	padding: 0 1em;
}

.passage {
	font-size: 1.15em;
	line-height: 2.1;
	text-align: left;
	letter-spacing: 0.04em;
	text-shadow: 0 1px 2px rgba(0, 0, 0, 0.45);
	animation: fadein 0.6s ease;
}

@keyframes fadein {
	from { opacity: 0; transform: translateY(6px); }
	to   { opacity: 1; transform: none; }
}

/* 链接 */
.passage a.link-internal {
	color: #a9c0da;
	border-bottom: 1px dotted rgba(169, 192, 218, 0.45);
	text-decoration: none;
}
.passage a.link-internal:hover {
	color: #dde8f4;
	background: rgba(169, 192, 218, 0.10);
}
.passage a.link-internal:active {
	color: #eccf96;
}

/* 侧边栏 */
#story {
	border-right: none;
}
#menu li a {
	color: #8b8497;
}
#menu li a:hover {
	color: #d3e2f5;
}

/* 血条 */
.hpbar {
	position: relative;
	height: 22px;
	background: #2c2836;
	border: 1px solid #4a4358;
	border-radius: 11px;
	overflow: hidden;
	margin: 0.8em auto;
	max-width: 320px;
}
.hpbar-fill {
	height: 100%;
	transition: width 0.4s ease;
	border-radius: 11px 0 0 11px;
}
.hpbar-text {
	position: absolute;
	inset: 0;
	text-align: center;
	font-size: 0.78em;
	line-height: 22px;
	color: #fff;
	text-shadow: 0 1px 2px rgba(0, 0, 0, 0.9);
}

/* 受伤提示 */
.damage-flash {
	display: block;
	color: #da8a95;
	margin: 0.4em 0;
}

/* 标题画面 */
.title-card {
	text-align: center;
	margin: 2.5em 0;
}
.title-card h1 {
	font-size: 2.4em;
	letter-spacing: 0.35em;
	margin: 0 0 0.3em;
	color: #d3e2f5;
	text-shadow: 0 0 24px rgba(157, 180, 212, 0.45);
}
.title-card .subtitle {
	color: #8b8497;
	font-size: 0.9em;
	letter-spacing: 0.2em;
}
.title-card .engine-credit {
	margin-top: 2.2em;
	font-size: 0.72em;
	color: #5f5a6d;
	letter-spacing: 0.05em;
}

/* 结局画面 */
.ending-card {
	border: 1px solid #4a4358;
	border-radius: 10px;
	padding: 1.2em 1.6em;
	margin: 1.5em 0;
	background: rgba(20, 18, 28, 0.7);
	box-shadow: 0 0 32px rgba(0, 0, 0, 0.5) inset;
}
.ending-card h2 {
	text-align: center;
	letter-spacing: 0.15em;
	margin-top: 0;
}
.ending-card table {
	margin: 0 auto;
	border-spacing: 1em 0.3em;
	font-size: 0.95em;
}
.ending-card td:first-child {
	color: #8b8497;
	padding-right: 0.5em;
	text-align: right;
}

/* ── 车卡流程 ── */
.chargen-card {
	border: 1px solid #4a4358;
	border-radius: 10px;
	padding: 1.2em 1.5em;
	background: rgba(20, 18, 28, 0.7);
}
.mode-expert {
	margin-top: 1.2em;
	text-align: center;
	padding: 0.7em;
	border-top: 1px dashed #4a4358;
}
.mode-expert a.link-internal {
	color: #8b8497;
	font-size: 0.88em;
}
.mode-expert a.link-internal:hover {
	color: #d3e2f5;
}
.chargen-progress {
	color: #8b8497;
	font-size: 0.8em;
	letter-spacing: 0.2em;
}
.chargen-card h3 {
	letter-spacing: 0.2em;
	margin: 0.3em 0;
}
.chargen-intro {
	color: #c8c0b0;
}
.choices {
	display: grid;
	grid-template-columns: repeat(auto-fit, minmax(min(170px, 100%), 1fr));
	gap: 0.8em;
	margin-top: 1em;
}
.choice-card {
	border: 1px solid #3c3648;
	border-radius: 8px;
	padding: 0.9em 1em;
	background: rgba(44, 40, 54, 0.5);
	display: flex;
	flex-direction: column;
	gap: 0.4em;
	transition: border-color 0.2s, transform 0.2s;
}
.choice-card:hover {
	border-color: #9db4d4;
	transform: translateY(-2px);
}
.choice-name {
	font-size: 1.1em;
	letter-spacing: 0.15em;
	color: #d3e2f5;
}
.choice-desc {
	color: #a89f92;
	font-size: 0.9em;
	flex: 1;
}
.choice-effect {
	color: #7fb285;
	font-size: 0.82em;
}
.choice-card a.link-internal {
	text-align: center;
	display: block;
	border: 1px solid #4a4358;
	border-radius: 6px;
	padding: 0.3em 0;
}

/* ── 检定结果框 ── */
.check-result {
	border-left: 3px solid;
	border-radius: 4px;
	padding: 0.5em 0.9em;
	margin: 0.8em 0;
	font-size: 0.95em;
	background: rgba(44, 40, 54, 0.5);
}
.check-result.check-success {
	border-color: #74b57c;
}
.check-result.check-fail {
	border-color: #d3707f;
}
.check-dice {
	color: #9db4d4;
	font-family: monospace;
}

/* ── 角色卡总览 ── */
.charsheet {
	border: 1px solid #4a4358;
	border-radius: 10px;
	padding: 1.2em 1.6em;
	background: rgba(20, 18, 28, 0.7);
}
.charsheet h2 {
	text-align: center;
	letter-spacing: 0.15em;
	margin-top: 0;
}
.charsheet-line {
	text-align: center;
	color: #8b8497;
}
.ability-table {
	width: 100%;
	table-layout: fixed;
	margin: 1em auto;
	border-spacing: 0.6em 0.3em;
	text-align: center;
}
.ability-table th {
	color: #8b8497;
	font-weight: normal;
	font-size: 0.85em;
}
.charsheet-rows {
	display: flex;
	flex-direction: column;
	gap: 0.3em;
}
.charsheet-rows .label {
	color: #8b8497;
	display: inline-block;
	min-width: 5.5em;
}

/* ── D6 窄屏适配（≤480px，#40）：卡片/表格/血条/检定框不溢出 ── */
@media (max-width: 480px) {
	#passages { padding: 0 0.5em; }
	.chargen-card, .charsheet, .passage .codex-hub { padding: 0.8em; }
	.charsheet h2 { font-size: 1.1em; letter-spacing: 0.05em; }
	.ability-table { font-size: 0.85em; }
	.act-group { padding: 0.35em 0.5em; }
	.ending-card { padding: 0.8em 0.9em; margin: 1em 0; }
	.ending-card table { font-size: 0.85em; border-spacing: 0.6em 0.2em; }
	.check-result { font-size: 0.85em; padding: 0.4em 0.6em; }
	.hpbar-text { font-size: 0.8em; }
	.choice-card { padding: 0.6em 0.7em; }
	.tower-hub ul { padding-inline-start: 1.2em; }
	.tower-hub li { margin: 0.3em 0; }
}

/* ── 设定集（伞 #64 子票 2）：hub 卡片与锁定态视觉弱化 ── */
.codex-hub {
	border: 1px solid #4a4358;
	border-radius: 10px;
	padding: 1em 1.4em;
	margin: 1em 0;
	background: rgba(20, 18, 28, 0.7);
}
.codex-hub h2 { text-align: center; letter-spacing: 0.15em; }
.codex-note { color: #8b8497; font-size: 0.9em; text-align: center; }
/* 设定集页脚：UI 开关等小字脚注（#202）——置底、弱化，不与内容目录并列 */
.codex-foot { color: #8b8497; font-size: 0.78em; text-align: center; margin-top: 1.6em; padding-top: 0.6em; border-top: 1px solid #3a3542; }
.codex-locked { color: #5a5468; display: block; margin: 0.25em 0; font-size: 0.95em; }
.codex-hub .macro-link { display: block; margin: 0.25em 0; }

/* ── 道具图鉴（v17 M8）────────────────────────────────── */
.codex-entry { border-top: 1px solid #3a3548; padding: 0.5em 0; }
.codex-entry h4 { margin: 0.2em 0; letter-spacing: 0.08em; }
.codex-entry.codex-locked h4 { color: #5a5468; }
.codex-clues { margin: 0.2em 0 0.2em 1.1em; padding: 0; }
.codex-clues li { color: #b9b2c6; font-size: 0.95em; margin: 0.15em 0; }
.codex-hint { margin: 0.2em 0 0; color: #8b8497; font-size: 0.92em; font-style: italic; }
.codex-hint-off { color: #5a5468; }

/* ── 常驻存档栏 + 物品栏（v16 §5.0）────────────────────── */
.save-bar {
	display: flex;
	flex-wrap: wrap;
	gap: 6px;
	margin: 0 0 0.8em;
}
.save-bar .save-btn {
	display: inline-block;
	font-family: inherit;
	padding: 3px 8px;
	font-size: 0.82em;
	line-height: 1.6;
	cursor: pointer;
	border: 1px solid rgba(169, 192, 218, 0.35);
	border-radius: 6px;
	color: #a9c0da;
	background: rgba(169, 192, 218, 0.08);
	user-select: none;
}
.save-bar .save-btn:hover { background: rgba(169, 192, 218, 0.2); }
.save-bar .save-btn:focus-visible { outline: 2px solid #a9c0da; outline-offset: 2px; }
.inv-block { margin-top: 0.6em; }
.inv-list {
	display: flex;
	flex-wrap: wrap;
	gap: 3px 8px;
	font-size: 0.88em;
	line-height: 1.7;
}
.inv-item { color: #cfd8c8; }

/* ── M1 骨架补充 ─────────────────────────────────────── */
.flip-note { color: #a9c0da; font-size: 0.95em; }
.econ-note { color: #b8a97e; font-size: 0.9em; }
.gain { color: #9fd0a0; }
.era-drained { color: #8b8497; font-style: italic; }

/* ── 交涉面板（B2）：诉求 ＋ 一列表开口方式／筹码 ───────────────────────── */
.soc-ask {
	margin: 0.8em 0;
	padding: 0.6em 0.9em;
	border-left: 3px solid #7c6a4f;
	background: rgba(124, 106, 79, 0.08);
}
.soc-ask > .soc-opts { display: block; margin-top: 0.35em; }
.soc-ask .soc-opts a { display: block; width: fit-content; max-width: 100%; margin-top: 0.6em; }
.soc-meta { display: block; color: #8a7f6a; font-size: 0.86em; overflow-wrap: anywhere; }
.soc-said { display: block; margin-top: 0.3em; }
.soc-cost { display: block; color: #9a6b4f; font-size: 0.9em; }
.soc-no, .soc-done { color: #8a7f6a; font-style: italic; }
.tavern-tables a { display: block; width: fit-content; max-width: 100%; margin: 0.4em 0; }
/* ── #180 同页交互分区：行动分组 + 已读折叠（#179）── */
.tavern-actions { display: flex; flex-direction: column; gap: 0.55em; margin-top: 1em; }
.act-group {
	border: 1px solid rgba(169, 192, 218, 0.25);
	border-radius: 10px;
	padding: 0.45em 0.7em;
	background: rgba(20, 24, 34, 0.45);
}
.act-group > summary { cursor: pointer; font-weight: 600; letter-spacing: 0.04em; }
.act-group[open] > summary { margin-bottom: 0.35em; }
.act-n { color: #8b8497; font-weight: 400; }
.act-n:not(:empty)::before { content: "·"; margin: 0 0.4em; }
.heard-fold { margin-top: 1.2em; border-top: 1px dashed rgba(169, 192, 218, 0.2); padding-top: 0.4em; }
.heard-fold > summary { cursor: pointer; color: #8b8497; }
.heard-fold[open] > summary { margin-bottom: 0.4em; }
.heard-item { margin: 0.55em 0; }
.action-feedback:focus-visible { outline: 1px solid #a9c0da; outline-offset: 0.3em; }
/* ── #185 阶段二：T-场景行动区（通用）＋ T-战斗回合连续（检定→你→它→下一轮，紧凑成块）── */
.scene-acts { display: flex; flex-direction: column; gap: 0.55em; margin-top: 1em; }
/* #261 键盘：跳转链接聚焦才现 */
.skip-link {
	position: absolute; left: -9999px; top: 0; z-index: 90;
	background: #2c2742; color: #e6dfd2; padding: 0.4em 0.7em;
	border: 1px solid rgba(169, 192, 218, 0.35); border-radius: 8px;
}
.skip-link:focus { left: 0.6em; }
/* 结果留屏：本次结果槽（#262 通用，行动区正上方） */
.scene-feedback {
	border-left: 3px solid rgba(169, 192, 218, 0.45);
	padding: 0.35em 0.6em; margin: 0.8em 0;
	background: rgba(20, 24, 34, 0.5); border-radius: 0 8px 8px 0;
}
.scene-feedback:empty { display: none; }
#hall-act .check-result, #hall-act .damage-flash, #hall-act .gain { display: inline-block; margin: 0.15em 0; }
.scene-acts > a { display: block; width: fit-content; max-width: 100%; margin: 0.3em 0; }
.fight-log { margin: 0.45em 0; }
.fight-acts { margin-top: 1em; }
.fight-acts a { display: block; width: fit-content; max-width: 100%; margin: 0.4em 0; }
.fight-acts .fight-meta { color: #8a7f6a; }

@media (prefers-reduced-motion: reduce) {
	.passage { animation: none; transition: none; }
	.choice-card, .hpbar-fill { transition: none; }
	.choice-card:hover { transform: none; }
}
/* ── 结局页收尾卡（C1）── */
.ending-foot {
	margin: 2em 0 1em;
	padding: 1em 1.1em;
	border: 1px solid rgba(200, 180, 255, 0.28);
	border-radius: 8px;
	background: rgba(24, 20, 40, 0.55);
}
.ending-foot-lead { margin: 0 0 0.7em; opacity: 0.85; }
.ending-acts { display: flex; flex-wrap: wrap; gap: 0.6em; }
.ending-acts .end-act {
	font: inherit;
	cursor: pointer;
	padding: 0.45em 0.9em;
	color: inherit;
	background: rgba(60, 50, 95, 0.7);
	border: 1px solid rgba(200, 180, 255, 0.35);
	border-radius: 6px;
}
.ending-acts .end-act:hover:not([disabled]) { background: rgba(86, 72, 130, 0.85); }
.ending-acts .end-act[disabled] { opacity: 0.45; cursor: not-allowed; }
.ending-foot-hint { margin: 0.7em 0 0; font-size: 0.88em; opacity: 0.7; line-height: 1.5; }

/* ── 系统提示 vs 叙事（#168 P2-5）：机制提示统一小字侧排，跟故事里的括号分开 ── */
.sys-note {
	display: block;
	margin: 0.35em 0;
	padding: 0.25em 0.7em;
	font-size: 0.86em;
	line-height: 1.55;
	opacity: 0.72;
	border-left: 2px solid rgba(200, 180, 255, 0.35);
}
/* ── 设定集词条（#168 P2-6）：定义性破折号改换行小标题 ── */
.cx-term {
	display: block;
	margin-top: 0.5em;
	font-weight: 600;
	letter-spacing: 0.06em;
	opacity: 0.92;
}
/* #180 三区之「本次回答」：新听到的那条紧贴行动区上方（阅读方向恒向下，#179） */
.fresh-heard { margin-top: 1em; padding-top: 0.15em; border-top: 1px solid rgba(169, 192, 218, 0.18); }
.fresh-heard .heard-item { margin: 0.45em 0; }
