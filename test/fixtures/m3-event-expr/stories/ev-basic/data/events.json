{
 "section": "Game Events",
 "note": "★#1562 阶 2a＋2b：子句 when/args/effect（就地）＋ call 子事件（无参 ⇒ ✗ 不隐式继承 args）",
 "events": {
  "斩": {
   "label": "斩",
   "value": 3,
   "properties": [
    "weapon"
   ],
   "use": [
    {
     "when": {
      "and": [
       {
        "gte": [
         {
          "rand": 20
         },
         "that.ac"
        ]
       },
       {
        "contains": [
         "that.properties",
         "enemy"
        ]
       }
      ]
     },
     "args": {
      "$1": "this.value"
     },
     "effect": {
      "hp": {
       "sub": [
        "that.hp",
        "$1"
       ]
      },
      "伤.累计": {
       "add": [
        "that.伤.累计",
        "$1"
       ]
      }
     },
     "text": {
      "format": "小刀劈中了{{目标}}，造成 {{伤害}} 点伤害。",
      "目标": "that.name",
      "伤害": "use:that.amount"
     }
    },
    {
     "call": "斩·空"
    }
   ]
  },
  "斩·空": {
   "label": "斩·空",
   "use": [
    {
     "effect": {
      "空砍": {
       "add": [
        "that.空砍",
        1
       ]
      }
     },
     "text": {
      "format": "小刀挥空了——{{目标}}闪开了。",
      "目标": "that.name"
     }
    }
   ]
  },
  "用绷带": {
   "label": "用绷带",
   "use": [
    {
     "when": {
      "lte": [
       {
        "sub": [
         "that.maxHp",
         "that.hp"
        ]
       },
       0
      ]
     },
     "text": {
      "format": "{{目标}}没有受伤，绷带派不上用场。",
      "目标": "that.name"
     }
    },
    {
     "text": {
      "format": "给{{目标}}包扎了伤口。",
      "目标": "that.name"
     }
    }
   ]
  }
 }
}
