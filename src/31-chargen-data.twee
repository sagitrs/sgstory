				apply(pc) { pc.gear.push('长剑'); } },
			{ name: '疗伤药膏', desc: '气味刺鼻，但管用。', effect: '受伤时自动消耗一副，回复 4 点生命（女巫处可回购补充）',
				apply(pc) { pc.gear.push('药膏'); pc.salves += 1; } },
		],
	},
	{
		title: '起源专长',
		intro: '在你成为你之前，有件事早已注定：',
		options: [
			{ name: '警觉', desc: '你睡觉都睁着一只眼。', effect: '察觉检定优势',
				apply(pc) { pc.feats = ['警觉']; } },
			{ name: '坚韧', desc: '打不倒你的，会让你更难打倒。', effect: '生命值上限 +2',
				apply(pc) { pc.feats = ['坚韧']; pc.max_hp += 2; } },
			{ name: '巧手', desc: '你的手指比大多数人的舌头还利索。', effect: '金币 +5',
				apply(pc) { pc.feats = ['巧手']; pc.gold += 5; } },
