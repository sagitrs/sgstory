:: Rules [script]

/* `#1048`：**取值词汇 · 引擎派生标签**（可检索载体 ㊷——与 `pc` 字段集对账的单一权威）。
 *注意：对账判据（能假）：`pc` 初始化里出现 `xxxLabel` 字段而此处未登记 → `test/prose-vocabulary.mjs` 红。 */
Object.assign(window.Game ??= {}, {
	VALUE_LABELS: Object.freeze(['classLabel', 'bgLabel', 'speciesLabel']),
});
// ── 规则内核（d20 / SRD 5.2 风格）——数值层单一源 ─────────────
// 设计模式参考（未复制代码）：Another-RPG-Engine (MIT) 修饰栈 / foundryvtt-dnd5e (MIT) 公式组织
// 规则数值来源：D&D SRD 5.2（CC BY 4.0, © Wizards of the Coast）
// #320 阶段 4：规则内核挂到 `Game.Rules`（本文件最早加载，故在此建命名空间根）
window.Game ??= {};
// ── **引擎保留槽的登记归引擎**（`#581`）：这些键由**引擎自己**写/读（结果槽、交涉台账、骰面快照、
// 战斗台账、结局登记、笔记存储），与故事内容无关 → 登记（`Consequences.engine`，D2 门的“归属桶”）
// 由引擎在这里种一份默认，故事 2/3 不必再为它们背书。
// 理由必须**非空**（否则 `--consequences` 判“声明缺理由 → 红”）；键必须是**引擎独占**的
//（若某个故事在**叙事段落**读它，门会判“错标”——那就说明该键不属于这一档）。
// 故事仍可覆盖/追加自己的 `Consequences`（故事 1 就是整块给；用 `Object.assign` 追加不会把引擎这半清掉）。
Object.assign(((window.Game.Consequences ??= { provenance: {}, engine: {} }).engine), {
	ending: '结局登记：致命伤安全网与结局页读它（引擎侧）',
	last_result: '结果槽：`<<actOut>>` 把本次结果暂存于此（#270 通用留屏）',
	last_roll: '骰面快照：`<<lastcheck>>` 复显用',
	soc: '交涉台账：渲染期结算后清空',
	soc_lever: '交涉优势筹码：随下一次手段掷骰消费后清空',
	soc_last: '交涉回显：面板展示用',
	notes: '笔记「已授予」真存储（`Sg.notes.has` 的存储面）',
	// 注：`fight`（战斗台账）**故意不在引擎默认里** —— 它是**故事相关**的：有战斗内容的故事
	//（无名洞窟）会在**叙事段落**读它（`<<if $pc.ev.fight.wave>>`）→ D2 会算成 `mechanic` 桶，
	// 此时再声明为 `engine` 就是“错标”；没有战斗内容的故事（minimal-demo）才是引擎面 → 由**它自己**登记。
});
// ── 加载期常量：**已搬到 `src/engine/10-const.twee`**（`#660` 片二 Q1）──
// `Game.Era`（时代枚举）与 `Game.Damage`（伤害档梯）是**引擎政策**、不是故事数据。
// 本文件**不再定义**它们（谁是源必须唯一）——只依赖 ORDER 保证那一份先加载（`scripts/module-order.mjs`，
// 本文件排在 `10-const` **之后**），历史原因与口径写在那一页的头注里。
// ── 随机源（#441-A 抽纯函数的第一步）：**唯一取值口**，可注入 ──────────────
// 为什么要有它：`#441` 的四条验收之一是「战斗/交涉/位点判定能**不经浏览器**在 node 里驱动」——
// 而 `random()`（SugarCube 全局）在 node 里不存在 → 判定函数必须把随机源当**依赖**而不是直接调。
// 纪律：`10-kernel`／`50-present` 里**不得出现直调 `Math.random()`**（本文件与后续 sim 件一律走此处）。
// 注入方式：浏览器/ jsdom 默认走 SugarCube `random()`（harness 覆盖 `window.Math.random` 仍然有效）；
// node 侧先 `Game.Rules.rng.set((lo, hi) => k)` 再驱动。
window.Game.Rules = {
	rng: {
		_impl: null,
		set(fn) { this._impl = fn; return this; },
		reset() { this._impl = null; return this; },
		d(n) {
			if (this._impl) return this._impl(1, n);
			// `#491` 判据 10：URL 给了 `?seed=` → 惰性装上内联 PRNG（**整局骰子固定**；没给则零影响）
			const dbg = window.Game?.Rules?.debug;
			if (dbg && dbg.seed != null && typeof window.Game.Rules.seedRng === 'function') {
				this._impl = window.Game.Rules.seedRng(dbg.seed);
				return this._impl(1, n);
			}
			if (typeof random === 'function') return random(1, n);   // SugarCube 默认源
			throw new Error('Game.Rules.rng 未注入随机源：node 环境请先 Game.Rules.rng.set(fn)');
		},
	},
	// ── `#491` 判据 10：**调试开关**（限"构建期/URL 参数"，**不进玩家 UI**）───────────────
	// 口径（已定 ⑩）：① 只在 URL 带参数时生效 → 默认**零影响**；② 只影响**随机与事件池**，不动规则/数值表；
	// ③ 不渲染任何 UI（玩家看不到开关本身）→ 验收的确定性证据由它提供（`?seed=123&pool=short,long,chest`）。
	debug: (() => {
		try {
			const q = new URLSearchParams((typeof location !== 'undefined' && location.search) || '');
			const seed = q.get('seed'), pool = q.get('pool');
			return {
				seed: seed == null || seed === '' || !Number.isFinite(Number(seed)) ? null : (Number(seed) >>> 0),
				pool: pool ? pool.split(',').map((s) => s.trim()).filter(Boolean) : null,
			};
		} catch { return { seed: null, pool: null }; }             // 无 location（vm/node）→ 空开关
	})(),
	/** 内联 PRNG（mulberry32；不引 `scripts/` 的 node 侧工具，那些不进产物）。 */
	seedRng(seed) {
		let a = seed >>> 0;
		return (lo, hi) => {
			a = (a + 0x6D2B79F5) >>> 0;
			let x = Math.imul(a ^ (a >>> 15), 1 | a);
			x = (x + Math.imul(x ^ (x >>> 7), 61 | x)) ^ x;
			return lo + Math.floor((((x ^ (x >>> 14)) >>> 0) / 4294967296) * (hi - lo + 1));
		};
	},
	ABILITIES: { str: '力量', dex: '敏捷', con: '体质', int: '智力', wis: '感知', cha: '魅力' },
	SKILLS: {
		运动: 'str', 体操: 'dex', 巧手: 'dex', 隐匿: 'dex',
		奥秘: 'int', 历史: 'int', 调查: 'int', 自然: 'int', 宗教: 'int',
		驯兽: 'wis', 洞悉: 'wis', 医药: 'wis', 察觉: 'wis', 生存: 'wis',
		欺瞒: 'cha', 恐吓: 'cha', 表演: 'cha', 游说: 'cha',
	},
	mod(score) { return Math.floor(((score ?? 10) - 10) / 2); },
	fmod(score) { const m = this.mod(score); return m >= 0 ? `+${m}` : `${m}`; },
	abilityMod(pc, ab) { return this.mod(pc.abilities?.[ab]); },
	prof() { return 2; }, // 1–4 级熟练加值（SRD 5.2 曲线）
	skillMod(pc, skill) {
		const ab = this.SKILLS[skill];
		if (!ab) throw new Error(`未知技能: ${skill}`);
		let m = this.abilityMod(pc, ab);
		if ((pc.skills ?? []).includes(skill)) m += this.prof();
		return m;
	},
	d20(adv) {
		if (!adv) return this.rng.d(20);
		const a = this.rng.d(20), b = this.rng.d(20);
		return adv > 0 ? Math.max(a, b) : Math.min(a, b);
	},
	// 判定标注：说清"用什么属性判定"（技能 → 属性，SRD 5.2）
	skillLabel(skill) { const ab = this.SKILLS[skill]; return ab ? `${skill}检定（${this.ABILITIES[ab]}）` : `${skill}检定`; },
	// 取骰：记下两枚供"计算过程"显示（优势取高 / 劣势取低）
	roll(adv) {
		const a = this.rng.d(20);
		if (!adv) return { roll: a, rolls: [a] };
		const b = this.rng.d(20);
		return { roll: adv > 0 ? Math.max(a, b) : Math.min(a, b), rolls: [a, b] };
	},
	// 修正构成（拆项：判定属性 + 熟练 + 加值 + 幸运）
	parts(pc, ability, { skill = '', bonus = 0 } = {}) {
		const out = [{ k: this.ABILITIES[ability] ?? ability, v: this.abilityMod(pc, ability), kind: 'ability' }];
		if (skill && (pc.skills ?? []).includes(skill)) out.push({ k: '熟练', v: this.prof(), kind: 'prof' });
		if (bonus) out.push({ k: '额外加值', v: bonus, kind: 'bonus' });
		if (pc.flags?.luck) out.push({ k: '幸运', v: 1, kind: 'luck' });
		return out;
	},
	// nat：要求「天然出目」等于 nat 才算成功（彩蛋检定用；此时 DC 不参与判定）
	check(pc, skill, dc, { adv = 0, bonus = 0, nat = 0, site = '', advWhy = '', disWhy = '' } = {}) {
		const ability = this.SKILLS[skill];
		if (!ability) throw new Error(`未知技能: ${skill}`);
		const parts = this.parts(pc, ability, { skill, bonus });
		const mod = parts.reduce((n, p) => n + p.v, 0);
		const { roll, rolls } = this.roll(adv), total = roll + mod;
		return { label: this.skillLabel(skill), site, skill, ability, dc, roll, rolls, mod, total, parts, adv, advWhy, disWhy, nat,
			success: nat ? roll === nat : roll === 20 ? true : roll === 1 ? false : total >= dc };
	},
	save(pc, ability, dc, { adv = 0, bonus = 0, nat = 0, site = '', advWhy = '', disWhy = '' } = {}) {
		const parts = this.parts(pc, ability, { bonus });
		const mod = parts.reduce((n, p) => n + p.v, 0);
		const { roll, rolls } = this.roll(adv), total = roll + mod;
		return { label: `${this.ABILITIES[ability]}豁免`, site, ability, dc, roll, rolls, mod, total, parts, adv, advWhy, disWhy, nat,
			success: nat ? roll === nat : roll === 20 ? true : roll === 1 ? false : total >= dc };
	},
};

// ── 角色状态形状：单一默认源 + 旧档迁移（新增字段必须过这里，否则读档即崩）──
window.Game.Pc = {
	// `#1186`：**玩法状态组的在场信号表**（单一真相：模块状态组 ← 故事契约面）。
	//
	// 口径（`#1184` 流一裁定）：模块的状态组不能按"模块文件有没有加载"来判——引擎各模块在任何故事里都加载，
	// 按加载判等于没判。在场信号一律取**故事的接入契约面**（"声明即所用"那条既有线，零新机制）。
	// 键名是契约成员名；`kind` 只用于文档（`fn`＝函数面、`face`＝数据面）。
	//注意：本片只落这张表与判据（键集合暂不动）；按它收窄基础面、各模块注册状态组是同一片的下一步。
	groups: {
		chargen: { keys: ['classKey', 'classLabel', 'bgKey', 'bgLabel', 'speciesKey', 'speciesLabel', 'abilities', 'skills', 'feats', 'gear', 'hp', 'max_hp', 'salves'], present: ['hasChargen'], kind: 'fn' },
		economy: { keys: ['gold'], present: ['econEvents'], kind: 'fn' },
		items: { keys: ['inv'], present: ['itemEffect'], kind: 'fn' },
		gear: { keys: ['gearHp'], present: ['gearDef'], kind: 'fn' },
		checks: { keys: ['statuses'], present: ['checkSite'], kind: 'fn' },
		// `#1227` 类一：`keys` 不再写死 `dragon` —— 战斗组贡献什么键由故事的 `foeStateShape()`（`pcShape` 同路）给；
		// 本行只声明『哪一面在场即启用这一组』。
		combat: { keys: [], present: ['combatPool', 'combatAction'], kind: 'fn' },
		social: { keys: ['soc'], present: ['socialAsks', 'socialHooks'], kind: 'fn' },
	},
	// 取当前 pc（原裸全局 `Game.Pc.now()`，#320 阶段 4 并进来）
	now() { return State.variables.pc; },
	// `#660` 片三-3：**形状住引擎、数值走故事** —— 本函数只给**形状**（键名 ＋ **中性值**：0/''/false/[]/{}），
	// 故事侧用 `Sg.story.pcDefaults()` 叠加它自己的数值（deep-merge 一层，键集合仍由引擎定）。
	// 为什么：`star.charge = 12`／`keeper.state = 'post'` 是**故事 1 的数值**，写在引擎里等于故事 2/3 也带着
	// 故事 1 的量跑（`#660` 片三-3 的边界问题）。缺面 → **显式降级**（只给形状，不报错）；面返回非对象 → **报错**（结构畸形）。
	defaults() {
		const shape = {
			// 基础面（与玩法机制无关；显式清单的单一真相在 `editor/lib/core/pc-state-map.mjs` 的 `PC_BASE_KEYS`）
			name: '', round: 0, picked: [], mode: '', flags: {}, ev: {}, world: {},
			// `#1186`：玩法状态（车卡族与其他六组）**不在这里预置** —— 一律由下面的**在场信号**（故事的接入契约面）贡献；
			// 缺面即无键（判据二"未声明模块的故事角色状态零玩法概念"要的形状）。
			// `#1186`：世界观概念（`star`／`keeper` 这类）由**故事自己声明形状与初值**（契约面 `pcShape`）；引擎不预置、
			// 也**不补兄弟键**（补了等于把形状偷渡回引擎，本票要治的正是这个）。
		};
		// ── `#1186`：在场模块的状态组（信号＝故事的接入契约面）──
		// 车卡族：只有 `hasChargen()` 为真的故事才有这 13 个键。缺面／假值 → 键不存在（判据二"零玩法概念"要的）。
		if (window.Sg?.story?.hasChargen?.() === true) {
			Object.assign(shape, {
				classKey: '', classLabel: '', bgKey: '', bgLabel: '', speciesKey: '', speciesLabel: '',
				abilities: null, skills: [], feats: [], gear: [], hp: 0, max_hp: 0, salves: 0,
			});
		}
		// ── `#1186`：故事自有的状态形状（契约面 `pcShape`：形状与初值一处给，引擎**不补兄弟键**）──
		if (typeof window.Sg?.story?.pcShape === 'function') {
			const own = window.Sg.story.pcShape();
			if (own && typeof own === 'object' && !Array.isArray(own)) {
				for (const [k, v] of Object.entries(own)) shape[k] = (v && typeof v === 'object' && !Array.isArray(v)) ? { ...v } : v;
			}
		}
		// ── `#1186`：在场模块的状态组（信号＝故事的接入契约面，登记见本对象 `groups`）──
		// 缺面 → 键不存在（判据二"未声明模块的故事角色状态零玩法概念"要的形状）。
		const face = (k) => window.Sg?.story?.[k] != null;
		if (face('econEvents')) shape.gold = 0;
		if (face('itemEffect')) shape.inv = {};
		if (face('gearDef')) shape.gearHp = {};
		if (face('checkSite')) shape.statuses = {};
		// `#1227` 类一：**伴生体状态键不再写死** —— 键名与形状由故事经 `pcShape` 声明（`#1186` 的同一路径）；
		// 引擎这里只按『故事有没有对手状态面』决定**要不要**贡献这一组，贡献什么键不归引擎定。
		//（旧写法 `shape.dragon = {...}` 等于把『雾林有一只叫 dragon 的伴生体』写进引擎形状。）
		if (face('foeState')) Object.assign(shape, window.Game?.Combat?.foeShape?.() ?? {});
		if (face('socialAsks') || face('socialHooks')) shape.soc = { att: {}, tries: {}, read: {} };
		// ── 故事数值叠加（`#660` 片三-3）────────────────────────────────────────────
		const extra = window.Sg?.story?.pcDefaults?.();
		if (extra === undefined || extra === null) return shape;        // 缺面 → **显式降级**（只给形状）
		if (typeof extra !== 'object' || Array.isArray(extra)) {
			throw new Error('Sg.story.pcDefaults()：必须返回对象（结构畸形必须报错，#660 片三-3）');
		}
		for (const [k, v] of Object.entries(extra)) {
			const cur = shape[k];
			// 两边都是对象 → **一层深合并**（保住形状的其它子键：只给 `charge` 不能把 `spent`/`first_free` 抹掉）
			if (v && typeof v === 'object' && !Array.isArray(v) && cur && typeof cur === 'object' && !Array.isArray(cur)) Object.assign(cur, v);
			else shape[k] = Array.isArray(v) ? [...v] : v;
		}
		return shape;
	},
	has(name) { return !!State.variables.pc?.inv?.[name]; },
	// ── `#746`（口径：「文字反馈最重要」）：**副作用要能自己说出数字** ──────────────────────
	// 为什么住引擎：句子由内容面写（文案属故事），但"掉了多少血／上了什么异常／哪件护具掉了几点耐久／
	// 拿了什么"是**机制算出来的** —— 让作者手写这些数字，一定会漏（实测：失败/惩罚路径普遍没接句子）。
	// 用法（内容面）：
	// <<set _snap to Game.Pc.snap($pc)>> …做点什么… <<caveEffect _snap>>
	// 口径：**纯函数**（不改 pc）· 只报**变化项**（无变化 → 空串 → 调用方不打印）· 顺序稳定（便于门与复核）。
	snap(pc) {
		return {
			hp: pc?.hp ?? 0, gold: pc?.gold ?? 0,
			gearHp: { ...(pc?.gearHp ?? {}) },
			statuses: JSON.parse(JSON.stringify(pc?.statuses ?? {})),
			inv: { ...(pc?.inv ?? {}) },
		};
	},
	/** 差分：返回**人话数组**（每项一段），例如 `−3 生命`／`获得异常：手臂·流血（5 回合）`／`耐久 火把 2→1`／`得到 干粮`／`−5 金币`。 */
	diff(before, pc) {
		const out = [];
		const b = before ?? {};
		const hp0 = b.hp ?? 0, hp1 = pc?.hp ?? 0;
		if (hp1 !== hp0) out.push(`${hp1 > hp0 ? '+' : '−'}${Math.abs(hp1 - hp0)} 生命（${hp0}→${hp1}）`);
		const g0 = b.gold ?? 0, g1 = pc?.gold ?? 0;
		if (g1 !== g0) out.push(`${g1 > g0 ? '+' : '−'}${Math.abs(g1 - g0)} 金币（${g0}→${g1}）`);
		const bStatus = b.statuses ?? {}, nowStatus = pc?.statuses ?? {};
		for (const [part, bag] of Object.entries(nowStatus)) {
			for (const [id, turns] of Object.entries(bag ?? {})) {
				const was = bStatus?.[part]?.[id];
				if (was !== turns) out.push(`获得异常：${part}·${id}（${turns} 回合）`);
			}
		}
		for (const [part, bag] of Object.entries(bStatus)) {
			for (const id of Object.keys(bag ?? {})) if (!nowStatus?.[part]?.[id]) out.push(`解除异常：${part}·${id}`);
		}
		const bGear = b.gearHp ?? {}, nowGear = pc?.gearHp ?? {};
		for (const k of [...new Set([...Object.keys(bGear), ...Object.keys(nowGear)])].sort()) {
			if ((bGear[k] ?? null) !== (nowGear[k] ?? null)) out.push(`耐久 ${k} ${bGear[k] ?? '?'}→${nowGear[k] ?? '?'}`);
		}
		const bInv = b.inv ?? {}, nowInv = pc?.inv ?? {};
		for (const k of [...new Set([...Object.keys(bInv), ...Object.keys(nowInv)])].sort()) {
			if (!bInv[k] && nowInv[k]) out.push(`得到 ${k}`);
			if (bInv[k] && !nowInv[k]) out.push(`失去 ${k}`);
		}
		return out;
	},
	migrate(pc) {
		if (!pc || typeof pc !== 'object') return this.defaults();
		const d = this.defaults();
		for (const k of Object.keys(d)) {
			if (pc[k] === undefined) pc[k] = d[k];
			else if (Array.isArray(d[k])) { if (!Array.isArray(pc[k])) pc[k] = d[k]; }
			else if (d[k] === null) { if (pc[k] !== null && typeof pc[k] !== 'object') pc[k] = d[k]; }
			else if (typeof d[k] === 'object') {
				if (!pc[k] || typeof pc[k] !== 'object' || Array.isArray(pc[k])) pc[k] = d[k];
				else for (const j of Object.keys(d[k])) if (pc[k][j] === undefined) pc[k][j] = d[k][j];
			}
		}
		// `#437` C-2c-2：旧档的知识面**写一次迁移**（旗标 → `ev.notes` 真存储）。
		// 放在最后、幂等：新档没有旗标可迁（返回 0），旧档每次载入都会补齐（补完即 0）。
		// 结构缺失（故事未注册笔记表）时 `Sg.notes` 自己 fail-loud → 这里不吞错。
		window.Sg?.notes?.migrateLegacy?.(pc);
		return pc;
	},
};

// ── 宏：<<check 技名 DC [adv|dis] [加值]>> / <<save 属性 DC [adv|dis] [加值]>> ──
// 计算过程显示开关（"显示计算过程"；关掉只剩结果）。本地持久化，与图鉴同一套 localStorage 套路
// #320 阶段 2：UI 与运行时统一挂到 `Sg.*`（数据/规则挂 `Game.*`，见 docs/dev-conventions.md §7）
window.Sg ??= {};
window.Sg.UI = {
	// #441-B/#462：键构造收敛到 `Sg.store`（本处是 **engine** 作用域 → 不加故事前缀，
	// 键名仍是 `sgstory.ui.v1` → 与旧档兼容、无需迁移；跨故事共享「显示计算过程」这类偏好）。
	key() { return window.Sg.store.key('engine', 'ui.v1'); },
	read() { try { return JSON.parse(window.localStorage.getItem(this.key()) ?? '{}') ?? {}; } catch { return {}; } },
	write(d) { try { window.localStorage.setItem(this.key(), JSON.stringify(d)); } catch { /* 降级：本次会话有效 */ } },
	showDetail() { const d = this.read(); return d.detail === undefined ? true : !!d.detail; },
	setDetail(on) { const d = this.read(); d.detail = !!on; this.write(d); },
	toggle() { this.setDetail(!this.showDetail()); },
	// 设定集里的开关（<<replace>> 就地重画）
	renderToggle() {
		if (this.showDetail()) {
			return `计算过程：'''开'''　${'<<link "关掉：只留骰面与总修正">><<set _t to Sg.UI.toggle()>><<replace "#ui-detail">><<= Sg.UI.renderToggle()>> <</replace>><</link>>'}`;
		}
		return `计算过程：'''关'''　${'<<link "打开：显示属性、熟练与取骰过程">><<set _t to Sg.UI.toggle()>><<replace "#ui-detail">><<= Sg.UI.renderToggle()>> <</replace>><</link>>'}`;
	},
};

function renderCheck(res) {
	// #441-A：本函数改为**纯渲染**（不再写 `State.variables.last_check`）——
	// 结果槽的写入属「算」那一步（`Game.Checks.resolve`／`check`·`save` 宏），present 只渲染。
	const cls = res.success ? 'check-success' : 'check-fail';
	const dcStr = res.nat ? `需天然 ${res.nat}` : `DC${res.dc}`;
	const detail = Sg.UI.showDetail();
	const modStr = res.mod >= 0 ? `+${res.mod}` : `${res.mod}`;
	const parts = (res.parts ?? []).filter((p) => p.v).map((p) => `${p.v >= 0 ? '+' : ''}${p.v} ${p.k}`).join(' ');
	const head = `<div class="check-result ${cls}">🎯 <span class="check-label">${res.label}</span>` +
		(res.site ? ` <span class="check-site">〔${res.site}〕</span>` : '') + ` · ${dcStr}：` +
		`<span class="check-dice">d20(${res.roll})</span>${detail && parts ? ` ${parts}` : ` ${modStr}`} = <b>${res.total}</b> ${res.roll === 20 ? '★ 大成功' : res.roll === 1 ? '✘ 大失败' : res.success ? '✔ 成功' : '✘ 失败'}</div>`;
	if (!detail) return head;
	const notes = [];
	if (res.adv > 0) notes.push(`优势：${res.advWhy || '有利条件'}（${(res.rolls ?? []).join(' / ')} 取高）`);
	if (res.adv < 0) notes.push(`劣势：${res.disWhy || '不利条件'}（${(res.rolls ?? []).join(' / ')} 取低）`);
	if (res.nat) notes.push(`只有天然 ${res.nat} 才算成功（DC 不参与）`);
	if (!notes.length) return head;
	return head + `<div class="check-why">↳ ${notes.join(' · ')}</div>`;
}
// <<check 技名 DC [adv|dis] [加值] [nat] [位点] [优势理由] [劣势理由]>>
// #441-A：本宏＝「算 ＋ 写结果槽 ＋ 渲染」的历史入口（段落里的 ad-hoc 检定用它）；
// 位点检定（sitecheck）改走 `Game.Checks.resolve`（算）＋ `<<checkres>>`（渲染）。
Macro.add('check', {
	handler() {
		const adv = this.args[2] === 'adv' ? 1 : this.args[2] === 'dis' ? -1 : 0;
		const res = Game.Rules.check(Game.Pc.now(), this.args[0], this.args[1], {
			adv, bonus: Number(this.args[3]) || 0, nat: Number(this.args[4]) || 0,
			site: this.args[5] ?? '', advWhy: this.args[6] ?? '', disWhy: this.args[7] ?? '',
		});
		State.variables.last_check = res;
		$(this.output).append(renderCheck(res));
	},
});
Macro.add('save', {
	handler() {
		const adv = this.args[2] === 'adv' ? 1 : this.args[2] === 'dis' ? -1 : 0;
		const res = Game.Rules.save(Game.Pc.now(), this.args[0], this.args[1], {
			adv, bonus: Number(this.args[3]) || 0, nat: Number(this.args[4]) || 0,
			site: this.args[5] ?? '', advWhy: this.args[6] ?? '', disWhy: this.args[7] ?? '',
		});
		State.variables.last_check = res;
		$(this.output).append(renderCheck(res));
	},
});
// ── 渲染一枚**已结算**的检定（#441-A）：present 侧入口，只渲染、不掷骰、不写状态 ──
// 用法：<<checkres `Game.Checks.resolve("门厅·翻检", $pc, null)`>>
// 拆开的理由：原 `<<sitecheck>>` 把「推导优势 + 掷骰 + 写结果槽 + 渲染」挤在一个 widget 里，
// 使位点判定只能在浏览器里测（#441 的四条验收之四：不经浏览器可驱动 resolve()）。
Macro.add('checkres', {
	handler() { $(this.output).append(renderCheck(this.args[0])); },
});

// ── 复显上一轮玩家发起的检定骰面（M9；不掷骰，只渲染快照）──
Macro.add('lastcheck', {
	handler() {
		const r = State.variables.pc?.ev?.last_roll;
		if (r) $(this.output).append(renderCheck(r));
	},
});
// 只在"刚掷过这些位点之一"时复显（hub 用：防止拿别处的旧骰面骗人）
// 也接受**一个数组**参数（<<lastcheckFor _a.sites>>）——SugarCube 的宏参数不支持 JS 展开（...），
// 交涉面板的位点表在运行期才知道，只能整表传进来再由这里摊平。
Macro.add('lastcheckFor', {
	handler() {
		// #300 P2：本次结果槽已经带着这一掷的骰面时不再复显（同一颗骰不显示两遍）
		const lr = State.variables.pc?.ev?.last_result;
		if (lr?.hasCheck && lr.p === State.passage) return;
		const sites = this.args.flat(Infinity).map(String);
		const r = State.variables.pc?.ev?.last_roll;
		if (r && sites.includes(r.site)) $(this.output).append(renderCheck(r));
	},
});

// ── 结局登记宏（图鉴用：终局 final 才给空页提示，章节出口 chapter 只记账）──
Macro.add('ending', {
	handler() {
		const key = String(this.args[0] ?? '').trim();
		const kind = String(this.args[1] ?? 'final').trim();
		if (key) {
			State.variables.pc.ev.ending = key;                          // 本档记录
			// `#574`：图鉴是**故事可选面**（故事 1 有、故事 2/3 没有）→ 可选链：没有它就只是不记账。
			window.Sg.Codex?.recordEnding?.(key, kind);  // 永久记录（有图鉴的故事才记）
		}
		// C1 收尾入口：每个结局都要有出口。卡片渲染在调用处（段落顶部），
		// 渲染完由 StoryScript 的:passagerender 挪到段落末尾。
		const foot = window.Sg.Ending?.foot(key, kind);
		if (foot) jQuery(this.output).append(foot);
	},
});

// ── 血条宏 ──────────────────────────────────────────────
Macro.add('hpbar', {
	skipArgs: true,
	handler() {
		const pc = Game.Pc.now();
		const hp = Math.max(0, pc.hp ?? 0), max = pc.max_hp ?? 1;
		const pct = Math.round((hp / max) * 100);
		const color = pct > 50 ? '#5dbb63' : pct > 25 ? '#e0a458' : '#d1495b';
		jQuery(this.output).append(
			`<div class="hpbar"><div class="hpbar-fill" style="width:${pct}%;background:${color}"></div>` +
			`<span class="hpbar-text">❤ ${hp} / ${max}</span></div>`
		);
	},
});
// `#1227` 类一：`dragonbar`（龙专用血条宏）**已删** —— 它是内容专用渲染件（文案里写死"龙"、取数写死
// `Sg.story.dragonMaxHp()`）。通用渲染件是上面的 `<<hpbar>>`；故事要自己的血条形态，走 `<<hpbar>>` 或
// 故事侧自带宏（引擎不再为某一个故事提供渲染件）。

// `#1132` B1：快速成型一次点击 → 写 `$pc.presetIdx` ＋ 跳目标段。段名由调用点给 → 引擎零故事 slug；
// `$i` 是真引擎**求值后**的值 → 没设即 `undefined` → 必须大声报（不许静默跑）。
Macro.add('pickPreset', {
	handler() {
		const dest = String(this.args[0] ?? '');
		const raw = this.args[1];
		const missing = dest === '' || raw === undefined || raw === null || raw === '';
		if (missing) {
			throw new Error('<<pickPreset>> 用法：<<pickPreset "目标段名" 序号>> —— 本次拿到 目标段名=['
				+ dest + ']／序号=[' + String(raw) + ']（序号未设 ⇒ 调用点没 capture 局部量 ⇒ 会静默跑错 ✗）');
		}
		const n = Number(raw);   // `#1132` S1 加固①：调用点可能传文本 → `Number('abc')` = NaN → **静默烂值**
		if (!Number.isFinite(n)) {
			throw new Error('<<pickPreset>> 序号=[' + String(raw) + '] 非数字 ⇒ 会写进烂值（后续 `presets[NaN]` 才炸且报文不知所云 ✗）');
		}
		State.variables.pc.presetIdx = n;
		Engine.play(dest);   // `#1132` B1：用引擎侧程序性导航（同 `80-script.twee` 的既有写法）
		//注意：别把跳转目标拼进 **wiki 宏串**（拼接出的字面宏会被静态分析当成真边 → 假悬空报错 实测踩过）
	},
});

// `#1132` B1：快速成型一次完成（委托既有 `Game.Chargen` 方法 → 本步行为逐字不变）。
// `pcName` 读取与声明式施加器留 B2（届时数据才进 json）；`pc` 未初始化靠 `StoryInit` 先行保证 → 不另设守卫。
Macro.add('applyQuickPreset', {
	handler() {
		const Ch = window.Game?.Chargen;
		const pc = State.variables.pc;
		if (!Ch || typeof Ch.applyPreset !== 'function') {
			throw new Error('<<applyQuickPreset>> 前置缺失：故事的 `Game.Chargen` 未接入（本宏需要其 applyPreset／finalize ✓）');
		}
		Ch.applyPreset(pc.presetIdx ?? 0);
		pc.mode = 'quick';
		if (!pc.finalized) {
			Ch.finalize(pc);
			pc.finalized = true;
		}
		// `#1132` B3：姓名由数据接管（原故事侧那一行 `$pc.name` 已删）——与 `mode`／`finalized` 同处，属宏的职责。
		const P = Ch.presets?.[pc.presetIdx ?? 0];
		if (P?.pcName) pc.name = P.pcName;
	},
});

// `#1216` B 半 Operator 裁：**能力组**——若干成员合起来才是『一个能力』，不是若干独立值。
// 口径一句话：『缺席＝这个能力不在』是一件事；『缺席＝某个值取零』是另一件事（前者门控、后者缺省，别混）。
// 判据件从**本表**派生组员（一处定义、别处引用），不另写一份。
window.Sg.capabilityGroups = { flip: ['flipItem', 'flipStarCost', 'flipReturnFlag'] };
/**
 * 能力组门控（单点入口，两处读点共用）：
 * - 全缺 → 能力关（不崩、不渲染）；
 * - **部分缺 → 出声**点名缺哪几个（半声明是作者错，别静默）；
 * - 全在 → 给参数。**不给数值缺省**（`flipStarCost` 缺省 0 会让『翻转免费』静默成立＝危险缺省）。
 */
window.Sg.capability = (group) => {
	const names = window.Sg.capabilityGroups?.[group];
	if (!names) return { ok: false, reason: 'unknown' };
	const have = names.filter((n) => typeof window.Sg.story?.[n] === 'function');
	if (have.length === 0) return { ok: false, reason: 'off' };
	if (have.length < names.length) return { ok: false, reason: 'partial', missing: names.filter((n) => !have.includes(n)) };
	const out = { ok: true };
	// 键名**显式映射**（原先用 `n.replace(/^flip/,'')` 机械推导 → `flipStarCost` 成了 `starcost`，
	// 调用方要的 `cost` 取到 undefined → `spent` 变 NaN。名字映射要写死，别推导。）
	const KEYS = { flipItem: 'item', flipStarCost: 'cost', flipReturnFlag: 'flag' };
	for (const n of names) out[KEYS[n] ?? n] = window.Sg.story[n]();
	return out;
};

:: StoryInit
/% 全局状态初始化（**形状**单一源见 `Game.Pc.defaults`；**数值**来自 `Sg.story.pcDefaults()`，见 `#660` 片三-3） %/
<<set $player_name to "">>
<<set $pc to Game.Pc.defaults()>>
<<set $era to Game.Era.PRESENT>>

:: Widgets [widget]
/% 受伤 + 药膏自动生效 + 死亡判定。用法：<<damage N>>。
   药膏自动门槛：缺口满 4 点（一副的恢复量）才自动用——满血/轻伤不烧药膏（#201）。 %/

<<widget "firstTime">>
	<<set _first to !$pc.ev[$args[0]]>>
	<<if _first>><<set $pc.ev[$args[0]] to true>><</if>>
<</widget>>

<<widget "damage">><<nobr>>
	<<set $pc.hp to Math.max(0, $pc.hp - $args[0])>>
	<<if $pc.salves gt 0 and $pc.hp gt 0 and ($pc.max_hp - $pc.hp) gte 4>>
		<<set $pc.salves to $pc.salves - 1>>
		<<set $pc.hp to $pc.hp + 4>>
		<span class="damage-flash">''你受到了 $args[0] 点伤害！''（伤得重，消耗一副药膏，恢复 4 点生命）</span>
	<<else>>
		<span class="damage-flash">''你受到了 $args[0] 点伤害！''</span>
	<</if>>
	<<if $pc.hp lte 0>>
		/% #357：致命伤**即刻登记结局**——安全网（:passagestart 的 hp≤0 修补）以
		   `!pc.ev.ending` 为门，若不先登记，它会赶在结局页渲染前把 hp 修回 1，
		   把刚受致命伤的角色"复活"。 %/
		/% `#491` 判据 4：这一跳是**故事可选面**——引擎不得假定每故事都有一页「结局 死亡」
（本仓反复的"引擎知道故事名"族：`hallResult`／`fog_thin`／`Sg.Codex` 同一个教训）。
		   没有该页的故事（用**重置**语义的「无名洞窟」）→ 什么都不做：登记 `ending` 会钉住安全网，
		   还会让故事自己的"回出生点"失去机会（实测：`<<damage>>` 抛 `passage "结局 死亡" does not exist`）。 %/
		<<if Story.has("结局 死亡")>>
			<<set $pc.ev.ending to "死亡">>
			<<goto "结局 死亡">>
		<</if>>
	<</if>>
<</nobr>><</widget>>

/% 检定位点词汇：DC/技能出走 Game.Checks.sites（正文只传位点键）；优势推导与掷骰住在
   `Game.Checks.resolve`（新文件 `src/21-resolve.twee`，sim 侧），本 widget 只负责**调它 + 渲染**。
   为什么这样拆（#441-A）：「点一下既算又画」是「界面/判定分离」在这份代码里的唯一实体障碍——
   抽完后本 widget 体内不再有 `<<set $…>>`（present 不写状态），且 `resolve()` 能在 node 里直接驱动。 %/
<<widget "sitecheck">><<nobr>>
	<<checkres `Game.Checks.resolve($args[0], $pc, $args[1])`>>
<</nobr>><</widget>>

/% 经济事件词汇：金额出走 Game.Economy；gives 自动入账 %/
/% 经济事件词汇：金额出走 Game.Economy；gives 自动入账 %/
/% #441-A：落帐（算价＋金币＋gives）搬去 `Game.Economy.apply`（sim）；文案格式与 `<<socresolve>>`
   共用 `Game.Economy.note`（单一源，否则两处各写一份必漂）。 %/
<<widget "econ">><<nobr>>
	<<set _d to Game.Economy.apply($pc, $args[0]).delta>>
	<span class="econ-note"><<print Game.Economy.note(_d)>></span>
<</nobr>><</widget>>

/% 时代切回现在（不耗星力：时间自己走完的场合专用——宴散/仪式终） %/
<<widget "eraPresent">>
	<<set $era to Game.Era.PRESENT>>
<</widget>>

/% #624 片一：落一条**笔记**（幂等；与 `<<give>>` 同族的词汇宏）。
   为什么要有它：点击态（link 体内）与表行 `text` 里**只该出现词汇宏**，不该出现裸 `<<run Sg.notes.add(…)>>`
   （W1 的允许表里本来也没有裸模块 API）→ 表内表外同一种写法。不打印任何东西（知识到手的文案由内容自己写）。 %/
<<widget "note">><<nobr>>
	<<run Sg.notes.add($args[0])>>
<</nobr>><</widget>>

/% **路径限定的授予**（`#437` 批三 C-2，`#569` 的形状）：`<<notepath "n_hall_hint" "ev.hall_seen">>`。
   与 `<<note>>` 的分工：**单源**笔记用 `<<note>>`；**多源 OR** 的笔记（`flagPath` 是数组）必须用本宏
   ——它显式声明"**写哪一条**"（`world.hall_hint` 还是 `ev.hall_seen`），同名知识的两条获取路径各记各的。
   为什么做成宏而不是放 `<<run Sg.notes.addPath(...)>>`：点击态域只许**可枚举的词汇宏**（W1，`#624`）——
   放模块 API 等于把判据从"白名单 token"退化成"是不是 `Sg.*`"（边际判别力下降）。
   参数顺序与底层 API 一致（`Sg.notes.addPath(id, path, pc)`）；**参数错位**（path 当 id）会 fail-loud（未登记笔记 id → 抛错）。 %/
<<widget "notepath">><<nobr>>
	<<run Sg.notes.addPath($args[0], $args[1])>>
<</nobr>><</widget>>

/% 拾取道具（物品栏）：<<give "日记">> %/
<<widget "give">><<nobr>>
	<<run $pc.inv[$args[0]] = true>>
	<span class="gain">''获得【$args[0]】。''</span>
<</nobr>><</widget>>

/% 检定结果快照（M9）：玩家发起的检定在 link 里掷完骰后存一份，
   结果分支重渲染时用 <<lastcheck>> 复显骰面——否则 <<goto>> 会把骰面一起丢掉 %/
<<widget "snapshot">>
	<<set $pc.ev.last_roll to $last_check>>
<</widget>>

/% 世界旗标：<<setflag "goblin_spared">> %/
<<widget "setflag">>
	/% `#624` 片三：裸键写 `world`（原语义）；**带点路径**（`ev.x`／`world.x`）走 `Sg.notes.writePath`
	   —— 点击态里"置某个 ev 旗标"原先只能裸 `<<set $pc.ev.x to true>>`（表行 `text` 里不许）。 %/
	<<if $args[0].includes('.')>>
		<<run Sg.notes.writePath($pc, $args[0], true)>>
	<<else>>
		<<run $pc.world[$args[0]] = true>>
	<</if>>
<</widget>>

/% `#624` 片三：**取走**一件道具（`<<take "月光花">>` ≡ `delete $pc.inv["月光花"]`）。
   为什么要有它：赠出/交出的位点原本只能裸 `<<run delete $pc.inv[…]>><<set $pc.ev.x to true>>` → 进不了表。
   幂等：没有这件道具也不报错（内容常在条件分支里调用）。 %/
<<widget "take">><<nobr>>
	<<run delete $pc.inv[$args[0]]>>
<</nobr>><</widget>>


/% ── 战斗动作池（B1）：每轮随机 3 选 1；每个动作是一次属性化检定，成/败/大成功各有后果 ──
   回合状态挂在 $pc.ev.fight：{ pool, round, offer, act, adv, guard, skipFoe, flee, done}。
   （`#707`：原有一个 `last` 字段**从未被写过、也没有产品面读者** → 已删；门 `test/fight-fields.mjs` 会盯住这类死字段。）
   点动作只写 $pc.ev.fight.act ＋重渲染（<<goto `passage()`>>）——结算在段落渲染顶部跑完，骰面不会丢。
   <<fightbegin>> 只在"新一场"重置：同池子且没打完＝这就是重渲染，不能清台账。 %/
<<widget "fightbegin">><<nobr>>
	<<if !$pc.ev.fight or $pc.ev.fight.pool isnot $args[0] or $pc.ev.fight.done>>
		/% `#1227` 类一：**这一场有没有"具名对手"是故事数据**（`Combat.poolsNamed` 列出具名对手的池），
		   不再由故事段把 `true/false` 当参数传进引擎（那是"引擎认识哪个故事有龙"的老写法）。 %/
		<<set $pc.ev.fight to { pool: $args[0], namedFoe: Game.Combat.poolIsNamed($args[0]), round: 1, offer: [], act: null, adv: 0, guard: 0, skipFoe: false, flee: false, done: false }>>
	<</if>>
<</nobr>><</widget>>

/% 结算玩家选的那一手 ＋ 对手这一轮的动作 %/
/% #350：**结算必须在点击时刻完成**——渲染期的状态变更不进 moment，S/L 会重掷这一轮
   （与 #300 P1 同源）。fightact＝点击时掷骰/结算/写日志；fightlog＝渲染期**只读**回放。 %/
/% #441-A：本 widget 现在只负责**调 sim ＋ 渲染**——算与写在 `Game.Combat.resolvePlayer`／`resolveFoe`。
   拆两段（而不是一次算完）是为了让**渲染顺序**（玩家骰面 → 玩家受伤闪光 → 对手骰面 → 挨打闪光）
   与 **hp 时序**（玩家受伤后的 hp 决定对手这一轮是否发生）与旧实现逐字一致。 %/
<<widget "fightact">><<nobr>>
	/% #487（S2）：**回合开始 → 异常结算** —— 在玩家行动之前先结算（已定 ⑤的顺序）。
	   未启用新机制（`Sg.story.mechanics()` 为 null）→ `tickStatuses` 返回 null → 这一行完全无副作用。
	   落 HP 仍走 present 的 `<<damage>>`（与其他伤害同一处，保住既有渲染/时序）。 %/
	<<set _st to Game.Combat.tickStatuses($pc)>>
	<<if _st and _st.hurt>><<damage _st.hurt>><</if>>
	<<set _p to Game.Combat.resolvePlayer($pc, $args[0])>>
	<<checkres `_p.check`>>
	<<if _p.hurt>><<damage _p.hurt>><</if>>
	<<set _fo to Game.Combat.resolveFoe($pc, $args[0], _p.log)>>
	<<if _fo.check>><<checkres `_fo.check`>><</if>>
	<<if _fo.hurt>><<damage _fo.hurt>><</if>>
	/% `#701`（症状：战斗屏只有**最后一手**，翻页/重渲染后旧的就没了）：**点击时**（sim 路径，允许写状态）
	   把这一手落进 `$pc.ev.fight.history`（有界环形缓冲，上限住引擎 `Game.Combat.HISTORY_MAX`）→ 渲染面只读回放。
	   **不改掷骰序**：只是把已经算完的 `log` 攒起来（`test/fight-seq.mjs` 仍逐字节不变 → 可机检）。
注意：逻辑住引擎（`Game.Combat.pushLog`）：SugarCube 的 `<<set>>` 吃不下"数组字面量＋方法链"，
	   而且那种失败只在真机初始化时现形（本节踩过一次）。 %/
	<<run Game.Combat.pushLog($pc)>>
<</nobr>><</widget>>

/% 渲染期只读回放上一手（#315 契约：渲染路径不得改状态；#350：S/L 后必须复现同一手） %/
<<widget "fightlog">><<nobr>>
	/% `#701`：先回放**战斗日志**（最近 N 手；上限住 `Game.Combat.HISTORY_MAX`），再面上一手。
	   历史块**独立于** `_L`（重渲染/读档后没有 `_L` 也能回看）；没打过仗（无 `history`）→ 整块不出现。 %/
	<<if $pc.ev.fight.history and $pc.ev.fight.history.length>>
		<div class="fight-history">''第 <<print $pc.ev.fight.moves>> 回合''（你 → 它）
			<<for _h range $pc.ev.fight.history>>
				<div>第 <<print _h.n>> 手：<<print _h.you>><<if _h.foes and _h.foes.length>> ／ <<print _h.foes.join(" ／ ")>><</if>></div>
			<</for>>
		</div>
	<</if>>
	<<set _L to $pc.ev.fight.log>>
	<<if _L>>
		<div class="fight-log">
			''你：<<print _L.you.label>>''　<<if _L.you.kind is "crit">><span class="fight-crit">''大成功''</span><</if>>
			<<print _L.you.text>>
			<div class="meta"><<if _L.you.dmg>>打掉 <<print _L.you.dmg>> 点<</if>><<if _L.you.gearBonus>>（<<print _L.you.gearName>> +<<print _L.you.gearBonus>>）<</if>><<if _L.you.dmg>>　<</if>><<if _L.you.adv>>下一击有优势　<</if>><<if _L.you.guard>>这一轮少挨 <<print _L.you.guard>>　<</if>><<if _L.you.hurt>>自己挨了 <<print _L.you.hurt>>　<</if>><<if _L.you.skipFoe>>它这一轮没能出手　<</if>><<if _L.you.goodNote>>（<<print _L.you.goodNote>>）<</if>><<if _L.you.kind is "bad">>''没能得手''<</if>></div>
		</div>
		<<if _L.foe>><div class="fight-log">''它：''<<print _L.foe.text>>
			/% `#704`（症状：`log.foe.slots` 有数据但渲染面**从不引用** → 玩家看不到"打在哪、被哪件吸了多少、哪件快坏了"）：
			   受击明细**单独一行**（与耐久/异常各占一块，不混排 —— 混排会让"扣了多少"对不上账）。
			   **取值口与 `#703` 侧栏共用** `Game.Combat.gearDurability($pc)`（不写两套）。
			   **未启用槽位的故事没有 `slots` → 这一行整个不出现**（不留空行/问号；这条是门的反例）。 %/
			<<if _L.foe.slots>>
				<<set _s to _L.foe.slots>>
				<<set _max to 0>>
				<<for _g range Game.Combat.gearDurability($pc)>>
					<<if _g.name is _s.gear>><<set _max to _g.max>><</if>>
				<</for>>
				<div class="meta">〔<<print _s.part>>〕<<if _s.gear>>护具 ''<<print _s.gear>>'' 吸 <<print _s.absorbed>><<if _s.reduce>>（减 <<print _s.reduce>>）<</if>><<if _max gt 0>>　余 <<print _s.gearHp>>/<<print _max>><</if>><<if _s.broke>>　''碎了''<</if>><<else>>没有护具挡下<</if>>　→ 落 HP <<print _s.toHp>></div>
			<</if>>
		</div><</if>>
	<</if>>
<</nobr>><</widget>>

/% #441-A：面板是 **present** —— 抽牌与「选中哪一手」都改走 `Game.Combat.ensureOffer`／`chooseAction`（sim），
   本 widget 体内因此不再有 `<<set $…>>`（旧实现三处 `<<set $pc.ev.fight.act to …>>` ＋ 一处经 `_f` 别名的
   `<<set _f.offer to …>>`，后者同样是写状态）。 %/
<<widget "fightpanel">><<nobr>>
	<<run Game.Combat.ensureOffer($pc)>>
	<<set _f to $pc.ev.fight>>
	<div class="acts">
		''这一轮你能做的：''
		<<if _f.offer.length gt 0>>
			<<link `Sg.story.actionLabel?.(_f.offer[0]) ?? _f.offer[0]`>>
				<<set _orig to passage()>>
				<<run Game.Combat.chooseAction($pc, 0)>>
				<<fightact $args[0]>>
				/% #350/#357：结算在点击时完成；**死透就不再归位**——<<damage>> 已跳「结局 死亡」，再 goto 会把它覆盖掉。用**存活条件**判，不依赖 widget 里的 passage() %/
				<<if $pc.hp gt 0>><<goto `_orig`>><</if>>
			<</link>>
			<span class="meta">（<<print Game.Combat.siteInfo(_f.offer[0])>>）</span>
		<</if>>
		<<if _f.offer.length gt 1>>
			<<link `Sg.story.actionLabel?.(_f.offer[1]) ?? _f.offer[1]`>>
				<<set _orig to passage()>>
				/% #350/#357：结算在点击时完成；**死透就不再归位**——<<damage>> 已跳「结局 死亡」，再 goto 会把它覆盖掉。用**存活条件**判，不依赖 widget 里的 passage() %/
				<<run Game.Combat.chooseAction($pc, 1)>>
				<<fightact $args[0]>>
				<<if $pc.hp gt 0>><<goto `_orig`>><</if>>
			<</link>>
			<span class="meta">（<<print Game.Combat.siteInfo(_f.offer[1])>>）</span>
		<</if>>
		<<if _f.offer.length gt 2>>
			<<link `Sg.story.actionLabel?.(_f.offer[2]) ?? _f.offer[2]`>>
				<<set _orig to passage()>>
				/% #350/#357：结算在点击时完成；**死透就不再归位**——<<damage>> 已跳「结局 死亡」，再 goto 会把它覆盖掉。用**存活条件**判，不依赖 widget 里的 passage() %/
				<<run Game.Combat.chooseAction($pc, 2)>>
				<<fightact $args[0]>>
				<<if $pc.hp gt 0>><<goto `_orig`>><</if>>
			<</link>>
			<span class="meta">（<<print Game.Combat.siteInfo(_f.offer[2])>>）</span>
		<</if>>
	</div>
<</nobr>><</widget>>

/% ── 交涉（B2 · D&D 2024 Influence action + DMG 社交交互）────────────────────
   三档意愿：willing（他本来就想给——不掷骰）· hesitant（掷骰）· unwilling（越线——掷骰也没用）
   态度：友好 −5 / 冷淡 0 / 敌意 +5（DMG 社交交互表压成一根轴）
   筹码：把对方想要的东西摆出来 → 免检（auto）或优势（adv）——有不靠嘴的路
   代价：游说/历史失败 → 这一问 DC 递增（2024「不许原地重掷」）· 欺瞒被识破 → 态度骤降 · 恐吓 → 得手也记仇
   架构与战斗动作池一致：点选项只写 $pc.ev.soc，重渲染后在段落顶部结算（骰面留在帧里）。

   注意：选项必须是**我们自己发的 <a data-...>**，不能写成 <<link>>：<<link>> 的内容在**点击时**才
   解析，那时 <<for>> 的临时变量早被同段落的下一个面板覆盖了（"点花的面板、算成求术的面板"）。
   值与它一起走进 DOM，点谁是谁。 %/

/% #441-A：本 widget 现在只负责**调 sim ＋ 渲染**——分支判定与全部状态写点都在
   `Game.Social.resolveAsk`（`21-resolve.twee`）。它**唯一渲染的东西**是筹码那一支的金额文案。
   抽出的意义：`test/social-lever.mjs` 可以不经浏览器驱动整个交涉回合。 %/
<<widget "socresolve">><<nobr>>
	<<set _r to Game.Social.resolveAsk($pc, $args[0], $pc.ev.soc?.how ?? null)>>
	<<if _r and _r.econ>><span class="econ-note"><<print Game.Economy.note(_r.econ.delta)>></span><</if>>
<</nobr>><</widget>>

<<widget "socpanel">><<nobr>>
	<<set _a to Game.Social.ask($args[0])>>
	<<set _S to Game.Social>>
	<<if _a>>
		<div class="soc-ask">
			''<<print _a.q>>''
			<<if $pc.ev.soc_last and $pc.ev.soc_last[_a.id]>>
				<<set _L to $pc.ev.soc_last[_a.id]>>
				<<lastcheckFor _a.sites>>
				<span class="soc-said"><<print _L.text>></span>
				<<for _n to 0; _n lt (_L.notes ?? []).length; _n++>><span class="soc-cost">（<<print _L.notes[_n]>>）</span><</for>>
			<</if>>
			<<if _S.askDone(_a, $pc)>>
				<span class="soc-done">（这一件已经有结果了。）</span>
			<<else>>
				<<set _v to _S.verdict(_a, $pc)>>
				<<if _v is "unwilling">>
					<span class="soc-no"><<print _a.why ?? "（这件事没得谈。）">></span>
				<<else>>
					<<set _att to _S.attitude(_a, $pc)>>
					<div class="soc-opts">
					<<if _v is "willing">>
						<<print `<a class="soc-opt" role="link" tabindex="0" data-ask="${_a.id}" data-how="will">开口：${_a.q}（${_a.tag}）</a>`>>
						<span class="soc-meta">（对方本来就要说<<if Sg.UI.showDetail()>>——不必掷骰<</if>>）</span>
					<</if>>
					<<for _i to 0; _i lt _S.levers(_a, $pc).length; _i++>>
						<<set _lv to _S.levers(_a, $pc)[_i]>>
						<<print `<a class="soc-opt" role="link" tabindex="0" data-ask="${_a.id}" data-how="lever:${_lv.id}">拿出筹码：${_lv.name}（${_a.tag}）</a>`>>
						<span class="soc-meta">（<<if _lv.econ>>花 <<print -Game.Economy.priceOf(_lv.econ, $pc)>> 金币 ｜ <</if>><<if _lv.gives is "auto">>直接答应<<if Sg.UI.showDetail()>>，无需掷骰<</if>><</if>><<if _lv.gives is "adv">>后续更有把握<<if Sg.UI.showDetail()>>（交涉检定有优势）<</if>><</if>>）</span>
					<</for>>
					<<for _i to 0; _i lt _S.open(_a, $pc).length; _i++>>
						<<set _o to _S.open(_a, $pc)[_i]>>
						<<print `<a class="soc-opt" role="link" tabindex="0" data-ask="${_a.id}" data-how="site:${_o.site}">${_o.ap.verb}：${_o.skill}（${_a.tag}）</a>`>>
						<span class="soc-meta">（<<print _S.ATT[_att]>><<if Sg.UI.showDetail()>> → DC<<print _o.dc>><</if>><<if _o.ap.onFail?.retry>> ｜ 失败：话说死了，更难开口<</if>><<if _o.ap.onFail?.att>> ｜ 失败：<<print _a.npc>>记住了<<if Sg.UI.showDetail()>>（态度降一级）<</if>><</if>><<if not _o.ap.onFail?.retry and not _o.ap.onFail?.att>> ｜ 失败：只是没接上话<</if>><<if _o.ap.onOk?.att>> ｜ 成了也记仇<</if>>）</span>
					<</for>>
					</div>
				<</if>>
			<</if>>
		</div>
	<</if>>
<</nobr>><</widget>>

/% 物品栏（v16 §5.0）：侧栏列出身上带着的东西——不凑数、不集齐开锁 %/
<<widget "inventory">><<nobr>>
	<<set _inv to Object.keys($pc.inv ?? {})>>
	<<if _inv.length>>
		<<for _i to 0; _i lt _inv.length; _i++>><span class="inv-item">_inv[_i]</span><</for>>
	<<else>>
		（空）
	<</if>>
<</nobr>><</widget>>
<<widget "flipEra">><<nobr>>
	/% `#1132` B3＋`#1216` B 半：时代翻转是**能力组**（三名一起才是这个能力）。
	   全缺 → 能力关（不渲染）；部分缺 → 出声点名；不给数值缺省。 %/
	<<set _flipCap to Sg.capability('flip')>>
	<<if _flipCap.reason is 'off'>>
	<<elseif _flipCap.reason is 'partial'>>
		<div><span class="era-drained">时代翻转的数据声明不完整：缺 <<print _flipCap.missing.join('、')>>。</span></div>
	<<else>>
	<<set _flipItem to _flipCap.item>><<set _flipCost to _flipCap.cost>><<set _flipFlag to _flipCap.flag>>
	<<if not $pc.inv[_flipItem]>>
		<div><span class="era-drained">你身上没有能校进另一段时间的东西。</span></div>
	<<else>>
		<<link `($era is Game.Era.PRESENT ? "翻转护符：坠入『过去』" : "翻转护符：回到『现在』")`>>
			/% `#1227` 类二：**首翻免费与两个键名都是故事数据**
（`Game.Star.flipPolicy = { firstFree, key, freeKey, spentKey}` —— 顶层键 `key` 与内层两个键名 `freeKey`／`spentKey`
			   都由故事给）；引擎**不写死任何故事键名字面**，**缺项即出声**（不静默取默认当键名）。
			   本句由判据「引擎侧出现故事键名 → 红」管着（见 `test/contract-defaults.mjs` 的同名格）。 %/
			<<run Game.Star.chargeFlip($pc, _flipCost)>>
			<<set $era to ($era is Game.Era.PRESENT ? Game.Era.PAST : Game.Era.PRESENT)>>
			<<if $era is Game.Era.PRESENT>><<set $pc.world[_flipFlag] to true>><</if>>
			<<goto `passage()`>>
		<</link>>
	<</if>>
	<</if>>
<</nobr>><</widget>>

:: StoryCaption
/% 侧边栏：常驻存档入口（v16 §5.0）+ 实时角色卡 + 物品栏 %/
<<nobr>>
<div class="save-bar">
	<button type="button" class="save-btn" onclick="Sg.save.quick()">💾 快速存档</button>
	<button type="button" class="save-btn" onclick="Sg.save.quickLoad()">📂 快速读档</button>
	<button type="button" class="save-btn" onclick="Sg.save.menu()">🗂 存档 / 读档</button>
</div>
<</nobr>>
<<if $pc.classLabel>>
''$pc.name''
$pc.speciesLabel $pc.classLabel
<<hpbar>>
金币：$pc.gold
药膏：$pc.salves 副（缺口满 4 点时自动用，一副恢复 4 点）
<<if $pc.gear.length>>行囊：<<print $pc.gear.join('、')>><</if>>
/% `#703`：**装备耐久**与**部位异常**——两者此前全仓零渲染（`gearHp`／`statuses` 只在 defaults 里出现过），
   玩家因此看不见 S1/S2 两套机制。取值走引擎只读快照（单一口径）；未启用机制的故事 → 列表为空 → 整块不出现。 %/
<<set _gh to Game.Combat.gearDurability($pc)>>
<<if _gh.length>>
<div class="gear-hp">''装备''　<<for _i to 0; _i lt _gh.length; _i++>><<print _gh[_i].name>>　<<print _gh[_i].cur>>/<<print _gh[_i].max>><<if _gh[_i].broken>>（''已损坏''）<</if>><<if _i lt _gh.length - 1>>　｜　<</if>><</for>></div>
<</if>>
<<set _st to Game.Combat.statusEntries($pc)>>
<<if _st.length>>
<div class="status-list">''状态''　<<for _i to 0; _i lt _st.length; _i++>><<print _st[_i].part>>·<<print _st[_i].label>>（<<print _st[_i].turns>> 回合）<<if _i lt _st.length - 1>>　｜　<</if>><</for>></div>
<</if>>
<div class="inv-block">
''物品栏''
<div class="inv-list"><<inventory>></div>
</div>
<<set _flipCap to Sg.capability('flip')>><<if _flipCap.ok and $pc.inv[_flipCap.item]>>
⌛ <<if $era is Game.Era.PAST>>过去<<else>>现在<</if>>
<</if>>
/% #460：设定集是本故事的页面（引擎不知道故事名）→ **存在才渲染**；否则第二/第三故事侧栏会出现死链 %/
<<if Story.has("设定集")>>[[📖 设定集|设定集]]<</if>>
<<elseif not Sg.story.hasChargen?.()>>
/% `#574`：**没有车卡的故事**（第二/第三个）——侧栏退化为最小面：血量·金币·物品·存档。
   为什么另起一段而不是共用上面那段：那段以车卡产物（`name`／`speciesLabel`／`classLabel`／`salves`／
   `gear`）为前提，没有车卡的故事里那些字段永远是空；而"能看见血量的战斗试验场"是本故事的前提。
   故事 1 不受影响：它有车卡 → 车卡前仍是"只有存档按钮"，与改前逐字相同。
   `#660` 片三-2：这里原本**直接探测故事的全局名**（`not Game.Chargen`）——那是边界破口（引擎知道故事的表叫什么）→
   改成问**接入契约** `Sg.story.hasChargen()`（引擎只问"有没有"，不把故事全局再拿回去）。 %/
