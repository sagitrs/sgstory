:: StoryBindings [script]
// @generated by editor/compile-story.mjs（源：stories/face-fixture/data/contract.json）——**手改会在下次编译被覆盖**（#762 / K4）
// 面夹具（`#1004` B2b）的接入契约**满配**：形状照被删的 `mist-forest`（引擎与那批测试就是按这个形状写的），值取最小可用。⚠️ 本件是**测试夹具**、不是内容故事：段名沿用旧故事只因消费者钉死了它们，正文全部新写。
window.Sg ??= {};
const __const_pcDefaults = {
	star: {
		charge: 12
	},
	keeper: {
		state: 'post'
	}
};
const __const_prepick = [
	{
		pool: '封印',
		round: 1,
		require: {
			item: '月光花'
		},
		pick: '龙·斩击',
		distinctFromPicked: true
	}
];
Object.assign((window.Sg.story ??= {}), {
	notes: () => window.Game?.Notes?.entries ?? {},
	econEvents: () => window.Game.Economy.events,
	codexItems: () => window.Game.Codex.items,
	socialAsks: () => window.Game.Social.asks,
	socialAttAdj: () => window.Game.Social.attAdj,
	socialApproaches: () => window.Game.Social.approaches,
	socialAttLabels: () => window.Game.Social.ATT,
	hasChargen: () => !!window.Game.Chargen,
	pcDefaults: () => __const_pcDefaults,
	prepick: () => __const_prepick,
	foeState: (pc) => pc?.dragon ?? {},
	battleDamage: (inv, round, defeats, poisoned) => window.Game.Items.battleDamage(round, inv, defeats, poisoned),
	rules: () => [],
	dragonMaxHp: () => {
		const v = window.Game?.Dragon?.hp;
		if (typeof v !== 'number') throw new Error(`Sg.story.dragonMaxHp：故事未提供 Game.Dragon.hp（结构缺失必须报错，#441-E）`);
		return v;
	},
	checkSite: (name) => {
		const v = window?.Game?.Checks?.sites?.[name];
		if (!v) throw new Error(`Sg.story.checkSite：位点「${name}」未登记（结构缺失必须报错，#441-E）`);
		return v;
	},
	combatAction: (id) => {
		const v = window?.Game?.Combat?.actions?.[id];
		if (!v) throw new Error(`Sg.story.combatAction：动作「${id}」未登记（结构缺失必须报错，#441-E）`);
		return v;
	},
	mechanics: () => null,
	itemDef: (name) => window?.Game?.Items?.defs?.[name] ?? null,
	itemEffect: (name) => window?.Game?.Items?.effects?.[name] ?? null,
	gearDef: (name) => window?.Game?.Gear?.defs?.[name] ?? null,
	combatPool: (id) => window?.Game?.Combat?.pools?.[id] ?? [],
	poisonReduce: () => {
		const v = window.Game?.Items?.poisonReduce;
		if (typeof v !== 'number') throw new Error(`Sg.story.poisonReduce：故事未提供 Items.poisonReduce（结构缺失必须报错，#441-E）`);
		return v;
	},
	actionLabel: (id) => {
		const a = window.Sg.story.combatAction(id);
		if (!a || typeof a.label !== 'string' || !a.label) throw new Error(`Sg.story.actionLabel：动作「${id}」缺 label（结构缺失必须报错，#441-E）`);
		return a.label;
	},
});
