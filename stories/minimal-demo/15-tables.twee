:: Game Tables [script]
// ── 第二个故事的**最小声明面**（`#460`）：本文件是「引擎接入契约」的**可执行清单** ─────────────
//
// 为什么它会存在（是本票实测挖出来的，不是设计出来的）：
//   引擎侧 `21-resolve` 在**加载期**就 `Object.assign(window.Game.Checks, {…})`（还有 Combat／Economy／
//   Gear／Items／Social）——而那些容器原先**只有故事 1 的 `15-tables.twee` 会建**。
//   ⇒ 一个"只有引擎 ＋ 自己的段落"的故事在加载期就崩（`TypeError: Cannot convert undefined or null to object`）。
//   这正是 `#512` 要清的"反向依赖"的一个实例：**引擎依赖故事提供容器**。
//   本文件先用最小容器把契约补上（引擎侧改成 `??=` 自建属另一票）；它同时是第二故事接入的**样板**。
//
// 纪律（`#436-b`／`#441-E`）：**结构缺失 ⇒ 报错**，所以空表要**显式**给（空表是合法数据集，不是缺失）。
window.Game = Object.assign(window.Game ?? {}, {
	Checks: { sites: {}, keyYields: [] },
	Combat: { pools: {}, actions: {} },
	Economy: { prices: {}, events: [] },
	Gear: { defs: {} },
	Items: { defs: {} },
	Social: { asks: [] },
	Truth: { claims: [] },
	Echoes: { list: [], revisit: [] },
	Shifts: { anchors: [] },
	Investment: { expressive: [], failClueExempt: {}, eraDomain: { past: [], branch: [], flagEra: {}, crossEraGates: [] } },
	// 接入契约：**引擎保留的运行时槽**由引擎写（`last_result`/`last_roll`/`soc*`/`fight`）⇒ 故事必须登记，
	// 否则 `--state` 会判"未落入任何域"（`#460`：这条纪律写进 `docs/dev-conventions.md` §12 的契约清单）。
	State: { domains: [{ id: 'runtime', keys: ['last_result', 'last_roll', 'soc', 'soc_last', 'soc_lever', 'fight', 'ending', 'notes'], note: '引擎保留的运行时槽（每个故事都要登记）' }], bookkeeping: [], dynamicKeys: [] },
	Notes: { entries: {} },
	// #572: Consequences 表——引擎运行时槽消费面登记（D2 门判据；与 State.domains 互补两门两套）。
	Consequences: {
		engine: {
			notes: '#434：笔记"已授予"真存储（Sg.notes.has 消费方在引擎侧）',
			last_roll: '骰面快照（<<lastcheck>> 复显用）',
			last_result: '结果槽暂存位（#270 通用留屏）',
			soc_lever: '交涉优势筹码',
			soc: '交涉台账（渲染期结算后清空）',
			soc_last: '交涉回显（面板展示用）',
			ending: '本档结局记录（engine：安全网门控）',
			fight: '短战斗状态机（引擎侧读写）',
		},
	},
});

:: StoryBindings [script]
// 接入契约（`#436-b`／`#441-E`）的**完整面**：引擎侧的取数口**只**经 `Sg.story.*`，纪律是
// 「**结构缺失 ⇒ 报错**」（未注册却来取数必须炸——不静默降级）；所以第二故事必须把**全部**口子显式注册，
// 空表/`null` 是**合法数据集**（本故事无机制 ⇒ 多数返回 `null`＝"未启用"，调用方跳过）。
//
// 本清单是**实测得出**的（`grep -rho "Sg\.story\.[a-zA-Z_]*" src/ | sort -u`）——引擎里每一个 `Sg.story.X`
// 就是一个必须注册的口子。这正是「第二故事接入」缺的那张清单：引擎知道故事名越少，这张表越短。
window.Sg ??= {};
Object.assign((window.Sg.story ??= {}), {
	notes: () => ({}),                 // 笔记表：本故事无笔记 ⇒ 空表（合法）
	rules: () => [],                   // 条件表：空表（合法）
	mechanics: () => null,             // 新机制声明表：未启用 ⇒ `null`（调用方必须跳过，不许当空表）
	checkSite: () => null,             // 位点表
	checkKnowledge: () => null,        // 位点→知识映射
	combatPool: () => [],              // 战斗池
	combatAction: () => null,          // 战斗动作
	actionLabel: (id) => String(id),   // 动作文案：**文案缺失** ⇒ 兜底不报错（与"结构缺失"分开）
	gearDef: () => null,               // 装备声明
	itemEffect: () => null,            // 道具效果
	poisonReduce: () => 0,             // 毒液减成
	dragonMaxHp: () => 0,              // 龙血上限（本故事无龙）
});
