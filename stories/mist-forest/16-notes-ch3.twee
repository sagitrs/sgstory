:: Game Notes 三章 [script]
// @generated by editor/compile-story.mjs（源：stories/mist-forest/data/notes.json）——**手改会在下次编译被覆盖**（#762 / K4）
Object.assign((window.Game.Notes ??= { entries: {} }).entries, {
	n_keeper_told: { title: '他小时候在那儿睡过一下午', src: '守林人', tags: ['三章', '守林人'], body: '他说那片花会睡人，要摘先把气含住——他小时候在那片花边上睡过一下午，醒来天都黑了。', era: window.Game.Era.PRESENT, flagPath: 'ev.keeper_told' },
	n_keeper_why: { title: '守的从来不是悔恨', src: '守林人', tags: ['三章', '守林人'], body: '\'守的从来不是悔恨\'——\'\'是它。\'\'他说：我家看了它三百年，它还在下面。', era: window.Game.Era.PRESENT, flagPath: 'ev.keeper_why' },
	n_star_ledger: { title: '有人拿那些点当过一把尺', src: '天文台', tags: ['三章', '天文台'], body: '缺口边那几粒点的间距是等分的——有人拿它们当过一把尺。量的是什么，纸上没写。', era: window.Game.Era.PRESENT, flagPath: 'ev.star_ledger' },
	n_witch_fire_hint: { title: '等一个不在场的人把话说完', src: '老巫女', tags: ['三章', '宴会'], body: '老巫女把两边的证据放在一起称了称，才开口：\'\'缺的不是咒，是等一个不在场的人把话说完。\'\'', era: window.Game.Era.PAST, flagPath: 'ev.witch_fire_hint' },
	n_witch_grip: { title: '她手里那支哨的形制', src: '当时的女巫', tags: ['三章', '宴会'], body: '你看清了她握着的那支哨：形制与守林人挂在门边那支一样。', era: window.Game.Era.PAST, flagPath: 'ev.witch_grip' },
	n_old_witch: { title: '厅角那位老人', src: '老巫女', tags: ['三章', '宴会'], body: '厅角坐着一位老人，没跟谁说话，也望着厅中央空着的那一块地方，双手收在袖里。', era: window.Game.Era.PAST, flagPath: 'ev.old_witch' },
	n_staff_hint: { title: '孩子总往桌布底下瞟', src: '寻杖', tags: ['三章', '宴会'], body: '满厅的人都在忙着，倒是那个跑动的孩子，总往长桌尽头的桌布底下瞟。', era: window.Game.Era.PAST, flagPath: 'world.staff_hint' },
	n_letter_seen: { title: '火漆完好的一封信', src: '观星者', tags: ['三章', '宴会'], body: '案角那封信\'\'火漆完好\'\'，没人拆过。收信人写着\'\'"观星者"\'\'。', era: window.Game.Era.PAST, flagPath: 'ev.letter_seen' },
	n_mist_is_guard: { title: '它不是拦路，是在守一个人', src: '雾之魔物', tags: ['三章', '森林'], body: '你不动，它也不动。看久了能看出来：它不是拦路，是\'\'在守一个人\'\'——它守的是守林人。', era: window.Game.Era.PRESENT, flagPath: 'ev.mist_guard' },
});
