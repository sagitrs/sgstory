:: Game Tables [script]
// ── 声明式数据表（v16）——机制数值单一源 ──────────────────────
// 正文只经词汇宏引用：<<sitecheck 位点 [adv]>> / <<econ 事件>> / <<give "道具">>。
// 审计：node scripts/audit.mjs（五门）。
// 权威关系：本表只承载机制；与 docs/lore-canon.md 冲突以设定书为准（P1）。
window.Game = (() => {
	// ── 位点表（技能检定 / 豁免）──────────────────────────
	const Checks = {
		// yields（M10 反 S/L 门）：这个位点能拿到什么关键产出。
		// 门禁要求每个 keyYields 至少两条路、且**判定属性不同**——不同策略都能走通，不必读档。
		sites: {
			'酒馆·打听':   { skill: '游说', dc: 12 },
			'森林·察觉':   { skill: '察觉', dc: 10 },
			'洞穴·战斗':   { skill: '运动', dc: 12, auto: '战斗（玩家已选择动手）' },
			'雾之魔物·挥击': { skill: '运动', dc: 12, auto: '战斗（玩家已选择动手）' },
			'雾之魔物·心防': { skill: '洞悉', dc: 13 },
			'守林人·交涉': { skill: '游说', dc: 12 },
			'守林人·指花': { skill: '察觉', dc: 11 },
			'门厅·翻检':   { skill: '调查', dc: 10, yields: '坏哨' },
			'门厅·看钉':   { skill: '察觉', dc: 9,  yields: '坏哨' },
			'门厅·硬掰':   { skill: '运动', dc: 12, yields: '坏哨' },
			'书房·追问':   { skill: '历史', dc: 10 },
			'书房·检视':   { skill: '调查', dc: 12, yields: '日记' },
			'书房·敲墙':   { skill: '察觉', dc: 11, yields: '日记' },
			'书房·断代':   { skill: '历史', dc: 13, yields: '日记' },
			'书房·强拆':   { skill: '运动', dc: 13, yields: '日记' },
			'工坊·识货':   { skill: '历史', dc: 12, yields: 'ev:forge_seen' },
			'工坊·记号':   { skill: '察觉', dc: 11, yields: 'ev:forge_seen' },
			// 塔基花田（v16 补正 #6）：贸然采花＝较高体质豁免；失败＝死亡结局（有情报免判定）
			'塔外花田':     { abil: 'con', dc: 16, yields: '月光花' },
			'花田·下风':   { skill: '生存', dc: 13, yields: '月光花' },
			'天文台·典籍': { skill: '奥秘', dc: 12, yields: 'ev:star_ledger' },
			'天文台·光点': { skill: '察觉', dc: 12, yields: 'ev:star_ledger' },
			'观星者·说服': { skill: '历史', dc: 13 },
			'观星者·洞悉': { skill: '洞悉', dc: 13 },
			'当时的女巫·辨认': { skill: '洞悉', dc: 12 },
			'当时的女巫·开口': { skill: '游说', dc: 13 },
			'寻杖':         { skill: '调查', dc: 13, yields: 'flag:family_favor', auto: '进入该段落＝玩家已经动手翻找（「在塔里找那根杖」）' },
			'寻杖·问孩子': { skill: '游说', dc: 12, yields: 'flag:family_favor' },
			'寻杖·看人':   { skill: '洞悉', dc: 11, yields: 'flag:family_favor' },
			'龙·吐息':     { abil: 'con', dc: 14, auto: '战斗（玩家已选择动手）' },
			'龙·斩击':     { skill: '运动', dc: 10, auto: '战斗（玩家已选择动手）' },
			// ── 战斗动作池（B1）：每轮随机 3 选 1；每个动作都是一次属性化检定 ──
			// 雾影（雾之魔物）
			'雾影·迎上':   { skill: '运动', dc: 12 },
			'雾影·让开':   { skill: '体操', dc: 12 },
			'雾影·蹲低':   { skill: '隐匿', dc: 12 },
			'雾影·亮哨':   { skill: '游说', dc: 10 },
			'雾影·开口':   { skill: '游说', dc: 13 },
			// 封印战（与守林人并肩）——基础攻击沿用「龙·斩击」（坏哨优势就在那儿）
			'封印·找旧伤': { skill: '察觉', dc: 12 },
			'封印·走位':   { skill: '体操', dc: 13 },
			'封印·读吸气': { skill: '洞悉', dc: 13 },
			'封印·涂毒':   { skill: '医药', dc: 11 },
			'封印·呼应':   { skill: '游说', dc: 12 },
			'封印·吹哨':   { skill: '表演', dc: 10 },
			'封印·读术式': { skill: '奥秘', dc: 13 },
			'封印·硬扛':   { abil: 'con', dc: 13 },
			'封印·举臂':   { skill: '运动', dc: 12 },
			// 单挑（必败线）：动作只决定你挨多重、看到多少
			'龙·躲闪':     { skill: '体操', dc: 14 },
			'龙·看缝':     { skill: '察觉', dc: 15 },
			'龙·喊名':     { skill: '历史', dc: 14 },
			'龙·横刀':     { skill: '运动', dc: 13 },
			'龙·后撤':     { skill: '洞悉', dc: 12 },
			'龙·数拍':     { skill: '生存', dc: 13 },
			// 彩蛋击杀（M5b）：需天然 20 且劣势 → 1/400 ≈ 0.25%，几乎不可达
			'龙·终击':     { skill: '运动', dc: 20, nat: 20, dis: true, auto: '战斗（玩家已选择动手）', disWhy: '正面硬撼一条龙，只有运气站在你这边' },
			// ── 交涉位点（B2 · D&D 2024 Influence）：同一句诉求，换手段＝换属性判定 ──
			// 老板娘（歪脖子鸭）：问出「进塔该注意什么」
			'老板娘·吓':   { skill: '恐吓', dc: 14 },
			'老板娘·接话': { skill: '表演', dc: 14 },
			'老板娘·读':   { skill: '洞悉', dc: 11 },
			// 守林人：读人（洞悉）＋请他动术式（游说 / 历史＝引先例）
			'守林人·读':   { skill: '洞悉', dc: 12 },
			'守林人·求术': { skill: '游说', dc: 13 },
			'守林人·引先例': { skill: '历史', dc: 12 },
			// 观星者：磨（游说）—— 与「说服＝历史」「洞悉」并列的第三条路
			'观星者·磨':   { skill: '游说', dc: 14 },
			// 当时的女巫：激（恐吓）—— 认得出，但被她记住
			'当时的女巫·激': { skill: '恐吓', dc: 16 },
			// 洞穴·哥布林：哄（游说）/ 骗（欺瞒）/ 吓（恐吓）/ 看（洞悉＝读它抱着什么）
			'哥布林·哄':   { skill: '游说', dc: 13 },
			'哥布林·骗':   { skill: '欺瞒', dc: 12 },
			'哥布林·吓':   { skill: '恐吓', dc: 10 },
			'哥布林·看':   { skill: '洞悉', dc: 11 },
		},
		// 关键产出（M10）：每个都得有 ≥2 条通路、且判定属性不同——不许把玩家逼去读档
		keyYields: ['日记', '坏哨', '月光花', '完整星图', 'flag:family_favor', 'flag:flower_warned', 'ev:witch_grip', 'ev:star_ledger', 'ev:forge_seen',
			'ev:tav_tips', 'flag:goblin_spared', 'keeper:seal'],
		// ── 情报优势（M6d）：付费/交涉得来的知识 → 位点自动双骰取高 ──
		// key = 位点，value = $pc.world 上的旗标名
		knowledge: {
			'洞穴·战斗': 'rumor',      // 老猎人：''第三块板子是脆的''
			'书房·检视': 'witch_hint', // 女巫：塔里的门道（暗格位置）
			'书房·敲墙': 'witch_hint',
			'书房·断代': 'witch_hint',
			'书房·强拆': 'witch_hint',
		},
		// 情报的人类可读说明（"为什么有优势"里显示这个，不是显示变量名）
		knowledgeWhy: {
			rumor: "老猎人的话（酒馆·第三块板子是脆的）",
			witch_hint: "女巫的门道（小屋·暗格位置）",
		},
	};

	// ── 经济（钱买信息与准备，不买结果）─────────────────────
	const Economy = {
		events: {
			torch_buy:    { delta: -10, gives: { gear: ['火把'] }, chapter: 1, note: '酒馆·买火把（行囊里有它，黑处的位点给优势）' },
			rumor_buy:    { delta: -5, chapter: 1, note: '酒馆·买传闻' },
			drink_round:  { delta: -3, chapter: 1, note: '酒馆·请一轮酒' },
			salve_buy:    { delta: -8, gives: { salves: 1 }, skillDiscount: { skill: '医药', to: -5 }, chapter: 1, note: '女巫·药膏（库存 +1）' },
			witch_hint:   { delta: -8, featDiscount: { flag: 'lore', to: -5 }, chapter: 1, note: '女巫·塔里的门道（学识烙印半价）' },
			goblin_bribe: { delta: -5, skillDiscount: { skill: '恐吓', to: -3 }, chapter: 1, note: '洞穴·买路' },
			goblin_kill:  { delta: 3, chapter: 1, note: '洞穴·搜刮' },
			study_errand: { delta: 6, chapter: 2, note: '书房·指出错抄的跑腿钱' },
			forged_scale: { delta: -8, chapter: 2, note: '工坊·打造龙鳞护臂' },
			dragon_hoard: { delta: 10, chapter: 3, note: '巢边·识货' },
		},
		priceOf(key, pc) {
			const ev = this.events[key];
			if (!ev) throw new Error(`未知经济事件: ${key}`);
			if (ev.featDiscount && pc?.flags?.[ev.featDiscount.flag]) return ev.featDiscount.to;
			if (ev.skillDiscount && pc?.skills?.includes(ev.skillDiscount.skill)) return ev.skillDiscount.to;
			return ev.delta;
		},
	};

	// ── 道具（v16 §5.0：各有用途，不集齐开锁）────────────────
	// ── 行囊（A1/A2）：职业装备进数值——不进口具表（canon §5.0 仍是 10 件）──
	const Gear = {
		defs: {
			长剑: {
				from: '职业·铁卫',
				damage: 1,
				note: '基础伤害 +1（把龙往下按得更快）',
			},
			短刃: {
				from: '职业·影手',
				damage: 1,
				advSites: ['雾之魔物·挥击'],
				note: '基础伤害 +1；贴身距离好使（雾里那个影子给优势）',
			},
			火把: {
				from: '酒馆（10 金）',
				advSites: ['洞穴·战斗', '门厅·看钉', '门厅·翻检', '书房·检视', '天文台·典籍'],
				note: '黑处看得见：洞穴与「看不清」的那些位点给优势',
			},
		},
		damageBonus(gear) {
			return (gear ?? []).reduce((a, k) => a + (this.defs[k]?.damage ?? 0), 0);
		},
		// 行囊带来的优势来源（与道具同一套"说出为什么"的机制）
		advSource(site, gear) {
			return (gear ?? []).find((k) => (this.defs[k]?.advSites ?? []).includes(site)) ?? '';
		},
	};

	const Items = {
		defs: {
			时光护符:     { from: '女巫（一章）', note: '翻转时代；原地生效（位置决定年代）' },
			日记:         { from: '塔·书房', note: '记着雾＝它漏出来的力气；说服守林人' },
			坏哨:         { from: '塔·门厅', note: '守林人家挂在门边那支；龙认得形状——带着就有用' },
			好哨:         { from: '过去·当时的女巫（她本人）', note: '吹响＝让龙冷静下来' },
			月光花:       { from: '塔外·一楼墙根', note: '献龙＝睡得稳（不提前醒、不烧路费）；毒液抹刃＝龙的攻击 −2（封印战）；贸然摘＝拿命试' },
			守林人的钥匙: { from: '守林人', note: '通往地下宴会厅那道门' },
			观星者的书:   { from: '塔·观测廊 / 龙穴', note: '证物（风化无法伪造）+ 现象与线索' },
			完整星图:     { from: '过去·天文台', note: '带回现在就是坐标' },
			龙鳞护臂:     { from: '塔·工坊', note: '受击 −1' },
			传送术卷轴:   { from: '现在·书房（日记后半本）', note: '完整术式（她算清的那一卷）' },
		},
		// 战斗侧效果（位点优势 / 减伤）
		effects: {
			坏哨:       { advSite: '雾之魔物·挥击', advSites: ['龙·斩击'], note: '它认得那个形状——魔物挥击劣势转优势；封印战里让龙迟疑半拍（v17 补正 #3）' },
			观星者的书: { advSite: '龙·吐息', note: '书里记着逆鳞可透——预判吐息' },
			日记:       { flatDamageReduce: 1, note: '念出那两个小字——整场再 −1' },
			龙鳞护臂:   { flatDamageReduce: 1, note: '受击 −1' },
		},
		perItemDamageReduce: 1,
		// 月光花毒液（v17 补正 #3）：抹在刃上 → 它每一下都慢半拍（龙的攻击 −2）
		poisonReduce: 2,
		// 受击方=玩家：伤害 = 基础 − 减伤件数 − 毒液 + 败次（封顶）
		battleDamage(round, inv, defeats, poisoned) {
			const held = Object.keys(inv ?? {}).filter((k) => this.effects[k]?.flatDamageReduce);
			const flat = held.reduce((a, k) => a + this.effects[k].flatDamageReduce, 0);
			const rage = Math.min(2, defeats ?? 0);
			const base = round >= 3 ? 5 : 3 + round;
			const poison = poisoned ? this.poisonReduce : 0;
			return Math.max(1, base - flat - poison + rage);
		},
		advAt(site, inv) {
			return !!this.advSource(site, inv);
		},
		// 优势来源（M10）：说出是哪件道具——"为什么有优势"也要给玩家看
		advSource(site, inv, gear) {
			for (const k of Object.keys(inv ?? {})) {
				const e = this.effects[k];
				if (e && (e.advSite === site || (e.advSites ?? []).includes(site))) return k;
			}
			return Gear.advSource(site, gear);   // 行囊也能给优势（A1：火把）
		},
	};

	// ── 道具图鉴（v17 M8）：线索集 + 空页提示。线索必须"挣得到"（新档全 false）──
	const Codex = {
		items: {
			时光护符: {
				hint: '女巫小屋——她把它从炉火边递到你手里。',
				clues: [
					{ id: 'own',  label: '来历：初代巫女那件星铁', test: (p) => !!p.inv['时光护符'] },
					{ id: 'flip', label: '用法：翻转在原处生效', test: (p) => (p.star?.spent ?? 0) >= 1 },
					{ id: 'fog',  label: '它每用一次，雾就淡一些', test: (p) => !!p.world?.fog_thin },
				],
			},
			日记: {
				hint: '塔里二楼，烤炉后头那个暗格。',
				clues: [
					{ id: 'own',   label: '来历：她记那一夜的那一本', test: (p) => !!p.inv['日记'] },
					{ id: 'cause', label: '那一夜发不动＝烧的是它自己的力气', test: (p) => !!p.ev?.failure_cause },
					{ id: 'lock',  label: '能改的只有没被观测过的那部分', test: (p) => !!p.ev?.observation_lock },
				],
			},
			坏哨: {
				hint: '门厅门边那支锈的——三百年没人动过。',
				clues: [
					{ id: 'own',   label: '来历：守林人家削的引路哨', test: (p) => !!p.inv['坏哨'] },
					{ id: 'fight', label: '带着它，雾里的东西会迟疑', test: (p) => !!p.world?.mist_fought },
					{ id: 'other', label: '还有一支，是照着它的样子削的', test: (p) => !!p.inv['好哨'] || !!p.world?.family_favor },
				],
			},
			好哨: {
				hint: '三百年前那场宴上，长桌尽头那位妇人手里攥着一支。',
				clues: [
					{ id: 'own',    label: '来历：她自己削的玩具哨', test: (p) => !!p.inv['好哨'] },
					{ id: 'blown',  label: '吹响它，龙会冷静下来', test: (p) => !!p.world?.whistle_blown },
					{ id: 'favor',  label: '换来它的人情：替她找回那根杖', test: (p) => !!p.world?.family_favor },
				],
			},
			月光花: {
				hint: '塔基外侧墙根那片银白——雾最浓的地方。',
				clues: [
					{ id: 'own',    label: '来历：雾生的花，只在塔根', test: (p) => !!p.inv['月光花'] },
					{ id: 'warned', label: '危险：味道闻久了会睡', test: (p) => !!p.world?.flower_warned },
					{ id: 'fed',    label: '献给它＝睡得稳，不烧路费', test: (p) => !!p.world?.flower_fed },
					{ id: 'venom',  label: '毒液抹刃＝它每一下都慢半拍', test: (p) => !!p.dragon?.venom },
				],
			},
			守林人的钥匙: {
				hint: '塔边那个男人腰上挂着一把，齿口磨圆了。',
				clues: [
					{ id: 'own',  label: '来历：他解下来放在桌上', test: (p) => !!p.inv['守林人的钥匙'] },
					{ id: 'met',  label: '去塔的路上会先遇见他', test: (p) => !!p.keeper?.met },
					{ id: 'why',  label: '他守的从来不是悔恨', test: (p) => !!p.ev?.keeper_why },
					{ id: 'door', label: '铁门后头是地下那道门', test: (p) => !!p.world?.present_done || !!p.dragon?.awake },
				],
			},
			观星者的书: {
				hint: '四楼观测廊的书架——一册风化了的星象手稿。',
				clues: [
					{ id: 'own',   label: '来历：《论坠星》，只记现象不记谜底', test: (p) => !!p.inv['观星者的书'] },
					{ id: 'proof', label: '证物：风化无法伪造', test: (p) => (p.keeper?.trust ?? 0) >= 2 },
					{ id: 'letter', label: '夹着的那封信，观星者到死没拆', test: (p) => !!p.ev?.letter_seen },
				],
			},
			完整星图: {
				hint: '三百年前的穹顶是完整的——那份图只在那时候还活着。',
				clues: [
					{ id: 'own',   label: '来历：观星者手抄的那一份', test: (p) => !!p.inv['完整星图'] },
					{ id: 'asked', label: '问过它从哪颗星被送来的', test: (p) => !!p.world?.seer_asked },
					{ id: 'coord', label: '带回现在，它就是坐标', test: (p) => !!p.ev?.coord },
				],
			},
			龙鳞护臂: {
				hint: '三楼拐角那间小工坊——砧板上那副还没成形。',
				clues: [
					{ id: 'own',   label: '来历：熔炉边那一副，打到一半', test: (p) => !!p.inv['龙鳞护臂'] },
					{ id: 'seen',  label: '他背上全是汗，嘴里哼着宴上的调子', test: (p) => !!p.world?.present_done },
					{ id: 'worn',  label: '穿它挨过一下：受击 −1', test: (p) => !!p.dragon?.awake && !!p.inv['龙鳞护臂'] },
				],
			},
			传送术卷轴: {
				hint: '日记的封底——她算清的那一卷夹在那里。',
				clues: [
					{ id: 'own',     label: '来历：初代巫女晚年算清的完整术式', test: (p) => !!p.inv['传送术卷轴'] },
					{ id: 'lock',    label: '她把没能用上的那一句写在旁边', test: (p) => !!p.ev?.observation_lock },
					{ id: 'deliver', label: '只有守林人读得通', test: (p) => !!p.world?.scroll_delivered },
				],
			},
		},
		// 线索 id 列表
		clueIds(item) {
			return (this.items[item]?.clues ?? []).map((c) => c.id);
		},
		// 本档已满足的线索（纯函数，便于机检）
		satisfied(pc) {
			const out = {};
			for (const [item, def] of Object.entries(this.items)) {
				out[item] = (def.clues ?? []).filter((c) => {
					try { return !!c.test(pc); } catch { return false; }
				}).map((c) => c.id);
			}
			return out;
		},
		// 永久已解锁（线索集齐）
		isUnlocked(item, store) {
			const ids = this.clueIds(item);
			const got = store?.clues?.[item] ?? {};
			return ids.length > 0 && ids.every((id) => got[id]);
		},
		// 线索进度（x/y）
		progress(item, store) {
			const ids = this.clueIds(item);
			const got = store?.clues?.[item] ?? {};
			return { got: ids.filter((id) => got[id]).length, total: ids.length };
		},
	};

