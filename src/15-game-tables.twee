:: Game Tables [script]
// #28 声明式数据表——机制数值单一源（治本：逻辑 sink 出 twee，测试成本 O(机制)）。
// 正文只经词汇宏引用：<<sitecheck 位点 [adv]>> / <<attackroll 位点 [adv]>>
// / <<econ 事件 [动态金额]>>；DC/定价/信物效果改这里，不动叙事文本。
// 审计：node scripts/audit.mjs（伞 #21/#22 查表，替代 jsdom 探查）。
// 范围纪律：本表只承载既有数值；调价/新 sink 属 #25。
window.Game = (() => {
	const Economy = {
		events: {
			torch_buy:   { delta: -10, chapter: 1, note: '酒馆·买火把' },
			loot:        { delta: null, chapter: 1, note: '战斗后搜刮（动态传入：1d6/幸运 2d6kh）' },
			goblin_kill: { delta: 3, chapter: 1, note: '战斗·斩草除根' },
			bribe:       { delta: -5, skillDiscount: { skill: '恐吓', to: -3 }, chapter: 1, note: '贿赂哥布林·买路（懂吓唬的 3 金搞定）' },
			shadow_alms: { delta: 1, chapter: 1, note: '雾影·施舍' },
			witch_heal:  { delta: -10, chapter: 1, note: '女巫小屋·治疗' },
			study_errand: { delta: 6, chapter: 2, note: '书房·过去 指出错抄，学徒跑腿钱' },
			flower_pick:  { delta: 5, chapter: 2, note: '温室·采月光花附赠' },
			star_iron:    { delta: 4, chapter: 2, note: '天文台·星铁碎片' },
			// ── 消费点（#25 经济 sink：钱买信息与准备，不买结果）──
			rumor_buy:       { delta: -5, chapter: 1, note: '酒馆·买传闻（吊桥脆板→断桥 adv）' },
			witch_hint_diary: { delta: -8, featDiscount: { flag: 'lore', to: -5 }, chapter: 1, note: '女巫·书房暗格情报（=hint_diary；学识烙印 5 金）' },
			witch_hint_star:  { delta: -8, featDiscount: { flag: 'lore', to: -5 }, chapter: 1, note: '女巫·星图残页情报（=hint_star；学识烙印 5 金）' },
			salve_buy:       { delta: -8, gives: { salves: 1 }, skillDiscount: { skill: '医药', to: -5 }, chapter: 1, note: '女巫·药膏补给（库存 +1；懂行者批发价 5）' },
			gardener_bribe:  { delta: -10, chapter: 2, note: '温室·贿赂园丁（月光花确定获取，替代 DC13 赌）' },
			crow_guide:      { delta: -5, chapter: 2, note: '楼梯间·乌鸦向导（高亮未取信物/秘密）' },
			loot_dragon:   { delta: 10, chapter: 3, note: '宝藏厅·识货（lore 终极兑现：断臂金像）' },
			forged_scale:  { delta: -8, chapter: 3, note: '熔炉·打造龙鳞护臂（受击全程 −1）' },
		},
		// 实付价：烙印折扣在这里算（表驱动，twee 不重复定价）
		priceOf(key, pc) {
			const ev = this.events[key];
			if (!ev) throw new Error(`未知经济事件: ${key}`);
			if (ev.featDiscount && pc?.flags?.[ev.featDiscount.flag]) return ev.featDiscount.to;
			if (ev.skillDiscount && pc?.skills?.includes(ev.skillDiscount.skill)) return ev.skillDiscount.to;
			return ev.delta;
		},
	};
	const Checks = {
		sites: {
			'开局·察觉':   { skill: '察觉', dc: 10 },
			'哥布林·战斗': { skill: '运动', dc: 12 },
			'断桥':        { skill: '体操', dc: 12 },
			'雾影·抵抗':   { abil: 'con', dc: 15 },
			'门厅·游说':   { skill: '游说', dc: 12 },
			'门厅·翻检':   { skill: '调查', dc: 10 },
			'书房·追问':   { skill: '历史', dc: 10 },
			'书房·再谈':   { skill: '游说', dc: 12 },
			'书房·检视':   { skill: '调查', dc: 12 },
			'温室·讨教':   { skill: '游说', dc: 13 },
			'温室·抵抗':   { abil: 'con', dc: 12 },
			'天文台·典籍': { skill: '奥秘', dc: 12 },
			'宝藏厅·识货': { skill: '历史', dc: 12 },
			'龙战·斩击': { skill: '运动', dc: 8 },
			'天文台·推演': { skill: '调查', dc: 12 },
			'化身·鞭击':   { skill: '运动', dc: 12 },
			'化身·悲鸣':   { abil: 'con', dc: 12 },
			'化身·终击':   { skill: '运动', dc: 12 },
		},
	};
	const Tokens = {
		perTokenDamageReduce: 1, // 共鸣护体：每件信物受击 −1
		rageCap: 2,              // 每败一次化身伤害 +1，封顶
		finalStrikeCountAdv: 2,  // 终击：信物 ≥N 件 → 攻击优势（共鸣/迟疑）
		roundBase: { 1: 3, 2: 4, 3: 1 }, // 化身战三回合基础伤害（鞭击/悲鸣/终击落空）
		effects: {
			'铜哨':     { advSite: '化身·鞭击', note: '她分心——闪避优势' },
			'星图残页': { advSite: '化身·悲鸣', note: '完整星空护体——豁免优势' },
			'月光花':   { advSite: '化身·终击', note: '银辉引路——攻击优势' },
			'日记':     { flatDamageReduce: 1, note: '念出她的名字——整场再 −1' },
		},
		battleDamage(round, tokens, defeats) {
			const t = tokens ?? [];
			const rage = Math.min(this.rageCap, defeats ?? 0);
			// 日记减伤只作用于前两回合（原式知此：终击落空伤害本就时最低，不再叠）
			const diary = t.includes('日记') && round < 3 ? (this.effects['日记'].flatDamageReduce ?? 0) : 0;
			return Math.max(1, this.roundBase[round] - t.length * this.perTokenDamageReduce - diary + rage);
		},
		advAt(site, tokens) {
			const t = tokens ?? [];
			if (t.some((x) => this.effects[x]?.advSite === site)) return true;
			return site === '化身·终击' && t.length >= this.finalStrikeCountAdv;
		},
	};
	const Truth = {
		// D1 真相可达性（#35）：核心命题 × 传达位点。判据：每命题 ≥2 独立通路（单点=错过即失真相）；
		// anchor 锚句机检——位点段落源文必须含锚串，改文案断链即 audit --check 红
		claims: [
			{ id: 'keeper_identity', claim: '守林人三百年前守着森林与路，塔与法杖是她的', sites: [
				{ p: '女巫的委托', anchor: '守林人' },
				{ p: '书房', anchor: '我以为守着路' },
				{ p: '塔的回声', anchor: '三百年前的守林人' },
			] },
			{ id: 'mist_origin', claim: '雾因她放任与自责而起', sites: [
				{ p: '书房', anchor: '是我放任雾涨起来的', via: '日记最后一页（需暗格链）' },
				{ p: '顶楼', anchor: '都是我', via: 'present 残影自语（速通必达）' },
			] },
			{ id: 'dragon_mist', claim: '雾生于龙的梦，锁其身者星轨（C2 三章真相层）', sites: [
			{ p: '塔底·观测廊', anchor: '雾生于龙梦', via: 'past《坠星志》残卷' },
			{ p: '塔底·封印大厅', anchor: '梦渗成雾', via: 'past 守卫吟诵词' },
			{ p: '塔底·囚徒·龙', anchor: '雾是从龙的梦里渗出来的', via: 'past 囚徒证词' },
		] },
			{ id: 'keeper_seal', claim: '青梧三百年守的是封印而非悔恨（与二章自责两读并存）', sites: [
			{ p: '塔底·囚室', anchor: '她封住了龙', via: 'past 囚徒第一面' },
			{ p: '塔底·囚徒·青梧', anchor: '守的从来不是悔恨——是封印', via: 'past 囚徒答"问青梧"' },
			{ p: '顶楼', anchor: '守的从来不是悔恨', via: 'present 残影自语（avatar_down 后）' },
			{ p: '塔底·囚室·信', anchor: '等它睡沉了，我再回来', via: 'present 未送出的信' },
		] },
			{ id: 'feast_meaning', claim: '宴会等的是打完龙回来吃饭的她（宾客走不出封印圈）', sites: [
			{ p: '门厅', anchor: '打完就回来吃饭', via: 'past 老妇人（avatar_down 后重访）' },
			{ p: '塔底·囚室·信', anchor: '菜要一直温着', via: 'present 青梧致星官的信' },
			{ p: '塔底·囚室', anchor: '门外的雾，推不开', via: 'past 囚徒（封印圈伏笔）' },
		] },
			{ id: 'avatar_nature', claim: '化身=三百年悔恨凝聚；残影=她本人残念', sites: [
				{ p: '女巫的委托', anchor: '悔恨' },
				{ p: '雾之化身战', anchor: '三百年的悔恨' },
			] },
			{ id: 'tokens_bond', claim: '四信物各系她的一段过往', sites: [
				{ p: '门厅', anchor: '她最怕丢的东西' },
				{ p: '书房', anchor: '青梧' },
				{ p: '温室 游说', anchor: '守林人常来浇水' },
				{ p: '天文台', anchor: '等我回来' },
			] },
			{ id: 'her_name', claim: '她的名字：青梧（念出名是战斗机制）', sites: [
				{ p: '女巫的委托', anchor: '青梧' },
				{ p: '书房', anchor: '青梧' },
				{ p: '雾之化身战', anchor: '青梧' },
				{ p: '结局 解放', anchor: '青梧' },
			] },
			{ id: 'ending_logic', claim: '集齐信物唤她回家；或接替/终结；宴会在等她', sites: [
				{ p: '女巫的委托', anchor: '带回家' },
				{ p: '顶楼', anchor: '唤她回家' },
				{ p: '天文台', anchor: '法杖放在顶楼瞭望位' },
			] },
		],
	};
	const Echoes = {
		// D4 世界活性（#38）：行为×回声。kind：past→present（过去行为现在留痕）/ present→past /
		// ch1→ch2（一章行为二章回响）/ state-gate（取物互斥变体）/ mechanic / text-variant / service
		list: [
			{ id: '星图缺角', cause: { token: '星图残页' }, kind: 'past→present', echo: [{ p: '天文台', anchor: '少了一角' }] },
			{ id: '宴会余温', cause: { towerFlag: 'hall_past' }, kind: 'past→present', echo: [{ p: '门厅', anchor: '余温' }] },
			{ id: '日记等三百年', cause: { token: '日记' }, kind: 'present→past', echo: [{ p: '书房', anchor: '等上三百年' }] },
			{ id: '枯花两态', cause: { token: '月光花' }, kind: 'state-gate', echo: [{ p: '温室', anchor: '枯藤' }] },
			{ id: '铜哨位空', cause: { token: '铜哨' }, kind: 'state-gate', echo: [{ p: '门厅', anchor: '静静躺着' }] },
			{ id: '放生→温室彩蛋', cause: { flag: 'goblin_spared' }, kind: 'ch1→ch2', echo: [{ p: '温室', anchor: '你放走了我们家的小子' }] },
			{ id: '火把照塔', cause: { gear: '火把' }, kind: 'ch1→ch2', echo: [{ p: '门厅', anchor: '火把的光' }] },
			{ id: '传闻→断桥优势', cause: { flag: 'heard_rumor' }, kind: 'mechanic', echo: [{ p: 'Widgets', anchor: 'has_rope' }] },
			{ id: '绳索→断桥优势', cause: { gear: '绳索' }, kind: 'mechanic', echo: [{ p: 'Widgets', anchor: 'has_rope' }] },
			{ id: '护身符→女巫开门', cause: { flag: 'has_amulet' }, kind: 'mechanic', echo: [{ p: '女巫小屋', anchor: '护身符' }] },
			{ id: '化身认得你', cause: { towerFlag: 'defeats' }, kind: 'mechanic', echo: [{ p: '雾之化身战', anchor: '认出了你' }] },
			{ id: '塔护住你', cause: { towerFlag: 'echo' }, kind: 'mechanic', echo: [{ p: '塔的回声', anchor: '不让你死在这里' }] },
			{ id: '乌鸦记账', cause: { event: 'crow_guide' }, kind: 'service', echo: [{ p: '乌鸦指路', anchor: '一百年的账' }] },
			{ id: '化身倒下→塔底三入口开', cause: { towerFlag: 'avatar_down' }, kind: 'mechanic', echo: [{ p: '化身·终击', anchor: '猛地震裂' }, { p: '塔门', anchor: '暗河河道下去' }, { p: '门厅', anchor: '密门' }] },
			{ id: '解放→封印松动三章开', cause: { towerFlag: 'freed' }, kind: 'mechanic', echo: [{ p: '结局 解放', anchor: '谁看着它' }, { p: '塔门', anchor: '暗河河道下去' }, { p: '门厅', anchor: '密门' }] },
			{ id: '星图对接→前厅星纹可读', cause: { flag: 'hint_weakness' }, kind: 'mechanic', echo: [{ p: '塔底·龙穴前厅', anchor: '排成了坠星的轨迹' }] },
			{ id: '囚徒问询已尽', cause: { towerFlag: 'asked_seer' }, kind: 'state-gate', echo: [{ p: '塔底·囚室', anchor: '想知道的都告诉了你' }] },
			{ id: '问过青梧', cause: { towerFlag: 'asked_wu' }, kind: 'state-gate', echo: [{ p: '塔底·囚室', anchor: '问青梧的事' }] },
			{ id: '问过龙', cause: { towerFlag: 'asked_dragon' }, kind: 'state-gate', echo: [{ p: '塔底·囚室', anchor: '问龙的事' }] },
			{ id: '见过沉睡之龙', cause: { towerFlag: 'saw_dragon' }, kind: 'state-gate', echo: [{ p: '塔底·封印大厅', anchor: '等它醒转' }] },
			{ id: '问过出路', cause: { towerFlag: 'asked_way' }, kind: 'state-gate', echo: [{ p: '塔底·囚室', anchor: '问出路' }] },
			{ id: '信已取出', cause: { towerFlag: 'read_letter' }, kind: 'state-gate', echo: [{ p: '塔底·囚室', anchor: '信已在你怀里' }] },
			{ id: '水闸→河床见底', cause: { towerFlag: 'sluice' }, kind: 'past→present', echo: [{ p: '塔底·暗河码头', anchor: '河床尽头的机房水门敞开' }] },
			{ id: '治疗→平凡之光', cause: { flag: 'witch_healed' }, kind: 'text-variant', echo: [{ p: '结局 空手而归', anchor: '身上旧伤全消' }] },
			{ id: '暗格情报→检定优势', cause: { flag: 'hint_diary' }, kind: 'mechanic', echo: [{ p: '书房', anchor: '宴会幽灵的话浮现' }] },
			{ id: '星图情报→检定优势', cause: { flag: 'hint_star' }, kind: 'mechanic', echo: [{ p: '天文台', anchor: '学徒的低语浮现' }] },
		],
		// revisit：重访状态句——旗标本身即留痕（“你已搜过”）
		revisit: [
			{ flag: 'study_past', p: '书房', anchor: '已搜过' },
			{ flag: 'green_past', p: '温室', anchor: '不肯再听' },
			{ flag: 'obs_past', p: '天文台', anchor: '看不懂的银线' },
			{ flag: 'hall_present', p: '门厅', anchor: '翻找过这里' },
			{ flag: 'study_present', p: '书房', anchor: '已搜过' },
			{ flag: 'green_present', p: '温室', anchor: '化为飞灰' },
			{ flag: 'obs_present', p: '天文台', anchor: 'obs_present' },
		],
		// exempt：机制本体非叙事回声（era=时代机制、intent=结局路由、hall_past 同时在 cause）
		exempt: {
			era: '时代机制本体', 'tower:intent': '结局路由机制（顶楼 intent→三结局）',
			// C3 龙战机制态（#51）：战斗循环/一次性副动作/先手——机制本体非叙事回声，
			// 玩家侧可感知性由 Systems 门（发现性）与 HUD/文本反馈承担
			'tower:dragon_hp': '龙战 HP 计量（HUD 血条实时反馈）',
			'tower:dragon_r': '龙战轮次计数（脚本轮转）',
			'tower:dragon_init': '龙战初始化哨兵',
			'tower:dragon_defeats': '龙威递增计数（败段文本反馈）',
			'tower:sneak_done': '偷袭先手一次性门（巢室链接消隐即反馈）',
			'tower:scroll_lower': '坠星志下半卷（拾取即情报，前厅/斩击伤害反馈）',
			'tower:whistle_blown': '铜哨一次性（宾客助战文本即反馈）',
			'tower:flower_used_dragon': '月光花一次性（回复文本即反馈）',
			'tower:name_struck': '念名一次性（震慑文本即反馈）',
			'tower:dragon_down': '屠龙完成（结局 星落 收束文本即反馈）',
			'tower:looted_hoard': '宝藏厅识货一次性（进账文本即反馈）',
			'tower:scale_armor': '龙鳞护臂获得（熔炉锻成文本即反馈）',
		},
	};
	const Choices = {
		// D2 选择意义感（#36）：选择点全景。判据（Spire 三标准之三）：非任意（有真差异）、
		// 非二元（有过程差异）、后果可见（landing 差异可感知）。landing 枚举：
		// mechanic（机制/资源）/ ending（结局分叉）/ content（内容量）/ text（文本变体）
		// kind 'chargen' 的 arms 由 ChargenRounds 机检（动态渲染无静态出边）
		sites: [
			{ id: '巢室·先手', p: '塔底·龙穴', arms: 2, landing: 'mechanic', note: '偷袭（先手6伤+龙战R1起）vs 对决（退出去大厅等它醒）——道德风味不罚分（C3/#51）' },
			{ id: '囚室·问询', p: '塔底·囚室', kind: 'hub', arms: 3, landing: 'content', note: '问青梧/问龙/问出路——真相互补三臂（C2/#50），互补型而非互斥型' },
			{ id: '车卡·属性', p: '车卡', kind: 'chargen', round: 0, arms: 3, landing: 'mechanic', note: '力/敏/智三系→检定与 build 分工' },
			{ id: '车卡·背景', p: '车卡', kind: 'chargen', round: 1, arms: 3, landing: 'mechanic', note: '金 10/15/12 + 技能组' },
			{ id: '车卡·物种', p: '车卡', kind: 'chargen', round: 2, arms: 3, landing: 'mechanic', note: '金+10 / 察觉 adv / 减伤-2' },
			{ id: '车卡·职业', p: '车卡', kind: 'chargen', round: 3, arms: 3, landing: 'mechanic', note: 'HP 档位 + 技能 + 金' },
			{ id: '车卡·技艺', p: '车卡', kind: 'chargen', round: 4, arms: 3, landing: 'mechanic', note: '技能组——部分为风味位见 exemptSkills' },
			{ id: '车卡·行囊', p: '车卡', kind: 'chargen', round: 5, arms: 3, landing: 'mechanic', note: '火把绳索 / 长剑+2 / 药膏' },
			{ id: '车卡·专长', p: '车卡', kind: 'chargen', round: 6, arms: 3, landing: 'mechanic', note: '察觉 adv / HP+2 / 金+5' },
			{ id: '车卡·烙印', p: '车卡', kind: 'chargen', round: 7, arms: 3, landing: 'mechanic', note: '减伤 / 检定+1 / 战利品+10+情报半价' },
			{ id: '酒馆·火把', p: '酒馆', arms: 2, landing: 'mechanic', note: '10 金买光明 vs 摸黑风险' },
			{ id: '酒馆·传闻', p: '酒馆', arms: 2, landing: 'mechanic', note: '5 金买断桥 adv（#25 sink）' },
			{ id: '洞穴·哥布林处置', p: '洞穴 黑暗', arms: 2, landing: 'mechanic', note: '贿赂买路（恐吓 3 金） vs 拔剑（胜+金/败伤）' },
			{ id: '战斗·尸身处置', p: '战斗', arms: 2, landing: 'mechanic', note: '放生（温室彩蛋+治疗线） vs 斩草（+3 金）' },
			{ id: '森林·赌不赌影子', p: '森林边缘', arms: 3, landing: 'mechanic', note: '进洞 / 吊桥 / 鲁莽挑战（+1 金 vs con15 赌）——路径枢纽即选择' },
			{ id: '委托·收手或登塔', p: '女巫的委托', arms: 2, landing: 'ending', note: '月光倾城（一章结局） vs 整个二章+4 结局' },
			{ id: '摊子·三买', p: '女巫 摊子', arms: 4, landing: 'mechanic', note: '情报×2（烙印半价）/药膏（医药批发价 5）/不买' },
			{ id: '温室·钱或嘴', p: '温室', arms: 2, landing: 'mechanic', note: '10 金确定 vs DC13 赌（#25 双明牌）' },
			{ id: '楼梯·乌鸦', p: '楼梯间', arms: 2, landing: 'mechanic', note: '5 金买剩余清单（QoL）' },
			{ id: '楼梯·去留', p: '楼梯间', arms: 2, landing: 'ending', note: '下塔=结局 半途 vs 继续探索' },
			{ id: '顶楼·三途', p: '顶楼', arms: 3, landing: 'ending', note: '吹哨唤归（需 4 信物）/接棒 keeper/折杖 burn' },
		],
		// 风味位豁免：无检定消费但保留 SRD 风味（D2 判据下显式留痕，非幻觉承诺）
		exemptSkills: {
			'生存': '风味位（荒野人设）', '自然': '风味位（秘闻人设）',
			'欺瞒': '风味位（市井人设）', '隐匿': '风味位（游荡者人设）',
			'巧手': '专长=金+5（effect 诚实标注）',
		},
	};
	const Systems = {
		// D3 系统可玩性（#37）：机制发现性门——每条核心规则的"玩家侧说明"锢点机检。
		// 判据（Spire 三标准之二：整座塔是可实验物）：规则不可知则不可实验。
		mechanics: [
			{ id: 'anchor', rule: '三章共鸣锚：锚内免费切换时代（不耗充能）', p: '塔底·塌井厅', anchor: '嗡鸣共鸣' },
			{ id: 'terrain', rule: '龙战地形=时代：过去石柱掩体受击−1 / 现在废墟攀爬输出+1', p: '塔底·封印大厅', anchor: '石柱是你的掩体' },
			{ id: 'dread', rule: '龙威：第3轮起伤害+1，每败+1，铜哨可清零', p: '塔底·龙战·败', anchor: '龙威会因你的败绩而更重' },
			{ id: 'subaction', rule: '信物副动作（哨/花/名）不耗轮，各一次性', p: '塔底·封印大厅', anchor: '唤宴会宾客的残念' },
			{ id: 'retry', rule: '龙战败：回声接住——战斗重开资产保留', p: '塔底·龙战·败', anchor: '你带来的每一样东西都还在' },
			{ id: 'era', rule: '护身符翻转时代，共 3 充能', p: '女巫的委托', anchor: '充能只够' },
			{ id: 'era-hub', rule: '枢纽页显示时代/充能/信物计数', p: '楼梯间', anchor: '护身符充能' },
			{ id: 'resonance', rule: '每件信物受击 -1', p: '雾之化身战', anchor: '共鸣护体' },
			{ id: 'token-timing', rule: '三信物各自的优势时机（入场预告）', p: '雾之化身战', anchor: '会在鞭击时让她分神' },
			{ id: 'whistle-adv', rule: '铜哨→鞭击优势（触发点即时提示）', p: '化身·一击', anchor: '这一击你有优势' },
			{ id: 'star-adv', rule: '星图→悲鸣豁免优势', p: '化身·终幕', anchor: '豁免优势' },
			{ id: 'final-adv', rule: '月光花或信物≥2→终击优势', p: '化身·终击', anchor: '最后一击有优势' },
			{ id: 'diary-reduce', rule: '日记：整场伤害再 -1', p: '雾之化身战', anchor: '整场伤害再 −1' },
			{ id: 'rage', rule: '每败一次伤害+1 封顶+2', p: '雾之化身战', anchor: '悲鸣比上次更烈' },
			{ id: 'echo-guard', rule: '战败不死，塔护住你', p: '塔的回声', anchor: '不让你死在这里' },
			{ id: 'salve', rule: '药膏受伤自动消耗回 4', p: '[chargen]', anchor: '自动消耗一副' },
			{ id: 'sword', rule: '长剑战斗检定+2', p: '[chargen]', anchor: '战斗检定 +2' },
			{ id: 'luck', rule: '机运：检定与豁免+1', p: '[chargen]', anchor: '所有检定与豁免 +1' },
			{ id: 'lore', rule: '学识：战利品+10、情报半价', p: '[chargen]', anchor: '情报半价' },
			{ id: 'hint-adv', rule: '线索→对应检定优势（买前知、用时见）', p: '书房', anchor: '更有方向——优势' },
		],
		// 组合矩阵：机制×机制交互的实现证据（出具报告，人工审计补充）
		combos: [
			{ a: 'resonance', b: 'diary-reduce', evidence: 'audit --tokens 伤害矩阵 + properties battleDamage 断言' },
			{ a: 'rage', b: 'resonance', evidence: 'properties battleDamage defeats 分支（败次封顶）' },
			{ a: 'salve', b: 'echo-guard', evidence: '塔的回声：怀中信物黯了一分但都在；药膏库存保留' },
			{ a: 'era', b: 'token-timing', evidence: 'past 取信物→present/战斗生效（Echoes 表）' },
			{ a: 'luck', b: 'sword', evidence: 'Rules.check：adv 骰+bonus+luck 线性叠加（rules 单测）' },
			{ a: 'hint-adv', b: 'lore', evidence: '情报半价（价格表）+ 优势（检定层）双兑现独立' },
		],
	};
	const Shifts = {
		// C1 三章主玩法（#49）：共鸣锚——位置门控替代二章的充能门控（教学→主玩法）。
		// 锚内切换免费无限；锚外不可切。新增锚点须同步 audit 门（Shifts.anchors 全部存在且挂锚）。
		unlimited: true,
		anchors: ['塔底·塌井厅', '塔底·暗河码头', '塔底·封印大厅', '塔底·水淹机房', '塔底·熔炉', '塔底·观测廊'],
	};
	// C3 龙战（#51）：雾之龙——lair 战数值单源。地形=era（战斗在大厅段内渲染，
	// 共鸣锚即战术动作：past 石柱掩体受击−1 / present 废墟攀爬输出+1）。
	// 弱点加成双源：hint_weakness（星图对接）+ scroll_lower（巢室坠星志下半卷）。
	const Dragon = {
		hp: 22,               // 龙 HP
		sneakHit: 6,          // past 巢室偷袭先手
		hitBase: 3,           // 玩家每轮输出基数
		script: { 1: 2, 2: 4, 3: 2, 4: 4 },  // 龙行动脚本（爪/焰/爪/焰），R5 起循环
		dreadCap: 2, dreadFromRound: 3,      // 龙威：第3轮起 +1 封顶2，哨响 −1（自检修正：不随败绩递增——回声守卫 retry 不加压）
		armorReduce: 1,       // 熔炉龙鳞护臂：受击全程 −1
		terrain: { past: { taken: -1, dealt: 0 }, present: { taken: 0, dealt: 1 } },
		effects: {
			'铜哨':   { kind: 'dread-clear', note: '宾客残念围龙——龙威清零（一次性）' },
			'星图残页': { kind: 'breath-half', note: '预判吐息——龙焰伤害减半（被动）' },
			'月光花':  { kind: 'heal', value: 2, note: '银辉解毒——回复 2（一次性）' },
			'日记':   { kind: 'name-strike', value: 2, note: '念出青梧之名震慑——输出 +2（一次性）' },
		},
		playerDamage(pc, era) {
			const w = (pc.tower.scroll_lower ? 1 : 0) + (pc.tower.name_struck ? 2 : 0) + (pc.tower.hint_weakness ? 1 : 0);
			const hint = pc.tower.hint_weakness && !pc.tokens.includes('星图残页') ? 1 : 0; // 星纹共振线的补偿位
			return this.hitBase + w + hint + (this.terrain[era]?.dealt ?? 0);
		},
		dragonDamage(pc, r, era) {
			const slot = ((r - 1) % 4) + 1;
			const breath = slot === 2 || slot === 4;
			let d = this.script[slot];
			if (breath && pc.tokens.includes('星图残页')) d = Math.ceil(d / 2);
			const dread = Math.max(0, (r >= this.dreadFromRound ? 1 : 0) - (pc.tower.whistle_blown ? 1 : 0));
			d += dread;
			if (pc.tower.scale_armor) d -= this.armorReduce;
			d += this.terrain[era]?.taken ?? 0;
			return Math.max(1, d);
		},
	};
	return { Economy, Checks, Tokens, Truth, Echoes, Choices, Systems, Shifts, Dragon };
})();
