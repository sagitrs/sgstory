{
	"name": "sgstory",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "Twine + SugarCube 文字冒险游戏脚手架（Twee 源码 → 单文件 HTML）",
	"scripts": {
		"build": "node build.mjs",
		"test": "node scripts/run-tests.mjs",
		"serve": "python3 -m http.server 8000 --directory dist",
		"watch": "node --watch --watch-path=src build.mjs",
		"audit": "node scripts/audit.mjs",
		"report:rhythm": "node scripts/report-rhythm.mjs",
		"report:freshness": "node scripts/report-ledger-freshness.mjs",
		"report:gates": "node scripts/report-gate-ledger.mjs",
		"report:gates:update": "node scripts/report-gate-ledger.mjs --update",
		"report:gates:check": "node scripts/report-gate-ledger.mjs --selftest && node scripts/report-gate-ledger.mjs",
		"audit:golden": "node test/audit-golden.mjs",
		"audit:golden:update": "node test/audit-golden.mjs --update",
		"report:freshness:check": "node scripts/report-ledger-freshness.mjs --selftest && node scripts/report-ledger-freshness.mjs --check",
		"test:saveload": "node build.mjs && node test/saveload.mjs",
		"report:rhythm:check": "node scripts/report-rhythm.mjs --check && node scripts/report-rhythm.mjs --selftest",
		"soak": "node build.mjs && node test/walker.mjs 20 20 && node test/browser.mjs",
		"update-coverage-baseline": "node test/coverage.mjs --update-baseline",
		"browser": "node test/browser.mjs",
		"browser:setup": "bash scripts/chrome-deps.sh",
		"test:serial": "node scripts/run-tests.mjs --serial",
		"test:list": "node scripts/run-tests.mjs --list"
	},
	"devDependencies": {
		"extwee": "^2.3.7",
		"jsdom": "^30.0.1"
	}
}
