:: StoryScript [script]
// ── 全局配置（数值层与宏定义见「规则系统」「车卡数据」段落）──
Config.history.maxStates = 40; // 可回退的步数（默认 20）
Config.saves.maxSlotSaves = 16; // 存档位（默认 8；SugarCube 上限 = Save.MAX_INDEX+1 = 16）

// 存档里写入自定义元数据，玩家在存档菜单里可以区分不同存档
Save.onSave.add((save) => {
	const pc = State.variables.pc ?? {};
	save.metadata = {
		name: pc.name || State.variables.player_name || '无名旅人',
		species: pc.speciesLabel || '',
		class: pc.classLabel || '',
		hp: pc.hp,
		gold: pc.gold,
	};
});
Save.onLoad.add((save) => {
	// 读档后可拿到 save.metadata 做展示或迁移逻辑（示范钩子用法）
	console.log('存档已载入', save.metadata);
});

// ── 常驻存档 / 读档（v16 §5.0：常驻界面，不埋进侧栏菜单）──
// 侧栏固定块调这三个全局函数；S / L 为快捷键（不在输入框内时生效）。
// #320 阶段 1：这五个收进 `Sg.save.*`（UI/运行时命名空间，见 docs/dev-conventions.md §7）
window.Sg.save = {
	quick: () => Save.browser.slot.save(1, `快速存档 · ${State.variables.pc?.name || '无名旅人'}`),
	// 读档有个坑：Save.browser.slot.load() 只把状态还原，**不会重画**（SugarCube 自己的存档界面
	// 也是 load().then(Engine.show)）。少了这一步，画面会停在原地——按 L 看着像没反应。
	load: (index) => Save.browser.slot.load(index).then(Engine.show, (ex) => UI.alert(`读档失败：${ex.message}`)),
	quickLoad: () => {
		if (!Save.browser.slot.has(1)) {
			UI.alert('还没有存档——先按 S 快速存档。');
			return;
		}
		window.Sg.save.load(1);
	},
	menu: () => UI.saves(),
};
jQuery(document).on('keydown.sgSave', (ev) => {
	const tag = (ev.target?.tagName ?? '').toUpperCase();
	if (tag === 'INPUT' || tag === 'TEXTAREA' || ev.ctrlKey || ev.metaKey || ev.altKey) return;
	if (ev.key === 's' || ev.key === 'S') { ev.preventDefault(); window.Sg.save.quick(); }
	else if (ev.key === 'l' || ev.key === 'L') { ev.preventDefault(); window.Sg.save.quickLoad(); }
});
// ── 道具图鉴（`Sg.Codex`）已搬去故事侧（`#574`：当时是 `stories/mist-forest/72-codex-ui.twee`）——
//    ⚠️ **`#1004` B 段后该故事已删** ✗ ⇒ 这一面现由（测试夹具）`stories/face-fixture/13-codex.twee` 声明 ✓
//    它读故事 1 的 `Game.Codex`，属**故事面**；本文件其余部分是**引擎运行时胶水**（layer: engine），
//    对每个故事都成立。引擎侧对它的引用是可选面：见下方 `:passagestart` 的 `Sg.Codex?.sync?.()`。

// ── 笔记（伞 #422 阶段 1）：知识的唯一取值口 ──────────────────────────
//     · `has(id)` 走条目的 `grant`（阶段 1 它读的是现有旗标 → 零行为变化）
//     · `all()` 返回已知笔记（按声明顺序），`missing(req)` 便于条件表做「缺什么」诊断
//     · 阶段 3 之后写点搬到 `add()`；在此之前本封装**只读**，不写状态（渲染路径契约）
window.Sg.notes = {
	// 单一路径求值器：笔记只声明 flagPath（如 'ev.tav_tips'），求值在此一处完成——
	// 这样数据表里不出现任何字面旗标读点（否则会被「选择后果」门的消费推导算成叙事消费）。
	// 多源 OR（#432-B8/B12）：flagPath 允许给**字符串数组** —— 同一知识的几条获取路径取 any
	//（例：`world.hall_hint`（看钉失败听人比过）∨ `ev.hall_seen`（看钉成功看准了））。
	readPath(pc, path) {
		if (Array.isArray(path)) return path.some((q) => this.readPath(pc, q));
		let cur = pc;
		for (const seg of String(path ?? '').split('.')) { if (cur == null) return undefined; cur = cur[seg]; }
		return cur;
	},
	// #436-b：表**只经故事注册的入口**取（`Sg.story.notes()`）——本文件将来搬进引擎侧时，
	// 它不得出现故事符号（`Game.Notes`）；结构缺失（未注册）⇒ **fail-loud**，不静默当空表。
	table() {
		const provide = window.Sg.story?.notes;
		if (typeof provide !== 'function') throw new Error('Sg.notes：故事未注册 `Sg.story.notes()`（接入契约 #436-b／#441-E）——结构缺失必须报错，不许静默当空表');
		const t = provide();
		// 结构**畸形**同样报错：`null`／非对象／数组都不是「笔记表」。空对象 `{}` 是合法空表（那是数据缺失，不是结构缺失）。
		if (t == null || typeof t !== 'object' || Array.isArray(t)) throw new Error('Sg.notes：`Sg.story.notes()` 未返回笔记表（拿到 ' + (t === null ? 'null' : Array.isArray(t) ? 'array' : typeof t) + '）——结构畸形必须报错');
		return t;
	},
	// 写入器（与 readPath 对称）：`'ev.x'`／`'world.x'`。
	// #434 阶段 3：**机制住在引擎侧**（读侧 `has()` 也是在这求值、数据由 `Sg.story.notes()` 给）
	// —— 故事侧**不新增 provider**，表里的 `flagPath` **就是**写回声明（形状定稿见 Discussion #513）。
	writePath(pc, path, v) {
		const segs = String(path ?? '').split('.');
		let cur = pc;
		for (const s of segs.slice(0, -1)) { if (cur[s] == null) cur[s] = {}; cur = cur[s]; }
		cur[segs[segs.length - 1]] = v;
	},
	// 真存储（#434）：`pc.ev.notes` 是「已授予」的**记录**；旧档只有旗标 ⇒ 由 has() 的旗标面兜住
	stored(id, pc = State.variables.pc) { return !!pc?.ev?.notes?.[id]; },
	entry(id) { return this.table()[id] ?? null; },
	ids() { return Object.keys(this.table()); },
	/**
	 * 位点 → 知识（`#762` A 线：`checkKnowledge` 下沉）。
	 * 故事仍持有 `Game.Checks.knowledge`（位点→旗标）与 `knowledgeWhy`（旗标→来源）两张**声明表**；
	 * **组装**（含"是否持有"）住引擎 ⇒ 故事不再需要写这个函数。
	 * 两态要分清：没有这个知识点 ⇒ `null`；有知识点但**未持有** ⇒ `{ flag, why, held: false }`。
	 */
	knowledgeOf(name, pc = State.variables.pc) {
		const flag = window.Game?.Checks?.knowledge?.[name];
		if (!flag) return null;
		const why = window.Game?.Checks?.knowledgeWhy?.[flag] ?? flag;
		// `flagPath` 反查笔记 id（读侧唯一权威是存储）；找不到就回落读该路径的旗标（合成态/旧档/单测）。
		const entries = window.Sg?.story?.notes?.() ?? {};
		const want = 'world.' + flag;
		const id = Object.keys(entries).find((k) => {
			const fp = Array.isArray(entries[k]?.flagPath) ? entries[k].flagPath : [entries[k]?.flagPath];
			return fp.includes(want);
		});
		const held = this.has(id ?? '__none__', pc) || !!this.readPath?.(pc, want);
		return { flag, why, held };
	},
	// 读取语义（`#437` C-2c-2 起）：`has(id, pc = 当前存档的 pc) = stored(id, pc)` —— **只认真存储**。
	// `pc` 参数（`#437` C-2c-3）：图鉴/门里的判据是 `test(p)` 形式，吃的是**传入的 pc**（例如门的"全收集态"合成 pc）——
	// 不给这个参数，`has()` 会一直读全局存档 ⇒ 判据在合成态上是错的（实测 `--canon` 报「全收集态仍不满足」）。
	// 兼容层（旗标兜底 `∨ any(readPath(flagPath))`）已随本片退场；旧档的旗标由 `migrateLegacy()` **一次性补进存储**，
	// 所以"旧档载入不丢知识"这条不变（`Game.Pc.migrate()` 里调用 ⇒ 每次载档幂等补齐）。
	has(id, pc = State.variables.pc) {
		const e = this.entry(id);
		if (!e) return false;
		return this.stored(id, pc);
	},
	// **旧档迁移**（`#437` C-2c-2）：把"只有旗标、没有 `ev.notes`"的存档补成存储态。
	// 为什么必须单独一条（而不是留在 `has()` 里兜底）：兜底是**读侧的兼容层**——它让"旗标"与"存储"两份状态
	// 长期并行存在（谁写谁忘都能蒙对）；改成**写一次迁移**之后，`has()` 只认一份真源，模型才闭合。
	// 幂等：已 stored 的跳过；返回补写条数（0 = 无需迁移）。
	migrateLegacy(pc = State.variables.pc) {
		if (!pc || typeof pc !== 'object') return 0;
		let n = 0;
		for (const id of this.ids()) {
			if (this.stored(id, pc)) continue;
			const e = this.entry(id);
			const v = typeof e?.grant === 'function' ? e.grant(pc) : this.readPath(pc, e?.flagPath);
			if (!v) continue;
			pc.ev = pc.ev ?? {};
			pc.ev.notes = pc.ev.notes ?? {};
			pc.ev.notes[id] = true;
			n++;
		}
		return n;
	},
	// 授予（#434）：**幂等** ＋ 真存储 ＋ **双写**（同时置旗标，票面「旗标降为兼容字段」）。
	// 多源护栏：`flagPath` 是**数组**时必须显式 `setPath`（写哪一条）⇒ 缺则**报错**，绝不静默多写一个旗标。
	add(id, pc = State.variables.pc) {
		const e = this.entry(id);
		if (!e) throw new Error(`Sg.notes.add：笔记「${id}」未登记（结构缺失必须报错，#434）`);
		// `#437` C-2c-1b：早退只看**存储**，不看 `has(id)`（＝存储 ∨ 旗标）。
		// 为什么（`#437` C-2c 的实验法实测）：语料里 `<<firstTime "wq_seen">><<note "n_wq_seen">>` 这种**紧接着**的写法，
		// `firstTime` 先置旗标 ⇒ `has()` 立刻为真 ⇒ `add()` 早退 ⇒ **存储永远补不上**（`pc.ev.notes` 始终 undefined），
		// 只是被 `has()` 的旗标兜底掩盖着；一旦按 C-2c-2 删掉兜底，那条知识就会**静默变假**。
		if (this.stored(id)) return false;
		// `#733` 片 2-b（**翻面**）：**单源**笔记不再写旗标 —— 它的 `flagPath` 只是"历史来源"（供 `migrateLegacy()` 迁移旧档），
		// 真存储是 `ev.notes.<id>`；读侧早只认存储（C-2c-2）、单源读点全转 `has()`（C-2c-3）、声明面词汇改 `note:<id>`（片 1）、
		// 写点统一 `add()/<<note>>`（片 2-a）、断言面形式无关（`#738`）、情报捷径接缝给 `held`（`#739` ＋ 故事侧）、接缝吃 `pc`（`#741`）⇒ 旗标已无读者。
		// **多源**笔记照旧：`flagPath` 是"哪一条路径拿到了"的事实，必须写（`setPath` 护栏不变）。
		if (Array.isArray(e.flagPath)) {
			if (!e.setPath) throw new Error(`Sg.notes.add：笔记「${id}」的 flagPath 是数组（多源 OR）⇒ 必须显式声明 setPath（该写哪一条）——不许静默多写一个旗标（#434/#435）`);
			this.writePath(pc, e.setPath, true);
		}
		pc.ev.notes = pc.ev.notes ?? {};
		pc.ev.notes[id] = true;
		return true;
	},
	all() { return this.ids().filter((id) => this.has(id)); },
	// **路径限定的授予**（`#569`）：行里声明 `yields: [{ id, path }]` ⇒ 只写**声明的那一条** path。
	// 与 `add()` 的三处差别（逐条写清，因为它们是这个 API 存在的理由）：
	//   ① **路径级幂等**：只看“这条 path 真不真”，**不看** `has(id)`。因为多源笔记里
	//      “听人比过”（`world.` 那条已真）之后**仍要能**记下“看清了钉子”（`ev.` 那条）——两条 path 各记各的；
	//   ② `path` 必须属于该笔记的 `flagPath`（否则写进去**读不出来** ⇒ fail-loud；门侧 `yieldPathProblems()` 同判据）；
	//   ③ `setPath` 护栏**不适用**（本调用就是“显式声明走哪条”本身）——所以 `add()` 对多源笔记的报错路径不受影响。
	addPath(id, path, pc = State.variables.pc) {
		const e = this.entry(id);
		if (!e) throw new Error(`Sg.notes.addPath：笔记「${id}」未登记（结构缺失必须报错，#569）`);
		const ps = Array.isArray(e.flagPath) ? e.flagPath : [e.flagPath];
		if (!ps.includes(String(path))) throw new Error(`Sg.notes.addPath：路径「${path}」不属于笔记「${id}」的 flagPath（${ps.join('／')}）——写进去读不出来（#569）`);
		// ① 路径级幂等（**并**要求存储已写：否则旗标已真而存储缺失时同样会把存储漏掉，见 `add()` 的注释）
		if (this.readPath(pc, path) === true && this.stored(id)) return false;
		this.writePath(pc, path, true);
		pc.ev.notes = pc.ev.notes ?? {};
		pc.ev.notes[id] = true;
		return true;
	},
	missing(req = []) {
		const need = req.flatMap((r) => (typeof r === 'string' ? [r] : (r?.any ?? [])));
		return need.filter((id) => !this.has(id));
	},
};


/* ── 结局页的收尾入口（C1）─────────────────────────────────────────────────
   每个 <<ending>>（终局 10 个 + 章节出口 5 个）都发这张卡：退回上一步 / 读档 / 从头再来。
   卡片写在 <<ending>> 里（渲染在段落顶部），下面这个 :passagerender 把它挪到段落末尾——
   于是"每个结局都有出口"只依赖 <<ending>> 一处（图鉴门已强制所有 结局* 段落都调它）。
   为什么用 button + 委托而不是 <<link>>：这三个动作是导航/存档 API，不是段落跳转，
   而且要能带条件显示（有没有存档、有没有上一步）。 */
// `#1132` B2：**声明式施加器**（能力进引擎库 ✓ 数据由调用方给 ⇒ 不碰故事全局 ✓）。
//   动词集＝**封闭三件**（从真实消费者推得，逐条有据 ✓）：
//     set    ＝赋值（替换，非合并）：顶层／点分路径／整对象
//     add    ＝数值增（仅 number ⇒ 非 number 当场大声报 ✗ 不静默）
//     append ＝数组追加
//   未知动词 ⇒ **大声报** ✗（封闭集的能假面：宁可响，不可静默漏字段）
window.Sg.Chargen = {
	VERBS: ['set', 'add', 'append'],
	// `#1132` B2：**写前深拷贝** —— 契约＝「**绝不改写调用方数据**」✓
	//   实测：`writePath` 按**引用**存对象 ⇒ 若不拷贝，后续 `add` 会把**调用方对象**（＝json 里的
	//   `patch.abilities.set`）当场改写 ✗ ⇒ 同一预设连用两次 ⇒ 数值翻倍 ✗（序列级读数咬出 ✓）
	_clone(v) { return v !== null && typeof v === 'object' ? JSON.parse(JSON.stringify(v)) : v; },
	apply(pc, patch) {
		if (!pc || typeof pc !== 'object') throw new Error('Sg.Chargen.apply：pc 缺失');
		if (!patch || typeof patch !== 'object') throw new Error('Sg.Chargen.apply：patch 缺失');
		for (const [path, v] of Object.entries(patch)) {
			if (v !== null && typeof v === 'object' && !Array.isArray(v)) {
				const verbs = Object.keys(v).filter((k) => this.VERBS.includes(k));
				if (verbs.length === 0) {
					throw new Error('Sg.Chargen.apply：载荷 `' + path + '` 没有可识别的动词（只认 '
						+ this.VERBS.join('／') + '）—— 拿到 ' + JSON.stringify(v));
				}
				for (const verb of verbs) {
					const arg = v[verb];
					if (verb === 'set') window.Sg.notes.writePath(pc, path, this._clone(arg));
					else if (verb === 'append') for (const x of [].concat(arg)) {
						const cur = window.Sg.notes.readPath(pc, path);
						window.Sg.notes.writePath(pc, path, this._clone([].concat(cur ?? [], x)));
					} else {
						const cur = window.Sg.notes.readPath(pc, path);
						if (typeof arg !== 'number') throw new Error('Sg.Chargen.apply：`' + path + '` 的 add 载荷必须是数字，拿到 ' + JSON.stringify(arg));
						if (typeof cur !== 'number') throw new Error('Sg.Chargen.apply：`' + path + '` 原值不是数字（' + JSON.stringify(cur) + '）⇒ add 不可用');
						window.Sg.notes.writePath(pc, path, cur + arg);
					}
				}
			} else {
				window.Sg.notes.writePath(pc, path, this._clone(v));   // 裸值 ⇒ set ✓（同样克隆 ✓）
			}
		}
	},
};

window.Sg.Ending = {
	foot(key, kind) {
		const hasSave = Save.browser.slot.has(1);
		const canUndo = State.history.length > 1;
		const loadLabel = hasSave ? '读档' : '读档（还没有存档）';
		const undoAttr = canUndo ? '' : ' disabled';
		return (
			`<div class="ending-foot" data-ending="${key}" data-kind="${kind}">` +
			`<p class="ending-foot-lead">这段旅程到此结束。你可以返回之前的选择，或开始新的旅程：</p>` +
			`<div class="ending-acts">` +
			`<button type="button" class="end-act" data-end-act="undo"${undoAttr}>↶ 退回上一步</button>` +
			`<button type="button" class="end-act" data-end-act="load">${loadLabel}</button>` +
			`<button type="button" class="end-act" data-end-act="restart">↻ 从头再来</button>` +
			`</div>` +
			`<p class="ending-foot-hint">（随时按 <b>S</b> 存档、<b>L</b> 读档；也可以从侧栏开存档菜单。` +
			`从头再来会重置当前进度，请先保存想保留的旅程；<b>已解锁的图鉴仍会保留</b>。）</p>` +
			`</div>`
		);
	},
};

// 从头再来：本档清零、回开场。不用 SugarCube 的 Engine.restart()——它靠 window.location.reload()，
// 单文件离线版也还得多一次整页重载；这里直接重跑 StoryInit 再落到起始段（同一条初始化路径）。
window.Sg.save.restart = () => {
	State.reset();
	new Wikifier(null, Story.get('StoryInit').processText());
	Engine.play(Config.passages.start);
};

jQuery(document).on('click.sgEndAct', '#passages button[data-end-act]', function (ev) {
	ev.preventDefault();
	const act = String(this.dataset.endAct ?? '');
	if (act === 'undo') {
		if (State.history.length > 1) Engine.backward();
	} else if (act === 'load') {
		if (Save.browser.slot.has(1)) window.Sg.save.load(1);
		else UI.saves();
	} else if (act === 'restart') {
		window.Sg.save.restart();
	}
});

// 卡片挪到段落末尾（:passagerender 的 ev.content 就是这个段落元素）
jQuery(document).on(':passagerender.sgEndFoot', (ev) => {
	const $content = jQuery(ev.content);
	const $foot = $content.find('.ending-foot');
	if ($foot.length) $content.append($foot);
});

// 同页选项会重绘整个段落，而 SugarCube 默认回到页顶。
// 只用点击前后的公开 DOM 找本次反馈；不把滚动目标写进存档或剧情状态。
(() => {
	const feedbackSelector = '.scene-feedback, .tavern-heard p, .check-result, .soc-said, .damage-flash, .fight-log, .gain, .econ-note';
	const textOf = (el) => el.textContent.trim();
	let pending = null;
	let action = 0;

	const remember = (ev) => {
		pending = null;
		action += 1;
		const control = ev.target instanceof Element
			? ev.target.closest('#passages a.link-internal, #passages a.soc-opt')
			: null;
		if (!control || control.closest('.chargen-card')) return;
		const content = control.closest('.passage');
		if (!content) return;
		const panel = control.closest('.soc-ask');
		pending = {
			action,
			root: content,
			textBefore: content.textContent,
			passage: State.passage,
			era: State.variables.era,
			scrollY: window.scrollY,
			panel: panel ? [...content.querySelectorAll('.soc-ask')].indexOf(panel) : -1,
			seen: new Set([...content.querySelectorAll(feedbackSelector)].map(textOf)),
			heard: new Set([...content.querySelectorAll('[data-heard]')].map((el) => el.dataset.heard)),
		};
	};
	// 捕获阶段早于宏与交涉处理器；键盘触发的自制链接也要记录。
	document.addEventListener('click', remember, true);
	document.addEventListener('keydown', (ev) => {
		if (ev.key === 'Enter' || ev.key === ' ') remember(ev);
		else pending = null;
	}, true);

	// #262（#185 阶段四）通用结果留屏：goto 式流程里，链接内的检定/结果文本会随重渲染一起丢。
	// 包一层 goto——导航前把「本次点击新出现、且不属于旧快照」的反馈文本存进 $pc.ev.last_result
	// （带段落名）。重渲染时由下列 :passagerender 槽位放回行动区正上方；不进存档语义，只存文本。
	const gotoMacro = (typeof Macro !== 'undefined' && typeof Macro.get === 'function') ? Macro.get('goto') : null;
	if (gotoMacro) {
		const origGoto = gotoMacro.handler;
		gotoMacro.handler = function () {
			try {
				// 链接里的输出此刻还在 wikifier 缓冲里（未进 DOM）：从 <<goto>> 的 this.output 取。
				// #300 P2：**保留骰面**——目标段落未必有 <<lastcheckFor>>（如洞穴动武→森林边缘），
				// 剥掉骰面就等于把这一掷丢了；改为整段保留并标 hasCheck，由 lastcheckFor 侧避重。
				if (pending) {
					const frag = jQuery(this.output).clone();
					const hasCheck = frag.find('.check-result').length > 0;
					const fresh = frag.text().replace(/\s+/g, ' ').trim();
					if (fresh && fresh.length < 400) {
						State.variables.pc.ev.last_result = { p: State.passage, era: State.variables.era, text: fresh, hasCheck };
					}
				}
			} catch (e) { /* 捕获失败不影响导航 */ }
			return origGoto.apply(this, arguments);
		};
	}
	jQuery(document).on(':passagerender.sgResult', (ev) => {
		const r = State.variables.pc?.ev?.last_result;
		if (!r || (r.era && r.era !== State.variables.era) || !r.text) return;
		// #300 裁决（2026-09-12）：**结局页不显示本次结果槽**——结局以自身叙述为准；
		// 落点是结局页的那些掷（顶楼·夺杖→讨伐、龙·终击→星落/坠星之死）在豁免表登记理由。
		if (String(State.passage ?? '').startsWith('结局')) {
			// #364：结局页不显示结果槽（#300 裁决），但**必须把它消费掉**——
			// 否则这次行动的临时结果会一直挂着，等玩家开设定集时串到那一页上去。
			delete State.variables.pc.ev.last_result;
			return;
		}
		// 显示一次即清空：跨段导航（如洞穴动武→森林边缘）也把本次结果留在屏上
		delete State.variables.pc.ev.last_result;
		const content = ev.content;
		if (content.querySelector('.scene-feedback')) return;
		const div = document.createElement('div');
		div.className = 'scene-feedback';
		jQuery(div).wiki(String(r.text));
		const anchor = content.querySelector('.scene-acts, .tavern-actions, .soc-ask, .fight-acts, details.act-group');
		if (anchor) { anchor.parentNode.insertBefore(div, anchor); return; }
		// 没有显式行动容器：插在段落「首个链接簇」之前——结果与行动相邻，且不改变出口在末
		const kids = [...content.childNodes];
		let idx = kids.findIndex((n) => n.nodeName === 'A' && n.classList.contains('link-internal'));
		if (idx < 0) idx = kids.length;
		while (idx > 0 && (kids[idx - 1].nodeName === 'BR' || (kids[idx - 1].nodeType === 3 && !kids[idx - 1].textContent.trim()))) idx--;
		content.insertBefore(div, kids[idx] ?? null);
	});

	jQuery(document).on(':passageend.sgFeedback', (ev) => {
		const previous = pending;
		pending = null;
		if (!previous || previous.passage !== State.passage || previous.era !== State.variables.era) return;
		const content = ev.content;
		const panel = previous.panel < 0 ? null : content.querySelectorAll('.soc-ask')[previous.panel];
		const fresh = (elements) => [...elements].find((el) => textOf(el) && !previous.seen.has(textOf(el)));
		// 优先按「新增回答容器」定位：一条话题的多段回答整体一组，不靠首段文字猜归属。
		const newHeard = [...content.querySelectorAll('[data-heard]')]
			.find((el) => !previous.heard.has(el.dataset.heard)) ?? null;
		const target = newHeard
			?? (panel
				? fresh(panel.querySelectorAll('.check-result, .soc-said, .soc-done'))
					?? panel.querySelector('.soc-said') ?? panel.querySelector('.check-result, .soc-done')
				: fresh(content.querySelectorAll(feedbackSelector)));
		requestAnimationFrame(() => {
			if (previous.action !== action || content !== document.querySelector('#passages .passage:last-child')) return;
			if (target) {
				// #180 三区（本次回答 / 分组行动 / 已读折叠）：新听到的那条搬进紧贴行动区的「本次回答」槽，
				// 读完就是下一批选项——场景内阅读方向恒为向下，不再回头向上找选项（#179 复发根因）。
				const slot = content.querySelector('.fresh-heard');
				if (slot && target.dataset.heard) {
					slot.append(target);
					slot.hidden = false;
					updateBadges(content);
				} else {
					// 其余反馈落在折叠块里时先展开祖先，再定位。
					for (let anc = target.parentElement; anc && anc !== content; anc = anc.parentElement) {
						if (anc instanceof HTMLDetailsElement) anc.open = true;
					}
				}
				target.classList.add('action-feedback');
				target.setAttribute('tabindex', '-1');
				target.focus({ preventScroll: true });
				window.scrollTo(0, Math.max(0, window.scrollY + target.getBoundingClientRect().top - 32));
			} else {
				// 只更新行囊等无正文反馈的同页操作，保留阅读位置。
				window.scrollTo(0, previous.scrollY);
			}
		});
	});

	// #185：子对话返回主场景 → 落行动区（前段名＝本段名＋「·」前缀；只动滚动/焦点）
	jQuery(document).on(':passageend.sgBackToActs', (ev) => {
		const hist = State.history;
		const prev = hist?.[hist.length - 2]?.title;
		if (!prev || prev === State.passage || !prev.startsWith(State.passage + '·')) return;
		const acts = ev.content.querySelector('.scene-acts, .tavern-actions');
		if (!acts) return;
		requestAnimationFrame(() => {
			acts.setAttribute('tabindex', '-1');
			acts.focus({ preventScroll: true });
			if (typeof window.scrollTo === 'function') {
				window.scrollTo(0, Math.max(0, window.scrollY + acts.getBoundingClientRect().top - 32));
			}
		});
	});

	// ── #261（#185 阶段三）共用层空白归一 ───────────────────────────────
	// 宏与模板的换行会逐行转 <br>，在行动区/块元素旁堆成非叙事空行。只清三类，不碰作者正文：
	// ① 块容器直接子级里的 <br>（行动区、折叠区、交涉面板、战斗区、结局卡）
	// ② 块级元素紧邻的 <br>（</div><br>、<br><div>）
	// ③ 连续空行封顶：run ≥3 个 <br> 归一成 2（作者的单段空行＝2 个，保留）
	const BLOCK_ZONES = '.scene-acts, .tavern-actions, .tavern-tables, .tavern-heard, .soc-ask, .soc-panel, .fight-acts, .fight-log, details, #hall-act, .ending-card, #keeper-acts';
	const normalizeBlank = (content) => {
		if (!content) return;
		content.querySelectorAll(BLOCK_ZONES).forEach((z) => {
			[...z.childNodes].forEach((n) => { if (n.nodeName === 'BR') n.remove(); });
		});
		// 块级元素紧邻的 <br>：游走时要跳过空白文本节点（模板换行常夹在其间）
		const isBlankText = (n) => n && n.nodeType === 3 && !n.textContent.trim();
		content.querySelectorAll('div, details, p, h1, h2, h3, ul, ol').forEach((el) => {
			let prev = el.previousSibling;
			while (prev && (prev.nodeName === 'BR' || isBlankText(prev))) {
				const t = prev.previousSibling;
				if (prev.nodeName === 'BR') prev.remove();
				prev = t;
			}
			let next = el.nextSibling;
			while (next && (next.nodeName === 'BR' || isBlankText(next))) {
				const t = next.nextSibling;
				if (next.nodeName === 'BR') next.remove();
				next = t;
			}
		});
		let run = [];
		const flush = () => { if (run.length > 2) run.slice(2).forEach((b) => b.remove()); run = []; };
		[...content.childNodes].forEach((n) => {
			if (n.nodeName === 'BR') { run.push(n); return; }
			if (n.nodeType === 3 && !n.textContent.trim()) return;   // 空白文本算在同一段空行里
			flush();
		});
		flush();
	};

	// #261（#185 阶段三）键盘继续路径：越过侧栏跳正文／直达行动区／折叠守卫
	jQuery(() => {
		const passages = document.getElementById('passages');
		if (!passages) return;
		passages.setAttribute('tabindex', '-1');   // 跳转落点可聚焦（不影响 Tab 顺序）
		const jump = document.createElement('a');
		jump.className = 'skip-link';
		jump.href = '#passages';
		jump.textContent = '跳到正文';
		document.body.insertBefore(jump, document.body.firstChild);

		// #262：没显式声明行动区的段落，自动把「末尾那串链接」识别成行动区并包进 .scene-acts
		// （整束 ≤6 条纯链接、段落里没有别的行动容器时）——键盘跳转与分组一次覆盖全库。
		const autoActs = (content) => {
			if (content.querySelector('.scene-acts')) return content.querySelector('.scene-acts');
			if (content.querySelector('.tavern-actions, .soc-ask, details.act-group')) return content.querySelector('.scene-acts');
			const kids = [...content.childNodes];
			let idx = kids.length, links = 0;
			while (idx > 0) {
				const n = kids[idx - 1];
				if (n.nodeName === 'BR' || (n.nodeType === 3 && !n.textContent.trim())) { idx--; continue; }
				if (n.nodeName === 'A' && n.classList.contains('link-internal')) { links++; idx--; continue; }
				break;
			}
			if (links < 2) return null;
			const div = document.createElement('div');
			div.className = 'scene-acts';
			div.id = 'scene-acts';
			content.insertBefore(div, kids[idx] ?? null);
			while (div.nextSibling && div.nextSibling.nodeName !== '#text') {
				if (div.nextSibling.nodeType === 3 || div.nextSibling.nodeName === 'BR') div.appendChild(div.nextSibling);
				else break;
			}
			let last = div.previousSibling;
			for (let n = div.nextSibling; n;) { const next = n.nextSibling; div.appendChild(n); n = next; }
			return div;
		};

		jQuery(document).on(':passageend.sgKeyboard', (ev) => {
			const content = ev.content;
			const acts = autoActs(content) ?? content.querySelector('.tavern-actions');
			if (!acts) return;
			if (!acts.id) acts.id = 'scene-acts';
			if (content.querySelector('.skip-acts')) return;
			const skip = document.createElement('a');
			skip.className = 'skip-link skip-acts';
			skip.href = '#' + acts.id;
			skip.textContent = '跳到行动';
			content.insertBefore(skip, content.firstChild);
		});

		// 替换式交互不触发 :passageend：焦点随旧节点消失时交回本次反馈
		let focusInside = false;
		document.addEventListener('focusin', (ev) => { focusInside = passages.contains(ev.target); }, true);
		new MutationObserver(() => {
			if (!focusInside) return;
			const active = document.activeElement;
			if (active && active !== document.body) { focusInside = passages.contains(active); return; }
			focusInside = false;
			const fb = passages.querySelector('.fresh-heard:not([hidden]), .check-result, .damage-flash, .gain:not(:empty), .scene-acts');
			if (!fb) return;
			normalizeBlank(passages);
			fb.setAttribute('tabindex', '-1');
			fb.focus({ preventScroll: true });
			if (typeof window.scrollTo === 'function') {
				window.scrollTo(0, Math.max(0, window.scrollY + fb.getBoundingClientRect().top - 32));
			}
		}).observe(passages, { childList: true, subtree: true });

		document.addEventListener('toggle', (ev) => {
			const d = ev.target;
			if (d instanceof HTMLDetailsElement && !d.open && d.contains(document.activeElement)) {
				d.querySelector('summary')?.focus({ preventScroll: true });
			}
		}, true);

		// `#1012`：**导航型交互**之后把焦点送回正文 ✗ —— 用户从正文里的控件发起跳转时，旧节点一被替换，
		//   `activeElement` 就落到 `body` 上（实测：`酒馆` 行动区的 `[[就地了结这一趟|结局 平凡之路]]`
		//   用 `Enter`/点击激活后 `passage` 真变了 ✓ 而焦点在 `body` ✗）⇒ 键盘／读屏用户失去落点 ✓。
		// ⚠️ 两条**合起来**才动（各挡一半 ✗）：① 焦点**本来就在正文里**（`focusInside` ✓）—— 这一条把
		//   **程序性导航**（`Engine.play`／页面载入 ✓）挡在外面 ✓（否则会把 Tab 序列的起点挪到正文之后，
		//   越过「跳到正文」/「跳到行动」那两条跳转链接 ✗）；② 替换之后焦点**确实丢了** ✓（`body`／
		//   已脱离文档 ✓）—— 已有更精确落点的两种（`#180` 就地反馈定位 ✓／`#185` 子对话返回行动区 ✓）
		//   各由上两处先处理 ✓，本处只补**没人接的那一类**（导航 + 目标段落里没有那些落点）✓。
		// ⚠️ 判据口径照 `docs/dev-conventions.md` §6 ✗：契约是「**焦点仍在 `#passages` 内**」✓
		//   —— 落到**哪一个**元素属实现路径 ✓（此处取段落根＝新内容的**顶部**，符合导航后的阅读顺序 ✓），
		//   断言不得绑元素 ✓；滚动不动（`preventScroll` ✓）—— 本票只修焦点，改滚动属另一件 ✗。
		jQuery(document).on(':passageend.sgFocusNav', (ev) => {
			if (!focusInside) return;                       // 程序性导航：不抢焦点 ✓
			const hist = State.history;
			const prev = hist?.[hist.length - 2]?.title;
			if (prev && prev !== State.passage && prev.startsWith(State.passage + '·')) return;   // 子对话返回：上面那条管 ✓
			const content = ev.content ?? passages.querySelector('.passage:last-child');
			if (!content) return;
			// ⚠️ **必须延到「激活序列」之后** ✗：Chrome 在 `Enter`／点击的**默认动作收尾**时会把焦点放回
			//   `body`（被激活的节点已被换掉 ✓）⇒ **同步** `focus()` 会被那一下盖掉 ✗ —— 实测：jsdom 里同步
			//   就绿（无默认动作收尾 ✓）、真机·`Enter` 却仍落 `body` ✓ ⇒ 这一行是本条修法的**关键** ✓。
			//   （`requestAnimationFrame` 与仓内其余焦点抖动同款 ✓：`#180` 就地反馈／`#185` 返回行动区 ✓。）
			requestAnimationFrame(() => {
				const active = document.activeElement;
				if (active && active !== document.body && passages.contains(active)) return;      // 已有落点：不动 ✓
				content.setAttribute('tabindex', '-1');
				content.focus({ preventScroll: true });
			});
		});
	});

	// 行动分组与已读记录的条数角标：纯展示，读当前渲染结果，不写任何状态。
	// 「本次回答」搬走条目后要复算一遍（角标减一、空折叠整块藏起），所以抽成函数两处共用。
	const updateBadges = (content) => {
		content.querySelectorAll('details.act-group, details.heard-fold').forEach((d) => {
			const badge = d.querySelector('.act-n');
			if (!badge) return;
			const scope = d.querySelector('.tavern-tables, .tavern-heard') ?? d;
			const n = scope.matches('.tavern-heard')
				? scope.querySelectorAll('[data-heard]').length
				: scope.querySelectorAll('a').length;
			badge.textContent = String(n);
			badge.hidden = n === 0;
			if (d instanceof HTMLDetailsElement && d.classList.contains('heard-fold')) d.hidden = n === 0;
		});
	};
	jQuery(document).on(':passagerender.sgBlank', (ev) => normalizeBlank(ev.content));
	jQuery(document).on(':passagerender.sgZones', (ev) => updateBadges(ev.content));
})();

// 安全网：每个段落开始前归一化 $pc 形状（旧档缺字段/类型错误都会被补齐，
// 幂等且代价可忽略——坑10 的纵深防御）；顺带把图鉴线索并进永久记录。
jQuery(document).on(':passagestart', () => {
	Game.Pc.migrate(State.variables.pc);
	// #264：旧档/手改档的「已倒下」残余——hp 或 max_hp ≤ 0 且没有结局记录时，
	// 场景会用 <<if $pc.hp gt 0>> 渲染空白页（实测：极简档进雾之魔物·战空白）。
	// 修到「一点余气」，让玩家能看见场景与出口而不是黑屏；真正的死亡仍走结局流程。
	// 只对「已车卡」的档生效：未车卡（abilities 为空）是正常初始形状，不得改动（C1 收尾路线会验）
	const pc = State.variables.pc;
	if (pc.abilities) {
		if (typeof pc.max_hp !== 'number' || pc.max_hp <= 0) pc.max_hp = 18;
		if ((typeof pc.hp !== 'number' || pc.hp <= 0) && !pc.ev?.ending) pc.hp = 1;
	}
	// `#574`：图鉴是**故事可选面**（故事 1 有、故事 2／3 没有）——引擎不得直呼其名。
	// 为什么必须可选：`Sg.Codex` 读 `Game.Codex.items`（故事 1 的数据）；对没有图鉴的故事直接调它会抛错，
	// 而这里是**引擎的段落开始钩子**（每个故事都跑）⇒ 每个故事都会被炸。
	window.Sg.Codex?.sync?.();
});

/* ── 交涉面板（B2）的选项点击 ───────────────────────────────────────────────
   选项为什么不用 <<link>>：<<link>> 的内容是**点击时**才解析的，那时 <<for>> 的临时变量
   已经被同一段落里下一个面板覆盖（"点花的面板、算成求术的面板"）。所以面板直接发
   <a data-ask data-how>，值与它一起进 DOM——点谁是谁。
   只写状态 + 重渲染同一段落：判定与结算留在段落顶部的 <<socresolve>>，骰面因此留在帧里。 */
jQuery(document).on('click.sgSocial', '#passages a.soc-opt', function (ev) {
	ev.preventDefault();
	const ask = String(this.dataset.ask ?? '');
	// `#574`：交涉**机制**由故事提供（`Game.Social.ask/levers/…` 是故事 1 的表侧实现）——
	// 引擎的点击代理不得盲调：没有交涉机制的故事若出现 `.soc-opt`，这里只当它不是可点的。
	if (typeof Game.Social?.ask !== 'function') return;
	if (!Game.Social.ask(ask)) return;
	State.variables.pc.ev.soc = { id: ask, how: String(this.dataset.how ?? 'will') };
	Engine.play(State.passage);
});
// 键盘可达（role="link" 的自制链接）
jQuery(document).on('keydown.sgSocial', '#passages a.soc-opt', function (ev) {
	if (ev.key === 'Enter' || ev.key === ' ') { ev.preventDefault(); jQuery(this).trigger('click'); }
});

/* ── #317② 选项稳定定位键（**派生**：只加属性、幂等、不改状态）──────────────
   为什么：测试靠**中文文案**定位 UI 是本仓最脆的耦合之一（实测改一句文案连动 5 处测试调用点）。
   这里给内部链接补一个稳定键：`data-choice` ＝ **目标段落名**（内容骨架，与文案解耦）。
   规则：
     · **只加属性、不碰任何状态** —— 兼容「渲染路径契约」与 `audit --state` 口径；
     · **幂等** —— 已有 `data-choice` 就跳过：作者显式覆盖优先（`data-key` 容器或未来的 widget）；
     · 注册在**文件末尾**，故在所有其它 `:passageend` 后处理**之后**执行
       （那些 pass 会做焦点回收 / 行动区包裹 / 跳转链接插入；派生若先跑会被重排丢掉或重复）。
   歧义由 `test/choice-keys.mjs` 静态枚举（同段落同目标 ≥2 条 → 要求作者覆盖或进白名单）。 */
jQuery(document).on(':passageend.sgChoiceKey', (ev) => {
	const root = ev.content ?? document.querySelector('#passages');
	if (!root?.querySelectorAll) return;
	for (const a of root.querySelectorAll('a.link-internal[data-passage]')) {
		if (a.dataset.choice) continue;                        // 幂等 + 作者覆盖优先
		a.dataset.choice = a.closest('[data-key]')?.dataset.key || a.dataset.passage;
	}
});
